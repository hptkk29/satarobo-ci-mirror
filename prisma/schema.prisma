// ─── Media (Phase NHÓM 3) ────────────────────────────────────────────────────
// Ảnh lớp học: GV upload (PENDING) → CENTER_MANAGER duyệt → phụ huynh xem ảnh
// APPROVED có tag con mình. classId/studentId là cột phẳng (không FK).
enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
  // DRAFT = kho ảnh — GV upload cả loạt, CHƯA chọn gửi PH; không hiện portal,
  // không vào hàng duyệt (reviewMedia chặn). Đặt CUỐI khớp thứ tự ALTER TYPE ADD VALUE.
  DRAFT
}

model ClassSessionMedia {
  id             String      @id @default(cuid())
  classId        String
  fileUrl        String
  fileName       String?
  caption        String?     @db.Text
  status         MediaStatus @default(PENDING)
  // Ảnh chung cả lớp (đánh dấu rõ ràng): mọi PH có con đang học lớp này đều xem
  // được. KHÁC với "không gắn thẻ" — ảnh không tag & không phải class-wide vẫn
  // ẩn với PH (giữ bất biến C6.2 trong lib/lms/media-consent.ts).
  isClassWide    Boolean     @default(false)
  // R7-09 — gắn ảnh vào BUỔI cụ thể + ngày chụp (scalar, fallback mức lớp nếu null).
  classSessionId String?
  takenAt        DateTime?
  uploadedById   String?
  uploadedByName String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?   @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  tags MediaStudentTag[]

  @@index([classId, status])
  @@index([status, createdAt])
  @@index([classSessionId])
}

// R7-14 — auto-giao bài khi "Hoàn tất buổi". 1 bản ghi / (buổi × bài thi × HV);
// unique đảm bảo idempotent khi event session.taught replay. ID phẳng (soft-ref).
enum HomeworkAssignmentStatus {
  ASSIGNED
  SUBMITTED
  GRADED
  MISSED
}

model HomeworkAssignment {
  id             String                   @id @default(cuid())
  classSessionId String
  examId         String
  studentId      String
  dueAt          DateTime?
  status         HomeworkAssignmentStatus @default(ASSIGNED)
  assignMode     String? // NOW / DEFER / CUSTOM_DUE
  assignedById   String?
  assignedAt     DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([classSessionId, examId, studentId])
  @@index([studentId])
  @@index([examId])
  @@index([classSessionId])
}

model MediaStudentTag {
  id        String            @id @default(cuid())
  mediaId   String
  media     ClassSessionMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  studentId String

  @@unique([mediaId, studentId])
  @@index([studentId])
}

// ─── Employee QR attendance (Phase NHÓM 4) ───────────────────────────────────
// Chấm công bằng QR xoay (HMAC time-window, không cần lưu QR). EmployeeCheckin
// ghi check-in/out + GPS + geofence theo Center. userId là cột phẳng (no FK).
enum CheckinType {
  CHECK_IN
  CHECK_OUT
}

// Đợt 3E — đăng ký ca làm việc (3 ca/ngày).
enum WorkShift {
  CA_SANG
  CA_CHIEU
  CA_TOI
}

// R6-B2 — Ca làm việc cấu hình trong DB (per-center giờ/dung sai). 2-phase: enum WorkShift
// giữ nguyên để back-compat; check-in đọc giờ/tolerance từ đây. code khớp enum cũ (T12).
model WorkShiftConfig {
  id        String  @id @default(cuid())
  centerId  String? // null = mặc định toàn hệ thống
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  code             String // CA_SANG | CA_CHIEU | CA_TOI (khớp enum cũ)
  name             String
  startTime        String // "08:00"
  endTime          String // "11:30"
  toleranceMinutes Int      @default(15)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@unique([centerId, code])
  @@index([centerId, isActive])
  @@index([orgUnitId])
}

enum ShiftRegStatus {
  REGISTERED
  LEAVE_REQUESTED
  APPROVED
}

model ShiftRegistration {
  id        String         @id @default(cuid())
  userId    String
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date      DateTime       @db.Date // 1 record / nhân viên / ngày
  shifts    WorkShift[]
  status    ShiftRegStatus @default(REGISTERED)
  note      String?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([centerId, date])
  @@index([userId, date])
  @@index([orgUnitId])
}

// Module Chấm công PHẦN 4 — yêu cầu chỉnh công + log chỉnh sửa.
enum AdjustStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimesheetAdjustmentRequest {
  id             String       @id @default(cuid())
  userId         String // người xin chỉnh
  centerId       String? // cơ sở (để quản lý lọc phạm vi)
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date           DateTime     @db.Date
  reason         String       @db.Text // lý do / giải trình
  requested      String? // nội dung đề nghị (vd giờ vào/ra đúng)
  status         AdjustStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?    @db.Timestamptz(6)
  reviewNote     String?      @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId, date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

// Log mọi lần chỉnh bản ghi công (ai, khi nào, từ→đến, lý do).
model TimesheetEditLog {
  id           String   @id @default(cuid())
  userId       String // chủ bản ghi công
  date         DateTime @db.Date
  field        String // "CHECK_IN" | "CHECK_OUT"
  fromValue    String? // giờ cũ (ISO) hoặc null
  toValue      String? // giờ mới (ISO)
  reason       String?  @db.Text
  editedById   String?
  editedByName String?
  requestId    String? // gắn yêu cầu chỉnh công (nếu duyệt từ yêu cầu)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, date])
  @@index([createdAt])
}

// Đơn từ GV (site giáo viên): 10 loại / 3 nhóm. GV gửi → PENDING → CENTER_MANAGER cơ sở
// duyệt/từ chối (scope theo centerId). Plain-string FK theo pattern TimesheetAdjustmentRequest
// (không relation — app resolve tên khi cần). Không tự sinh side-effect (chỉ trạng thái).
enum WorkRequestKind {
  CLASS_CHANGE // Đổi lớp dạy
  SUB_TEACH // Dạy thay
  CLASS_OFF // Nghỉ buổi dạy
  SHIFT_SWAP // Đổi ca
  OT // Tăng ca
  LATE_EARLY // Đi muộn / Về sớm
  TIMESHEET_FIX // Chỉnh công
  LEAVE // Nghỉ phép
  REMOTE // Làm từ xa
  BUSINESS_TRIP // Đi công tác
  COMP_LEAVE // nghỉ bù — trừ quỹ CompTimeLedger (đợt 8, 08/10/2026)
  HOLIDAY_WORK // làm ngày nghỉ / ngày lễ — phút vào cột riêng (đợt 9)
  OUTSIDE_ATTENDANCE // chấm công ngoài địa điểm trong khung giờ (đợt 10)
}

/// Thời lượng nghỉ (đợt 7). NULL trên đơn cũ = cả ngày.
enum LeaveDurationType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
  HOURLY
}

enum WorkRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN // người nộp thu hồi khi còn PENDING (đợt 1 đơn từ, 08/10/2026)
  CANCEL_REQUESTED // người nộp xin huỷ đơn ĐÃ DUYỆT — còn hiệu lực tới khi duyệt huỷ (đợt 11)
  CANCELLED // đã duyệt huỷ, hệ quả hoàn tác (đợt 11)
}

/// Sổ quỹ NGHỈ BÙ (đợt 8, 08/10/2026) — ledger: mỗi dòng một biến động có dấu, số dư = Σ minutes.
/// `khoa` UNIQUE chống ghi trùng bút toán gắn với một đơn; NULL cho dòng chênh lệch do tính lại công.
/// Giữ cả centerId (cách ly đang đọc) và orgUnitId (đích) — luật Nền Hệ thống #3.
model CompTimeLedger {
  id          String    @id @default(cuid())
  userId      String
  centerId    String
  orgUnitId   String?
  minutes     Int
  /// APPROVED_OT · HOLIDAY_WORK · MANUAL_ADJUSTMENT · COMP_LEAVE · COMP_LEAVE_REFUND
  sourceType  String
  sourceId    String?
  workDate    DateTime? @db.Date
  khoa        String?   @unique
  note        String?
  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
  @@index([sourceType, sourceId])
}

model WorkRequest {
  id          String  @id @default(cuid())
  requesterId String // User (GV gửi đơn)
  centerId    String? // cơ sở của GV (scope duyệt CENTER_MANAGER)
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId   String?

  kind                   WorkRequestKind
  status                 WorkRequestStatus @default(PENDING)
  fromDate               DateTime?         @db.Date // ngày / từ ngày (đơn theo ngày)
  toDate                 DateTime?         @db.Date // đến ngày (đơn khoảng)
  startTime              String? // "HH:mm"
  endTime                String? // "HH:mm"
  hours                  Float? // OT tự tính / chỉnh công
  className              String? // tên lớp (snapshot, đơn liên quan lớp)
  classId                String? // link lớp (tuỳ chọn)
  targetUserId           String? // người dạy thay / nhận ca
  targetShiftId          String? // ca muốn đổi (ShiftRegistration id) — cũ, không ai đọc; thay bằng assignmentId
  // ── Module chấm công v3 (L1 · 06/09/2026) — kế hoạch §3.2 ───────────────────
  assignmentId           String? // ShiftAssignment của ngày áp dụng
  requesterNewTemplateId String? // "Mã ca mới" (SHIFT_SWAP / LEAVE có người thay)
  targetNewTemplateId    String? // "Mã ca của người nhận thay"
  leaveTypeId            String? // LeaveType (LEAVE)
  submittedLate          Boolean           @default(false) // nộp < 2 ngày trước ngày áp dụng (snapshot lúc nộp)
  requestedInAt          String? // TIMESHEET_FIX: giờ vào đề nghị "HH:mm"
  requestedOutAt         String? // TIMESHEET_FIX: giờ ra đề nghị "HH:mm"
  requestedIn2At         String? // TIMESHEET_FIX: giờ VÀO lần 2 "HH:mm" (ca hai buổi — 06/10/2026)
  requestedOut2At        String? // TIMESHEET_FIX: giờ RA lần 2 "HH:mm"
  appliedAt              DateTime?         @db.Timestamptz(6) // đã áp hệ quả (đổi lịch) lúc nào
  applyError             String? // lỗi áp hệ quả — ghi SAU rollback (T-05)
  detail                 String? // meta phụ (nơi đến, hình thức muộn/sớm, người nhận…)
  reason                 String            @db.Text // lý do (bắt buộc)
  reviewedById           String?
  reviewedByName         String?
  reviewedAt             DateTime?         @db.Timestamptz(6)
  reviewNote             String?           @db.Text
  withdrawnAt            DateTime?         @db.Timestamptz(6) // người nộp thu hồi lúc nào (status WITHDRAWN)
  approvedStartTime      String? // OT: khung QUẢN LÝ DUYỆT "HH:mm" (đợt 4) — null = theo khung xin
  leaveDurationType      LeaveDurationType? // nghỉ / nghỉ bù: cả ngày · nửa sáng · nửa chiều · theo giờ (startTime–endTime)
  approvedEndTime        String?
  effectVersion          Int? // dấu "duyệt theo luật mới" — chỉ đơn có dấu mới tác động bảng công khi tính lại
  appliedEffect          Json? // ảnh chụp hệ quả lúc duyệt — để huỷ đơn hoàn tác đúng thứ đã làm
  cancelReason           String?           @db.Text // đợt 11: lý do người nộp xin huỷ đơn đã duyệt
  cancelRequestedAt      DateTime?         @db.Timestamptz(6)
  cancelDecidedById      String?
  cancelDecidedByName    String?
  cancelDecidedAt        DateTime?         @db.Timestamptz(6)
  cancelDecisionNote     String?           @db.Text
  cancelEffect           Json? // ảnh chụp những gì lượt huỷ đã hoàn tác
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)

  @@index([requesterId, status])
  @@index([centerId, status, createdAt])
  @@index([orgUnitId])
}

// Module Quản lý lớp phần 4 — checklist mở/đóng cơ sở theo ngày.
model CenterDayChecklist {
  id        String   @id @default(cuid())
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  date      DateTime @db.Date

  // Đầu ngày
  openPower       Boolean @default(false)
  openDevices     Boolean @default(false)
  openRoomsReady  Boolean @default(false)
  openCleanCommon Boolean @default(false)
  openSecurity    Boolean @default(false)
  // Cuối ngày
  closePower      Boolean @default(false)
  closeDevices    Boolean @default(false)
  closeLock       Boolean @default(false)
  closeKpiBoard   Boolean @default(false)
  closeSafety     Boolean @default(false)
  closeHandover   Boolean @default(false)

  note      String?  @db.Text
  byUserId  String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([centerId, date])
  @@index([centerId, date])
  @@index([orgUnitId])
}

model EmployeeCheckin {
  id             String      @id @default(cuid())
  userId         String
  userName       String?
  centerId       String?
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  type           CheckinType
  checkedAt      DateTime    @default(now()) @db.Timestamptz(6)
  latitude       Float?
  longitude      Float?
  distanceMeters Int?
  withinGeofence Boolean     @default(true)
  qrToken        String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([userId, type, qrToken])
  @@index([userId, checkedAt])
  @@index([centerId, checkedAt])
  @@index([orgUnitId])
}

// ─── Cụm A1 — OTP service + kích hoạt tài khoản ─────────────────────────────

enum AccountStatus {
  PENDING_ACTIVATION // tài khoản phụ huynh mới tạo — chờ kích hoạt qua OTP
  ACTIVE
  DISABLED
}

enum OtpChannel {
  EMAIL
  SMS // QĐ-H 30/07: bỏ hẳn SMS brandname — giữ value vì enum Postgres không xoá được, KHÔNG dùng
  ZALO // AUTH-SĐT P3 — kênh ZNS (otp-provider cắm ở P4)
  // AUTH-SĐT P6 — mã cấp TẠI QUẦY khi ZNS chết: hệ thống KHÔNG gửi đi đâu cả,
  // nhân viên đọc mã cho phụ huynh. Tách riêng để /admin/otp-logs và SLO không
  // đếm nhầm nó là tin đã gửi (và để soát được ai cấp tay, bao nhiêu lần).
  OFFLINE
}

enum OtpPurpose {
  ACTIVATION
  RESET
  CHANGE_CONTACT
}

// 1 yêu cầu OTP. LƯU CODE DẠNG HASH (HMAC) — không lưu plain.
model OtpRequest {
  id          String     @id @default(cuid())
  target      String // email hoặc SĐT nhận OTP
  channel     OtpChannel @default(EMAIL)
  purpose     OtpPurpose
  codeHash    String // HMAC-SHA256(secret, code)
  expiresAt   DateTime   @db.Timestamptz(6)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  verifiedAt  DateTime?  @db.Timestamptz(6)
  consumedAt  DateTime?  @db.Timestamptz(6) // đã dùng để hoàn tất nghiệp vụ (set mật khẩu…)
  userId      String? // tài khoản liên quan (nếu có)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  deliveries OtpDeliveryLog[]

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
}

// Log mỗi lần gửi OTP qua provider.
model OtpDeliveryLog {
  id           String     @id @default(cuid())
  otpRequestId String
  otpRequest   OtpRequest @relation(fields: [otpRequestId], references: [id], onDelete: Cascade)
  channel      OtpChannel
  target       String
  provider     String // "resend" | "speedsms" | …
  status       String // "SENT" | "FAILED"
  error        String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([otpRequestId])
  @@index([target, createdAt])
}

// ─── Cụm A2 — Email tự động (queue + worker/cron) ───────────────────────────

enum EmailQueueStatus {
  PENDING
  SENT
  FAILED
}

// Hàng đợi email — KHÔNG gửi trực tiếp trong transaction nghiệp vụ; worker/cron
// xử lý + retry. templateKey = EmailTemplate.code (render qua template) hoặc dùng
// subject/body inline khi không có template.
model EmailQueue {
  id          String           @id @default(cuid())
  toEmail     String
  toName      String?
  templateKey String? // EmailTemplate.code để render; null = inline
  subject     String? // inline fallback (nếu không có template)
  bodyText    String?          @db.Text
  bodyHtml    String?          @db.Text
  payload     Json // biến render (vars)
  status      EmailQueueStatus @default(PENDING)
  attempts    Int              @default(0)
  maxAttempts Int              @default(3)
  error       String?          @db.Text
  contextType String?
  contextId   String?
  scheduledAt DateTime         @default(now()) @db.Timestamptz(6)
  sentAt      DateTime?        @db.Timestamptz(6)
  emailLogId  String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  @@index([status, scheduledAt])
  @@index([contextType, contextId])
  @@index([createdAt])
}

// ─── Cụm B1 — MakeupNeed: nhu cầu học bù ────────────────────────────────────

enum MakeupNeedStatus {
  PENDING // mới phát sinh, chờ xếp buổi bù
  SCHEDULED // đã gắn buổi bù
  COMPLETED // đã học bù xong
  CANCELLED
}

/// T05 — NGUỒN của một dòng cần bù (không đoán lại từ `note` — `note` bị ghi đè). Dòng cũ trước T05 mang SYSTEM_MIGRATION:
/// không có lịch sử nào cho biết nó từ đâu tới; phân loại lại bằng chứng cứ là việc có dry-run (T15), không phải migration.
enum MakeupSourceType {
  ABSENCE // buổi gốc vắng (điểm danh GV/quản lý, hoặc phiếu của phụ huynh)
  ORDER_CONVERSION // chuyển đổi đơn: học vượt vào lớp đang chạy — KHÔNG có điểm danh gốc
  MANUAL // quản lý tạo tay
  SYSTEM_MIGRATION // script vá/di trú, và mọi dòng có TRƯỚC T05
  OTHER
}

model MakeupNeed {
  id              String           @id @default(cuid())
  studentId       String
  classId         String
  centerId        String? // để lọc theo cơ sở
  orgUnitId       String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  missedSessionId String // buổi đã lỡ
  missedLessonId  String? // lesson của buổi lỡ
  status          MakeupNeedStatus @default(PENDING)
  makeupSessionId String? // buổi được xếp để bù
  note            String?          @db.Text
  createdById     String?
  scheduledById   String?
  completedAt     DateTime?        @db.Timestamptz(6)
  // Học bù đời mới (docs/hoc-bu/DAC-TA.md) — Huỷ = không bù nữa, bắt buộc lý do. Dòng có
  // `waivedAt` KHÔNG được hồi sinh khi sửa điểm danh (chủ ý của QLCS/GĐ/Admin).
  waivedAt        DateTime?        @db.Timestamptz(6)
  waivedById      String?
  waivedReason    String?          @db.Text
  // Buổi bù này có tiêu một lượt bù không (ghi khi bé CÓ MẶT ở case bù dùng lượt).
  usedQuota       Boolean          @default(false)
  // Phí bù (hết lượt ⇒ thu tiền trước khi xếp case). Dòng đơn loại MAKEUP_FEE; phí đã thu
  // GIỮ cho lần xếp sau nếu bé vắng buổi bù (chốt 5 — không thu lần hai).
  feeOrderItemId  String?
  // Miễn phí ngoại lệ (QLCS/Giám đốc/Admin, bắt buộc lý do).
  freeApprovedAt   DateTime?       @db.Timestamptz(6)
  freeApprovedById String?
  freeReason       String?         @db.Text
  /// Nguồn của dòng cần bù. `PHUC_HOC` = buổi bù sinh khi phục học vào lớp đi trước (Bảo lưu BR-22):
  /// KHÔNG trừ hạn mức học bù. NULL = nguồn thường (vắng buổi). Cột văn bản, không enum, để thêm
  /// nguồn không phải migrate enum; giá trị hợp lệ khai ở `lib/bao-luu/hang-so.ts`.
  nguon            String?
  // T05 — chuẩn hoá MakeupLine. KHÔNG có default ở schema: mọi chỗ ghi PHẢI khai nguồn (luật 7 — `tsc` liệt kê chỗ ghi),
  // nên "quên khai" là lỗi biên dịch chứ không phải một dòng lặng lẽ mang nhãn sai.
  sourceType           MakeupSourceType
  // Điểm danh GỐC làm phát sinh dòng này (null với ORDER_CONVERSION/MANUAL, và với dòng cũ chưa liên kết). FK SET NULL:
  // xoá điểm danh không được kéo theo mất nghĩa vụ bù. Chưa có FK cho missedSessionId/missedLessonId/feeOrderItemId:
  // cần dọn dòng mồ côi trước (T15) và `ON DELETE` của khoản phí là quyết định nghiệp vụ.
  originalAttendanceId String?
  // Khoá của lớp lúc dòng được tạo — nhóm case ghép theo khoá, nên đọc cột này thay vì join qua lớp. Luôn khớp
  // Class.courseId (checker TV-30); dòng cũ được backfill tất định từ Class.
  courseId             String
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  originalAttendance Attendance? @relation("MakeupNeedOriginalAttendance", fields: [originalAttendanceId], references: [id], onDelete: SetNull)
  caseStudents MakeupCaseStudent[]
  parentRequests ParentRequest[]

  @@unique([studentId, missedSessionId])
  @@index([studentId, status])
  @@index([centerId, status])
  @@index([classId])
  @@index([orgUnitId])
  @@index([courseId])
  @@index([originalAttendanceId])
}

// ─── Học bù đời mới — CASE DẠY BÙ (29/09/2026, docs/hoc-bu/DAC-TA.md) ──────────────
// Một case = một buổi dạy bù (ngày · giờ · phòng · GV có ca) cho các bé CÙNG khoá, CÙNG
// buổi bù (`lessonId`), CÙNG cơ sở. Công dạy đọc case COMPLETED qua nguồn `MAKEUP`.

enum MakeupCaseStatus {
  SCHEDULED
  COMPLETED // có ít nhất một bé CÓ MẶT
  CANCELLED // huỷ, hoặc không còn bé nào trước khi điểm danh
  NO_SHOW // T07 — giáo viên đã dạy nhưng mọi bé đều vắng: có công dạy, không có bé nào học
}

enum MakeupCaseStudentStatus {
  PLACED // đã xếp, chưa điểm danh
  PRESENT // có mặt ⇒ buổi vắng gốc đã bù
  ABSENT // vắng buổi bù ⇒ dòng cần bù quay về danh sách, KHÔNG trừ lượt
  RELEASED // T07 — mục đã bị gỡ / nhả khỏi case (giữ lại làm lịch sử, KHÔNG xoá)
}

/// T07 — điểm danh TẦNG 1 của một bé trong case: bé có tới buổi bù không.
enum MakeupParticipantAttendance {
  PENDING
  PRESENT
  ABSENT
  REMOVED // bị gỡ khỏi case trước khi điểm danh (lịch sử)
}

/// T07 — kết quả TẦNG 2 của MỘT mục (một buổi vắng cần bù): bé có học xong bài đó không.
enum MakeupItemResult {
  PLANNED
  COMPLETED
  NOT_COMPLETED
  RELEASED
}

model MakeupCase {
  id                String           @id @default(cuid())
  centerId          String
  orgUnitId         String?
  courseId          String
  /// Bài ĐẦU TIÊN của case (T07: case có 1–3 bài ở `MakeupCaseLesson`; cột này giữ để mọi chỗ đọc cũ còn chạy).
  lessonId          String
  date              DateTime         @db.Date
  startTime         String
  endTime           String
  roomId            String?
  teacherId         String
  /// Phân loại buổi cho công dạy (mặc định `BU`); chỉnh được, không cố định trong code.
  sessionCategoryId String?
  status            MakeupCaseStatus @default(SCHEDULED)
  note              String?          @db.Text
  createdById       String
  completedAt       DateTime?        @db.Timestamptz(6)
  /// T07 — khoá lạc quan khi sửa case (ngày / giờ / GV / phòng / bộ bài).
  version           Int              @default(0)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  students     MakeupCaseStudent[]
  lessons      MakeupCaseLesson[]
  participants MakeupCaseParticipant[]

  @@index([centerId, date])
  @@index([teacherId, date])
  @@index([orgUnitId])
}

model MakeupCaseStudent {
  id           String                  @id @default(cuid())
  caseId       String
  makeupNeedId String
  centerId     String
  orgUnitId    String?
  /// BẢN GƯƠNG của `result` cho mọi chỗ đọc cũ (checker, sổ lượt, lõi trùng lịch): PLANNED→PLACED, COMPLETED→PRESENT,
  /// NOT_COMPLETED→ABSENT, RELEASED→RELEASED (bé bị gỡ) hoặc ABSENT (bé vắng buổi bù). `result` mới là nguồn sự thật.
  status       MakeupCaseStudentStatus @default(PLACED)
  /// Xếp bằng lượt bù miễn phí (true) hay bằng phí/miễn phí ngoại lệ (false).
  dungLuot     Boolean                 @default(true)
  addedById    String
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(6)

  // ── T07: mục = một buổi vắng cần bù trong case ──
  /// Null với mục cũ chưa được nâng cấp (xem `lib/hoc-bu/case-nang-cap-db.ts`).
  participantId        String?
  /// Bài của buổi vắng (chụp từ dòng cần bù lúc xếp). Phải thuộc bộ bài của case.
  lessonId             String?
  originalSessionId    String?
  originalAttendanceId String?
  result               MakeupItemResult @default(PLANNED)
  completedAt          DateTime?        @db.Timestamptz(6)
  /// Đánh giá của giáo viên cho RIÊNG mục này — không ghi vào nhận xét của buổi gốc.
  teacherEvaluation    String?          @db.Text
  evaluatedById        String?
  evaluatedAt          DateTime?        @db.Timestamptz(6)
  releasedAt           DateTime?        @db.Timestamptz(6)

  case        MakeupCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  makeupNeed  MakeupNeed             @relation(fields: [makeupNeedId], references: [id], onDelete: Cascade)
  participant MakeupCaseParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  // Unique (caseId, makeupNeedId) chỉ cho mục CÒN SỐNG nằm ngoài schema (chỉ mục từng phần `MakeupCaseStudent_case_need_song_key`,
  // migration 20261008100000) — nhả mục không xoá nó nên bé xếp lại vào chính case đó phải được.
  @@index([caseId, makeupNeedId])
  @@index([participantId])
  @@index([lessonId])
  @@index([originalSessionId])
  @@index([makeupNeedId])
  @@index([centerId])
  @@index([orgUnitId])
}

/// T07 — bộ bài của case (1–3 bài). Giới hạn 3 do service giữ (CHECK ở DB chỉ chặn `order` ngoài 1..3).
model MakeupCaseLesson {
  id        String   @id @default(cuid())
  caseId    String
  lessonId  String
  order     Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  case   MakeupCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lesson Lesson     @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([caseId, lessonId])
  @@index([lessonId])
}

/// T07 — học viên tham gia case; điểm danh TẦNG 1 (có tới buổi bù không). Mang cả `centerId`/`orgUnitId`: bảng theo cơ sở (luật nền hệ thống #3).
model MakeupCaseParticipant {
  id               String                      @id @default(cuid())
  caseId           String
  studentId        String
  centerId         String
  orgUnitId        String?
  attendanceStatus MakeupParticipantAttendance @default(PENDING)
  generalComment   String?                     @db.Text
  attendedAt       DateTime?                   @db.Timestamptz(6)
  processedById    String?
  version          Int                         @default(0)
  createdAt        DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                    @updatedAt @db.Timestamptz(6)

  case    MakeupCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  student Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   MakeupCaseStudent[]

  @@unique([caseId, studentId])
  @@index([studentId])
  @@index([centerId])
  @@index([orgUnitId])
}

/// T06 — SỔ LƯỢT HỌC BÙ: một tài khoản mỗi (học viên, khoá). "Còn" = granted − held − consumed. Hàng tài khoản bị KHOÁ
/// khi ghi (SELECT … FOR UPDATE) và DB có CHECK chặn số âm — xem migration `20261007220000_hoc_bu_so_luot`.
model MakeupCreditAccount {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  /// Tổng lượt được cấp (GRANT + ADJUSTMENT).
  granted   Int      @default(0)
  /// Đang giữ chỗ: đã xếp vào case bằng lượt, chưa điểm danh.
  held      Int      @default(0)
  /// Đã tiêu: bé có mặt ở buổi bù.
  consumed  Int      @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  entries MakeupCreditEntry[]

  @@unique([studentId, courseId])
  @@index([courseId])
}

enum MakeupCreditEntryType {
  GRANT // cấp lượt (granted +n)
  HOLD // giữ chỗ khi xếp case (held +1)
  RELEASE // nhả chỗ: gỡ / huỷ case / bé vắng buổi bù (held −1)
  CONSUME // bé có mặt: tiêu lượt (held −1, consumed +1; held 0 cho dòng cũ nhập vào sổ)
  ADJUSTMENT // điều chỉnh có lý do (đơn huỷ/hoàn/đổi số buổi) — granted ±n
}

/// Bút toán CHỈ-THÊM: trigger DB chặn UPDATE; `idemKey` duy nhất trong tài khoản (chạy lại một bước không ghi hai lần).
/// Cố ý KHÔNG có FK tới MakeupNeed/MakeupCaseStudent: sổ phải sống lâu hơn dòng bị xoá.
model MakeupCreditEntry {
  id            String                @id @default(cuid())
  accountId     String
  type          MakeupCreditEntryType
  grantedDelta  Int                   @default(0)
  heldDelta     Int                   @default(0)
  consumedDelta Int                   @default(0)
  makeupNeedId  String?
  caseStudentId String?
  reason        String?               @db.Text
  actorId       String?
  idemKey       String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)

  account MakeupCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, idemKey])
  @@index([accountId, createdAt])
  @@index([makeupNeedId])
  @@index([caseStudentId])
}

// ─── Cụm B2 — Cảnh báo rủi ro học viên + task chăm sóc ──────────────────────

enum RiskAlertType {
  CONSECUTIVE_ABSENCE // nghỉ 2 buổi liên tiếp
  HIGH_ABSENCE // nghỉ quá ngưỡng
  MISSED_SUBMISSIONS // không nộp bài nhiều lần
  NEEDS_SUPPORT // GV đánh dấu cần hỗ trợ nhiều lần
  NEARING_END_NO_RENEWAL // sắp hết khoá chưa tái đăng ký
  OVERDUE_PAYMENT // công nợ quá hạn
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  RESOLVED
  ESCALATED
}

model StudentRiskAlert {
  id           String        @id @default(cuid())
  studentId    String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  type         RiskAlertType
  severity     RiskSeverity  @default(MEDIUM)
  status       RiskStatus    @default(OPEN)
  detail       String?       @db.Text
  resolvedById String?
  resolvedAt   DateTime?     @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careTasks StudentCareTask[]

  @@index([studentId, status])
  @@index([centerId, status])
  // Idempotent: 1 alert OPEN / loại / học viên (tạo lại sau khi resolve thì cần key khác — dùng app logic).
  @@index([orgUnitId])
}

enum CareTaskStatus {
  OPEN
  DONE
  CANCELLED
}

model StudentCareTask {
  id           String         @id @default(cuid())
  studentId    String
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  assignedToId String? // SALES_CSM phụ trách
  riskAlertId  String?
  title        String
  description  String?        @db.Text
  dueAt        DateTime       @db.Timestamptz(6)
  status       CareTaskStatus @default(OPEN)
  completedAt  DateTime?      @db.Timestamptz(6)
  createdById  String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  riskAlert StudentRiskAlert? @relation(fields: [riskAlertId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt])
  @@index([centerId, status])
  @@index([studentId])
  @@index([orgUnitId])
}

/// Sinh nhật học viên — sổ cái MỘT dòng cho MỘT lần sinh nhật của MỘT học viên.
///
/// Vì sao cần bảng riêng thay vì mượn StudentCareTask: cron chạy mỗi ngày, không có
/// khoá chống trùng thì mỗi sáng đẻ thêm một việc + gửi lại một tin ZNS mất tiền. Khoá
/// `@@unique([studentId, year])` là chỗ chặn đó, đồng thời là nơi giữ trạng thái ZNS
/// (StudentCareTask không có chỗ lưu) để tra "phụ huynh có nhận được lời chúc không".
///
/// ⚠️ CHỈ tạo dòng cho học viên ĐANG HỌC và TÌM ĐƯỢC buổi tổ chức. HV chưa xếp lớp /
/// lớp đã kết thúc → bỏ qua hoàn toàn (chủ dự án chốt 06/08/2026): không việc, không tin.
model StudentBirthdayGreeting {
  id           String   @id @default(cuid())
  studentId    String
  /// Năm dương lịch của lần sinh nhật này — nửa còn lại của khoá chống trùng.
  year         Int
  /// Ngày sinh nhật quy về năm `year`, lưu UTC-midnight — CÙNG quy ước với
  /// Student.dateOfBirth (mọi đường ghi đều ép Date.UTC), nên so ngày không lệch múi giờ.
  birthdayDate DateTime @db.Timestamptz(6)
  centerId     String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId    String?

  /// Buổi học được chọn để tổ chức (buổi đúng hôm sinh nhật, hoặc buổi liền trước).
  celebrationSessionId String?
  /// Ngày của buổi tổ chức — nhân bản ra đây để lọc "sắp tới hạn" không phải join ClassSession.
  celebrationDate      DateTime? @db.Timestamptz(6)

  /// Đã đẩy thông báo cho Sale/QLCS/GV chưa — chống dội chuông mỗi lần cron chạy lại.
  staffNotifiedAt DateTime? @db.Timestamptz(6)
  /// Nhân sự bấm "Đã chúc" trên /admin/sinh-nhat.
  celebratedAt    DateTime? @db.Timestamptz(6)
  celebratedById  String?

  /// Kết quả gửi ZNS. NULL = chưa gửi. SIMULATED = có creds nhưng ZALO_LIVE tắt ⇒
  /// phụ huynh KHÔNG nhận gì (xem lib/zalo/provider.ts) — đừng đọc nhầm là đã gửi.
  znsStatus String? // SENT | SIMULATED | SKIPPED | FAILED
  znsLogId  String? // → ZaloMessageLog.id
  znsSentAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, year])
  @@index([centerId, birthdayDate])
  @@index([celebrationDate])
  @@index([birthdayDate])
  @@index([orgUnitId])
}

// ─── Cụm B3 — Khảo sát / NPS ────────────────────────────────────────────────

enum SurveyMilestone {
  AFTER_TRIAL
  AFTER_3_SESSIONS
  MID_COURSE
  END_COURSE
  AFTER_COMPLAINT
  GENERAL
}

enum SurveyQuestionType {
  NPS // 0-10
  RATING // 1-5
  TEXT
}

model Survey {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  milestone   SurveyMilestone @default(GENERAL)
  isActive    Boolean         @default(true)
  centerId    String? // null = mọi cơ sở
  orgUnitId   String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  createdById String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([isActive, milestone])
  @@index([centerId])
  @@index([orgUnitId])
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  surveyId String
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String             @db.Text
  type     SurveyQuestionType @default(RATING)
  order    Int                @default(0)

  @@index([surveyId, order])
}

// 1 lần phụ huynh trả lời. Gắn center/class/teacher/csm → cơ sở KPI CSKH.
model SurveyResponse {
  id           String   @id @default(cuid())
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentId    String?
  parentUserId String?
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  classId      String?
  teacherId    String?
  csmId        String? // SALES_CSM phụ trách
  npsScore     Int? // 0-10
  comment      String?  @db.Text
  answers      Json? // {questionId: value}
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  // Chống trả lời trùng 1 survey cho 1 con (double-submit TOCTOU ở portal).
  // studentId NULL không bị ràng buộc (Postgres coi NULL là distinct).
  @@unique([surveyId, studentId])
  @@index([surveyId, createdAt])
  @@index([centerId, createdAt])
  @@index([csmId])
  @@index([teacherId])
  @@index([orgUnitId])
}

// ─── Cụm B4 — Hoàn thành khoá + chứng chỉ ───────────────────────────────────

model CourseCompletion {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  classId         String?
  completedAt     DateTime @default(now()) @db.Timestamptz(6)
  finalAssessment String?  @db.Text // GV đánh giá cuối khoá
  finalGrade      String? // điểm/xếp loại cuối khoá
  certificateCode String   @unique // CERT-YYMMDD-XXXX
  nextCourseId    String? // gợi ý khoá tiếp theo
  createdById     String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation("CourseCompletions", fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// Đề xuất hoàn thành khoá (site GV): GV đề xuất → CENTER_MANAGER cơ sở duyệt → tạo
// CourseCompletion. Plain-string FK (pattern WorkRequest). GV chỉ ĐỀ XUẤT (không tự
// xác nhận hoàn thành — quyền completions:manage vẫn ở trung tâm).
enum CourseCompletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CourseCompletionRequest {
  id           String  @id @default(cuid())
  enrollmentId String
  studentId    String
  courseId     String
  centerId     String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId    String?

  requesterId    String // GV đề xuất
  status         CourseCompletionRequestStatus @default(PENDING)
  nextCourseId   String? // lộ trình chuyển cấp đề xuất
  note           String?                       @db.Text
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?                     @db.Timestamptz(6)
  reviewNote     String?                       @db.Text
  createdAt      DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @db.Timestamptz(6)

  @@index([enrollmentId, status])
  @@index([centerId, status])
  @@index([requesterId, status])
  @@index([orgUnitId])
}

// =============================================================================
// Cụm C1 — Chuyển lớp / chuyển cơ sở (StudentTransferRequest + lịch sử cơ sở)
// =============================================================================

enum TransferRequestStatus {
  PENDING // chờ duyệt
  APPROVED // đã chuyển
  REJECTED
  WAITLISTED // chưa có lớp đích phù hợp → chờ
  CANCELLED
}

model StudentTransferRequest {
  id            String                @id @default(cuid())
  studentId     String
  fromClassId   String? // lớp hiện tại
  fromCenterId  String?
  toClassId     String? // lớp đích (null nếu waitlist)
  toCenterId    String?
  status        TransferRequestStatus @default(PENDING)
  reason        String?               @db.Text
  note          String?               @db.Text // ghi chú khi duyệt/từ chối
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?             @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([status])
  @@index([toCenterId])
}

model StudentCenterHistory {
  id        String    @id @default(cuid())
  studentId String
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  fromDate  DateTime  @default(now()) @db.Timestamptz(6)
  toDate    DateTime? @db.Timestamptz(6) // null = đang ở cơ sở này
  reason    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([centerId])
  @@index([orgUnitId])
}

// =============================================================================
// Cụm C2 — Lịch sử phân công lead (bàn giao khi sale nghỉ)
// =============================================================================

model LeadAssignmentHistory {
  id           String   @id @default(cuid())
  leadId       String
  fromUserId   String? // sale cũ
  toUserId     String? // sale mới
  assignedById String? // người thực hiện bàn giao
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([fromUserId])
  @@index([toUserId])
}

// =============================================================================
// Cụm C3 — Rubric chấm bài robotics (6 tiêu chí, 4 mức)
// =============================================================================

enum RubricCriterion {
  ANALYSIS // Phân tích vấn đề
  DESIGN // Thiết kế & lắp ráp
  PROGRAMMING // Lập trình
  TESTING // Kiểm thử & gỡ lỗi
  CREATIVITY // Sáng tạo
  PRESENTATION // Trình bày & hợp tác
}

enum RubricLevel {
  NEED_SUPPORT // 1 — cần hỗ trợ
  BASIC // 2 — cơ bản
  GOOD // 3 — tốt
  EXCELLENT // 4 — xuất sắc
}

model SubmissionRubricScore {
  id           String          @id @default(cuid())
  submissionId String
  criterion    RubricCriterion
  level        RubricLevel
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterion])
  @@index([submissionId])
}

// =============================================================================
// Cụm C4 — SataCoin (điểm thưởng nội bộ). KHÔNG blockchain. Sổ cái BẤT BIẾN:
// điều chỉnh = ghi giao dịch đảo (reversal). Số dư = tổng amount.
// =============================================================================

enum SataCoinTxType {
  EARN // cộng coin (thưởng)
  SPEND // trừ coin (đổi quà)
  ADJUST // điều chỉnh thủ công (+/-)
  REVERSAL // đảo 1 giao dịch trước đó
}

model SataCoinTransaction {
  id           String         @id @default(cuid())
  studentId    String
  amount       Int // dương = cộng, âm = trừ
  type         SataCoinTxType
  reason       String // mã/lý do (vd "ATTENDANCE", "REDEEM_GIFT")
  note         String?        @db.Text
  centerId     String?
  orgUnitId    String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  ruleCode     String? // rule áp dụng (nếu có)
  reversedTxId String?        @unique // trỏ tới giao dịch bị đảo (1-1)
  createdById  String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([centerId])
  @@index([orgUnitId])
}

model SataCoinRule {
  id        String  @id @default(cuid())
  code      String  @unique // ATTENDANCE, ASSIGNMENT_GOOD, ...
  label     String
  amount    Int // coin cộng khi áp rule
  isActive  Boolean @default(true)
  centerId  String? // null = áp mọi cơ sở
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([orgUnitId])
}

// R7-17 (PR3) — Cấu hình quy tắc Satacoin (PENDING — QĐ-O10/O20). SCHEMA-ONLY:
// migrate được + seed rỗng, KHÔNG code đọc runtime, KHÔNG UI cho tới khi TGĐ ban
// hành bảng quy đổi. behaviorKey = hành vi; points = điểm; cap ngày/tổng; source =
// nguồn phát sinh; active mặc định false (trơ). Không centerId → không qua scopedDb.
enum CoinRuleSource {
  HOMEWORK_RESULT // kết quả bài tập
  TEACHER_EVAL_DONE // hoàn tất đánh giá GV
  CENTER_SURVEY_DONE // hoàn tất khảo sát trung tâm
}

model CoinRuleConfig {
  id          String         @id @default(cuid())
  behaviorKey String         @unique // khóa hành vi (vd HOMEWORK_PASSED)
  points      Int // điểm cộng
  dailyCap    Int? // trần điểm/ngày (null = không trần)
  totalCap    Int? // trần điểm tổng (null = không trần)
  source      CoinRuleSource
  active      Boolean        @default(false) // trơ tới khi ban hành
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// =============================================================================
// R7-11/R7-12 — SCORM: gói bài giảng giải nén lên R2 private + player có bảo vệ.
// Giải nén qua DB-backed job (DomainEvent outbox A0-07) vì Vercel serverless
// không giữ tiến trình dài. Flag SCORM_ENABLED gate menu/route. Không centerId
// (gắn buổi qua lessonId) → không qua scopedDb.
// =============================================================================

enum ScormVersion {
  SCORM_12 // SCORM 1.2
  SCORM_2004
}

enum ScormPackageStatus {
  UPLOADING // đang upload (zip/pdf) lên R2 (presigned)
  PROCESSING // job đang giải nén + đọc manifest (chỉ SCORM)
  FAILED // job lỗi (xem error) — resume được
  TESTING // giải nén xong, Đào tạo xem thử trước publish
  PUBLISHED // đã phát hành, GV mở được
  ARCHIVED // bản cũ (không xóa vật lý trong R7)
}

// Loại giáo án/học liệu mỗi buổi: gói SCORM (.zip giải nén) hoặc 1 file PDF (slide).
// Cả 2 hiển thị chung 1 khung trình chiếu (slider) ở "Tài liệu lớp tôi".
enum LessonMaterialKind {
  SCORM
  PDF
}

model ScormPackage {
  id                String             @id @default(cuid())
  lessonId          String // gắn buổi (FK)
  name              String
  // Loại học liệu: SCORM (giải nén + manifest) hoặc PDF (slide render bằng pdf.js).
  kind              LessonMaterialKind @default(SCORM)
  scormVersion      ScormVersion? // đọc từ manifest sau khi giải nén (chỉ SCORM)
  storagePrefix     String // prefix R2 `scorm/{packageId}/`
  uploadKey         String? // key R2 của zip gốc đã upload
  launchUrl         String? // đường dẫn launch (tương đối trong prefix)
  sizeBytes         Int? // tổng kích thước
  fileCount         Int? // số entry đã giải nén
  status            ScormPackageStatus @default(UPLOADING)
  version           Int                @default(1) // version per lesson
  isActiveForLesson Boolean            @default(false) // chỉ 1 active/buổi
  entryCursor       Int                @default(0) // con trỏ entry để job resume (idempotent)
  error             String? // lý do FAILED
  uploadedById      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  accessLogs ScormAccessLog[]
  attempts   ScormAttempt[] // LMS-14 — theo dõi GV giảng (KHÔNG ghi điểm HV)

  // 1 active duy nhất mỗi buổi: PARTIAL unique `(lessonId) WHERE isActiveForLesson`
  // tạo bằng raw SQL trong migration (Prisma không khai báo partial index native).

  /// EL-03 — bài học nội bộ kiểu SCORM. Cột khai từ GƐ1, khoá bằng validator tới GƐ4.
  trnLessons TrnLesson[] @relation("TrnLessonScorm")

  @@index([lessonId])
  @@index([status])
}

// LMS-14 — Theo dõi GIÁO VIÊN hoàn thành GIẢNG tài liệu SCORM (delivery tracking).
// LEARNER = GV/staff đang xem để giảng, KHÔNG phải HV (HV không xem SCORM — yêu cầu chốt).
// KHÔNG nối học bạ HV. Lưu cmi (SCORM 1.2 runtime) để resume + ghi nhận đã giảng.
enum ScormCompletion {
  NOT_ATTEMPTED
  INCOMPLETE
  COMPLETED
  PASSED
  FAILED
  BROWSED
}

model ScormAttempt {
  id             String          @id @default(cuid())
  packageId      String
  package        ScormPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId         String // GV/staff (người giảng) — KHÔNG phải studentId
  classSessionId String? // buổi giảng (nếu mở từ buổi); null = xem ngoài buổi
  completion     ScormCompletion @default(NOT_ATTEMPTED) // map từ cmi.core.lesson_status
  scoreRaw       Float? // cmi.core.score.raw (self-check của GV, không phải điểm HV)
  lessonLocation String?         @db.Text // cmi.core.lesson_location (bookmark)
  suspendData    String?         @db.Text // cmi.suspend_data (resume)
  totalTimeSec   Int             @default(0) // tổng thời gian tích lũy (giây)
  sessionCount   Int             @default(0) // số lần mở
  lastAccessedAt DateTime        @default(now()) @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  @@index([packageId])
  @@index([userId])
  @@index([classSessionId])
}

model ScormAccessLog {
  id             String   @id @default(cuid())
  packageId      String
  classSessionId String? // buổi GV mở (nếu mở theo lớp)
  userId         String // ai mở
  openedAt       DateTime @default(now())
  ip             String?

  package ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, openedAt])
  @@index([userId])
}

// NOTE(reconcile FixLMS→main): bản ScormAttempt ghi-điểm-HV của FixLMS (LMS-14)
// đã GỠ — D4 theo MAIN (R7-12 tracking GV, KHÔNG ghi điểm HV). Xem model ScormAttempt ở trên.

// =============================================================================
// Cụm C5 — Zalo OA/ZNS adapter (SKELETON). Tắt an toàn khi thiếu credential →
// fallback email, không phá hệ thống. Log mọi lần gửi.
// =============================================================================

enum ZaloMessageStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // chưa cấu hình credential → bỏ qua (fallback email)
}

model ZaloMessageLog {
  id                String            @id @default(cuid())
  toPhone           String?
  templateKey       String?
  payload           Json              @default("{}")
  status            ZaloMessageStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?           @db.Text
  fallbackEmailed   Boolean           @default(false)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  sentAt            DateTime?         @db.Timestamptz(6)

  @@index([status, createdAt])
}

// =============================================================================
// Cụm C6 — MISA AMIS sync (SKELETON) + IntegrationLog/IntegrationConfig chung.
// Bật/tắt qua config; KHÔNG push API thật khi tắt hoặc thiếu credential.
// =============================================================================

enum IntegrationStatus {
  PENDING
  SUCCESS
  SKIPPED // tắt hoặc thiếu credential → bỏ qua, không lỗi
  FAILED
}

enum IntegrationDirection {
  PUSH
  PULL
}

model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String   @unique // "MISA"
  isEnabled Boolean  @default(false)
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model IntegrationLog {
  id              String               @id @default(cuid())
  provider        String // "MISA"
  direction       IntegrationDirection @default(PUSH)
  action          String // "PUSH_INVOICE", "PUSH_PAYMENT", ...
  status          IntegrationStatus    @default(PENDING)
  requestPayload  Json                 @default("{}")
  responsePayload Json?
  errorMessage    String?              @db.Text
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)

  @@index([provider, status, createdAt])
}

// ───────────────────────────────────────────────────────────────────────────
// R6-A — Cấu hình hệ thống 2 tầng (Flexibility & Hardening).
// Resolve giá trị: CenterSetting (theo OrgUnit) → SystemSetting (GLOBAL) →
// default trong code (registry lib/settings/registry.ts). Key phải có schema
// trong registry mới được ghi (validate Zod). Mọi thay đổi ghi AuditLog.
// ───────────────────────────────────────────────────────────────────────────
/// Tham số vận hành toàn hệ thống (GLOBAL). Chỉ SUPER_ADMIN sửa.
model SystemSetting {
  key           String   @id // khớp key registry, vd "student.nearEndThreshold"
  valueJson     Json
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
}

/// Override tham số theo cơ sở (OrgUnit). CENTER_MANAGER cơ sở đó / SUPER_ADMIN sửa.
model CenterSetting {
  orgUnitId     String // OrgUnit.id (cơ sở áp dụng)
  key           String // khớp key registry, phải centerOverridable=true
  valueJson     Json
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@id([orgUnitId, key])
  @@index([key])
}

// ─── Marketing content (hardcode remediation Đợt 5) ──────────────────────────
// Chuyển nội dung marketing tĩnh (components/legacy-*/_data/*) sang DB để CMS hoá.

enum PromotionKind {
  PRIMARY // ưu đãi chính (có CTA + details bullet)
  SECONDARY // chính sách phụ (referral/sibling/team — có condition + note)
}

/// Ưu đãi/khuyến mãi hiển thị trang khoá học. Nguồn cũ: _data/promotions.ts.
model Promotion {
  id          String        @id @default(cuid())
  slug        String        @unique // "early-bird", "combo", "installment"...
  kind        PromotionKind @default(PRIMARY)
  title       String
  highlight   String
  description String        @db.Text
  details     String[]      @default([]) // PRIMARY: bullet list
  cta         String? // PRIMARY: nhãn nút
  target      String? // PRIMARY: anchor/target
  condition   String?       @db.Text // SECONDARY: điều kiện
  note        String?       @db.Text // SECONDARY: ghi chú
  icon        String // tên icon lucide
  featured    Boolean       @default(false)
  courseSlug  String? // giới hạn theo landing (laptrinhrobot/luyenthirobosim); null = chung

  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  startsAt     DateTime? @db.Timestamptz(6)
  endsAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([kind, isActive, displayOrder])
  @@index([courseSlug, isActive])
}

/// Cảm nhận phụ huynh/học viên. Nguồn cũ: _data/testimonials.ts.
model Testimonial {
  id          String  @id @default(cuid())
  name        String
  role        String // "Phụ huynh bạn Duy Tùng" / "Học sinh lớp 4"
  location    String  @default("Đà Nẵng")
  rating      Int     @default(5)
  avatar      String // chữ cái viết tắt "NA"
  avatarColor String // class gradient tailwind hoặc mã hex nền avatar
  content     String  @db.Text
  videoId     String? // YouTube id video cảm nhận (nếu có)
  courseSlug  String? // landing áp dụng: laptrinhrobot/luyenthirobosim/home; null = chung

  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([courseSlug, isPublished, displayOrder])
}

// ─── R7-03 — Ưu đãi theo khóa ────────────────────────────────────────────────
/// Ưu đãi/học bổng cấu hình theo Course (áp toàn hệ thống, KHÔNG per-center — QĐ-9).
model CourseDiscount {
  id         String             @id @default(cuid())
  courseId   String
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type       CourseDiscountType
  value      Int // AMOUNT: VND; PERCENT/SCHOLARSHIP: %; PROGRAM: tùy note
  note       String?
  conditions String?            @db.Text
  active     Boolean            @default(true)
  validFrom  DateTime?          @db.Timestamptz(6)
  validTo    DateTime?          @db.Timestamptz(6)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(6)

  @@index([courseId, active])
}

// ─── R7-06 — Kế hoạch buổi học theo lớp (snapshot từ curriculum pin) ──────────
/// Kế hoạch từng buổi của 1 lớp, sao từ Lesson của curriculum version pin lúc tạo lớp.
/// Reorder/ghi chú sửa ở đây — KHÔNG đụng Lesson gốc (AC4).
/// Kế hoạch buổi đã GHIM cho một lớp — bản sao đông cứng của giáo trình lúc tạo lớp.
///
/// ⚠️ ĐỪNG thêm `@@unique([classId, order])`. Đo prod 08/09: 0 cặp trùng, nên nhìn thì
/// tưởng thêm được — nhưng nó sẽ LÀM VỠ `adoptCurriculumVersion` (`lib/classes/snapshot.ts`).
/// Hàm đó giữ nguyên `order` GỐC của plan thuộc buổi COMPLETED, rồi đánh số plan mới từ
/// `keptCount` trở đi. Lớp `CS1.SATA3.26.001` có 1 buổi COMPLETED mà plan của nó nằm ở
/// `order` 47 ⇒ `keptCount = 1` ⇒ plan mới xin lại đúng `order` 47 đang bị giữ ⇒ vi phạm
/// ràng buộc ⇒ rollback CẢ transaction, và lớp đó vĩnh viễn không đổi được giáo trình.
/// Muốn thêm thì phải sửa hàm đó đánh lại `order` liên tục từ 0 trước — việc riêng, rủi ro riêng.
///
/// Cùng lý do, quan hệ `ClassSession.planId` giữ `onDelete: SetNull`: `snapshot.ts:126` là
/// đường xoá plan DUY NHẤT trong mã sản phẩm và nó dựa vào `SetNull` để buổi tương lai
/// tự nhả plan cũ. Xem `docs/dieu-tra-lech-bai-hoc.md`.
model ClassSessionPlan {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  seq         Int // số thứ tự buổi gốc theo curriculum
  lessonId    String? // tham chiếu Lesson nguồn (snapshot; không ràng FK cứng)
  /// Tên buổi ĐÔNG CỨNG, chép từ `Lesson.title` lúc `createSessionPlansForClass` chạy.
  /// Giáo trình đổi tên bài SAU đó thì cột này KHÔNG đổi theo — đó là gốc của sự cố
  /// "lệch tên bài" 08/09. `meaningfulSessionTitle` loại giá trị rỗng-nghĩa ("Buổi 7"),
  /// nên chỉ tên THẬT cũ mới che được tên mới.
  customTitle String?
  note        String?  @db.Text
  order       Int      @default(0) // thứ tự hiển thị (cho phép reorder)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  sessions ClassSession[]

  @@index([classId, order])
}

// ═══ R7-04 — Payment 2 tầng + Receipt ════════════════════════════════════════
enum PaymentSaleStatus {
  RECORDED // Sale ghi nhận đã thu
  COLLECT_CONFIRMED // Sale xác nhận thực thu (chuẩn bị bàn giao kế toán)
}

enum PaymentAccountantStatus {
  PENDING // chờ kế toán
  CONFIRMED // kế toán xác nhận (giảm công nợ, sinh Receipt)
  REJECTED // kế toán từ chối (bắt buộc reason)
  REFUNDED // hoàn (bút toán âm, không xóa gốc)
  // ⚠️ 07/09/2026 — ĐÃ BỎ `ADJUSTED`. Nó là LOẠI bút toán, không phải trạng thái kế
  // toán: nhét vào đây thì mọi truy vấn lọc `accountantStatus = CONFIRMED` đều bỏ qua
  // bút toán điều chỉnh, nên số kế toán vừa sửa không bao giờ tới phụ huynh. Loại bút
  // toán nay nằm ở cột riêng `Payment.paymentType`.
}

/// Loại bút toán trong sổ thu (07/09/2026 — tách khỏi `accountantStatus`).
///
/// KHÔNG có `REFUND`: hoàn tiền đã có `accountantStatus = REFUNDED`, thêm ở đây nữa là
/// hai cách diễn đạt cùng một sự kiện và sớm muộn hai chỗ sẽ lệch nhau.
enum PaymentType {
  PAYMENT // khoản thu bình thường
  ADJUSTMENT // bút toán điều chỉnh — lưu DELTA, trỏ `adjustmentOfId` về phiếu thu gốc
}

enum ReceiptStatus {
  ACTIVE
  VOID // thu hồi khi khoản bị reject sau khi đã sinh receipt
}

/// R7-04 — khoản thanh toán 2 tầng (Sale ghi nhận ↔ Kế toán xác nhận). Center-scoped.
model Payment {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Restrict) // FIX-C3
  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentPayments", fields: [enrollmentId], references: [id], onDelete: SetNull) // FIX-C3: liên kết mềm, giữ SetNull

  /// Khoản này của DÒNG HÀNG nào — tức của CON nào [16/09/2026, phiên A].
  ///
  /// ⚠️ KHÔNG thay `enrollmentId`, hai cột sống chung và có vai khác nhau:
  ///   · `orderItemId`  — con nào trên ĐƠN. Có NGAY từ lúc tạo đơn. Hạt của công nợ theo con.
  ///   · `enrollmentId` — ghi danh nào. Chỉ có SAU khi chốt lead. Hạt của học bạ, hoàn tiền.
  ///
  /// Vì sao cần: `/orders/new` không tạo `Enrollment` nào (convert-lead đúc sau), nên suốt
  /// quãng "đơn đã tạo, chưa chốt lead" — đúng quãng phụ huynh chuyển đợt 1 — không có gì để
  /// gắn tiền vào một đứa trẻ. Đo trên prod 16/09: **18 đơn / 24 khoản / 178.544.000đ** đang
  /// kẹt ở đúng tình trạng đó (`enrollmentId IS NULL`).
  ///
  /// `Restrict` (khác `SetNull` của `enrollmentId` ngay trên, và khác có chủ ý): xoá ghi danh
  /// là việc học vụ nên không được kéo sổ tiền theo; còn dòng hàng thì không có đường xoá nào
  /// trong mã chạy thật, nên `Restrict` không chặn ai mà vẫn bảo đảm tiền không mất dấu con.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  amount      Int
  method      String // tiền mặt / chuyển khoản / ... (id hoặc nhãn)
  paidDate    DateTime @db.Timestamptz(6)
  evidenceUrl String?
  note        String?  @db.Text

  saleStatus       PaymentSaleStatus       @default(RECORDED)
  accountantStatus PaymentAccountantStatus @default(PENDING)
  /// LOẠI bút toán. Mặc định PAYMENT — mọi dòng cũ backfill về đây.
  paymentType      PaymentType             @default(PAYMENT)
  recordedById     String?
  confirmedById    String?
  confirmedAt      DateTime?               @db.Timestamptz(6)
  rejectReason     String?                 @db.Text

  adjustmentOfId String?
  adjustmentOf   Payment?  @relation("PaymentAdjustment", fields: [adjustmentOfId], references: [id], onDelete: SetNull)
  adjustments    Payment[] @relation("PaymentAdjustment")

  centerId String? // cách ly cơ sở (scopedDb)

  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).

  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo

  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.

  orgUnitId String?

  receipts        Receipt[]
  /// 26/09 — khoản này nằm trong hoá đơn nào (bảng nối; MỘT hoá đơn còn hiệu lực tối đa — chỉ
  /// mục từng phần viết tay trong migration `*_hoa_don_dien_tu`).
  hoaDonKhoan     HoaDonKhoan[]
  /// 29/09 — dòng ÂM sinh từ bước "Đã chi" của một yêu cầu hoàn (`chiHoanTien`). NULL với mọi dòng khác.
  refundRequestId String?
  refundRequest   RefundRequest? @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?      @db.Timestamptz(6) // FIX-C3 — soft-delete tài chính (read filter deletedAt: null)

  @@index([orderId])
  @@index([enrollmentId])
  @@index([orderItemId])
  @@index([centerId])
  @@index([accountantStatus])
  @@index([orgUnitId])
  @@index([refundRequestId])
}

/// R7-04 — phiếu thu per Enrollment (nhiều phiếu), sinh khi kế toán CONFIRMED.
// =============================================================================
// 03/08 — SỔ THU THEO ĐỢT + PHÂN BỔ WATERFALL.
//
// Vì sao có: QR in theo TỔNG đơn còn webhook từ chối mọi giao dịch nhỏ hơn tổng
// ⇒ khách chọn 2 đợt, quét QR đóng đợt 1 thì bị xếp "trả thiếu, chờ xử lý tay".
// Cơ chế tự xác nhận chưa bao giờ chạy được với người trả góp.
//
// Nguyên tắc (chốt chủ dự án 03/08):
//  • Đối khớp theo ĐỊNH DANH (matchKey/VA hoặc mã cổng), KHÔNG theo số tiền.
//  • Tiền về LUÔN được ghi nhận rồi phân bổ; thiếu → PARTIAL, dư → tràn sang đợt
//    sau rồi vào CreditBalance. KHÔNG từ chối vì lệch tiền.
//  • Trạng thái phiếu thu là KẾT QUẢ TÍNH từ sổ phân bổ, không phải cờ gán tay.
//  • Hạn QR (5–10 phút) CHỈ để hiển thị + chặn 2 QR sống song song. TUYỆT ĐỐI
//    không dùng làm điều kiện đối khớp — PH quét QR hết hạn mà tiền vẫn về thì
//    tiền đó phải phân bổ bình thường.
//
// Tiền: Int (VND) — đồng bộ toàn schema, không dùng Decimal.
// =============================================================================

enum PaymentRequestStatus {
  PENDING
  PARTIAL
  PAID
  VOID
}

/// Phiếu thu — MỘT dòng cho mỗi đợt. `installmentNo = 0` là "thu toàn bộ đơn"
/// (đơn không trả góp / kế hoạch chưa duyệt). Phiếu theo đợt (1,2,…) CHỈ được
/// sinh bởi đường duyệt kế hoạch trả góp — xem lib/payments/payment-request.ts.
model PaymentRequest {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Phiếu này thu tiền cho DÒNG HÀNG nào — tức cho CON nào [16/09/2026, bước B].
  ///
  /// NULL = luồng CŨ (phiếu "thu toàn đơn", hoặc mọi phiếu sinh trước 16/09). Là giá trị
  /// HỢP LỆ với dữ liệu cũ, KHÔNG phải thiếu dữ liệu — đó là thứ giữ cho migration
  /// additive. Luồng MỚI thì bắt buộc có, và cổng đó nằm ở tầng mã chứ không phải
  /// NOT NULL ở DB (chủ dự án: *"luồng mới BẮT BUỘC có, không có đợt NULL/đợt chung"*).
  ///
  /// `Restrict`: phiếu thu là sổ tiền. Xoá dòng hàng mà kéo phiếu theo là mất dấu khoản
  /// đã thu; để phiếu ở lại với `orderItemId = NULL` thì nó lặng lẽ tụt về luồng cũ và
  /// tiền của một em hoá tiền chung. Con nghỉ học thì HUỶ dòng, không xoá dòng.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  centerId    String? // cách ly cơ sở (scopedDb)
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId   String?

  installmentNo       Int // 0 = toàn đơn; 1,2,… = số thứ tự đợt
  amountDue           Int
  dueDate             DateTime?            @db.Timestamptz(6)
  /// Định danh đối khớp bền theo ĐỜI của phiếu thu (VA payOS hoặc mã tham chiếu
  /// tĩnh). Sale tạo lại QR bao nhiêu lần thì khoá này vẫn nguyên → tiền luôn
  /// rơi đúng đợt (bất biến #3).
  matchKey            String?              @unique
  /// TÍNH LẠI từ PaymentAllocation, không set tay.
  /// F2 · US-18 AC2 — lượt `StudentReserve` ĐÃ dời hạn đợt này. Khoá chống dời HAI LẦN.
  ///
  /// Cột TRẦN, KHÔNG FK (nếp "actor snapshots — no FK (defensive)"): đây là DẤU VẾT trên sổ
  /// tiền. `StudentReserve` bị xoá cascade theo `Student` thì phép dời hạn vẫn đã xảy ra
  /// thật, và một `ON DELETE SET NULL` sẽ âm thầm gỡ khoá chống dời hai lần của đợt ấy.
  pauseShiftReserveId String?
  /// Tổng số ngày đợt này đã bị dời vì bảo lưu — CỘNG DỒN qua nhiều lượt. Để màn hình nói
  /// thật ("hạn 22/11, đã dời 30 ngày do bảo lưu") chứ không chỉ in một cái hạn lạ.
  pauseShiftDays      Int?
  status              PaymentRequestStatus @default(PENDING)
  /// Thứ tự rót waterfall (mặc định = installmentNo).
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)

  qrSessions  QrSession[]
  allocations PaymentAllocation[]
  billLines   PaymentBillLine[]

  @@index([pauseShiftReserveId])
  // ⛔ KHÔNG khai lại `@@unique([orderId, installmentNo])` ở đây.
  //
  // [16/09/2026] Khoá đó nay CHIA ĐÔI theo luồng và là hai chỉ mục TỪNG PHẦN (partial
  // unique) viết tay trong `20260916120000_payment_request_theo_con`:
  //   · ("orderId","installmentNo")     WHERE "orderItemId" IS NULL      — luồng CŨ;
  //   · ("orderItemId","installmentNo") WHERE "orderItemId" IS NOT NULL  — luồng MỚI.
  //
  // Prisma không có cú pháp cho mệnh đề WHERE của chỉ mục, nên chỗ này BẮT BUỘC trống.
  // Thêm `@@unique` lại là `migrate dev` sinh câu dựng lại khoá ĐẦY ĐỦ ⇒ đơn nhiều con
  // hết tạo được phiếu đợt 2 ngay lúc chạy migration, và không lỗi nào báo trước.
  //
  // ⚠️ Và đây là chỗ dễ yên tâm nhầm, ĐÃ ĐO 16/09: `migrate diff` **KHÔNG** kêu gì cả —
  // Prisma bỏ qua hẳn chỉ mục có mệnh đề WHERE, nên hai khoá trên vô hình với nó. Nghĩa
  // là **không cổng tự động nào canh chúng**: xoá nhầm hai dòng `CREATE UNIQUE INDEX`
  // trong migration thì DB mất sạch lưới chống phiếu trùng mà mọi phép kiểm vẫn xanh.
  // Lưới duy nhất là ca `[BTC-05]`/`[BTC-06]` trong `lib/payments/thu-theo-con.bat-bien.test.ts`
  // (đọc thẳng văn bản migration) — đừng gỡ chúng.
  @@index([orderItemId])
  @@index([centerId, status])
  @@index([status, dueDate])
  @@index([orgUnitId])
}

/// PHIẾU GỘP — MỘT mã QR cho cả gia đình, chia về từng con [16/09/2026, bước B].
///
/// Chủ dự án chốt: *"công nợ theo CON, QR theo ĐƠN"*. Phụ huynh hai con không nên phải
/// quét hai mã và nhớ chuyển đúng số cho đúng em — họ chuyển MỘT lần, hệ thống chia.
///
/// Webhook khớp `matchKey` của phiếu gộp → rót vào các `PaymentRequest` của dòng theo
/// `PaymentBillLine.sortOrder` tăng dần: thiếu thì lấp dần từ dòng đầu, thừa thì phần dư
/// vào ví gia đình (`CreditBalance`). KHÔNG chia theo tỷ lệ.
///
/// ⚠️ Phiếu gộp KHÔNG phải sổ tiền thứ tư. Tiền vẫn chỉ nằm ở `PaymentAllocation`
/// (BankTransaction → PaymentRequest). Phiếu gộp là cái PHONG BÌ: nó nói "lần thu này
/// gồm những phiếu nào, theo thứ tự nào". Ai cộng tiền thì cộng `PaymentAllocation`.
model PaymentBill {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  centerId  String? // cách ly cơ sở (scopedDb)
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  orgUnitId String?

  /// Σ số tiền các dòng, CHỤP LẠI lúc phát phiếu. Không tính lại khi đọc: mã QR khách
  /// đang cầm in số của lúc phát, và đối khớp phải so với đúng số đã in ra.
  amountDue Int
  status    PaymentBillStatus @default(OPEN)
  /// Định danh đối khớp của phiếu gộp (VA / mã tham chiếu tĩnh) — cùng vai trò
  /// `PaymentRequest.matchKey` nhưng ở cấp GIA ĐÌNH.
  matchKey  String?           @unique
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)

  lines PaymentBillLine[]

  /// 06/10/2026 — GĐ1 POS: các phiếu thu thẻ đã mở cho phiếu gộp này.
  posIntents PosPaymentIntent[]

  // ⛔ "Mỗi đơn tối đa MỘT phiếu OPEN" là chỉ mục TỪNG PHẦN viết tay
  // (`PaymentBill_orderId_open_key ... WHERE "status" = 'OPEN'`), không khai được ở đây.
  // Luật đó PHẢI do DB gác: đếm phiếu OPEN ở tầng mã rồi mới tạo thì hai lượt bấm đồng
  // thời cùng đọc thấy 0 và cùng ghi ⇒ hai mã QR cùng sống cho một gia đình.
  @@index([orderId])
  @@index([centerId, status])
  @@index([orgUnitId])
}

/// Một dòng của phiếu gộp = "phần này của lần thu là của phiếu thu kia".
model PaymentBillLine {
  id               String         @id @default(cuid())
  billId           String
  bill             PaymentBill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)

  /// Thứ tự RÓT trong phiếu gộp. Sao lại `PaymentRequest.sortOrder` (xem
  /// `lib/payments/thu-tu-rot.ts`) LÚC PHÁT PHIẾU, để thứ tự đã hứa với khách không đổi
  /// khi ai đó sửa kế hoạch giữa chừng.
  sortOrder Int      @default(0)
  /// Phần của phiếu gộp dành cho dòng này. Σ cột này = `PaymentBill.amountDue`.
  amount    Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([billId, paymentRequestId])
  @@index([paymentRequestId])
}

enum PaymentBillStatus {
  /// Đang chờ tiền. Mỗi đơn tối đa MỘT phiếu ở trạng thái này (DB gác).
  OPEN

  /// ⛔ KHÔNG dùng ở luồng mới [chốt 16/09/2026 chiều].
  ///
  /// Sinh ra cho ý tưởng "đóng phiếu khi đã nhận một phần" (`CLOSED_PARTIAL` của bản thiết
  /// kế). Luật mới là ĐƯỢC ĂN CẢ HOẶC KHÔNG ĂN GÌ — một phiếu gộp không bao giờ được lấp một
  /// phần, nên trạng thái này không còn nghĩa. Giữ giá trị để không phá enum (Postgres không
  /// bỏ được giá trị enum), nhưng KHÔNG đường ghi nào được đặt nó.
  CLOSED

  /// Đã thu ĐỦ, tiền đã chia đích danh theo dòng.
  PAID

  /// Huỷ — phát lại phiếu khác. Mã QR của phiếu VOID không được đối khớp nữa.
  VOID
}

enum QrSessionStatus {
  ACTIVE
  EXPIRED
  CONSUMED
}

/// Một lần sale bấm "Xuất QR". Nhiều session/1 phiếu thu là chuyện THƯỜNG
/// (QR sống 5–10 phút, quá hạn thì bấm lại) — tất cả trỏ về cùng phiếu thu.
model QrSession {
  id               String         @id @default(cuid())
  paymentRequestId String
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  centerId         String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId        String?

  /// Mã cổng trả về (payOS `orderCode`). Đường tra dự phòng khi cổng không cấp
  /// VA tĩnh: webhook → QrSession → PaymentRequest.
  providerOrderCode String?         @unique
  amountShown       Int
  qrContent         String?         @db.Text
  checkoutUrl       String?         @db.Text
  /// CHỈ để hiển thị đếm ngược + chặn 2 QR ACTIVE. KHÔNG phải điều kiện đối khớp.
  expiresAt         DateTime        @db.Timestamptz(6)
  status            QrSessionStatus @default(ACTIVE)
  createdById       String?
  createdByName     String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  @@index([paymentRequestId, status])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
}

enum BankTransactionStatus {
  MATCHED
  UNMATCHED
  IGNORED
}

/// Giao dịch tiền về (payOS/SePay) — bản ghi THÔ, là nguồn của mọi phân bổ.
/// Idempotency của webhook neo vào `providerTxnId` (@unique).
model BankTransaction {
  id            String                @id @default(cuid())
  provider      String // "PAYOS" | "SEPAY"
  providerTxnId String
  amount        Int
  transferredAt DateTime              @db.Timestamptz(6)
  accountNumber String?
  referenceCode String?
  content       String?               @db.Text
  rawPayload    Json                  @default("{}")
  status        BankTransactionStatus @default(UNMATCHED)
  unmatchedNote String?               @db.Text
  centerId      String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId     String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  allocations PaymentAllocation[]

  /// 29/09/2026 — dòng giao dịch thẻ SmartPOS sinh ra giao dịch này (provider "CARD_POS").
  posCardTransaction PosCardTransaction?

  /// 06/10/2026 — GĐ1 POS: phiếu thu thẻ đã NHẬN giao dịch này (tối đa một).
  posPaymentIntent PosPaymentIntent?

  @@unique([provider, providerTxnId])
  @@index([status, createdAt])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
}

// ─── 29/09/2026 — Import & đối soát giao dịch thẻ SmartPOS Techcombank ─────────
// Thiết kế + 4 quyết định chủ dự án: docs/pos-the-smartpos.md.
// Ngân hàng KHÔNG có webhook cho thẻ ⇒ Kế toán HO import file "Danh sách giao dịch V2".
// Mỗi dòng "Thanh toán + Thành công" nối vào sổ tiền QUA `BankTransaction`
// (provider "CARD_POS") — bảng POS KHÔNG giữ paymentId/paymentRequestId.

/// Kết quả phân loại LÚC IMPORT. "Đã ghi nhận" đọc từ `BankTransaction.status = MATCHED`,
/// KHÔNG đọc cột này (gắn tay sau import không cập nhật nó).
enum PosMatchStatus {
  TU_KHOP
  CAN_XU_LY
  BO_QUA
}

/// Trạng thái một lượt import file POS (30/09/2026 — nợ 4 của docs/pos-the-smartpos.md).
/// DANG_NHAP quá 30 phút không cập nhật ⇒ màn SUY "Dừng giữa chừng" khi ĐỌC (không cron ghi).
enum PosImportStatus {
  DANG_NHAP
  XONG
  DUNG_GIUA_CHUNG
}

/// Máy POS ⇒ cơ sở. Máy chưa khai (hoặc tắt) ⇒ giao dịch của nó là CAN_XU_LY.
model PosTerminal {
  id          String   @id @default(cuid())
  maThietBi   String   @unique
  maQuay      String?
  ten         String?
  /// 06/10/2026 — GĐ2 POS: mã do Techcombank cấp trên portal merchant, cho GĐ4 (agent). KHÔNG là khoá
  /// khớp giao dịch (khoá vẫn là `maThietBi`). Trống = chưa khai. Khai tay ở tab "Máy POS" hoặc
  /// `scripts/pos-khai-may.ts` (chạy tay, dry-run mặc định).
  maCuaHang    String? // store_code — "Mã cửa hàng" (vd CH9TSGU9)
  maNhaCungCap String? // merchant_code — portal gọi "merchant_code" (vd NCCPH6KE)
  maTcbQuay    String? // "Mã TCB quầy" (KHÁC `maQuay` = "Mã quầy thanh toán" của file)
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)
  // Ghi kép centerId → orgUnitId (lib/org/dual-write.ts). Cột trần, không FK.
  orgUnitId   String?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  /// 06/10/2026 — GĐ1 POS: phiếu thu thẻ mở trên máy này (chỉ để hiển thị).
  intents PosPaymentIntent[]

  @@index([centerId])
  @@index([orgUnitId])
}

/// Một lượt import file (zip/xlsx). KHÔNG theo cơ sở — một file chứa giao dịch mọi máy.
model PosImportBatch {
  id           String   @id @default(cuid())
  tenFile      String
  importedById String
  importedBy   User     @relation("PosImportBatchNguoiNhap", fields: [importedById], references: [id], onDelete: Restrict)
  soDong       Int      @default(0)
  soMoi        Int      @default(0)
  soCapNhat    Int      @default(0)
  soTuKhop     Int      @default(0)
  soCanXuLy    Int      @default(0)
  soBoQua      Int      @default(0)
  soLoi        Int      @default(0)
  /// Lượt đang chạy / xong / dừng (client báo). Lô cũ trước 30/09/2026 được backfill = XONG.
  trangThai    PosImportStatus @default(DANG_NHAP)
  /// Số lô client cắt ra cho cả file (`catLoPos`) — khai lúc mở lượt.
  soLoTong     Int      @default(0)
  /// Lô CAO NHẤT đã ghi xong (đặt theo chỉ số lô, không cộng dồn ⇒ gửi lại một lô không đếm hai lần).
  soLoXong     Int      @default(0)
  xongLuc      DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  transactions PosCardTransaction[]

  @@index([importedById])
  @@index([createdAt])
}

/// Một dòng của file giao dịch thẻ. KHÔNG lưu tên chủ thẻ — chỉ số thẻ đã che.
model PosCardTransaction {
  id                 String           @id @default(cuid())
  maGiaoDich         String           @unique
  loaiGiaoDich       String
  hinhThuc           String
  trangThai          String
  soTien             Int
  thoiGianGiaoDich   DateTime         @db.Timestamptz(6)
  dienGiai           String           @db.Text
  maChuanChi         String?
  maGiaoDichThe      String?
  maGiaoDichGoc      String?
  trangThaiHoanHuy   String?
  maDonHang          String?
  maQuay             String?
  maThietBi          String?
  soTheMasked        String?
  loaiThe            String?
  maHachToan         String?
  phiGiaoDich        Int?
  /// 07/10/2026 — GĐ4 POS (T14): `settlement_id` của portal (có sau kết toán). File không có cột này.
  maKetToan          String?
  /// 07/10/2026 — GĐ4 POS (T14): mã lý do thất bại dạng MÃ (vd USER_CANCELLED) agent đọc được từ
  /// `transaction_operation_msg`. Chữ tự do KHÔNG lưu (có thể mang PII).
  maLyDoThatBai      String?
  // NULL = chưa biết cơ sở (máy chưa khai) — như BankTransaction, xem BACKFILL_SPECS.
  centerId           String?
  orgUnitId          String?
  matchStatus        PosMatchStatus
  matchReason        String?          @db.Text
  maPhieu            String?
  bankTransactionId  String?          @unique
  bankTransaction    BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  // Lô TẠO RA dòng này; lô import gần nhất chạm tới nó ở `lastImportBatchId` (không FK).
  // 07/10/2026 — GĐ4 POS (T1): NULL = dòng do MÁY ĐỒNG BỘ (agent) tạo — agent và file hội tụ vào
  // CÙNG một dòng theo `maGiaoDich`; file nhập SAU chỉ ghi `lastImportBatchId`.
  importBatchId      String?
  importBatch        PosImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  lastImportBatchId  String?
  // Cảnh báo "bị hủy/hoàn SAU KHI đã ghi nhận" — không bao giờ tự đảo bút toán.
  canhBaoHuy         Boolean          @default(false)
  canhBaoDaXuLyLuc   DateTime?        @db.Timestamptz(6)
  canhBaoDaXuLyBoiId String?
  canhBaoGhiChu      String?          @db.Text
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  @@index([maGiaoDichGoc])
  @@index([matchStatus, thoiGianGiaoDich])
  @@index([centerId, thoiGianGiaoDich])
  @@index([orgUnitId])
  @@index([canhBaoHuy])
  @@index([importBatchId])
}

// ─── 06/10/2026 — GĐ1 POS: PHIẾU THU THẺ (thiết kế: docs/pos-gd1-thiet-ke.md §1) ──────

/// Trạng thái một PHIẾU THU THẺ. Mở: CHO_QUET, THAT_BAI.
enum PosIntentStatus {
  CHO_QUET // vừa tạo, chờ khách quẹt
  THAT_BAI // lần quẹt gần nhất THẤT BẠI — phiếu VẪN MỞ, quẹt lại được
  DA_THU // tiền thẻ đã tự khớp vào ĐÚNG phiếu gộp này (Payment PENDING chờ kế toán)
  LECH_TIEN // máy đã thu nhưng ≠ còn phải thu lúc khớp ⇒ giao dịch ở hàng chờ tay
  CAN_XU_LY // [TỰ QUYẾT T1] máy đã thu, không tự khớp vì lý do khác ⇒ hàng chờ tay
  HET_HAN // bị thay bằng phiếu POS mới sau hạn
  HUY // phiếu gộp của nó không còn mở lúc tạo phiếu POS mới cho đơn
}

/// `PosCheckResult.kind` gần nhất. Hợp đồng của provider — lib/payments/pos/provider/kieu.ts.
enum PosCheckKind {
  PAID
  PAID_AMOUNT_MISMATCH
  FAILED
  NOT_FOUND
  CANCELLED_AFTER_PAID
  PROVIDER_ERROR
}

/// Ai kích lượt kiểm gần nhất. AGENT để chỗ cho GĐ4.
enum PosCheckTrigger {
  SALE
  POLLER
  AGENT
  IMPORT
  QUET_SACH // 06/10/2026 — GĐ2: quét sạch cuối ngày 23:30 giờ VN (ADD VALUE ⇒ luôn nối cuối)
}

/// GĐ2 POS — kết quả MỘT lượt kiểm trong nhật ký: kind của provider, hoặc CACHE (lượt bị cửa sổ
/// chống bấm dồn chặn — KHÔNG gọi provider). Enum RIÊNG: thêm CACHE vào `PosCheckKind` là cho
/// `PosPaymentIntent.lastResultKind` lưu một "kết quả máy" vô nghĩa.
enum PosCheckLogKind {
  PAID
  PAID_AMOUNT_MISMATCH
  FAILED
  NOT_FOUND
  CANCELLED_AFTER_PAID
  PROVIDER_ERROR
  CACHE
}

/// GĐ1 POS — một lần sale bấm "Thu bằng thẻ POS" cho MỘT phiếu gộp (mã 5 ký tự US-10).
/// KHÔNG phải sổ tiền: tiền chỉ ở BankTransaction → PaymentAllocation → Payment.
/// KHÔNG có paymentId (phiếu gộp n dòng ⇒ n Payment) và KHÔNG có orderId (tra qua phiếu gộp).
/// ⛔ "Một phiếu ĐANG MỞ mỗi phiếu gộp" là chỉ mục TỪNG PHẦN viết tay
/// (`PosPaymentIntent_paymentBillId_mo_key … WHERE status IN ('CHO_QUET','THAT_BAI')`) + ba
/// CHECK (amount > 0, code5 dài 5, expiresAt > createdAt) — Prisma không khai được, chỉ có
/// trong migration 20261006140000_pos_payment_intent; ca [POS1-MIG-02] đo chúng trên DB.
/// Cách ly: SCOPED_MODELS + getModelPrefixes (`payments:`) + BACKFILL_SPECS (BAT_BUOC).
model PosPaymentIntent {
  id                String           @id @default(cuid())
  paymentBillId     String
  paymentBill       PaymentBill      @relation(fields: [paymentBillId], references: [id], onDelete: Restrict)
  /// = PaymentBill.matchKey lúc tạo (mã bất biến) — sao chép để tra nhanh.
  code5             String
  /// Còn phải thu (`conPhaiThuCuaPhieu`) LÚC TẠO — để hiển thị/đối chiếu. KHÔNG phải số đối khớp.
  amount            Int
  /// Cơ sở của ĐƠN (luôn có). Cột TRẦN, không FK — cùng lối PaymentBill.centerId.
  centerId          String
  // Ghi kép centerId → orgUnitId (lib/org/dual-write.ts). Cột trần, không FK.
  orgUnitId         String?
  posTerminalId     String?
  posTerminal       PosTerminal?     @relation(fields: [posTerminalId], references: [id], onDelete: Restrict)
  provider          String           @default("CARD_POS")
  status            PosIntentStatus  @default(CHO_QUET)
  lastCheckAt       DateTime?        @db.Timestamptz(6)
  lastResultKind    PosCheckKind?
  lastResultMessage String?          @db.Text
  lastTriggeredBy   PosCheckTrigger?
  /// Giao dịch thẻ phiếu này đã NHẬN (tối đa một phiếu cho một giao dịch).
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  createdById       String
  createdBy         User             @relation("PosPaymentIntentNguoiTao", fields: [createdById], references: [id], onDelete: Restrict)
  /// Do APP đặt = `now` truyền vào (TỰ QUYẾT T18), không dùng default lúc chạy thật.
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime         @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  /// 06/10/2026 — GĐ2: nhật ký mọi lượt kiểm (kể cả lượt CACHE).
  checkLogs PosCheckLog[]
  /// 07/10/2026 — GĐ4: yêu cầu "đồng bộ ngay" gửi máy đồng bộ khi sale bấm Kiểm tra.
  checkJobs PosCheckJob[]

  @@index([paymentBillId])
  @@index([code5])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
  @@index([status, createdAt])
}

/// GĐ2 POS — NHẬT KÝ: mỗi lượt `kiemTraPhieuPos` một dòng (cả lượt CACHE). CHỈ THÊM — không sửa, không
/// xoá trong mã. KHÔNG phải sổ tiền, KHÔNG phải AuditLog (đổi trạng thái phiếu vẫn ghi writeAudit).
/// KHÔNG lưu raw/PII: không số thẻ, không ghi chú (dienGiai), không tên chủ thẻ.
/// ⛔ Ba CHECK (durationMs ≥ 0 · errorCode ≤ 64 · CACHE ⇒ 0 ms + không mã GD) chỉ có trong migration
/// 20261006160000_pos_gd2_nhat_ky_kiem — ca [POS2-MIG-02] đo chúng trên DB.
/// Cách ly: SCOPED_MODELS + getModelPrefixes (`payments:`) + BACKFILL_SPECS (BAT_BUOC).
/// Thiết kế: docs/pos-gd2-thiet-ke.md §1–2.
model PosCheckLog {
  id            String           @id @default(cuid())
  intentId      String
  intent        PosPaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  /// = PosPaymentIntent.centerId (cơ sở của ĐƠN) — cột cách ly đang thật sự đọc (luật cứng #3).
  centerId      String
  /// Chép từ phiếu POS; trống thì ghi kép tự điền (lib/org/dual-write.ts). Cột trần, không FK.
  orgUnitId     String?
  triggeredBy   PosCheckTrigger
  kind          PosCheckLogKind
  /// `reasonCode` của provider (≤ 64 ký tự), hoặc "XU_LY_NEM" khi xuLyKetQuaPos ném.
  errorCode     String?
  /// Thời lượng gọi provider (đồng hồ đơn điệu). CACHE = 0.
  durationMs    Int
  /// Mã giao dịch TCB provider trả (không phải PII). CACHE = null.
  providerTxnId String?
  /// [TỰ QUYẾT U5] Trạng thái phiếu SAU lượt (CACHE: trạng thái đọc dưới khoá). Null khi xử lý ném.
  statusSau     PosIntentStatus?
  /// Người bấm (SALE) / người nhập file (IMPORT). Null cho máy (POLLER, QUET_SACH, AGENT).
  createdById   String?
  createdBy     User?            @relation("PosCheckLogNguoiKiem", fields: [createdById], references: [id], onDelete: SetNull)
  /// Do APP đặt = `now` truyền vào (khuôn T18).
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)

  @@index([intentId, createdAt])
  @@index([centerId, createdAt])
  @@index([createdAt])
  @@index([orgUnitId])
}

// ─── 07/10/2026 — GĐ4 POS: ĐẦU NHẬN POS AGENT (thiết kế: docs/pos-gd4-thiet-ke.md §2) ─────────────
// Hợp đồng với Chrome extension: docs/pos-agent-api.md. Bảy CHECK + năm RLS chỉ có trong migration
// 20261007120000_pos_gd4_pos_agent — ca [POS4-MIG-02] đo chúng trên DB.

/// Phiên portal Techcombank mà agent đang thấy.
enum PosAgentSessionState {
  READY
  EXPIRED
  UNKNOWN
}

enum PosAgentEventType {
  HEARTBEAT // chỉ LAN_DAU · KET_NOI_LAI · DOI_PHIEN_BAN — KHÔNG mỗi lượt (T19)
  SESSION_READY
  SESSION_EXPIRED
  SYNC // chỉ lô có dòng đổi / từ chối mới
  ERROR
}

enum PosCheckJobStatus {
  PENDING
  DONE
  EXPIRED
}

/// Nguồn đã THẤY một giao dịch thẻ (GĐ6 đối chiếu agent ↔ file).
enum PosDataSource {
  FILE
  AGENT
}

/// Một máy đồng bộ (Chrome extension) cho MỘT merchant portal. KHÔNG giữ bí mật (T2): khoá =
/// HMAC(POS_AGENT_MASTER_KEY, id:secretVersion) — lib/payments/pos/agent/khoa.ts. "Tạo lại secret" =
/// secretVersion + 1 (khoá cũ chết ngay).
/// Cách ly: SCOPED_MODELS + getModelPrefixes (`payments:`) + BACKFILL_SPECS (BAT_BUOC).
model PosAgent {
  id               String               @id @default(cuid())
  centerId         String
  center           Center               @relation(fields: [centerId], references: [id], onDelete: Restrict)
  // Ghi kép centerId → orgUnitId (lib/org/dual-write.ts). Cột trần, không FK.
  orgUnitId        String?
  merchantCode     String               @unique
  profileName      String?
  secretVersion    Int                  @default(1)
  secretDoiLuc     DateTime?            @db.Timestamptz(6)
  active           Boolean              @default(true)
  /// Lần cuối nhận MỘT request đã ký hợp lệ (mọi endpoint) — T4. Ghi tối đa 1 lần / 15 giây.
  lastHeartbeatAt  DateTime?            @db.Timestamptz(6)
  /// Cron giám sát đặt (= lastHeartbeatAt) khi mất > 5′; request hợp lệ kế tiếp xoá + ghi KET_NOI_LAI.
  matKetNoiTuLuc   DateTime?            @db.Timestamptz(6)
  sessionState     PosAgentSessionState @default(UNKNOWN)
  sessionDoiLuc    DateTime?            @db.Timestamptz(6)
  sessionLyDo      String?
  /// Mốc `exp` của access token portal. Heartbeat nguồn `SESSION` ⇒ null (không rõ hạn — chốt hợp đồng 1.1).
  sessionExpiresAt DateTime?            @db.Timestamptz(6)
  /// Giờ MÁY CHỦ nhận lô `final:true` (đủ lô) gần nhất — màn Sức khoẻ: "Nhận lô cuối".
  lastSyncedAt     DateTime?            @db.Timestamptz(6)
  /// `windowTo` của CHÍNH lô final đó (giờ VN ⇒ mốc tuyệt đối) — "Dữ liệu đã đọc tới" (chốt hợp đồng 1.1, RV5.4 #4).
  /// Migration 20261007140000_pos_gd4_du_lieu_den_luc (additive, nullable).
  duLieuDenLuc     DateTime?            @db.Timestamptz(6)
  extensionVersion String?
  loiGanNhat       String?
  loiGanNhatLuc    DateTime?            @db.Timestamptz(6)
  createdById      String?
  createdBy        User?                @relation("PosAgentNguoiTao", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)

  events  PosAgentEvent[]
  jobs    PosCheckJob[]
  nonces  PosAgentNonce[]
  sources PosTxnSource[]
  loCho   PosAgentLoCho[]

  @@index([centerId])
  @@index([orgUnitId])
}

/// Nhật ký máy đồng bộ. `detail` KHÔNG PII (chỉ số đếm, mã, mốc giờ).
/// Cách ly: SCOPED_MODELS + getModelPrefixes (`payments:`) + BACKFILL_SPECS (BAT_BUOC).
model PosAgentEvent {
  id        String            @id @default(cuid())
  agentId   String
  agent     PosAgent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  /// Chép từ agent — cột cách ly đang thật sự đọc (luật cứng #3).
  centerId  String
  orgUnitId String?
  type      PosAgentEventType
  /// Mã con ≤ 64, IN HOA + gạch dưới — CHECK ở migration.
  ma        String?
  detail    Json              @default("{}")
  /// Gộp ERROR theo (agent, mã, ngày VN) — T19.
  khoaGop   String?           @unique
  /// Do APP đặt = `now` truyền vào (khuôn T18 GĐ1).
  createdAt DateTime          @default(now()) @db.Timestamptz(6)

  @@index([agentId, createdAt])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
}

/// "Đồng bộ ngay" cho một lượt sale bấm Kiểm tra. CHECK (DONE ⇔ doneAt) ở migration.
/// Cách ly: SCOPED_MODELS + getModelPrefixes (`payments:`) + BACKFILL_SPECS (BAT_BUOC).
model PosCheckJob {
  id        String            @id @default(cuid())
  intentId  String
  intent    PosPaymentIntent  @relation(fields: [intentId], references: [id], onDelete: Restrict)
  agentId   String
  agent     PosAgent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  /// = intent.centerId.
  centerId  String
  orgUnitId String?
  status    PosCheckJobStatus @default(PENDING)
  /// = intent.createdAt − 5′ — mốc sớm nhất agent cần quét (API: `scanFrom`).
  tuLuc     DateTime          @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  doneAt    DateTime?         @db.Timestamptz(6)

  @@index([agentId, status, createdAt])
  @@index([intentId, status])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
}

/// Chống phát lại. NGOẠI LỆ CÓ CHỦ ĐÍCH: không cột đơn vị (khuôn AttendanceTicket) — sống 15′, chỉ tầng
/// xác thực đọc/ghi bằng `db` trần trong lib, không màn nào đọc.
model PosAgentNonce {
  agentId   String
  agent     PosAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  nonce     String
  createdAt DateTime @db.Timestamptz(6)

  @@id([agentId, nonce])
  @@index([createdAt])
}

/// 07/10/2026 — GĐ4 POS (rà đối kháng RV-04): lô `final:false` của một lượt đồng bộ XẾP CHỜ; lô `final:true` xử
/// lý CẢ LƯỢT như MỘT file (tập hủy của cả lượt) rồi xoá. NGOẠI LỆ CÓ CHỦ ĐÍCH: không cột đơn vị (khuôn
/// `PosAgentNonce`) — bảng tạm của MỘT agent đã xác thực, chỉ `nhan-giao-dich.ts` đọc/ghi, cron giám sát dọn > 1 giờ.
model PosAgentLoCho {
  agentId    String
  agent      PosAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  syncId     String
  /// 0..999 — CHECK ở migration.
  batchIndex Int
  /// Các dòng `transactions[i]` ĐÃ QUA schema strict (whitelist §6.1) mà chuẩn hoá NHẬN, kèm vị trí gốc.
  dong       Json
  /// R9 (07/10/2026): dòng hủy/hoàn BỊ TỪ CHỐI của lô này (mã · mã từ chối · RRN · quầy · giờ) — để lô final của lượt
  /// biết PAYMENT cùng RRN ở lô KHÁC không được đi lõi một mình. NULL = không có / lô xếp chờ trước bản vá.
  huyTuChoi  Json?
  createdAt  DateTime @db.Timestamptz(6)

  @@id([agentId, syncId, batchIndex])
  @@index([createdAt])
}

/// NGUỒN đã thấy một giao dịch thẻ: một dòng / (maGiaoDich × nguồn). Ảnh chụp những gì NGUỒN ĐÓ nói (không
/// phải giá trị đang lưu ở PosCardTransaction). KHÔNG lưu ghi chú (chỉ băm), không số thẻ.
/// CHECK (nguồn ⇔ posAgentId · tuChoi chỉ AGENT · băm 64 hex) ở migration.
/// Cách ly: SCOPED_MODELS + getModelPrefixes (`payments:`) + BACKFILL_SPECS (NULL_CHUA_KHOP — T25).
model PosTxnSource {
  id               String        @id @default(cuid())
  maGiaoDich       String
  nguon            PosDataSource
  posAgentId       String?
  posAgent         PosAgent?     @relation(fields: [posAgentId], references: [id], onDelete: Restrict)
  /// Lô file GẦN NHẤT (không FK — như lastImportBatchId).
  importBatchId    String?
  lanDauThay       DateTime      @db.Timestamptz(6)
  lanCuoiThay      DateTime      @db.Timestamptz(6)
  soLanThay        Int           @default(1)
  /// sha256 hex dòng đã chuẩn hoá của nguồn này (T11).
  bam              String
  loaiGiaoDich     String?
  trangThai        String?
  soTien           Int?
  thoiGianGiaoDich DateTime?     @db.Timestamptz(6)
  bamDienGiai      String?
  trangThaiHoanHuy String?
  maHachToan       String?
  phiGiaoDich      Int?
  maKetToan        String?
  maThietBi        String?
  maQuay           String?
  /// AGENT: mã từ chối (API §7.2) — dòng KHÔNG vào sổ.
  tuChoi           String?
  /// Theo MÁY (T25); NULL = chưa biết cơ sở.
  centerId         String?
  orgUnitId        String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  @@unique([maGiaoDich, nguon])
  @@index([centerId, thoiGianGiaoDich])
  @@index([thoiGianGiaoDich])
  @@index([orgUnitId])
}

/// Sổ phân bổ: giao dịch X rót bao nhiêu vào phiếu thu Y. Trạng thái phiếu thu
/// và công nợ đều TÍNH TỪ bảng này.
model PaymentAllocation {
  id                String          @id @default(cuid())
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  paymentRequestId  String
  paymentRequest    PaymentRequest  @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  centerId          String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId         String?

  amount         Int
  /// Phần THIẾU được tha theo dung sai làm tròn (payment.roundingToleranceVnd).
  /// Bắt buộc lưu: `deriveStatus` cần nó để coi phiếu là PAID — không có cột này
  /// thì mỗi lần tính lại trạng thái sẽ ghi đè PAID về PARTIAL, tức dung sai chỉ
  /// đúng đúng một lần rồi tự huỷ. Cũng là số kế toán cần thấy khi đối soát.
  roundingWaived Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([bankTransactionId, paymentRequestId])
  @@index([paymentRequestId])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
}

/// Tiền thừa sau khi đã rót hết các đợt của đơn. CHỈ ghi nhận + hiện cho kế toán
/// quyết — không tự hoàn, không tự trừ sang đơn khác.
model CreditBalance {
  id                String  @id @default(cuid())
  /// Gắn phụ huynh (User) và/hoặc học viên — đơn có thể chưa convert nên cả hai nullable.
  parentUserId      String?
  studentId         String?
  orderId           String?
  bankTransactionId String?
  centerId          String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId         String?

  amount        Int
  note          String?   @db.Text
  /// Kế toán đã xử lý (hoàn/trừ đơn khác) chưa — xử lý TAY, hệ thống không tự động.
  settledAt     DateTime? @db.Timestamptz(6)
  settledById   String?
  /// Lý do đánh dấu đã xử lý. Gỡ gắn giao dịch (`goGanTheoCon`) ghi "Do gỡ gắn giao dịch …"
  /// — dòng tiền thừa KHÔNG bị xoá, KHÔNG ghi dòng âm (chốt 29/09/2026).
  settledReason String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([parentUserId, settledAt])
  @@index([studentId])
  @@index([centerId, createdAt])
  @@index([orgUnitId])
}

model Receipt {
  id           String        @id @default(cuid())
  code         String        @unique // RCP-{CENTER}-{YY}-{SEQ}
  /// NULL = phiếu thu của đơn KIT / THI (Order.type PRODUCT · EXAM — không có ghi danh), 29/09/2026.
  /// Khoản đơn COURSE vẫn BẮT BUỘC có ghi danh mới xác nhận được — luật ở `lib/finance/can-ghi-danh.ts`.
  enrollmentId String?
  enrollment   Enrollment?   @relation("EnrollmentReceipts", fields: [enrollmentId], references: [id], onDelete: Restrict) // FIX-C3
  paymentId    String
  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict) // FIX-C3
  issuedById   String?
  issuedAt     DateTime      @default(now()) @db.Timestamptz(6)
  status       ReceiptStatus @default(ACTIVE)

  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6) // FIX-C3 (FIX-M4)
  deletedAt DateTime? @db.Timestamptz(6) // FIX-C3 — soft-delete tài chính

  @@index([enrollmentId])
  @@index([paymentId])
}

// ─── HOÁ ĐƠN ĐIỆN TỬ (26/09/2026) — docs/ke-toan-hoa-don/PLAN.md §2.2 ─────────────────────
//
// Hệ thống KHÔNG phát hành hoá đơn: kế toán phát hành ở MISA rồi TẢI TỆP LÊN đây. Bảng này giữ
// tệp + số hoá đơn + BẢN CHỤP pháp nhân và người mua lúc chốt (pháp nhân đã đảo hai lần trong 7
// ngày — 15/09, 22/09 — nên không được tính lại khi đọc).
//
// ⚠️ KHÔNG đặt tên `Invoice`: `lib/finance/invoice-code.ts` + Counter `invoice:` đã là mã ĐƠN INV-….
// ⚠️ KHÔNG xoá mềm: hoá đơn sai thì HUỶ (bản cũ → THAY_THE, bắt buộc lý do — GĐ 8) rồi xuất lại theo
//    luồng thường; bản kế tiếp tự trỏ `thayTheChoId` về bản đã huỷ.
// ⚠️ Hai chỉ mục TỪNG PHẦN chỉ có trong SQL (Prisma không biểu diễn được `WHERE`):
//    · `HoaDonKhoan_paymentId_hieuLuc_key`  — UNIQUE(paymentId) WHERE hieuLuc
//    · `HoaDonDienTu_soHoaDon_conSong_key`  — UNIQUE(phapNhanMst, kyHieu, soHoaDon)
//                                              WHERE trangThai IN ('NHAP','DA_XAC_NHAN')
//    Kiểm drift sẽ hiện hai dòng đó — đã biết, không phải lệch.
enum HoaDonTrangThai {
  /// đã tải tệp, CHƯA bấm xác nhận — khoản đã bị khoá vào hoá đơn này
  NHAP
  /// kế toán đã chốt ⇒ bất biến; gửi email nếu `guiEmailKhach`
  DA_XAC_NHAN
  /// ĐÃ HUỶ (nút Huỷ hoá đơn, bắt buộc lý do — GĐ 8); bản kế tiếp tạo theo luồng thường và tự trỏ
  /// `thayTheChoId` về đây; `hieuLuc` của các dòng nối = false. Giữ lại, không xoá.
  THAY_THE
  /// "không xuất / đã xuất ngoài hệ thống" — BẮT BUỘC `lyDo`, không có tệp
  KHONG_XUAT
  /// Bước 1 MISA (30/09) — đã tạo bản ghi + khoá khoản, đang/đã gửi MISA, chưa hoàn tất (chưa có số,
  /// hoặc có số mà chưa tải đủ tệp). Mọi kết quả KHÔNG CHẮC CHẮN giữ ở đây (lib/finance/hoa-don/phat-hanh-misa.ts)
  DANG_PHAT_HANH
  /// Bước 1 MISA — MISA từ chối CHẮC CHẮN ⇒ chưa có hoá đơn; khoản vẫn bị giữ tới "Phát hành lại" / "Bỏ, làm tay"
  LOI_PHAT_HANH
}

/// Bản hoá đơn đến từ đâu (30/09). Dòng cũ = kế toán tải tệp lên.
enum HoaDonNguonPhatHanh {
  TAI_LEN
  MISA_API
  /// cổng GIA_LAP — bản MÔ PHỎNG, KHÔNG có giá trị pháp lý, không bao giờ email khách
  MISA_GIA_LAP
}

enum HoaDonGuiTrangThai {
  CHO
  DANG_GUI
  DA_GUI
  LOI
}

model HoaDonDienTu {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// cột cách ly ĐANG ĐỌC (SCOPED_MODELS). NOT NULL: một hoá đơn luôn thuộc đúng một cơ sở.
  centerId  String
  /// hướng đích; ghi kép tự động qua lib/org/dual-write.ts
  orgUnitId String?
  trangThai HoaDonTrangThai

  // Số trên tờ hoá đơn — kế toán gõ; ký hiệu điền sẵn theo mẫu của pháp nhân (1C{YY}TSR)
  kyHieu       String?
  soHoaDon     String?
  ngayPhatHanh DateTime? @db.Date
  maTraCuu     String?

  // BẢN CHỤP lúc chốt
  phapNhanMa        String?
  phapNhanTen       String?
  phapNhanMst       String?
  nguoiMuaTen       String?
  nguoiMuaDonVi     String?
  nguoiMuaMst       String?
  nguoiMuaDiaChi    String?
  /// chụp lại LÚC CHỐT từ đơn; sau chốt là NGUỒN DUY NHẤT của người nhận email — không đọc lại Order
  emailNhan         String?
  /// hash người mua lúc kế toán tải phiếu thu chờ — bước chốt so để cảnh báo đã đổi giữa chừng
  nguoiMuaHashLucIn String?

  /// Σ HoaDonKhoan.soTien (số RÒNG, lib/finance/hoa-don/nguon-khoan.ts) — đồng
  tongTien            Int
  /// phần dung sai làm tròn được tha của các đợt nó phủ — hiện riêng, không cộng vào tổng
  tienThaLamTron      Int     @default(0)
  /// lần thu còn THIẾU mà vẫn xuất (PH không trả nốt) — BẮT BUỘC `xuatTheoSoDaThuLyDo` (CHECK ở DB)
  xuatTheoSoDaThu     Boolean @default(false)
  xuatTheoSoDaThuLyDo String?
  /// kế toán bỏ tick khi MISA đã gửi khách rồi (hoá đơn cũ) — tránh khách nhận hai lần
  guiEmailKhach       Boolean @default(true)

  // Tệp — CHỈ lưu KHOÁ trong bucket riêng (R2_INVOICE_BUCKET_NAME), không lưu URL
  tepPdfKey    String?
  tepPdfTen    String?
  tepPdfCo     Int?
  tepPdfSha256 String?
  tepXmlKey    String?
  tepXmlTen    String?
  tepXmlCo     Int?

  lyDo         String?
  thayTheChoId String?
  /// bản ĐÃ HUỶ mà bản này thay cho (tự nối lúc tạo — lib/finance/hoa-don/thay-the.ts)
  thayTheCho   HoaDonDienTu?  @relation("HoaDonThayThe", fields: [thayTheChoId], references: [id], onDelete: NoAction)
  banThay      HoaDonDienTu[] @relation("HoaDonThayThe")
  taoBoiId     String
  xacNhanBoiId String?
  xacNhanLuc   DateTime?      @db.Timestamptz(6)

  // GĐ 8 — HUỶ hoá đơn đã xác nhận (quyết định (1) 27/09). CHECK ở DB: THAY_THE ⇒ đủ ba cột.
  huyLyDo  String?
  huyBoiId String?
  huyLuc   DateTime? @db.Timestamptz(6)

  // GĐ 8 — lần thu NGHI TRÙNG kế toán xác nhận "không trùng" (quyết định (2) 27/09). Ba cột đi cùng nhau.
  khongTrungLyDo  String?
  khongTrungBoiId String?
  khongTrungLuc   DateTime? @db.Timestamptz(6)

  // Bước 1 MISA (30/09) — phát hành qua API meInvoice. `misaRefId` sinh MỘT LẦN khi tạo bản DANG_PHAT_HANH;
  // gửi lại dùng lại đúng giá trị (khoá chống trùng của MISA). `misaPhieu` = đúng phiếu đã gửi.
  nguonPhatHanh    HoaDonNguonPhatHanh @default(TAI_LEN)
  misaRefId        String?             @unique
  misaPhieu        Json?
  misaLoiMa        String?
  misaLoiThongDiep String?
  misaSoLanGui     Int                 @default(0)
  misaGuiLuc       DateTime?           @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  khoan    HoaDonKhoan[]
  guiEmail HoaDonGuiEmail[]

  @@index([orderId])
  @@index([centerId, trangThai])
  @@index([tepPdfSha256])
  @@index([orgUnitId])
  @@index([thayTheChoId])
  @@index([trangThai, misaGuiLuc])
}

/// Nối hoá đơn ↔ Payment (một hoá đơn phủ 1..n khoản CÙNG đơn). Bảng con: KHÔNG có centerId —
/// luôn đọc qua `HoaDonDienTu` đã scope, không truy vấn thẳng ở tầng app.
model HoaDonKhoan {
  hoaDonId  String
  hoaDon    HoaDonDienTu @relation(fields: [hoaDonId], references: [id], onDelete: Cascade)
  paymentId String
  payment   Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// số RÒNG của khoản lúc gắn — bước chốt tính lại và so
  soTien    Int
  /// false khi hoá đơn bị THAY_THE — nhả khoản cho hoá đơn thay thế
  hieuLuc   Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  @@id([hoaDonId, paymentId])
  @@index([paymentId])
}

/// Mỗi lượt gửi email hoá đơn một dòng — "giành chỗ" CHO→DANG_GUI chống gửi đôi. Trạng thái
/// hiển thị đọc từ EmailQueue qua `emailQueueId`. Bảng con: đọc qua `HoaDonDienTu`.
model HoaDonGuiEmail {
  id           String             @id @default(cuid())
  hoaDonId     String
  hoaDon       HoaDonDienTu       @relation(fields: [hoaDonId], references: [id], onDelete: Cascade)
  /// lượt gửi thứ mấy của CÙNG hoá đơn (gửi lại = lanGui + 1, idempotencyKey mới)
  lanGui       Int
  toi          String
  trangThai    HoaDonGuiTrangThai @default(CHO)
  emailQueueId String?
  loi          String?
  guiBoiId     String?
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([hoaDonId, lanGui])
}

// W3-1 — Yêu cầu hoàn tiền theo lifecycle (rút/chuyển/hủy lớp). Đề xuất → duyệt → ghi sổ.
enum RefundTrigger {
  WITHDRAW
  TRANSFER
  CLASS_CANCELLED
  MANUAL
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model RefundRequest {
  id String @id @default(cuid())

  // ── PHIÊN D [21/09/2026] — MỘT TRONG HAI đầu mối, không bắt buộc cả hai ────
  //
  // Trước hôm nay `enrollmentId` là NOT NULL. Nới ra vì phần DƯ sau khi dừng học phải
  // được phân HẾT, mà một dòng đơn CHƯA gắn ghi danh (đơn tạo tay trước lúc convert lead)
  // không có `Enrollment` nào để treo yêu cầu hoàn vào ⇒ khoản dư không có cửa ra.
  //
  // ⚠️ MẤT CẢ HAI = dòng tiền mồ côi. CHECK ở tầng DB gác
  // (`RefundRequest_co_nguon_check`) — Prisma không model được CHECK nên nó chỉ sống
  // trong migration `20260921160000_dung_hoc_mot_con`.
  //
  // ⚠️ `RefundRequest` nằm trong danh sách KHÔNG auto-scope của `lib/db-scope.ts`, lý do
  // ghi rõ *"scope qua quan hệ enrollment→class"*. Dòng không có ghi danh thì KHÔNG CÒN
  // đường đó — tầm nhìn của nó đi qua `orderItem.order`, ép TAY trong
  // `listRefundRequests`. Bỏ nhánh ấy là yêu cầu hoàn tàng hình với kế toán, và tàng hình
  // thì không ai báo lỗi.
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  /// Dòng đơn (một CON) mà khoản hoàn này thuộc về. `Restrict` giống `Payment.orderItemId`:
  /// xoá dòng đơn không được kéo theo sổ tiền.
  orderItemId  String?
  orderItem    OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  centerId     String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId    String?

  trigger         RefundTrigger
  reason          String        @db.Text
  // Số liệu snapshot tại thời điểm tạo (để tính minh bạch, không phụ thuộc thay đổi sau).
  paidConfirmed   Int // Σ Payment CONFIRMED
  sessionsTotal   Int
  sessionsLearned Int
  unitPrice       Int // finalPrice / sessionsTotal (làm tròn)
  proposedAmount  Int // computeRefund (đề xuất, ≥0)
  approvedAmount  Int?
  status          RefundStatus  @default(PENDING)
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?     @db.Timestamptz(6)
  note            String?       @db.Text
  // 29/09 — bước ĐÃ CHI (`chiHoanTien`): ai chi, lúc nào, bằng phương thức gì (kiểu như `Payment.method`).
  paidAt          DateTime?     @db.Timestamptz(6)
  paidById        String?
  paidMethod      String?
  /// Các dòng `Payment` âm ghi vào sổ khi chi.
  payments        Payment[]
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  @@index([enrollmentId])
  @@index([orderItemId])
  @@index([status])
  @@index([centerId])
  @@index([orgUnitId])
}

// LMS-15 — Nhắn 2 chiều PH↔GV theo từng enrollment (sổ liên lạc trao đổi).
enum ConversationSide {
  PARENT
  STAFF
}

model ConversationMessage {
  id             String           @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorSide     ConversationSide
  body           String           @db.Text
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  // Đánh dấu đã đọc theo từng phía (null = chưa đọc).
  readByParentAt DateTime?        @db.Timestamptz(6)
  readByStaffAt  DateTime?        @db.Timestamptz(6)
  // #03 Pha A — denormalize từ Enrollment.centerId để cách ly cơ sở ở tầng query.
  // Nullable trong pha A (dòng cũ backfill bằng migration; đường tạo mới đã set).
  // Pha B (sau khi prod 0 null) mới đưa vào SCOPED_MODELS — xem lib/db-scope.ts.
  centerId       String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId      String?

  @@index([enrollmentId, createdAt])
  @@index([centerId])
  @@index([orgUnitId])
}

// LMS-16 — Mục tiêu doanh thu theo kỳ (cho báo cáo doanh-thu-vs-mục-tiêu).
// centerId null = mục tiêu toàn hệ thống. period = "YYYY-MM".
model RevenueTarget {
  id        String  @id @default(cuid())
  centerId  String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  period       String
  targetAmount Int
  note         String?
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([centerId, period])
  @@index([centerId])
  @@index([orgUnitId])
}

/// C-01 — chỉ tiêu SỐ HỌC SINH theo tháng × cơ sở. Song sinh với RevenueTarget ở trên.
///
/// ĐƠN VỊ ĐẾM: `targetCount` là số HỌC SINH (`LeadChild`), KHÔNG phải số phụ huynh
/// (`Lead`) — quyết định 24/08/2026 (B4) nối doanh số về từng con qua `Order.leadChildId`,
/// nên đơn vị sinh doanh thu là đứa trẻ và chỉ tiêu phải đếm cùng thứ với tử số của C2.
/// Một phụ huynh hai con = 2 đơn vị chỉ tiêu. (E-02 thì ngược lại: đếm theo phụ huynh.)
///
/// `centerId = NULL` ⇒ chỉ tiêu TOÀN HỆ THỐNG (KHÔNG phải "chưa gán cơ sở").
/// ⚠️ Khai vào SCOPE_EXEMPT (lib/db-scope.ts), KHÔNG khai SCOPED_MODELS — `injectScope`
///    chèn `centerId IN (...)` trần và dòng toàn hệ thống sẽ tàng hình.
/// ⚠️ `@@unique([centerId, period])` với `centerId` nullable: Postgres coi NULL là
///    DISTINCT ⇒ `upsert` KHÔNG match nhánh toàn hệ thống, phải `findFirst` + create/update
///    tay (khuôn có sẵn ở app/(admin)/admin/bao-cao/doanh-thu/_actions.ts).
model LeadTarget {
  id        String  @id @default(cuid())
  centerId  String?
  // Luật cứng Nền Hệ thống #3 + quyết định 24/08 (B1): bảng MỚI mang CẢ HAI cột.
  // Ở đây bảng nằm NGOÀI scope nên `orgUnitId` chỉ để ghi kép/đối soát, không phải cột lọc.
  // `lib/org/dual-write.ts` tự lấp khi `centerId` có giá trị — không tự gọi orgUnitIdForCenter().
  orgUnitId String?

  period      String // "YYYY-MM" — cùng quy ước RevenueTarget.period + monthKeyVN
  targetCount Int // SỐ HỌC SINH
  note        String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([centerId, period])
  @@index([period])
  @@index([centerId])
  @@index([orgUnitId])
}

/// D-02 — chỉ tiêu NGÂN SÁCH QUẢNG CÁO theo tháng × cơ sở. Bảng thứ ba của bộ ba chỉ
/// tiêu, cùng hình dạng với RevenueTarget (tiền THU) và LeadTarget (đầu NGƯỜI); ở đây
/// đo tiền CHI cho quảng cáo.
///
/// ĐỌC KÈM: đây là con số NGƯỜI TA ĐẶT RA, không phải số đã tiêu. Số đã tiêu là
/// snapshot chi tiêu Facebook của D-01 (chưa xây — đang chờ chốt loại mã kết nối Meta).
/// D-03 ghép hai vế lại thành "% thực tế / chỉ tiêu", nên trộn hai thứ vào một bảng là
/// mất luôn khả năng nói "đã tiêu vượt chỉ tiêu".
///
/// `centerId = NULL` ⇒ chỉ tiêu TOÀN HỆ THỐNG (KHÔNG phải "chưa gán cơ sở"). Nó KHÁC
/// hẳn nhóm `CHƯA PHÂN BỔ` của D-06/D-08 — nhóm đó là chi tiêu THẬT chưa quy được về
/// cơ sở nào, còn dòng NULL ở đây là một chỉ tiêu do người đặt cho cả công ty.
///
/// ⚠️ Khai vào SCOPE_EXEMPT (lib/db-scope.ts), KHÔNG khai SCOPED_MODELS — `injectScope`
///    chèn `centerId IN (...)` trần và dòng toàn hệ thống sẽ tàng hình.
/// ⚠️ `@@unique([centerId, period])` với `centerId` nullable: Postgres coi NULL là
///    DISTINCT ⇒ `upsert` KHÔNG match nhánh toàn hệ thống, phải `findFirst` + create/update
///    tay (khuôn có sẵn ở app/(admin)/admin/bao-cao/doanh-thu/_actions.ts).
/// ⚠️ `targetAmount` là `Int` ⇒ int4, trần 2_147_483_647 đồng. Đường ghi CHẶN TRƯỚC ở
///    `ADS_BUDGET_TARGET_AMOUNT_MAX` (lib/reports/ads-budget-target.ts) để lỗi hiện ra
///    ngay tại ô nhập, không phải thành "Lỗi cơ sở dữ liệu" chẳng nói gì.
model AdsBudgetTarget {
  id        String  @id @default(cuid())
  centerId  String?
  // Luật cứng Nền Hệ thống #3 + quyết định 24/08 (B1): bảng MỚI mang CẢ HAI cột.
  // Bảng nằm NGOÀI scope nên `orgUnitId` chỉ để ghi kép/đối soát, không phải cột lọc.
  // `lib/org/dual-write.ts` tự lấp khi `centerId` có giá trị — không tự gọi orgUnitIdForCenter().
  orgUnitId String?

  period       String // "YYYY-MM" — cùng quy ước RevenueTarget.period + monthKeyVN
  targetAmount Int // VNĐ, số nguyên
  note         String?
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([centerId, period])
  @@index([period])
  @@index([centerId])
  @@index([orgUnitId])
}

/// G-04 — tuỳ chọn cột danh sách theo TỪNG NGƯỜI (kiểu MISA).
///
/// 🔴 CỐ Ý KHÔNG mang `centerId`/`orgUnitId` — ngoại lệ có chủ đích của luật cứng
/// Nền Hệ thống #3 ("bảng mới có DỮ LIỆU THEO ĐƠN VỊ bắt buộc có orgUnitId"), đã
/// chốt tường minh ở PRD G-lead §7.2 / A-nen-tang SL-13. Bốn lý do, viết ra để
/// người sau khỏi "sửa cho đúng luật":
///   1. Đây là SỞ THÍCH CÁ NHÂN. Nó không trả lời "bản ghi này thuộc cơ sở nào",
///      nó trả lời "người này thích nhìn thấy gì".
///   2. Cách ly đã mạnh hơn scope: MỌI truy vấn khoá cứng `userId` từ phiên đăng
///      nhập. Không màn nào đọc cấu hình của người khác ⇒ không có gì để scope.
///   3. Quản lý nhiều cơ sở chỉ có MỘT bộ cột; gắn theo cơ sở thì cột nhảy loạn
///      mỗi lần họ đổi bộ lọc phạm vi.
///   4. Khai vào SCOPED_MODELS còn phản tác dụng: `injectScope` chèn
///      `centerId IN (...)` trần ⇒ dòng `centerId = null` tàng hình với CHÍNH CHỦ.
/// Vì không có `centerId`, bảng này KHÔNG cần (và không được) khai vào
/// SCOPED_MODELS/SCOPE_EXEMPT (`lib/db-scope.ts`) hay BACKFILL_SPECS
/// (`lib/org/center-bridge.ts`) — cả hai test canh gác đều soi theo SỰ CÓ MẶT của
/// cột, nên thêm cột "cho đủ luật" là tự chuốc thêm hai dòng khai báo vô nghĩa.
///
/// `columns` (Json) — hình dạng ở `lib/tables/column-preference.ts`:
///   { "v": 1, "visible": ["parentName", …], "hidden": ["email", …] }
/// Cần CẢ `hidden` chứ không chỉ `visible`: thiếu nó thì không phân biệt được
/// "đã tắt có chủ ý" với "chưa từng biết đến", và cột thêm sau sẽ không bao giờ
/// hiện ra với người đã lưu cấu hình.
model UserTablePreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserTablePreferences", fields: [userId], references: [id], onDelete: Cascade)

  /// Định danh bảng, có namespace: "admin.leads.list". Bảng thứ hai chỉ cần khai
  /// danh mục cột riêng ở tầng mã — KHÔNG phải đổi schema.
  tableKey String
  columns  Json
  /// Dành sẵn cho P2 (nhớ số dòng mỗi trang). v1 luôn null.
  pageSize Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, tableKey])
  @@index([userId])
}

// ═══ R7-02 — Lớp trải nghiệm N buổi ══════════════════════════════════════════
enum TrialClassV2Status {
  OPEN
  RUNNING
  COMPLETED
  CANCELLED
}

enum TrialSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TrialEnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum TrialAttendanceStatus {
  PRESENT
  ABSENT
}

/// R7-02 — cấu hình số buổi lớp trải nghiệm (Đào tạo cấu hình, QĐ-O10).
model TrialProgramConfig {
  id           String         @id @default(cuid())
  name         String
  sessionCount Int
  active       Boolean        @default(true)
  updatedById  String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  trialClasses TrialClassV2[]
}

/// R7-02 — lớp trải nghiệm (mới; TrialClass cũ giữ đọc-only 2-phase). Center-scoped.
model TrialClassV2 {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  type      String  @default("TRIAL_ROBOSIM")
  centerId  String // cách ly cơ sở (scopedDb)
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  roomId       String?
  // FL-R2 (QĐ-R2-1): slot tái sử dụng → startDate nullable (lớp không gắn ngày bắt đầu
  // cố định; buổi tạo ad-hoc theo giờ/giảng viên). Lớp cũ giữ nguyên startDate.
  startDate    DateTime?           @db.Date
  /// ⚠️ 28/08 — GIỜ / SĨ SỐ / GIÁO VIÊN Ở CẤP LỚP ĐÃ THÔI DÙNG. Ba thứ đó nay đặt ở
  /// TỪNG BUỔI (`TrialClassSession.startTime/endTime/roomId/teacherId`), vì một lớp
  /// trải nghiệm là slot tái sử dụng: mỗi buổi có thể khác giờ, khác phòng, khác người
  /// dạy. Cột giữ lại ở pha A để lớp cũ không mất số liệu và để lùi được — pha B mới
  /// drop. Đường ghi MỚI phải để `null`; đường đọc phải chịu được `null`.
  startTime    String?
  endTime      String?
  /// `null` = KHÔNG giới hạn sĩ số (mặc định từ 28/08). `isOverCapacity` hiểu null là
  /// không bao giờ vượt — đừng "vá" bằng cách coi null là 0.
  /// 23/09/2026 — lop THEO KHUNG (mo hinh case: mot ngay x mot khung, nhieu case song
  /// song cua nhieu Sale) hay lop slot CU. Quyet dinh nghia cua
  /// `TrialEnrollment.scheduledSessionId = NULL`: theo khung = "chua xep case", cu = "hoc
  /// ca lop" (xem lib/trial/nghia-null.ts). KHONG suy tu startTime/endTime: lop truoc
  /// 28/08 van mang gio o cap lop. Chi `createTrialClass` ghi true (du ngay + khung).
  theoKhung    Boolean             @default(false)
  capacity     Int?
  teacherId    String?
  /// Khoá trải nghiệm của lớp (= "khoá quan tâm" của khách). Cột TRẦN, không FK —
  /// cùng nếp với `LeadChild.interestedCourseId`.
  courseId     String?
  assistantId  String?
  status       TrialClassV2Status  @default(OPEN)
  configId     String?
  config       TrialProgramConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  sessionCount Int // snapshot lúc tạo (lớp cũ giữ N cũ khi config đổi)
  // 18/09/2026 — Sale/người TẠO lớp. NULL với lớp tạo trước hôm nay: màn danh sách rơi
  // về suy Sale từ lead của các con đang xếp trong lớp. Không FK cứng (giống
  // `teacherId`/`assistantId` cùng bảng) để xoá tài khoản cũ không kéo sập bản ghi lớp.
  createdById  String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)

  sessions     TrialClassSession[]
  enrollments  TrialEnrollment[]
  trialHistory LeadTrialHistory[]

  @@index([centerId, status])
  @@index([orgUnitId])
  @@index([createdById])
}

/// FL-R2 (E2-TRIAL / item 6) — lịch sử "đã từng học thử" của 1 con. Giữ lại kể cả khi
/// lead rời pipeline (đăng ký/mất) để nếu quay lại không mất thông tin cũ. 1 dòng / con×lớp.
model LeadTrialHistory {
  id           String       @id @default(cuid())
  leadChildId  String
  leadChild    LeadChild    @relation(fields: [leadChildId], references: [id], onDelete: Cascade)
  trialClassId String
  trialClass   TrialClassV2 @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  centerId     String // cách ly cơ sở (scopedDb)
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId    String?

  attendedCount   Int       @default(0)
  totalSessions   Int
  firstAttendedAt DateTime? @db.Timestamptz(6)
  lastAttendedAt  DateTime? @db.Timestamptz(6)
  outcome         String? // ENROLLED | LOST | PENDING
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([leadChildId, trialClassId])
  @@index([leadChildId])
  @@index([trialClassId])
  @@index([centerId])
  @@index([orgUnitId])
}

/// R7-02 — buổi của lớp trải nghiệm (sinh tự động khi tạo lớp, né Holiday).
model TrialClassSession {
  id           String             @id @default(cuid())
  trialClassId String
  trialClass   TrialClassV2       @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  seq          Int // 1..N
  date         DateTime           @db.Date
  startTime    String
  endTime      String
  roomId       String?
  teacherId    String?
  status       TrialSessionStatus @default(SCHEDULED)
  /// 23/09/2026 — AI TAO ra "case" nay. Trong mot lop trai nghiem (mot ngay x mot
  /// khung gio) nhieu Sale cung xep case cua minh; cot nay la thu duy nhat tra loi
  /// "case nay cua ai", va luat "Sale chi sua/xoa case cua chinh minh" tua vao no.
  /// NULL = buoi tao truoc 23/09/2026 (KHONG backfill — khong co nguon nao dang tin
  /// de doan). Duong doc phai chiu duoc NULL: xem `lib/trial/quyen-case.ts`.
  createdById  String?
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  attendances TrialAttendance[]

  @@index([trialClassId, seq])
  @@index([createdById])
}

/// R7-02 — ghi danh 1 LeadChild vào 1 lớp trải nghiệm. Partial-unique 1 lớp ACTIVE/con (migration).
model TrialEnrollment {
  id                       String                @id @default(cuid())
  trialClassId             String
  trialClass               TrialClassV2          @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  leadChildId              String
  leadChild                LeadChild             @relation(fields: [leadChildId], references: [id], onDelete: Cascade)
  status                   TrialEnrollmentStatus @default(ACTIVE)
  summaryNote              String?               @db.Text // nhận xét tổng kết học thử
  // LD3(b) — buổi (TrialClassSession) cụ thể được chọn khi xếp con vào lớp. Scalar nullable
  // (validation "buổi thuộc lớp" đã làm ở action boundary — không cần relation, giữ blast radius nhỏ).
  scheduledSessionId       String?
  // Site GV 25/08 — DỜI LỊCH học thử. Trước đó `scheduledSessionId` ghi ĐÚNG MỘT LẦN lúc
  // xếp con vào lớp rồi bất biến: không admin/GV/Sale nào đổi được buổi, nên bảng trial
  // của giáo viên không có cách nào biết suất nào "bị dời lịch".
  // Nay `rescheduleTrialEnrollment` đổi buổi và GHI LẠI buổi cũ ở đây (buổi gần nhất —
  // dời nhiều lần thì chỉ giữ lần cuối; lịch sử đầy đủ nằm ở DomainEvent + AuditLog).
  rescheduledFromSessionId String?
  rescheduledAt            DateTime?             @db.Timestamptz(6)
  rescheduleReason         String?               @db.Text
  addedById                String?
  createdAt                DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(6)

  // ─── GĐ3 — hai ô giáo viên, tách theo VAI người ghi ────────────────────────
  //
  // Đặt ở ĐÂY (per ca của một bé) chứ không phải trên TrialClassV2, vì luồng đã
  // chốt là trial 1-1 theo từng khách: Sale đề xuất cho ca của mình, Đào tạo duyệt
  // cho ca đó, và khi dời lịch thì chỉ ca đó mất phân công. Để ở cấp LỚP thì dời
  // lịch cho bé A sẽ gỡ luôn giáo viên của bé B, C trong cùng lớp.
  //
  // `TrialClassV2.teacherId` và `TrialClassSession.teacherId` VẪN GIỮ nguyên vai trò
  // cũ: giáo viên mặc định của lớp/buổi. Hai cột dưới đây là quyết định cho TỪNG CA.
  /// Sale ĐỀ XUẤT (đã bàn trước với giáo viên đó). KHÔNG bắt buộc.
  gvDeXuatId      String?
  /// Đào tạo PHÂN CÔNG. Có giá trị = đã chốt, Sale không sửa được nữa.
  gvPhanCongId    String?
  /// Số lần ca này bị dời lịch. Chỉ số chất lượng chốt lịch của Sale.
  rescheduleCount Int     @default(0)

  attendances TrialAttendance[]
  reschedules TrialReschedule[]

  @@index([trialClassId])
  @@index([leadChildId])
  @@index([scheduledSessionId])
  @@index([gvPhanCongId])
}

/// GĐ3 — NHẬT KÝ DỜI LỊCH của một ca trải nghiệm.
///
/// Vì sao là bảng riêng chứ không phải một trạng thái buổi: chủ dự án đã chốt GIỮ
/// `TrialSessionStatus` ba giá trị (buổi là của cả lớp, còn dời lịch là việc của MỘT
/// bé — nhét vào trạng thái buổi thì một buổi bốn bé không mang nổi bốn trạng thái).
///
/// Vì sao phải giữ vết dù trên màn hình bé đó "biến mất" khỏi buổi cũ: tỷ lệ dời lịch
/// phản ánh chất lượng chốt lịch của Sale. Xoá thẳng là mất hẳn chỉ số đó, không dựng
/// lại được.
model TrialReschedule {
  id                String          @id @default(cuid())
  trialEnrollmentId String
  trialEnrollment   TrialEnrollment @relation(fields: [trialEnrollmentId], references: [id], onDelete: Cascade)

  /// Buổi CŨ (có thể null nếu ca chưa từng được xếp buổi nào).
  fromSessionId String?
  /// Buổi MỚI được dời sang.
  toSessionId   String

  /// Giáo viên bị gỡ phân công vì lượt dời này — giữ để đối chiếu khi có khiếu nại.
  gvBiGoId String?
  /// Vì sao dời: "PH vắng" | "PH xin dời" | ghi chú tự do của Sale.
  reason   String?

  changedById   String?
  changedByName String?

  centerId  String? // cách ly cơ sở (scopedDb)
  /// Cột SONG SONG với centerId theo P1 · US-07. Cột trần, không FK.
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([trialEnrollmentId, createdAt])
  @@index([centerId])
  @@index([orgUnitId])
}

/// R7-02 — điểm danh + nhận xét per buổi per LeadChild.
model TrialAttendance {
  id                String                @id @default(cuid())
  trialSessionId    String
  trialSession      TrialClassSession     @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)
  trialEnrollmentId String
  trialEnrollment   TrialEnrollment       @relation(fields: [trialEnrollmentId], references: [id], onDelete: Cascade)
  status            TrialAttendanceStatus @default(PRESENT)
  note              String?               @db.Text
  /// GĐ4 — AI điểm danh. Trước GĐ4 bảng này không lưu người thao tác, nên khi đổi vai
  /// điểm danh từ giáo viên sang Sale thì lịch sử cũ không quy được trách nhiệm.
  /// NULL với mọi dòng có trước GĐ4 — không suy ngược được, đừng bịa.
  markedById        String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)

  @@unique([trialSessionId, trialEnrollmentId])
}

// Phiếu đánh giá buổi TRẢI NGHIỆM (rubric thang 8.0 SataRobo) — 1 phiếu/HV trải
// nghiệm. Ref phẳng tới TrialEnrollment (@unique) + buổi (scalar) để blast radius nhỏ.
// scores = JSON { focus, interact, keyboard, experience, absorb, logic } → điểm đã chọn.
// Cấu trúc rubric cố định trong lib/trial/rubric.ts (không drive bằng DB).
model TrialRubricEval {
  id String @id @default(cuid())

  // ⚠️ GĐ4 (25/08/2026) — BỎ `@unique` trên `trialEnrollmentId`, khoá lại theo BUỔI.
  //
  // Trước GĐ4 mỗi ca chỉ chứa được MỘT phiếu, mà đường ghi lại là `upsert` theo
  // `trialEnrollmentId`. Hệ quả: giáo viên chấm buổi 2 sẽ GHI ĐÈ IM LẶNG phiếu buổi 1
  // và dời luôn con trỏ buổi. Dữ liệu buổi cũ mất hẳn, không khôi phục được — phần đã
  // mất trước ngày này thì đành chịu, đây chỉ chặn không mất thêm.
  //
  // Khoá kép cho phép nhiều NULL (Postgres coi NULL là khác nhau), nên phiếu KHÔNG gắn
  // buổi vẫn trùng được. Chấp nhận có chủ đích: phiếu không gắn buổi là dữ liệu cũ,
  // không phải đường ghi mới — mọi đường ghi từ GĐ4 đều bắt buộc có buổi.
  trialEnrollmentId   String
  trialClassSessionId String? // buổi được đánh giá (ref phẳng)
  scores              Json // criterionId -> points (thang 8.0)
  totalScore          Float
  rank                String // "Tốt" | "Khá" | "Trung bình" | "Cần cố gắng"
  generalComment      String?  @db.Text // Nhận xét chung
  orientation         String?  @db.Text // Định hướng của SataRobo
  evaluatedById       String? // GV (User.id)
  evaluatedByName     String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  // Một phiếu / một buổi / một ca — cùng khuôn với `TrialAttendance`, bảng vốn đã
  // khoá đúng theo buổi từ đầu.
  @@unique([trialEnrollmentId, trialClassSessionId])
  @@index([trialEnrollmentId])
  @@index([trialClassSessionId])
}

// ═══ R7-05 — Convert v2 ═══════════════════════════════════════════════════════
enum ConvertConflictStatus {
  OPEN
  RESOLVED
}

/// R7-05 §8.4 — xung đột dedupe parent (email thuộc hồ sơ A, phone thuộc hồ sơ B)
/// → khoá convert, Admin gộp/sửa ở /admin/convert-conflicts rồi RESOLVED để mở khoá.
model ConvertConflict {
  id           String                @id @default(cuid())
  leadId       String
  parentAId    String // User.id khớp theo email
  parentBId    String // User.id khớp theo phone
  status       ConvertConflictStatus @default(OPEN)
  resolvedById String?
  note         String?               @db.Text
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(6)

  @@index([leadId, status])
  @@index([status])
}

/// R7-05 — chống double-submit/idempotency cho thao tác nhạy cảm (convert...).
/// key = hash ổn định của payload (vd `convert:${leadId}:${hash}`).
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  scope     String? // "convert" | ...
  result    Json? // tham chiếu kết quả (vd enrollmentIds) để trả lại khi trùng
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([scope, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// R7-15 — Học bạ ReportCard (nhập → duyệt → phát hành). 1 học bạ / Enrollment.
// ═══════════════════════════════════════════════════════════════════════════
enum ReportCardStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RECALLED
}

model ReportCard {
  id                String           @id @default(cuid())
  enrollmentId      String           @unique // 1-1 với Enrollment (ref phẳng)
  status            ReportCardStatus @default(DRAFT)
  periodComments    Json? // nhận xét theo giai đoạn [{period, comment}]
  finalComment      String?          @db.Text
  completionStatus  String?
  teacherId         String?
  reviewedById      String?
  publishedById     String?
  publishedAt       DateTime?
  publishedSnapshot Json? // đóng băng số liệu lúc phát hành
  centerId          String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores ReportCardScore[]

  @@index([status])
  @@index([centerId])
  @@index([teacherId])
  @@index([orgUnitId])
}

model ReportCardCriterion {
  id        String   @id @default(cuid())
  courseId  String // Đào tạo cấu hình tiêu chí năng lực per khóa (ref phẳng)
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([courseId, active])
}

model ReportCardScore {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  criterionId  String // ref phẳng tới ReportCardCriterion
  level        Int // thang 1..4
  note         String?    @db.Text

  @@unique([reportCardId, criterionId])
  @@index([reportCardId])
}

// ═══════════════════════════════════════════════════════════════════════════
// R7-16 — Form builder (4 loại câu hỏi) + Đánh giá GV + Khảo sát trung tâm.
// Bảng Eval* MỚI — KHÔNG đụng Survey NPS cũ.
// ═══════════════════════════════════════════════════════════════════════════
enum EvalScope {
  TEACHER_EVAL
  CENTER_SURVEY
  SESSION_EVAL // FL W0 (FL4-01) — phiếu đánh giá buổi học (GV đánh giá HS theo buổi); cũng dùng cho lớp trải nghiệm
}

enum EvalFormStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EvalQuestionType {
  STAR_RATING
  RADIO
  CHECKBOX
  TEXTBOX
  PHOTO // FL4 (R5) — ô tải ảnh (ảnh dự án/lớp trong phiếu đánh giá buổi); urls lưu EvalAnswer.valueOptions
}

enum EvaluationRoundStatus {
  DRAFT
  OPEN
  CLOSED
}

model EvalForm {
  id          String         @id @default(cuid())
  title       String
  scope       EvalScope
  status      EvalFormStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  questions EvalQuestion[]
  rounds    EvaluationRound[]

  @@index([scope, status])
}

model EvalQuestion {
  id              String           @id @default(cuid())
  formId          String
  form            EvalForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  type            EvalQuestionType
  label           String
  options         Json? // cho RADIO/CHECKBOX (mỗi option có thể là mức mô tả dài — phiếu đánh giá buổi)
  required        Boolean          @default(false)
  order           Int              @default(0)
  // FL4 (R5) — nhóm tiêu chí (header: "Kiến thức"/"Kỹ năng"/"Sản phẩm"/"Thái độ") để gom câu hỏi như phiếu mẫu.
  groupLabel      String?
  // FL4 (R6) — cho phép GV nhập tự do kèm lựa chọn (RADIO/CHECKBOX) → lưu EvalAnswer.valueText.
  allowCustomText Boolean          @default(false)

  @@index([formId])
}

model EvaluationRound {
  id        String    @id @default(cuid())
  formId    String
  form      EvalForm  @relation(fields: [formId], references: [id], onDelete: Restrict)
  scope     EvalScope
  name      String
  centerId  String?
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  courseId  String?
  opensAt   DateTime?
  closesAt  DateTime?
  status    EvaluationRoundStatus @default(DRAFT)
  createdAt DateTime              @default(now())

  responses EvalResponse[]

  @@index([scope, status])
  @@index([centerId])
  @@index([orgUnitId])
}

model EvalResponse {
  id                  String          @id @default(cuid())
  roundId             String
  round               EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  enrollmentId        String?
  teacherId           String? // GV được đánh giá (TEACHER_EVAL)
  parentUserId        String? // PH làm khảo sát (CENTER_SURVEY)
  studentId           String?
  classSessionId      String? // FL W0 (FL4-01) — phiếu SESSION_EVAL gắn buổi học (ref phẳng, theo style EvalResponse)
  trialClassSessionId String? // FL4 (R4) — phiếu SESSION_EVAL gắn buổi LỚP TRẢI NGHIỆM (TrialClassSession, ref phẳng)
  submittedAt         DateTime        @default(now())

  answers EvalAnswer[]

  // Chống trùng: TEACHER_EVAL theo (đợt×enrollment×GV); CENTER_SURVEY theo (đợt×PH).
  // SESSION_EVAL (đợt×buổi×HS): EVAL-A chốt chiến lược chống trùng (app-level idempotency hoặc unique riêng).
  @@unique([roundId, enrollmentId, teacherId])
  @@unique([roundId, parentUserId])
  @@index([roundId])
  @@index([classSessionId])
  @@index([trialClassSessionId])
}

model EvalAnswer {
  id           String       @id @default(cuid())
  responseId   String
  response     EvalResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId   String // ref phẳng tới EvalQuestion
  valueNumber  Int? // STAR_RATING
  valueOptions Json? // RADIO/CHECKBOX
  valueText    String?      @db.Text

  @@index([responseId])
}

// NOTE(reconcile FixLMS→main): messaging FixLMS (MessageThread/Message, LMS-15) đã GỠ
// — D6 theo MAIN dùng ConversationMessage (per-enrollmentId). RevenueTarget bản FixLMS
// (`amount`, LMS-16) đã GỠ — giữ bản MAIN (`targetAmount`) ở trên.

// ============================================================================
// === CHAT REALTIME (Đợt 0) ===
// Schema theo BA-chat-realtime-satarobo.md mục 4 + delta 00-dieu-chinh-cho-repo.md.
// KHÁC hệ cũ ConversationMessage (per-enrollment) — hệ mới thay thế ở Đợt 1 (Q3).
// userId/senderId là String trần (User.id cuid) — BA cố ý KHÔNG relation sang User.
// Quyền đọc/gửi là participant-based; Conversation.centerId chỉ phục vụ truy vấn
// quản trị (SCOPE_EXEMPT — DM có centerId=null, xem delta mục E.3).
// ============================================================================

enum ConversationType {
  CLASS_GROUP
  DM_TEACHER_PARENT
  DM_SALE_PARENT
  DM_STAFF // reserve cho cây B, chưa dùng ở P0
}

enum ConversationSubjectType {
  CLASS
  NONE
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

enum ParticipantRole {
  OWNER
  MODERATOR
  MEMBER
  OBSERVER
}

enum ParticipantSource {
  DERIVED
  MANUAL
}

enum DerivedFrom {
  CLASS_TEACHER
  CLASS_STUDENT_PARENT
  CENTER_MANAGER
}

enum MessageKind {
  CHAT
  ANNOUNCEMENT
  SYSTEM
}

model Conversation {
  id     String             @id @default(uuid())
  type   ConversationType
  status ConversationStatus @default(ACTIVE)

  // Phạm vi tổ chức — phục vụ quyền quản trị, KHÔNG dùng để suy ra thành viên
  centerId  String?
  orgUnitId String?

  // Đa hình
  subjectType ConversationSubjectType @default(NONE)
  subjectId   String?

  // Khoá duy nhất cho hội thoại 1-1: sort 2 userId rồi nối — chống tạo trùng (BR-06)
  dmKey String? @unique

  title         String?
  lastMessageAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  archivedAt    DateTime?

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([type, subjectType, subjectId])
  @@index([centerId, status, lastMessageAt])
}

model ConversationParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String // User.id (cuid) — không relation, BA cố ý

  role        ParticipantRole   @default(MEMBER)
  source      ParticipantSource @default(DERIVED)
  derivedFrom DerivedFrom?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  lastReadMessageId String?
  lastReadAt        DateTime?
  unreadCount       Int       @default(0)
  muted             Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId, leftAt]) // truy vấn "danh sách hội thoại của tôi"
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String? // null khi kind = SYSTEM
  kind           MessageKind @default(CHAT)

  body      String  @db.Text
  replyToId String? // một cấp, không lồng nhau

  // Idempotency gửi lại (US-06 AC4/TS-10.4) — client sinh, SYSTEM message không có
  clientMsgId String?

  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedById   String?
  deletedReason String?

  conversation Conversation        @relation(fields: [conversationId], references: [id])
  attachments  MessageAttachment[]

  @@unique([conversationId, senderId, clientMsgId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, kind, createdAt(sort: Desc)]) // lọc ANNOUNCEMENT
}

model MessageAttachment {
  id          String  @id @default(uuid())
  messageId   String
  storagePath String // R2 private, prefix `chat-attachments/` + signed URL (delta Q2)
  fileName    String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  message     Message @relation(fields: [messageId], references: [id])
}

// Chỉ dùng cho ANNOUNCEMENT — GV cần biết PH nào đã đọc thông báo lịch học
// Phụ huynh ĐÃ ĐỌC một mục trên bảng tin portal.
//
// `itemId` là id của MỤC BẢNG TIN, không phải khoá ngoại tới `Notification`:
// bảng tin portal v2 (`lib/portal/notification-feed.ts` — bản PROD đang chạy) tổng hợp
// 7 nhóm, phần lớn KHÔNG phải dòng `Notification` (nhận xét buổi, học bù, học phí,
// học bạ, khảo sát) và mang id tổng hợp dạng `nt-<id>` / `mk-need-<id>`. Khoá theo
// item mới phủ được cả bảng tin; khoá theo `Notification.id` chỉ vá được một nhóm.
//
// Cùng hình dạng với `AnnouncementRead` ngay dưới (khoá kép, không FK) — bảng đọc thì
// không cần cascade, và giữ hai bảng giống nhau để ai đọc một cái là hiểu cái kia.
model PortalFeedRead {
  itemId String
  userId String
  readAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([itemId, userId])
  @@index([userId])
}

model AnnouncementRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  @@id([messageId, userId])
}

// ── US-04: job đối soát thành viên hằng đêm (cron chat-membership-reconcile) ──
// Log kỹ thuật của lưới cuối chống drift: REMOVE tự thi hành (leftAt), ADD chỉ log.
// Chỉ SUPER_ADMIN xem qua /admin/hoi-thoai/doi-soat (gate chat:admin) — SCOPE_EXEMPT
// trong lib/db-scope.ts. centerId + orgUnitId ghi kép theo luật Nền Hệ thống #3.

enum MembershipDriftType {
  REMOVE // phải rời mà chưa — job TỰ set leftAt (autoEnforced=true)
  ADD // phải có mà thiếu — job CHỈ log, chờ người xử lý (pre-mortem T5)
}

model ConversationMembershipDrift {
  id             String              @id @default(uuid())
  conversationId String
  classId        String
  userId         String // User.id (cuid) — không relation, đồng bộ với ConversationParticipant
  driftType      MembershipDriftType
  detail         String // luồng nghi vấn / ngữ cảnh (derivedFrom, lý do nghi)
  autoEnforced   Boolean             @default(false)
  centerId       String?
  orgUnitId      String?
  createdAt      DateTime            @default(now())

  @@index([createdAt])
  @@index([classId, createdAt])
}

// Mỗi lần cron chạy = 1 record — phân biệt "đêm sạch" (removeCount=addCount=0)
// với "job không chạy" (không có record) — US-04 AC4 / cron.md mục 4.
model ConversationReconcileRun {
  id                   String   @id @default(uuid())
  ranAt                DateTime @default(now())
  classesChecked       Int
  removeCount          Int
  addCount             Int
  durationMs           Int
  /// Lớp ACTIVE CHƯA có nhóm chat tại thời điểm chạy — job KHÔNG tự tạo (luật "job không
  /// tự thêm người/nhóm"), chỉ báo động. >0 = có lớp lọt lưới BR-01 (vd lớp đã ACTIVE từ
  /// trước khi module chat ra đời) ⇒ chạy scripts/backfill-nhom-lop-chat.ts.
  /// Default 0 để dòng cũ (trước 09/08/2026) đọc được, KHÔNG phải "0 lớp thiếu" đã đo.
  missingConversations Int      @default(0)
}

// ── US-14: sổ gửi ZNS "có tin nhắn mới" (cron chat-zns-notify) ───────────────
// Bảng này là CHỐT CHỐNG TRÙNG, không phải log cho vui: mỗi tin 400đ và ZNS không
// thu hồi được. Hai lượt cron chồng nhau (Vercel retry, GitHub pump trên test) phải
// va vào UNIQUE `(conversationId, userId, messageId)` chứ không được gửi đôi.
// Quy trình: GIÀNH CHỖ trước (status PENDING) → gửi → cập nhật kết quả. Giành chỗ
// trước nên nếu tiến trình chết giữa chừng thì lượt sau KHÔNG gửi lại (fail-safe
// nghiêng về "thiếu một lời nhắc" thay vì "trừ tiền hai lần").

enum ChatZnsStatus {
  PENDING // đã giành chỗ, chưa biết kết quả (tiến trình chết giữa chừng thì dừng ở đây)
  SENT // Zalo nhận thật
  SIMULATED // provider mô phỏng (ZALO_LIVE tắt) — PHỤ HUYNH KHÔNG NHẬN GÌ
  SKIPPED // thiếu điều kiện gửi (không có SĐT / chưa cấu hình credential)
  FAILED // Zalo từ chối
}

model ChatZnsNotification {
  id             String        @id @default(uuid())
  conversationId String
  /// Phụ huynh nhận tin (User.id cuid) — không relation, đồng bộ ConversationParticipant.
  userId         String
  /// Tin "mốc": tin CŨ NHẤT chưa đọc đã quá ngưỡng (lib/chat/zns-notify-rules.ts).
  /// Tất định giữa các lượt quét — nhờ vậy UNIQUE bên dưới mới chặn được trùng.
  messageId      String
  messageKind    MessageKind
  status         ChatZnsStatus @default(PENDING)
  /// ZaloMessageLog.id — đường duy nhất truy ngược "tin này gửi cho ai, vì việc gì"
  /// (ZaloMessageLog không có cột userId/entityId).
  znsLogId       String?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  sentAt         DateTime?

  @@unique([conversationId, userId, messageId])
  /// Trần chống bão: "phụ huynh này đã được nhắc ở hội thoại này trong X phút qua chưa".
  @@index([conversationId, userId, createdAt])
  @@index([status, createdAt])
}

// ── US-16: mốc ĐỒNG Ý chính sách sử dụng chat (onboarding PH) ────────────────
// Cổng chặn Ở SERVER: chưa có dòng nào ở version hiện hành thì `/portal/tin-nhan/**`
// KHÔNG trả một chữ nội dung nào (layout + từng page tự kiểm — lib/chat/policy.ts).
//
// Vì sao BẢNG MỚI chứ không tái dùng `StudentConsent`: consent kia gắn theo `studentId`
// và enum `ConsentType` chỉ có `CLASS_MEDIA`; còn "đồng ý điều khoản chat" là hành vi của
// NGƯỜI DÙNG (1 PH nhiều con vẫn bấm một lần) — nhét vào đó là sai chủ thể + phải đụng
// enum đang chạy prod.
//
// Vì sao có cột `version`: đổi nội dung chính sách thì tăng CHAT_POLICY_VERSION là mọi PH
// phải đồng ý lại — bản ghi CŨ giữ nguyên (bằng chứng "lúc đó họ đồng ý với bản nào").
// UNIQUE (userId, version) làm luôn nhiệm vụ chống ghi đôi khi bấm 2 lần / 2 tab.
model ChatPolicyAcceptance {
  id         String   @id @default(uuid())
  /// User.id (cuid) — không relation, đồng bộ với ConversationParticipant/Message.
  userId     String
  /// CHAT_POLICY_VERSION tại thời điểm bấm đồng ý (lib/chat/policy.ts).
  version    String
  acceptedAt DateTime @default(now())

  @@unique([userId, version])
  /// Dashboard pilot đếm "đã đồng ý trong khoảng" — theo version của bản đang phát hành.
  @@index([version, acceptedAt])
}

/// [Hồ sơ Bộ Công Thương · mục 4] Sổ ĐỒNG Ý CHÍNH SÁCH WEBSITE của phụ huynh.
///
/// Đặt ngay cạnh `ChatPolicyAcceptance` có chủ đích: hai sổ đồng ý cùng một hình dạng,
/// người đi tìm "repo ghi consent ở đâu" thấy cả hai trong một màn hình.
///
/// Append-only — KHÔNG bao giờ UPDATE hay DELETE một dòng. Mỗi dòng là bằng chứng
/// "người này, lúc nào, đồng ý với BẢN NÀO". Nâng version ⇒ phụ huynh phải tích lại,
/// dòng cũ giữ nguyên.
model SitePolicyAcceptance {
  id String @id @default(uuid())

  /// User.id (cuid) — KHÔNG relation: FK kèm cascade sẽ xoá bằng chứng cùng tài khoản.
  userId String

  /// SITE_POLICY_KEY (lib/legal/site-policy-content.ts). Có cột này để sau còn thêm ô
  /// tích cho một chính sách thứ hai mà không phải đụng bảng đang có dữ liệu prod.
  policyKey String

  /// SITE_POLICY_VERSION tại thời điểm bấm đồng ý, dạng ngày phát hành "2026-09-21".
  version String

  acceptedAt DateTime @default(now())

  /// Bằng chứng phụ, nullable: đường gọi ngoài request vẫn ghi được.
  ip        String?
  userAgent String?

  @@unique([userId, policyKey, version])
  /// Báo cáo "bao nhiêu phụ huynh đã đồng ý bản đang phát hành".
  @@index([policyKey, version, acceptedAt])
}

// [Nền Hệ thống P1 · US-07 AC3] Nhật ký đối soát đêm centerId ↔ orgUnitId.
//
// Có bảng RUN riêng vì nếu chỉ ghi bảng LỆCH thì "đêm sạch" và "job không chạy" trông
// giống hệt nhau. Đây đúng là cách cron chat đã phải làm (ConversationReconcileRun), và
// đúng cái đã xảy ra khi 20 cron prod chết vì canonical 308 mà không ai thấy.
model OrgUnitDriftRun {
  id            String             @id @default(cuid())
  ranAt         DateTime           @default(now()) @db.Timestamptz(6)
  tablesChecked Int                @default(0)
  driftCount    Int                @default(0)
  totalRows     BigInt             @default(0)
  durationMs    Int                @default(0)
  note          String?
  items         OrgUnitDriftItem[]

  @@index([ranAt])
}

model OrgUnitDriftItem {
  id             String          @id @default(cuid())
  runId          String
  run            OrgUnitDriftRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  model          String
  /// BAT_BUOC | NULL_TOAN_HE_THONG | NULL_CHUA_KHOP — xem lib/org/center-bridge.ts
  nullMeaning    String
  /// MẪU SỐ bắt buộc: prod đã dọn sạch dữ liệu 01/08 nên "0 lệch" rất dễ là XANH GIẢ.
  totalRows      BigInt          @default(0)
  withCenter     BigInt          @default(0)
  withOrgUnit    BigInt          @default(0)
  missingOrgUnit BigInt          @default(0)
  mismatched     BigInt          @default(0)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)

  @@index([runId])
  @@index([model])
}

// ═══════════════════════════════════════════════════════════════════════════
// EL-03 — LÕI ĐÀO TẠO NỘI BỘ (`Trn*`)
//
// QĐ-1: mọi bảng của module mang tiền tố `Trn` — quy ước PHÒNG NGỪA, không phải
// sửa lỗi. Bằng chứng va chạm là thật: `Course.isPublished @default(true)` và
// `/khoa-hoc` lọc đúng cờ đó ⇒ một `Course` tạo nhầm sẽ hiện trên trang bán hàng
// công khai cho phụ huynh. `TrnCourse` là bảng KHÁC, không dùng lại `Course`.
//
// QĐ-2: người học là `User` nhân sự, KHÔNG phải `Student`. Vì thế không tái dùng
// bảng khảo thí cũ — `ExamAttempt.studentId` là FK BẮT BUỘC tới `Student`.
//
// Nguồn đặc tả: §3.3 "Mô hình dữ liệu" của kế hoạch (bản chi tiết), KHÔNG phải
// khối tóm tắt trong ticket EL-03 — hai mục mâu thuẫn nhau về `TrnProgram.status`
// (7 giá trị vs 3) và tên cột (`orderIndex` vs `order`, `contentMd` vs `bodyMd`);
// chủ dự án chốt lấy §3.3 ngày 21/08/2026.
//
// ⚠️ Đổi giá trị enum về sau là `ALTER TYPE` — KHÔNG thuộc nhóm chỉ-ADD an toàn
// và vướng luật cứng #4 khi bảng đã có dữ liệu prod. Mọi enum dưới đây khai ĐỦ
// giá trị ngay từ GĐ1, kể cả giá trị chưa dùng tới.
// ═══════════════════════════════════════════════════════════════════════════

/// Vòng đời chương trình đào tạo. 7 giá trị — 3 giá trị (DRAFT/ACTIVE/ARCHIVED)
/// KHÔNG biểu diễn được bước duyệt mà §8.3 đòi.
enum TrnProgramStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RUNNING
  DONE
  EVALUATED
  CANCELLED
}

/// Thẻ (b) — chức năng. Sinh phần `[CN]` của mã `SR.DT.[CN].[NĂM].[STT]`.
enum TrnFunctionTag {
  SALE
  TEACHING
  MARKETING
  HR
  ACCOUNTING
  OPERATION
  COMPANY_WIDE
}

/// Thẻ (a) — bậc công việc. BỎ L5 (C6): §8.3 định nghĩa L5 = "<60 ngày, CTV,
/// thực tập" nhưng đó là GIAI ĐOẠN, không phải bậc ⇒ tách sang `TrnStageTag`.
enum TrnLevelTag {
  L1
  L2
  L3
  L4
}

/// Thẻ (a, tách ra) — giai đoạn, độc lập với bậc công việc.
enum TrnStageTag {
  NEW_HIRE
  IN_SERVICE
}

/// Thẻ (c) — thời lượng: ngắn / trung bình / dài.
enum TrnDurationTag {
  S
  M
  LG
}

/// Thẻ (d) — tính chất. `MANDATORY_COMPLIANCE` buộc phải có `validityMonths`.
enum TrnNatureTag {
  MANDATORY
  MANDATORY_COMPLIANCE
  RECOMMENDED
  OPTIONAL
}

/// Thẻ (e) — hình thức tổ chức.
enum TrnFormatTag {
  ELEARNING
  OFFLINE
  BLENDED
  OJT
  COACHING
  WEBINAR
}

/// Thẻ (f) — mức bảo mật (C7). KHÔNG phải nhãn trang trí: `RESTRICTED` trở lên ⇒
/// bật hình mờ động, cấm tải tệp đính kèm, và BẮT BUỘC `visibility=ASSIGNED_ONLY`.
enum TrnSecurityTag {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

enum TrnCourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Ai THẤY được khoá. Mặc định `ASSIGNED_ONLY` là fail-closed: khoá mới tạo
/// không tự xuất hiện với ai. Tách khỏi `selfEnrollEnabled` vì có ca thật
/// "thấy được nhưng phải chờ giao".
enum TrnCourseVisibility {
  ASSIGNED_ONLY
  SELF_ENROLL
  RULE_BASED
}

/// Vòng đời một phiên bản khoá — 5 giá trị (§3.3), có bước rà soát và duyệt.
enum TrnVersionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// 6 loại bài, khai đủ ở GĐ1. `SCORM` bị validator khoá cho tới GĐ4 — khai cột
/// trước vì thêm cột vào bảng đã có dữ liệu prod vướng luật cứng #4.
enum TrnLessonKind {
  READ
  VIDEO
  SCORM
  QUIZ
  TASK
  LIVE_SESSION
}

/// Phạm vi áp dụng của một yêu cầu đào tạo — ĐÚNG 5 giá trị (HỢP ĐỒNG V2 §Z3).
/// ⚠️ `POSITION` dùng được về mã nhưng PROD có 0 dòng `Position` (đo 20/08/2026)
/// ⇒ ở GĐ1 một yêu cầu `POSITION` áp cho 0 người. Màn tạo phải vô hiệu hoá lựa
/// chọn này kèm dòng giải thích, KHÔNG hiện một ô chọn rỗng.
enum TrnReqScope {
  POSITION
  DEPARTMENT
  LEVEL_TAG
  ORG_UNIT
  ALL_STAFF
}

/// Vòng đời một yêu cầu đào tạo.
enum TrnReqStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// 4 mức đánh giá Kirkpatrick.
enum TrnEvalLevel {
  L1
  L2
  L3
  L4
}

/// Nguồn sinh ra một lượt ghi danh — ĐÚNG 4 giá trị (§5.0.4). Khai đủ 4 ngay từ
/// đầu vì thêm giá trị vào enum Postgres sau này là `ALTER TYPE`.
/// `EQUIVALENCE` = công nhận tương đương; nó KHÔNG phải trạng thái thứ 7 của
/// `TrnEnrollmentStatus` — nhãn hiển thị suy từ chính cột `source` này.
enum TrnEnrollSource {
  ASSIGNMENT
  REQUIREMENT
  EQUIVALENCE
  SELF_ENROLL
}

/// ĐÚNG 6 giá trị. KHÔNG có `ASSIGNED`, KHÔNG có `COMPLETED_VERIFIED` — thêm giá
/// trị thứ 7 làm vỡ mọi chỉ số đếm theo `status` (HỢP ĐỒNG V2 §Z9).
/// Bảng `TrnEnrollment` thuộc EL-05; enum khai ở migration này.
enum TrnEnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  COMPLETED_LATE
  OVERDUE
  REVOKED
}

/// Mức gắn đánh giá (QĐ-CDA-06b). Không có dòng cấu hình ⇒ hiểu là `REPORT_ONLY`
/// (fail-closed): giai đoạn đầu chỉ báo cáo, chưa gắn gì vào xét lương.
enum TrnEvalLinkMode {
  REPORT_ONLY
  LINKED
}

/// Tiêu chí được phép gắn vào đánh giá — đúng hai lựa chọn quyết định nêu.
enum TrnEvalCriterion {
  ON_TIME
  EXAM_SCORE
}

// ─── 9 BẢNG LÕI ────────────────────────────────────────────────────────────

/// Chương trình đào tạo (B3, §8.3) + kế hoạch gộp thẳng vào form (B2).
///
/// centerId/orgUnitId NULL = ÁP TOÀN CÔNG TY (không phải "chưa gán") ⇒ model này
/// phải nằm trong NULL_IS_GLOBAL_MODELS, nếu không thì chương trình dùng chung
/// toàn hệ TÀNG HÌNH với người cấp cơ sở.
model TrnProgram {
  id    String @id @default(cuid())
  /// SR.DT.[CN].[NĂM].[STT] — ĐÃ BỎ đoạn [CB] (C6).
  code  String @unique
  year  Int
  seq   Int
  title String

  /// 3–5 mục tiêu hành vi (§8.2).
  objectivesJson Json?

  // ── 6 nhóm thẻ phân loại (bảng thẻ ở EL-08) ──
  primaryFunctionTag TrnFunctionTag
  functionTags       TrnFunctionTag[]
  levelTags          TrnLevelTag[]
  stageTag           TrnStageTag
  durationTag        TrnDurationTag
  natureTag          TrnNatureTag
  formatTag          TrnFormatTag
  /// Nhóm thẻ thứ SÁU (C7) — mức bảo mật MẶC ĐỊNH cho các khoá thuộc chương trình.
  /// Giá trị HIỆU DỤNG nằm ở TrnCourse.securityLevel (kế thừa lúc tạo, sửa được).
  securityTag        TrnSecurityTag   @default(INTERNAL)

  // ── Văn bản nguồn (C15b/C20) — bắt buộc để XUẤT BẢN, không bắt buộc để lưu nháp ──
  sourceDocCode        String?
  sourceDocVersion     String?
  sourceDocEffectiveAt DateTime? @db.Timestamptz(6)
  /// Văn bản nguồn lên phiên bản mới → khoá tự chuyển "Cần rà lại".
  needsReview          Boolean   @default(false)

  /// Bắt buộc khi natureTag = MANDATORY_COMPLIANCE (§13.4). CHỈ là giá trị MẶC
  /// ĐỊNH khi tạo TrnRequirement. Nguồn sự thật của chu kỳ tái chứng nhận là
  /// TrnRequirement.validityMonths — không chỉ số nào đọc trực tiếp cột này.
  validityMonths Int?
  /// (C15c) nội dung có ngày chết định trước — hết hạn thì lưu trữ, KHÔNG dùng
  /// làm bằng chứng tuân thủ nội bộ.
  expiresAt      DateTime? @db.Timestamptz(6)

  /// FK bật ở EL-08 khi TrnTrainingNeed có mặt.
  needId           String?
  /// Đường thoát duy nhất của §8.1 — không có phiếu thì phải có lý do; không
  /// được để trống CẢ HAI (kiểm ở Zod, DB không ép được).
  needExemptReason String?

  /// (C19) ngân sách dự kiến. KHÔNG bao gồm giờ công người học — và từ QĐ-CDA-05
  /// (giờ học TỰ CHỌN, không tính công) dòng đó bằng 0đ, không phải "chưa định lượng".
  budgetPlanned Decimal? @db.Decimal(14, 2)

  status TrnProgramStatus @default(DRAFT)

  ownerUserId        String
  /// Người chịu trách nhiệm NỘI DUNG có tên — bắt buộc để xuất bản.
  contentOwnerUserId String?

  centerId  String?
  orgUnitId String?

  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  need           TrnTrainingNeed?      @relation(fields: [needId], references: [id], onDelete: SetNull)
  courses        TrnCourse[]
  evaluationRows TrnEvaluationResult[]
  evalLinkConfig TrnEvalLinkConfig?

  /// Chống hai người sinh trùng STT trong cùng chức năng + năm.
  @@unique([primaryFunctionTag, year, seq])
  @@index([status, year])
  @@index([orgUnitId])
  @@index([centerId])
  @@index([needsReview])
}

/// Khoá học nội bộ. KHÔNG dùng lại Course (bảng bán hàng công khai) — Course
/// isPublished mặc định true và /khoa-hoc lọc đúng cờ đó, nên một bản ghi tạo
/// nhầm ở đó sẽ hiện trên trang bán hàng cho phụ huynh.
///
/// centerId/orgUnitId NULL = áp toàn công ty ⇒ NULL_IS_GLOBAL_MODELS.
model TrnCourse {
  id        String  @id @default(cuid())
  programId String?
  code      String  @unique
  slug      String  @unique
  title     String
  summary   String?

  estimatedMinutes Int?
  sequential       Boolean @default(false)

  status      TrnCourseStatus @default(DRAFT)
  publishedAt DateTime?       @db.Timestamptz(6)

  /// Mức bảo mật HIỆU DỤNG. Mặc định kế thừa TrnProgram.securityTag lúc tạo nhưng
  /// sửa được: hành vi thật (hình mờ, cấm tải, ẩn câu hỏi) áp ở cấp KHOÁ vì đó là
  /// thứ người học mở ra.
  /// RESTRICTED trở lên ⇒ visibility BẮT BUỘC ASSIGNED_ONLY (chặn ở Zod).
  securityLevel TrnSecurityTag @default(INTERNAL)

  /// Ai THẤY khoá này. Fail-closed: khoá mới tạo không tự hiện với ai.
  visibility        TrnCourseVisibility @default(ASSIGNED_ONLY)
  /// Cho phép tự bấm vào học. Tách khỏi visibility vì có ca thật "thấy được
  /// nhưng phải chờ giao".
  selfEnrollEnabled Boolean             @default(false)
  /// Dùng CHUNG schema Zod và CHUNG hàm thuần ruleToWhere() với
  /// TrnAssignmentRule.filterJson (EL-05). Tuyệt đối KHÔNG viết bộ dịch thứ hai:
  /// hai bộ dịch lệch nhau là loại lỗi không ai phát hiện được bằng mắt.
  catalogRuleJson   Json?

  /// Nhân bản khoá (QĐ-CDA-07 mục 2) — không có cột này thì bản sao mất dấu vết
  /// nguồn và không ai trả lời được "khoá này chép từ đâu, bản gốc sửa gì sau đó".
  clonedFromCourseId String?

  ownerUserId String?
  centerId    String?
  orgUnitId   String?

  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  program      TrnProgram?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  modules      TrnModule[]
  versions     TrnCourseVersion[]
  requirements TrnRequirement[]

  @@index([status, orgUnitId])
  @@index([orgUnitId])
  @@index([centerId])
  @@index([visibility, status])
  @@index([programId])
}

/// Ảnh chụp một phiên bản khoá. BR-013 "giao lại phần chênh lệch" tính được nhờ
/// ảnh chụp danh sách bài (TrnCourseVersionLesson), không nhờ có cột version.
model TrnCourseVersion {
  id       String @id @default(cuid())
  courseId String
  major    Int
  minor    Int

  clonedFromVersionId String?

  status            TrnVersionStatus @default(DRAFT)
  changeNote        String?
  approvedByUserId  String?
  publishedByUserId String?
  publishedAt       DateTime?        @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)

  course  TrnCourse                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons TrnCourseVersionLesson[]

  @@unique([courseId, major, minor])
  @@index([courseId, status])
  /// Nguồn của chỉ số "số khoá được xuất bản mỗi tháng" — chỉ số theo dõi rủi ro
  /// "danh mục trống sau ngày mở". Không có index thì báo cáo quét toàn bảng.
  @@index([status, publishedAt])
}

/// Ảnh chụp danh sách bài của MỘT phiên bản. contentHash là thứ cho phép
/// diff(v1, v2) phát hiện bài đã đổi nội dung mà vẫn giữ nguyên id.
model TrnCourseVersionLesson {
  id          String  @id @default(cuid())
  versionId   String
  lessonId    String
  orderIndex  Int
  required    Boolean @default(true)
  contentHash String

  version TrnCourseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lesson  TrnLesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([versionId, lessonId])
  @@index([lessonId])
}

/// Chương trong một khoá.
///
/// Bẫy kỹ thuật của kéo-thả sắp thứ tự: @@unique([courseId, orderIndex]) là ràng
/// buộc KIỂM NGAY trong Postgres (không DEFERRABLE), nên đổi chỗ hai chương bằng
/// hai lệnh UPDATE liên tiếp sẽ vi phạm khoá ở lệnh ĐẦU TIÊN. Đường đúng: một
/// transaction, đánh số lại toàn bộ qua khoảng lệch tạm (orderIndex += 10000) rồi
/// mới gán số cuối. Lỗi này lộ ra ở lần kéo thả THỨ HAI, không phải lần đầu.
model TrnModule {
  id         String   @id @default(cuid())
  courseId   String
  title      String
  orderIndex Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  course  TrnCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons TrnLesson[]

  @@unique([courseId, orderIndex])
}

/// Bài học. Bảng CON của TrnModule ⇒ KHÔNG mang cột đơn vị (scope theo khoá).
model TrnLesson {
  id         String        @id @default(cuid())
  moduleId   String
  title      String
  orderIndex Int
  kind       TrnLessonKind

  /// kind=READ
  contentMd       String? @db.Text
  /// QĐ-9 lát cắt 1 — trỏ 50 bài hướng dẫn đã số hoá, là nội dung MỒI có sẵn ngay
  /// ngày mở (biện pháp chặn rủi ro "danh mục trống sau ngày mở").
  sourceGuideSlug String?
  /// Sàn thời gian đọc để tính là đã đọc — bài dưới 60 từ vẫn phải đủ 30 giây.
  minReadSeconds  Int     @default(30)

  // ── kind=VIDEO ──
  /// Chuẩn nộp QĐ-3: H.264 720p, ≤200MB, ≤15 phút — kiểm LÚC TẢI LÊN, thay cho
  /// "chờ transcode" của BR-016. lib/storage/upload-config.ts đang cho 500MB ⇒
  /// đường này phải khai preset riêng chặt hơn.
  videoKey     String?
  /// (C11) mặc định 360p cho kết nối di động.
  videoKey360  String?
  durationSec  Int?
  videoMeta    Json?
  /// (C10) phụ đề tiếng Việt là ĐIỀU KIỆN XUẤT BẢN cho mọi bài VIDEO của khoá
  /// MANDATORY* — không phải "tuỳ chọn của người tải lên".
  captionKey   String?
  /// (C10/C11) cho người khiếm thính, người học ở trung tâm ồn, người mạng yếu.
  transcriptMd String? @db.Text
  audioKey     String?
  /// Số câu hỏi chèn giữa video, suy từ TrnLessonCue — giữ dạng cột đếm để danh
  /// sách bài không phải join.
  cueCount     Int     @default(0)

  /// kind=SCORM — khai cột từ GĐ1, KHOÁ bằng validator tới GĐ4.
  scormPackageId String?
  /// kind=QUIZ → TrnExam (EL-14). Cột trần tới khi bảng đó có mặt.
  examId         String?
  /// kind=TASK → TrnRubric (EL-15). Cột trần tới khi bảng đó có mặt.
  rubricId       String?
  /// kind=LIVE_SESSION
  sessionDate    DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  module         TrnModule                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scormPackage   ScormPackage?            @relation("TrnLessonScorm", fields: [scormPackageId], references: [id], onDelete: SetNull)
  versionLessons TrnCourseVersionLesson[]
  cues           TrnLessonCue[]
  videoSessions  TrnVideoSession[]

  /// EL-04 — tiến độ của mọi lượt học trên bài này.
  progress   TrnLessonProgress[]
  watchFlags TrnWatchFlag[]

  @@unique([moduleId, orderIndex])
  @@index([kind])
  @@index([scormPackageId])
}

/// Yêu cầu đào tạo — "ai BẮT BUỘC phải học khoá này".
///
/// orgUnitId mang HAI vai: cột đơn vị của bản ghi, VÀ cột đích khi
/// scopeKind='ORG_UNIT' (§3.3 chốt: không đẻ cột thứ hai).
/// centerId/orgUnitId NULL = áp toàn công ty ⇒ NULL_IS_GLOBAL_MODELS.
model TrnRequirement {
  id        String      @id @default(cuid())
  courseId  String
  scopeKind TrnReqScope

  // 4 cột đích, KHÔNG có scopeId chung: một cột chuỗi trần không có toàn vẹn
  // tham chiếu và sẽ mục IM LẶNG khi vị trí/phòng ban bị xoá.
  // ĐÚNG MỘT cột có giá trị theo scopeKind; ALL_STAFF ⇒ cả 4 NULL (kiểm ở Zod).
  positionId   String?
  departmentId String?
  levelTag     TrnLevelTag?

  /// Số ngày kể từ joinedAt hoặc ngày đổi vị trí.
  dueDays        Int
  /// Chu kỳ tái chứng nhận. NGUỒN SỰ THẬT DUY NHẤT của chu kỳ và của vế Dat(u,r,d)
  /// trong NSM. KHÔNG có cột graceDays.
  validityMonths Int?

  effectiveFrom   DateTime     @default(now()) @db.Timestamptz(6)
  effectiveTo     DateTime?    @db.Timestamptz(6)
  status          TrnReqStatus @default(ACTIVE)
  createdByUserId String?

  centerId  String?
  orgUnitId String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  course     TrnCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position   Position?      @relation("TrnRequirementPosition", fields: [positionId], references: [id], onDelete: SetNull)
  department DepartmentDef? @relation("TrnRequirementDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  orgUnit    OrgUnit?       @relation("TrnRequirementOrgUnit", fields: [orgUnitId], references: [id], onDelete: SetNull)

  /// Postgres coi hai NULL là KHÁC nhau nên khoá này KHÔNG chặn được trùng ở
  /// nhánh nullable — phải kiểm thêm ở service tạo mới.
  @@unique([courseId, scopeKind, positionId, departmentId, levelTag, orgUnitId])
  @@index([scopeKind])
  @@index([courseId])
  @@index([centerId])
  @@index([orgUnitId])
}

/// Bằng chứng "người này đã được thông báo phạm vi dữ liệu thu thập, vào ngày ấy".
///
/// KHÔNG BAO GIỜ update một dòng đã ghi: đổi phạm vi thu ⇒ TĂNG policyVersion ⇒
/// người dùng xác nhận lại. Sửa tại chỗ là làm hỏng chính chuỗi bằng chứng mà 8
/// cơ chế giám sát của GĐ2 dựa vào (QĐ-CDA-12).
/// Bảng CON theo người dùng ⇒ không mang cột đơn vị.
model TrnPolicyAcceptance {
  id            String    @id @default(cuid())
  userId        String
  policyKey     String
  policyVersion String
  acceptedAt    DateTime  @default(now()) @db.Timestamptz(6)
  /// Rút đồng ý: đÓNG dòng đang hiệu lực, KHÔNG xoá nó. Đây là đường `update` DUY NHẤT
  /// được phép trên bảng này; mọi đường update/delete khác đều bị cấm, vì dòng cũ là BẰNG
  /// CHỨNG BẤT BIẾN rằng người đó đã được thông báo phạm vi nào, vào ngày nào.
  /// Đóng xong: hệ thống ngừng thu nhịp xem NGAY, và nghĩa vụ học chuyển sang hình thức
  /// khác (điểm danh trực tiếp / xác nhận của quản lý) chứ KHÔNG tự huỷ.
  revokedAt     DateTime? @db.Timestamptz(6)

  user User @relation("TrnPolicyAcceptanceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyKey, policyVersion])
  @@index([policyKey, policyVersion])
}

/// Kết quả đánh giá 4 mức Kirkpatrick của một chương trình.
///
/// KHÁC 3 model trên: centerId/orgUnitId ở đây là BẮT BUỘC (nhóm BAT_BUOC), NULL
/// nghĩa là dữ liệu chưa backfill chứ KHÔNG phải "toàn công ty" ⇒ model này KHÔNG
/// vào NULL_IS_GLOBAL_MODELS.
model TrnEvaluationResult {
  id            String       @id @default(cuid())
  programId     String
  level         TrnEvalLevel
  subjectUserId String
  /// Khoá chống trùng theo nguồn: một phiếu khảo sát / một bài thi / một kỳ đánh giá.
  sourceRef     String
  score         Decimal?     @db.Decimal(6, 2)
  payloadJson   Json
  recordedAt    DateTime     @default(now()) @db.Timestamptz(6)

  centerId  String?
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  program TrnProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, level, subjectUserId, sourceRef])
  @@index([programId, level])
  @@index([centerId])
  @@index([orgUnitId])
}

// ─── 3 BẢNG KHAI RỖNG TỪ GĐ1 (migration ở đây; luồng ghi + màn hình ở ticket sau) ──

/// Câu hỏi chèn giữa video, gắn mốc giây (QĐ-CDA-04, model #37).
/// Migration ở EL-03; luồng chèn câu hỏi và màn hình ở EL-12.
///
/// Vì sao là BẢNG chứ không phải mảng Json trên TrnLesson: mảng Json mất khoá duy
/// nhất, mất FK, và không đếm được.
/// Bảng CON ⇒ không mang cột đơn vị.
model TrnLessonCue {
  id       String @id @default(cuid())
  lessonId String
  /// Mốc giây trong video. Zod ép 0 < atSec < TrnLesson.durationSec.
  atSec    Int

  /// FK nullable tới ngân hàng câu hỏi — tái dùng KHI nó tồn tại (GĐ3).
  questionId String?
  /// Câu hỏi khai tại chỗ, dùng ở GĐ2 khi ngân hàng câu hỏi chưa có.
  /// Bất biến (Zod): ĐÚNG MỘT trong questionId / inlineJson có giá trị. Đường GĐ2
  /// BẮT BUỘC là inlineJson — ai thiết kế màn soạn cue mà giả định đã có ngân
  /// hàng câu hỏi sẽ dựng một màn không dùng được trong 4 tuần đầu.
  inlineJson Json?

  /// true = không trả lời thì không phát tiếp.
  blocking   Boolean  @default(true)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  lesson TrnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// Hai cue trùng giây là lỗi soạn nội dung — chặn ở tầng DB.
  @@unique([lessonId, atSec])
  @@index([lessonId])
}

/// Cấu hình mức gắn đánh giá theo chương trình (QĐ-CDA-06b, model #38).
/// Migration ở EL-03; màn hình ở ticket cấu hình mức gắn đánh giá.
///
/// Đây là YÊU CẦU MỚI, không phải hằng số trong mã: chủ dự án chốt "giai đoạn đầu
/// chưa gắn gì, chỉ báo cáo; sau này admin sẽ setup mức đánh giá để xét lương".
/// Vế sau biến "gắn hay không" thành DỮ LIỆU CÓ MÀN HÌNH, để bật liên kết về sau
/// không cần lập trình viên.
/// centerId/orgUnitId NULL = áp toàn công ty ⇒ NULL_IS_GLOBAL_MODELS.
model TrnEvalLinkConfig {
  id        String @id @default(cuid())
  /// Một chương trình MỘT dòng.
  programId String @unique

  /// Không có dòng cấu hình ⇒ hiểu là REPORT_ONLY (fail-closed).
  mode            TrnEvalLinkMode    @default(REPORT_ONLY)
  criteria        TrnEvalCriterion[]
  /// Zod: tổng trọng số của các tiêu chí ĐÃ CHỌN = 100.
  weightOnTime    Int?
  weightExamScore Int?
  /// Kỳ đánh giá đầu tiên bị ảnh hưởng phải nằm SAU ngày này.
  effectiveFrom   DateTime?          @db.Timestamptz(6)

  // ĐƯỜNG PHÁP LÝ CỦA CHẾ TÀI — `mode = LINKED` chỉ lưu được khi ĐỦ SÁU thứ: ba cột dưới đây
  // + `effectiveFrom` + ≥1 tiêu chí + tổng trọng số = 100. Thiếu một là từ chối, nêu đúng ô thiếu.
  // Không có mấy cột này thì luật đó là CHỮ CHẾT: không chỗ nào lưu số hiệu quyết định, không
  // chỗ nào lưu ai duyệt — tức bật liên kết lương mà không có căn cứ nào truy được về sau.
  /// Số hiệu quyết định sửa SR.QD.231 cho phép gắn đánh giá vào lương.
  decisionDocCode        String?
  /// Ngày hiệu lực của quyết định đó. Zod: `effectiveFrom >= decisionDocEffectiveAt`.
  decisionDocEffectiveAt DateTime? @db.Timestamptz(6)
  /// Người của Nhân sự đã duyệt — có TÊN, không phải một cờ boolean.
  hrApprovedByUserId     String?
  /// Ai sửa lần cuối. Mọi lần đổi đi qua `defineAction` với `requireReason: true`.
  updatedByUserId        String?

  centerId  String?
  orgUnitId String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  program TrnProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([mode, effectiveFrom])
  @@index([centerId])
  @@index([orgUnitId])
}

/// Phiên xem video — TẦNG 2 (dữ liệu đo hành vi), thời hạn lưu 90 NGÀY.
///
/// Bảng này khai ở GĐ1 CHỈ VÌ cột purgeAfter phải có mặt ngay trong câu CREATE
/// TABLE (QĐ-CDA-14). Luồng ghi (heartbeat, bitmap, khoá phát Redis) và màn hình
/// vẫn ở EL-12.
///
/// purgeAfter = thời điểm bản ghi phiên sinh ra + 90 ngày, GHI CỨNG lúc INSERT,
/// KHÔNG tính lại ở các nhịp ghi sau. Hai lý do, cả hai đắt nếu làm ngược:
///   1. Đổi chính sách lưu trữ về sau KHÔNG được hồi tố lên dữ liệu đã thu dưới
///      bản thông báo cũ — cùng tinh thần TrnPolicyAcceptance không sửa tại chỗ.
///   2. Cron dọn quét bằng MỘT điều kiện purgeAfter < now() có index, không phải
///      bằng một phép tính trên từng dòng.
///
/// Bảng này phải nằm NGOÀI SOFT_DELETE_MODELS và NGOÀI DUAL_WRITE_MODELS. Vế đầu
/// là ĐIỀU KIỆN để cron dọn 90 ngày xoá CỨNG được: bảng có xoá mềm thì "xoá sau
/// 90 ngày" chỉ là đặt một cột deletedAt và dữ liệu thô VẪN NẰM NGUYÊN trong DB —
/// đúng thứ quyết định không cho phép.
///
/// KHÔNG mang cột đơn vị (ngoại lệ nhịp ghi cao N, §5.0.3).
model TrnVideoSession {
  id           String  @id @default(cuid())
  lessonId     String
  /// FK bật ở EL-05 khi TrnEnrollment có mặt — cột trần tới lúc đó.
  enrollmentId String?
  userId       String

  startedAt      DateTime @default(now()) @db.Timestamptz(6)
  lastBeatAt     DateTime @default(now()) @db.Timestamptz(6)
  totalWatchSec  Int      @default(0)
  maxPositionSec Int      @default(0)

  // TẦNG 2 — KHÔNG lưu IP thô. Băm + tiền tố là đủ để phát hiện bất thường mà
  // không giữ định danh mạng của nhân viên.
  ipHash        String?
  ipPrefix      String?
  deviceClass   String?
  browserFamily String?

  checkpointAnswered Int   @default(0)
  checkpointMissed   Int   @default(0)
  checkpointLogJson  Json?

  /// NOT NULL, ghi cứng lúc INSERT = mốc tạo + 90 ngày.
  purgeAfter DateTime @db.Timestamptz(6)

  lesson TrnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([purgeAfter])
  @@index([userId, lessonId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EL-05 PR0 — GIAO BÀI + GHI DANH: **CHỈ SCHEMA**, 0 giao diện, 0 bộ giải luật,
// 0 Server Action.
//
// Vì sao PR này tồn tại và vì sao nó chạy TRƯỚC EL-04: EL-04 (trang đọc + đo tiến
// độ) khoá route theo `enrollmentId`, chống IDOR bằng `TrnEnrollment`, và khoá ghi
// sau hạn bằng `TrnAssignment.allowLate` — nhưng kế hoạch xếp EL-04 TRƯỚC EL-05.
// Vòng phụ thuộc là thật.
//
// Cách né dễ dãi — để `TrnLessonProgress.enrollmentId` nullable — ĐÃ BỊ BÁC, và lý
// do là Postgres chứ không phải kỷ luật: `@@unique([enrollmentId, lessonId])` với
// `enrollmentId = NULL` KHÔNG chặn được trùng (`NULL != NULL`), nên một người sẽ
// đẻ nhiều dòng tiến độ cho cùng một bài, im lặng.
//
// ⚠️ Hai enum `TrnEnrollSource` và `TrnEnrollmentStatus` ĐÃ `CREATE TYPE` ở
// migration `el_add_trn_core` (EL-03). KHÔNG khai lại — `CREATE TYPE` lần hai là
// lỗi `type already exists`.
// ═══════════════════════════════════════════════════════════════════════════

/// Lượt giao nhắm vào cái gì. `PATH` = lộ trình nhiều khoá; lượt giao cấp `LESSON`
/// nở về khoá chứa bài đó khi sinh `TrnEnrollment` (ghi danh luôn ở cấp KHOÁ).
enum TrnContentType {
  LESSON
  COURSE
  PATH
}

/// `STATIC` = chốt danh sách người học lúc tạo. `DYNAMIC` = tập người theo luật lọc,
/// ai khớp thì vào, ai rời tập thì `REVOKED` + lý do "rời tập luật".
enum TrnAudienceMode {
  STATIC
  DYNAMIC
}

/// Mốc tính hạn tương đối: từ lúc được giao, hay từ ngày vào làm.
enum TrnDueAnchor {
  ASSIGNED_AT
  JOINED_AT
}

enum TrnAssignmentStatus {
  ACTIVE
  REVOKED
}

/// Lượt giao bài.
///
/// `centerId`/`orgUnitId` BẮT BUỘC (nhóm `BAT_BUOC`): một lượt giao luôn thuộc một
/// cơ sở. NULL ở đây là dữ liệu chưa backfill, KHÔNG phải "toàn công ty" — nên model
/// này KHÔNG vào `NULL_IS_GLOBAL_MODELS`.
model TrnAssignment {
  id          String         @id @default(cuid())
  contentType TrnContentType
  /// Id của bài / khoá / lộ trình, tuỳ `contentType`. Cột trần có chủ đích: ba đích
  /// khác bảng nhau nên không có FK nào đúng cho cả ba.
  contentId   String

  /// Giao theo một phiên bản khoá cụ thể. `baseCourseVersionId` phục vụ BR-013
  /// "giao lại phần chênh lệch": diff(base, current) ra đúng những bài đã đổi.
  courseVersionId     String?
  baseCourseVersionId String?

  title        String
  isMandatory  Boolean         @default(false)
  audienceMode TrnAudienceMode @default(STATIC)

  startAt         DateTime     @default(now()) @db.Timestamptz(6)
  dueAt           DateTime?    @db.Timestamptz(6)
  dueRelativeDays Int?
  dueAnchor       TrnDueAnchor @default(ASSIGNED_AT)

  /// HẠN CHÓT CỨNG CÓ HIỆU LỰC (QĐ-CDA-05). Mặc định `false`, và mặc định đó là
  /// phần thi hành chứ không phải gu:
  ///  · quá hạn mà `allowLate = false` ⇒ NGƯNG ghi nhận tiến độ mới (409 DUE_PASSED);
  ///  · bitmap và tiến độ ĐÃ CÓ không bị xoá — bằng chứng đã học vẫn là bằng chứng;
  ///  · học tiếp phải gia hạn CÓ LÝ DO, và gia hạn ghi `dueAt`, KHÔNG BAO GIỜ ghi
  ///    `dueAtOriginal`.
  /// Với `isMandatory = true`, bật cờ này là ngoại lệ phải nhập lý do + AuditLog —
  /// không cấm cứng, nhưng không được im lặng.
  allowLate Boolean @default(false)

  completionRuleJson Json
  maxAttempts        Int  @default(1)

  /// Chống tua và chặn tốc độ phát — cơ chế giám sát của GĐ2, khai cột từ GĐ1.
  blockSeek       Boolean @default(true)
  maxPlaybackRate Float   @default(1.5)

  /// ⚠️ CHỈ hai kênh `IN_APP` và `EMAIL` (QĐ-CDA-08 — bỏ hẳn Zalo ZNS). Kiểu để
  /// `String[]` theo đúng đặc tả, và Zod chặn giá trị thứ ba ở tầng nhập; đừng
  /// "thêm lại cho tiện" mà không qua quyết định.
  notifyChannels   String[]
  reminderSchedule String[]

  status       TrnAssignmentStatus @default(ACTIVE)
  revokedAt    DateTime?           @db.Timestamptz(6)
  revokeReason String?

  centerId  String
  orgUnitId String

  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  rules       TrnAssignmentRule[]
  includes    TrnAssignmentInclude[]
  excludes    TrnAssignmentExclude[]
  enrollments TrnEnrollment[]

  /// Cron quét hạn đi bằng index này.
  @@index([status, dueAt])
  @@index([orgUnitId, status])
  @@index([contentType, contentId])
  @@index([centerId])
}

/// Một luật lọc của lượt giao động. Điều kiện TRONG một luật nối VÀ; giữa các luật
/// nối HOẶC.
///
/// `filterJson` dùng Json chứ không 13 cột nullable, NHƯNG bắt buộc có Zod schema +
/// hàm thuần `ruleToWhere(filterJson)` dịch sang `Prisma.UserWhereInput`.
/// ⚠️ `TrnCourse.catalogRuleJson` dùng CHUNG schema và CHUNG hàm đó — hai bộ dịch
/// song song là hai bộ lỗi song song, và lệch nhau thì không ai thấy bằng mắt.
/// Bảng con ⇒ không mang cột đơn vị.
model TrnAssignmentRule {
  id           String @id @default(cuid())
  assignmentId String
  filterJson   Json
  orderIndex   Int    @default(0)

  assignment TrnAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

/// Người được THÊM TAY vào lượt giao, ngoài kết quả của luật lọc.
model TrnAssignmentInclude {
  id            String   @id @default(cuid())
  assignmentId  String
  userId        String
  addedByUserId String?
  addedAt       DateTime @default(now()) @db.Timestamptz(6)

  assignment TrnAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId])
}

/// Danh sách LOẠI TRỪ của lượt giao.
///
/// ⛔ Loại trừ hiện thực bằng ĐÚNG BẢNG NÀY. TUYỆT ĐỐI không dùng
/// `UserPermissionGrant` với `grant = DENY`: `can()` v2 là ALLOW-wins thuần,
/// nhánh DENY KHÔNG TỒN TẠI, nên một grant DENY bị bỏ qua IM LẶNG — không chặn
/// được ai và cũng không báo lỗi cho người tạo.
/// `reason` bắt buộc ở tầng Zod: loại một người khỏi khoá bắt buộc là việc phải
/// giải thích được về sau.
model TrnAssignmentExclude {
  id            String   @id @default(cuid())
  assignmentId  String
  userId        String
  reason        String
  addedByUserId String?
  addedAt       DateTime @default(now()) @db.Timestamptz(6)

  assignment TrnAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId])
}

/// Một LƯỢT GHI DANH — luôn ở cấp KHOÁ.
///
/// `centerId`/`orgUnitId` **NOT NULL**: không có `centerId` thì KHÔNG tạo bản ghi.
/// Đây là hàng rào duy nhất giữa hiện trạng dữ liệu nhân sự (prod 20/08: 4/15 có
/// `centerId`) và một bảng đầy bản ghi vô hình với chính cơ sở của người học —
/// vì `TrnEnrollment` ∈ `SCOPED_MODELS` và NULL ở đây nghĩa là "chưa backfill",
/// không phải "toàn công ty".
model TrnEnrollment {
  id           String  @id @default(cuid())
  /// Tên cột là `userId`, KHÔNG phải `learnerUserId` — đồng bộ với
  /// `TrnLessonProgress.userId` và `TrnCertificate.userId`.
  userId       String
  /// NOT NULL. Lượt giao cấp LESSON nở về khoá chứa bài; cấp PATH nở thành nhiều dòng.
  courseId     String
  /// NULL = không sinh từ lượt giao (công nhận tương đương, auto từ `TrnRequirement`,
  /// hoặc tự ghi danh).
  assignmentId String?

  /// Chu kỳ tái chứng nhận — tăng khi khoá được giao lại theo `validityMonths`.
  cycle  Int                 @default(1)
  source TrnEnrollSource     @default(ASSIGNMENT)
  /// ĐÚNG 6 giá trị. "Công nhận tương đương" KHÔNG phải trạng thái thứ 7 — nó là
  /// `COMPLETED` + `verifiedAt` + `source = EQUIVALENCE`, nhãn suy từ cột `source`.
  status TrnEnrollmentStatus @default(NOT_STARTED)

  progressPercent Int @default(0)

  /// ⚠️ BẤT BIẾN. Mọi chỉ số đúng-hạn dùng cột này. KHÔNG action nào được ghi lại nó.
  /// Nullable vì lượt `source = EQUIVALENCE` không có hạn.
  dueAtOriginal DateTime? @db.Timestamptz(6)
  /// Hạn HIỆN HÀNH — gia hạn từng người không đụng lượt giao.
  dueAt         DateTime? @db.Timestamptz(6)

  extensionReason String?

  /// Ngày LÀM VIỆC được MIỄN TRỪ vì NGƯỜI CHẤM trễ hạn SLA (EL-15c).
  ///
  /// ⚠️ KHÁC hẳn gia hạn: gia hạn là người xử chủ động cho thêm thời gian và ghi
  /// `extensionReason`; đây là TRẢ LẠI đúng phần người học đã mất vì lỗi của người
  /// khác, do máy tính ra, không có người bấm.
  ///
  /// Vì sao cần cột này chứ không chỉ nới `dueAt`: `cuonTienDoKhoa` phân biệt
  /// `COMPLETED` với `COMPLETED_LATE` bằng `dueAtOriginal` — cột BẤT BIẾN. Nới
  /// `dueAt` mở lại đường nộp và chặn `OVERDUE`, nhưng người bị bỏ quên năm ngày
  /// rồi học xong VẪN bị đếm là TRỄ trên báo cáo tuân thủ gửi thẳng quản lý trực
  /// tiếp, CÓ GHI TÊN. Kế hoạch §9.3 luật 2: "thiếu (b) thì (a) vô nghĩa".
  ///
  /// `dueAtOriginal` vẫn KHÔNG BAO GIỜ bị ghi lại. Đây là khoản CỘNG bên cạnh.
  slaGraceDays     Int     @default(0)
  extendedByUserId String?

  /// CHỈ SERVER GHI — mốc "hoàn thành có kiểm chứng" (BR-004). Không setter nào từ
  /// client, không màn hình nào sửa được.
  verifiedAt DateTime? @db.Timestamptz(6)

  startedAt      DateTime? @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)
  lastActivityAt DateTime? @db.Timestamptz(6)
  /// Suy từ `completedAt > dueAtOriginal` (BR-005).
  isLate         Boolean   @default(false)

  /// (C4) chuyển sang nghỉ việc tạm ⇒ tạm dừng đồng hồ: không sinh nhắc, và bản ghi
  /// đang `pausedAt != null` bị LOẠI khỏi CẢ tử số lẫn mẫu số của chỉ số đúng hạn.
  pausedAt   DateTime? @db.Timestamptz(6)
  pausedDays Int       @default(0)

  /// EL-05 — thu hồi. Rời tập luật ĐỘNG ⇒ `REVOKED` + lý do "rời tập luật"; thu hồi
  /// tay ⇒ lý do người vận hành nhập. KHÔNG đẻ trạng thái mới cho hai đường đó —
  /// chúng khác nhau ở LÝ DO, không khác ở trạng thái.
  revokedAt    DateTime? @db.Timestamptz(6)
  revokeReason String?

  // ── Ảnh chụp tổ chức lúc giao, GHI MỘT LẦN, không bao giờ cập nhật ──
  // Vì sao bắt buộc chứ không phải tối ưu: báo cáo nhóm theo phòng ban và quản lý
  // trực tiếp. Join sống sang `Employee` thì một lần chuyển cơ sở làm ĐỔI HỒI TỐ
  // mọi con số của các tháng đã chốt, và người ký báo cáo tháng trước không giải
  // thích được vì sao số hôm nay khác.
  //
  // ⚠️ Ảnh chụp của GĐ1 đứng trên BA cột có dữ liệu thật: `snapDepartmentId` +
  // `snapOrgUnitId` + `snapJobTitle`. `snapPositionId` LUÔN NULL cho tới khi Nhân
  // sự điền bảng vị trí (prod: 0 `Position`) — KHÔNG báo cáo nào được lấy nó làm
  // nguồn. `snapManagerUserId` phủ 13/15, nguồn chốt là `Employee.managerId`.
  snapDepartmentId  String?
  snapPositionId    String?
  snapOrgUnitId     String?
  snapManagerUserId String?
  /// Chuỗi `Employee.jobTitle` tại thời điểm giao — KHÔNG phải `Position.title`
  /// (bảng đó rỗng trên prod). `jobTitle` là String bắt buộc nên phủ 15/15.
  snapJobTitle      String
  snappedAt         DateTime @default(now()) @db.Timestamptz(6)

  centerId  String
  orgUnitId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  assignment TrnAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  /// Một người, một khoá, một chu kỳ — đúng một lượt.

  /// EL-04 — tiến độ từng bài của lượt ghi danh này.
  lessonProgress TrnLessonProgress[]
  reminders      TrnReminder[]

  @@unique([courseId, userId, cycle])
  @@index([userId, status])
  @@index([status, dueAt])
  @@index([centerId])
  @@index([orgUnitId])
  @@index([assignmentId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EL-04 PR1 — TIẾN ĐỘ HỌC + QUYỀN CHỦ THỂ DỮ LIỆU
// ═══════════════════════════════════════════════════════════════════════════

/// ĐÚNG 3 giá trị. Không có "SKIPPED", không có "FAILED" — bài học không trượt;
/// trượt là chuyện của bài THI (EL-14), một bảng khác.
enum TrnLessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum TrnDsrKind {
  VIEW_EXPORT
  CORRECTION
  WITHDRAW_CONSENT
}

enum TrnDsrStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

/// Tiến độ của MỘT LƯỢT GHI DANH trên MỘT BÀI. Bảng nóng nhất module —
/// heartbeat ghi đè liên tục trong lúc học.
///
/// ─── KHÔNG mang cột đơn vị, và đó là NGOẠI LỆ CÓ TÊN ─────────────────────────
/// Ba lý do, không phải một:
///  1. Đây là đường ghi NÓNG. Cơ chế ghi kép `centerId → orgUnitId` tra DB ở mỗi
///     lệnh ghi; cõng thêm một truy vấn vào mỗi nhịp heartbeat là trả ngược đúng
///     phần công đã cắt khi gom 9 truy vấn xuống 1.
///  2. Dữ liệu này KHÔNG TỰ ĐỨNG: nó chỉ có nghĩa qua `enrollmentId`, mà
///     `TrnEnrollment` đã scoped. Cách ly đi qua đường đó khi ĐỌC.
///  3. Vòng đời khác: bitmap là dữ liệu tầng 2, bị dọn sau 90 ngày; cột đơn vị là
///     thuộc tính vĩnh viễn. Trộn hai vòng đời vào một bảng đã đủ, thêm cột đơn
///     vị là trộn ba.
///
/// ⛔ Vì thế model này phải nằm NGOÀI cả bốn danh sách: `SCOPED_MODELS`,
/// `NULL_IS_GLOBAL_MODELS`, `BACKFILL_SPECS`/`DUAL_WRITE_MODELS`, và
/// `SOFT_DELETE_MODELS`. Cũng KHÔNG khai vào `SCOPE_EXEMPT` — danh sách đó dành
/// cho model CÓ `centerId` mà cố ý không scope. Có test khẳng định cả bốn.
///
/// ─── HAI TẦNG DỮ LIỆU TRONG CÙNG MỘT BẢNG ────────────────────────────────────
/// TẦNG 1 (chứng từ, giữ dài): `status` · `coveredSec` · `readSeconds` ·
///   `verifiedAt` · `completedAt`. Cron dọn KHÔNG được chạm.
/// TẦNG 2 (đo hành vi, 90 ngày): `segmentBitmap` và các cột đếm giám sát.
/// Thứ tự bắt buộc khi dọn: bitmap chỉ được xoá SAU KHI `coveredSec` đã chốt trên
/// chính dòng đó — xoá trước là xoá luôn bằng chứng hoàn thành, không khôi phục được.
model TrnLessonProgress {
  id           String @id @default(cuid())
  enrollmentId String
  userId       String
  lessonId     String

  /// ⚠️ PHẢI nullable. Cron đêm dọn tầng 2 bằng `SET segmentBitmap = NULL`; khai
  /// NOT NULL là khoá chết chính bước dọn 90 ngày mà quyết định đòi.
  /// 1 bit = 1 đoạn `segmentSec` giây.
  segmentBitmap  Bytes?
  segmentSec     Int      @default(5)
  coveredSec     Int      @default(0)
  contentSec     Int      @default(0)
  totalWatchSec  Int      @default(0)
  maxPositionSec Int      @default(0)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(6)

  // ── Bài ĐỌC — CÙNG bảng, cố ý không tách bảng thứ hai ──
  // Tách ra thì mọi báo cáo tiến độ phải join thêm một nguồn, và "một lượt học
  // một bài" mất chỗ đứng duy nhất của nó.
  readSeconds  Int @default(0)
  scrollMaxPct Int @default(0)

  // ── Cột giám sát của GĐ2, khai ĐỦ ngay từ GĐ1 ──
  // Bảng này là bảng nóng nhất module; `ALTER TABLE` lên nó khi đã có dữ liệu prod
  // là đúng thứ luật cứng #4 bắt tránh. Khai sớm tốn 0 đồng.
  seekCount         Int       @default(0)
  blockedSeekCount  Int       @default(0)
  attnAskedCount    Int       @default(0)
  attnPassedCount   Int       @default(0)
  attnPendingAt     DateTime? @db.Timestamptz(6)
  attnPendingPosSec Int?
  cueLogJson        Json?

  status         TrnLessonProgressStatus @default(NOT_STARTED)
  firstStartedAt DateTime?               @db.Timestamptz(6)
  completedAt    DateTime?               @db.Timestamptz(6)
  /// CHỈ SERVER GHI — mốc "đã đọc/xem có kiểm chứng" của MỘT BÀI.
  /// KHÁC `TrnEnrollment.verifiedAt`, vốn là mốc của cả LƯỢT (BR-004). Hai cột,
  /// hai cấp, đừng gộp.
  verifiedAt     DateTime?               @db.Timestamptz(6)

  /// Chống nhịp heartbeat tới trễ hoặc đảo thứ tự: nhịp mang `seq` nhỏ hơn bị bỏ.
  seq Int @default(0)

  /// EL-09 — buổi TRỰC TIẾP: ai là người tick "đã dự".
  ///
  /// Nullable vì chỉ bài dạng `LIVE_SESSION` mới có. Không có cột này thì việc
  /// điểm danh tay không có nhật ký, và câu hỏi "ai xác nhận người này đã dự"
  /// không trả lời được — trong khi đó chính là thứ chống việc cấp chứng nhận
  /// cho người mới học phần trực tuyến (BR-004).
  attendanceMarkedByUserId String?
  attendanceMarkedAt       DateTime? @db.Timestamptz(6)
  /// Mốc cron đã dọn bitmap của dòng này — để phân biệt "chưa từng có bitmap" với
  /// "đã có và đã dọn đúng hạn".
  bitmapPurgedAt           DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  enrollment TrnEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     TrnLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// Một lượt ghi danh · một bài = ĐÚNG một dòng tiến độ.
  /// ⚠️ Khoá này chỉ chặn được trùng vì `enrollmentId` là NOT NULL. Nới nó thành
  /// nullable thì Postgres coi hai NULL là KHÁC nhau và khoá mất tác dụng IM LẶNG
  /// — một người sẽ đẻ nhiều dòng tiến độ cho cùng một bài.
  @@unique([enrollmentId, lessonId])
  @@index([userId, lessonId])
  @@index([lessonId, status])
  @@index([lastActivityAt])
}

/// Yêu cầu của CHỦ THỂ DỮ LIỆU: xem/xuất, đính chính, rút đồng ý.
///
/// KHÔNG có `deletedAt` và KHÔNG có đường xoá: đây là bản ghi thực thi quyền của
/// người lao động với dữ liệu của chính họ. Xoá được là mất bằng chứng đã tiếp nhận.
///
/// `centerId`/`orgUnitId` nhóm `BAT_BUOC`: NULL = chưa backfill, KHÔNG phải "toàn
/// công ty" ⇒ KHÔNG vào `NULL_IS_GLOBAL_MODELS`. Với dữ liệu cá nhân thì biến
/// "chưa biết cơ sở" thành "ai cũng thấy" là rò rỉ, không phải tiện lợi.
model TrnDataSubjectRequest {
  id     String       @id @default(cuid())
  userId String
  kind   TrnDsrKind
  detail String       @db.Text
  status TrnDsrStatus @default(NEW)

  handledByUserId String?
  handledAt       DateTime? @db.Timestamptz(6)
  resolutionNote  String?   @db.Text

  centerId  String?
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId])
  @@index([centerId])
  @@index([orgUnitId])
}

/// Bảy mốc nhắc của §12.2, theo đúng thứ tự thời gian.
///
/// `T_MINUS_2H` là mốc mà nhịp NGÀY không phục vụ được — đó là lý do cron nhắc
/// chạy mỗi 15 phút chứ không chạy đêm.
enum TrnReminderMilestone {
  T0
  T_MINUS_5D
  T_MINUS_2D
  T_MINUS_1D
  T_MINUS_2H
  T_PLUS_0
  T_PLUS_3D
}

/// ⚠️ `CANCELLED` là lý do bảng này TỒN TẠI. `EmailQueue` chỉ có
/// `PENDING/SENT/FAILED` — không có "đã huỷ" — nên sổ nghiệp vụ của lịch nhắc
/// không dồn vào đó được. `SKIPPED` = tới mốc nhưng không cần nhắc (đã xong).
enum TrnReminderStatus {
  PENDING
  SENT
  SKIPPED
  CANCELLED
}

/// Sổ lịch nhắc — MỘT dòng cho mỗi (lượt ghi danh × mốc), có vòng đời huỷ được.
///
/// Ba lý do không dồn vào `EmailQueue` (kế hoạch §TrnReminder):
///   1. `EmailQueue` không có trạng thái "đã huỷ";
///   2. AC3/AC4 của EL-06 ĐẾM số dòng `SKIPPED`/`CANCELLED` — không có bảng thì
///      không có gì để đếm;
///   3. chỉ số T4 đo "nhắc tồn đọng quá mốc" cho CẢ in-app, còn
///      `EmailQueue.scheduledAt` chỉ phủ email.
///
/// Bảng CON của `TrnEnrollment`: cách ly cơ sở đi theo bảng cha, nên KHÔNG mang
/// cột đơn vị (cùng khuôn 8 bảng con của EL-03).
model TrnReminder {
  id           String               @id @default(cuid())
  enrollmentId String
  milestone    TrnReminderMilestone
  /// Mốc PHẢI gửi. Cron quét `status = PENDING AND scheduledAt <= now`.
  scheduledAt  DateTime             @db.Timestamptz(6)
  status       TrnReminderStatus    @default(PENDING)
  sentAt       DateTime?            @db.Timestamptz(6)
  /// Kênh đã gửi thật — mảng vì một mốc có thể đi cả in-app lẫn email.
  sentChannels String[]             @default([])
  /// Vì sao bỏ qua / huỷ. Thu hồi hay gia hạn đều phải ghi lý do vào đây.
  reason       String?

  enrollment TrnEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Chống nhắc trùng: một lượt ghi danh chỉ có ĐÚNG MỘT dòng cho mỗi mốc.
  @@unique([enrollmentId, milestone])
  @@index([status, scheduledAt])
  @@index([enrollmentId])
}

/// Phạm vi của một sự cố: một lượt giao, hay toàn hệ thống.
enum TrnIncidentScope {
  ASSIGNMENT
  GLOBAL
}

/// Sự cố hệ thống — gia hạn CẢ lượt giao, không xét từng đơn (QĐ-CDA-15 mục 2).
///
/// Kịch bản chắc chắn xảy ra tuần đầu: 16h50 ngày hạn, video không chạy trên
/// điện thoại của bốn người. Không có bảng này thì cách xử duy nhất là sửa tay
/// từng dòng, không để lại dấu vết nào.
///
/// 🔴 `confirmedByUserId` là NGƯỜI TRỰC CÓ TÊN — `String` NOT NULL, không
/// nullable, không mặc định. Không có tên người thì không có bản ghi sự cố: một
/// vai ghi bằng tên phòng là một vai không ai nhận.
model TrnIncident {
  id                String           @id @default(cuid())
  title             String
  detectedAt        DateTime         @db.Timestamptz(6)
  resolvedAt        DateTime?        @db.Timestamptz(6)
  confirmedByUserId String
  scope             TrnIncidentScope
  assignmentId      String?
  /// Số ngày gia hạn cho mọi người trong phạm vi.
  extendDays        Int
  /// Mốc đã THI HÀNH việc gia hạn. NULL = đã ghi nhận sự cố nhưng chưa áp dụng.
  appliedAt         DateTime?        @db.Timestamptz(6)
  /// Số dòng ghi danh đã được gia hạn — để đối chiếu sau, không phải đếm lại.
  appliedCount      Int              @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([scope, detectedAt])
  @@index([assignmentId])
}

/// Hai trạng thái, không hơn (bản tối giản của B1 — C2).
///
/// Thêm trạng thái thứ ba ("đang xem xét", "trả lại") nghe hợp lý nhưng mỗi giá
/// trị mới là một nhánh phải nhớ ở mọi câu truy vấn về sau, đổi lấy một thông tin
/// mà ô lý do đã nói được.
enum TrnTrainingNeedStatus {
  NEW
  APPROVED
}

/// Phiếu nhu cầu đào tạo (B1, §8.1).
///
/// ⚠️ Bảng này tồn tại vì một MÂU THUẪN CỨNG trong tài liệu gốc: BA §22.1 xếp
/// bước "Nhu cầu" sang giai đoạn sau, trong khi chính §8.1 viết *"không được tạo
/// chương trình nếu không gắn phiếu nhu cầu đã duyệt"*. Không có bảng này thì
/// luật kia không thi hành được, và nó sẽ lặng lẽ thành một câu chữ không ai theo.
///
/// Đường thoát duy nhất là `TrnProgram.needExemptReason` — không có phiếu thì
/// phải viết ra lý do; không được để trống CẢ HAI.
model TrnTrainingNeed {
  id               String                @id @default(cuid())
  code             String                @unique
  title            String
  requesterUserId  String
  /// Mô tả nhóm người học bằng LỜI, không phải luật lọc: ở bước đề xuất thì
  /// người đề nghị chưa biết (và không cần biết) hệ thống lọc nhân sự thế nào.
  targetGroupText  String
  reason           String                @db.Text
  expectedOutcome  String                @db.Text
  /// Quý dự kiến, dạng "2026-Q3". Chuỗi chứ không phải ngày: đây là dự kiến ở
  /// mức quý, ép thành ngày cụ thể là bịa ra độ chính xác không có thật.
  proposedQuarter  String
  status           TrnTrainingNeedStatus @default(NEW)
  approvedByUserId String?
  approvedAt       DateTime?             @db.Timestamptz(6)

  centerId  String?
  orgUnitId String?

  programs TrnProgram[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([orgUnitId])
  @@index([centerId])
}

/// Công nhận tương đương (C8, EL-09).
///
/// ⚠️ Không có bảng này thì ma trận đào tạo ngày mở **tô xám 100%**: người đã học
/// khoá An toàn từ hai năm trước hiện ra như chưa từng học, và khoá tuân thủ 12
/// tháng không có mốc gốc nào để tính hạn tái chứng nhận.
///
/// ⚠️ Nó KHÔNG đẻ ra trạng thái thứ bảy. Lượt ghi danh sinh từ đây mang
/// `status = COMPLETED` + `source = EQUIVALENCE`; nhãn "Công nhận tương đương"
/// suy từ CỘT `source`, và tách khỏi "Hoàn thành" trên mọi báo cáo.
///
/// ⚠️ `originalEffectiveAt` là NGÀY HIỆU LỰC GỐC, không phải ngày bấm nút. Chu kỳ
/// tái chứng nhận tính từ nó — lấy ngày nhập liệu là kéo dài hiệu lực thêm đúng
/// khoảng thời gian người ta chậm nhập.
model TrnEquivalence {
  id       String @id @default(cuid())
  userId   String
  courseId String

  /// Bằng chứng là gì (chứng chỉ ngoài, biên bản lớp cũ, quyết định…). Bắt buộc:
  /// một lượt công nhận không nêu được bằng chứng thì nó chỉ là một lời nói.
  evidenceSource      String
  /// Ngày hiệu lực GỐC — mốc để tính hạn tái chứng nhận.
  originalEffectiveAt DateTime @db.Timestamptz(6)
  /// Người xác nhận, CÓ TÊN. Bắt buộc, không mặc định.
  confirmedByUserId   String
  note                String?

  centerId  String
  orgUnitId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Một người chỉ được công nhận tương đương MỘT lần cho mỗi khoá.
  @@unique([userId, courseId])
  @@index([courseId])
  @@index([originalEffectiveAt])
  @@index([centerId])
  @@index([orgUnitId])
}

/// EL-13 — chủ thể bị gắn cờ: dòng tiến độ một bài, hay một phiên xem.
enum TrnFlagSubject {
  LESSON_PROGRESS
  VIDEO_SESSION
}

/// EL-13 — vòng đời cờ nghi ngờ.
///
/// `OPEN` → người học khiếu nại → `APPEALED` → người xử quyết: giữ cờ (`UPHELD`)
/// hoặc gỡ cờ (`REVOKED`). Hết cửa sổ khiếu nại mà vẫn `OPEN` thì cron chốt
/// `UPHELD` — im lặng để cờ treo mãi là cách tệ nhất, vì người bị gắn cờ không
/// biết mình còn bao lâu để nói lại.
enum TrnFlagStatus {
  OPEN
  APPEALED
  UPHELD
  REVOKED
}

/// EL-13 — CỜ NGHI NGỜ HỌC ĐỐI PHÓ.
///
/// ⚠️ Là một BẢNG CÓ VÒNG ĐỜI, cố ý KHÔNG phải hai cột `flagged`/`flagReason` trên
/// `TrnLessonProgress`. Hai cột thì không giữ được lịch sử khiếu nại, không biết
/// ai xử, và gỡ cờ xong là mất sạch dấu vết việc từng có cờ — trong khi đây là dữ
/// liệu quan hệ lao động.
///
/// ⚠️ `evidenceJson` CHỈ chứa SỐ LIỆU TỔNG HỢP. Nó là lưới an toàn cuối cùng: sau
/// 90 ngày dữ liệu thô tầng 2 bị dọn, nhưng người khiếu nại và người xử vẫn phải
/// nhìn CÙNG một bộ số. Nhét bitmap thô hay nhật ký phiên vào đây là rò tầng 2
/// sang tầng 1 và vô hiệu hoá chính hạn dọn 90 ngày.
model TrnWatchFlag {
  id           String  @id @default(cuid())
  userId       String
  lessonId     String
  enrollmentId String?

  subjectKind      TrnFlagSubject
  /// Đúng MỘT trong hai cột dưới có giá trị, theo `subjectKind`.
  lessonProgressId String?
  videoSessionId   String?

  /// MÃ LUẬT, không phải câu văn: `WATCH_TIME_TOO_LOW` · `SEEK_ABUSE` · `TOO_FAST`
  /// · `HEARTBEAT_FLOOD`. Câu văn tiếng Việt nằm ở tầng hiển thị — để ở đây thì
  /// sửa câu chữ là sửa dữ liệu lịch sử.
  ruleCode     String
  evidenceJson Json

  status   TrnFlagStatus @default(OPEN)
  openedAt DateTime      @default(now()) @db.Timestamptz(6)

  appealedAt     DateTime? @db.Timestamptz(6)
  appealNote     String?
  /// `= openedAt + 14 ngày`. Hết cửa sổ mà cờ còn `OPEN` thì chốt `UPHELD`.
  appealDeadline DateTime  @db.Timestamptz(6)

  /// NGƯỜI XỬ CÓ TÊN, gán ngay lúc mở cờ — không phải "phòng Đào tạo" chung
  /// chung. Không có tên người thì không ai thấy mình phải trả lời, và khiếu nại
  /// nằm đó tới khi hết hạn.
  handlerUserId String
  /// `= appealedAt + 5 ngày làm việc`. Quá hạn thì vào hàng đợi việc của người xử.
  decisionDueAt DateTime? @db.Timestamptz(6)

  decidedAt       DateTime? @db.Timestamptz(6)
  decidedByUserId String?
  /// Bắt buộc khi gỡ cờ (`REVOKED`) — gỡ mà không nói lý do thì lần sau không ai
  /// biết luật đã sai ở đâu.
  decisionNote    String?

  centerId  String?
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lesson TrnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([status, openedAt])
  @@index([userId, status])
  @@index([orgUnitId, status])
  /// Cron chốt `UPHELD` khi hết cửa sổ đi bằng index này.
  @@index([appealDeadline])
  @@index([handlerUserId, status])
  @@index([decisionDueAt, status])
}

// ═══════════════════════════════════════════════════════════════════════════
// EL-14 — KHẢO THÍ ĐÀO TẠO NỘI BỘ (7 bảng)
//
// ⚠️ VÌ SAO DỰNG BẢNG MỚI thay vì tái dùng `Question`/`Exam`/`ExamAttempt` đã có:
// hai cây nội dung KHÔNG có một khoá ngoại nào bắc qua nhau. `Question` treo vào
// `Curriculum`/`Course`/`Lesson`/`Assignment` — toàn bộ là miền DẠY HỌC SINH; còn
// `ExamAttempt.studentId → Student` là NOT NULL, trong khi người thi ở đây là
// `User` (nhân viên). Nhét nhân viên vào đó là phải nới một FK đang chặt, và câu
// hỏi tuân thủ nội bộ sẽ hiện trong màn chọn đề của giáo viên robotics.
//
// ⚠️ Nhưng KHUÔN câu hỏi thì dùng chung (`contentQuestionSchema`) — một khuôn,
// hai bảng. Đúng tiền lệ `lib/elearning/lesson-cue.ts`.
// ═══════════════════════════════════════════════════════════════════════════

/// Chín loại câu hỏi của BA §13.1.
///
/// ⚠️ Khai ĐỦ CHÍN dù lượt 1 chỉ mở năm: bỏ bớt giá trị enum rồi thêm lại sau là
/// `ALTER TYPE` trên bảng đã có dữ liệu prod. Phạm vi thi hành khoá ở tầng Zod,
/// nơi sửa được mà không đụng schema.
enum TrnQuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  ORDERING
  SHORT_ANSWER
  CASE
  ESSAY
}

/// `FIXED` = mọi người cùng một bộ câu. `RANDOM` = rút theo `blueprintJson`.
///
/// ⚠️ `RANDOM` rút MỘT LẦN lúc kích hoạt đề và vật chất hoá vào `TrnExamQuestion`;
/// khác biệt giữa người này với người kia đến từ trộn THỨ TỰ, không phải rút khác
/// bộ câu. Rút-theo-người cần một bảng thứ tám và `TrnExamAnswer` phải trỏ vào nó
/// — đổi sau khi đã có dữ liệu là đổi khoá ngoại trên bảng sống.
enum TrnExamMode {
  FIXED
  RANDOM
}

/// Khi nào người học thấy đáp án đúng.
enum TrnShowAnswerPolicy {
  NEVER
  AFTER_EACH_ATTEMPT
  AFTER_LAST_ATTEMPT
}

/// Vòng đời một lượt thi.
///
/// ⚠️ `PENDING_GRADE` là trạng thái RIÊNG, không gộp vào `SUBMITTED`. Đề có câu
/// chấm tay mà đóng thẳng sang `GRADED` nghĩa là lượt đó bị chốt điểm 0 và tính
/// trượt trong khi chưa ai đọc bài — và nó không nằm trong hàng chờ chấm của ai.
enum TrnAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  PENDING_GRADE
  GRADED
  ABANDONED
}

/// EL-14 — NGÂN HÀNG CÂU HỎI đào tạo nội bộ.
model TrnQuestion {
  id String @id @default(cuid())

  /// Đường trong cây ngân hàng, vd `/an-toan/pccc/`. Cây bằng chuỗi đường dẫn chứ
  /// không bằng bảng cha-con: ngân hàng ở quy mô này không cần một cây có ràng
  /// buộc, và đổi nhánh chỉ là một lượt cập nhật chuỗi.
  bankPath    String
  type        TrnQuestionType
  /// Đề bài. `stem` chứ không `text` — `text` là tên cột của bảng học sinh, và để
  /// trùng tên hai miền là mời người đọc nhầm bảng.
  stem        String          @db.Text
  explanation String?         @db.Text

  /// Nội dung phụ thuộc loại câu (lựa chọn, đáp án đúng, cặp ghép…), theo
  /// `contentQuestionSchema` dùng chung.
  ///
  /// ⚠️ Đáp án đúng nằm TRONG đây, nên mọi đường trả câu hỏi cho người học phải đi
  /// qua một hàm lọc — bơm cả cục xuống là gửi kèm đáp án trong thân phản hồi.
  contentJson Json

  difficulty    String   @default("MEDIUM")
  skillTags     String[] @default([])
  /// Điểm mặc định khi đưa câu này vào đề. Điểm THẬT của một đề nằm ở
  /// `TrnExamQuestion.points` — sửa ở đây không đổi điểm lượt thi đã chấm.
  defaultPoints Int      @default(1)

  /// Sửa một câu ĐÃ nằm trong đề đã thi thì KHÔNG sửa tại chỗ: tạo bản mới
  /// (`version + 1`) và đặt `supersededById` trên bản cũ. Sửa tại chỗ làm lệch
  /// điểm của mọi lượt đã chấm, im lặng.
  version        Int     @default(1)
  supersededById String?

  centerId  String?
  orgUnitId String?

  createdByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  choices       TrnChoice[]
  examQuestions TrnExamQuestion[]

  @@index([bankPath])
  @@index([centerId])
  @@index([orgUnitId])
  @@index([type, difficulty])
}

/// EL-14 — lựa chọn của một câu hỏi.
///
/// ⚠️ Tồn tại SONG SONG với `contentJson`, cố ý: `contentJson` là khuôn dùng chung
/// cho trình soạn, còn bảng này là thứ TRUY VẤN ĐƯỢC (thống kê câu nhiễu nào hay
/// bị chọn — EL-17). Hai bên phải được ghi trong cùng một transaction.
model TrnChoice {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  orderIndex Int

  question TrnQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, orderIndex])
  @@index([questionId])
}

/// EL-14 — MỘT ĐỀ THI.
model TrnExam {
  id String @id @default(cuid())

  /// ĐÚNG MỘT trong hai có giá trị. Hai cột cùng có giá trị = hai đường tìm đề, và
  /// báo cáo sẽ đếm đôi.
  courseId String?
  lessonId String?

  title         String
  mode          TrnExamMode @default(FIXED)
  /// Công thức rút cho `RANDOM`, vd `{"EASY":10,"MEDIUM":10,"HARD":5}`.
  blueprintJson Json?

  durationMin Int
  /// Điểm ĐẠT, TUYỆT ĐỐI (không phải phần trăm) — và giao diện cũng NHẬP TUYỆT ĐỐI,
  /// không có phép quy đổi % nào ở giữa. (Bản đầu của chú thích này nói giao diện
  /// nhập theo %; mã chưa bao giờ làm thế, và một chú thích sai ở schema là thứ người
  /// sau tin trước khi họ đọc mã.) Lưu % thì đổi `maxScore` là im lặng đổi ngưỡng đạt
  /// của mọi lượt đã thi.
  passScore   Int
  /// Tổng điểm của đề, ĐÓNG BĂNG lúc kích hoạt.
  ///
  /// ⚠️ Cột này KHÔNG có trong bảng khai của đặc tả (§3.3.3) nhưng được §9 dùng
  /// năm lần, và chính §9.12 liệt nó vào danh sách "phải đi xin EL-14". Không có
  /// nó thì không tính được tỉ lệ điểm, và mọi chỉ số phải quay sang đọc
  /// `passScore` — một con số do chính người bị đo tự đặt.
  maxScore    Int @default(0)

  maxAttempts   Int @default(1)
  cooldownHours Int @default(24)

  showAnswerPolicy TrnShowAnswerPolicy @default(AFTER_LAST_ATTEMPT)
  shuffleQuestions Boolean             @default(true)
  shuffleChoices   Boolean             @default(true)

  /// `false` = còn nháp, sửa thoải mái. `true` = đã đóng băng bộ câu và `maxScore`.
  isActive Boolean @default(false)

  centerId  String?
  orgUnitId String?

  createdByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  questions TrnExamQuestion[]
  attempts  TrnExamAttempt[]
  unlocks   TrnExamUnlock[]

  @@index([courseId])
  @@index([lessonId])
  @@index([centerId])
  @@index([orgUnitId])
}

/// EL-14 — một câu trong một đề, kèm điểm của riêng đề đó.
model TrnExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  orderIndex Int
  /// Điểm THẬT dùng để chấm. Tách khỏi `TrnQuestion.defaultPoints` để sửa câu
  /// trong ngân hàng không làm lệch điểm của lượt đã chấm.
  points     Int    @default(1)

  exam     TrnExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  question TrnQuestion     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers  TrnExamAnswer[]

  @@unique([examId, questionId])
  @@unique([examId, orderIndex])
  @@index([examId])
}

/// EL-14 — MỘT LƯỢT THI của một người.
///
/// ⚠️ Mang CẢ HAI cột đơn vị, NOT NULL — khác `TrnLessonProgress` (không mang cột
/// nào). Ngoại lệ của bảng tiến độ có ba điều kiện: nhịp ghi nóng, không tự đứng
/// được, và vòng đời tầng 2. Lượt thi ghi vài lần một người một đề, là CHỨNG TỪ
/// giữ dài, và phải đối soát được ở cron drift đêm — không điều kiện nào áp.
model TrnExamAttempt {
  id           String  @id @default(cuid())
  examId       String
  userId       String
  enrollmentId String?
  attemptNo    Int     @default(1)

  status      TrnAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now()) @db.Timestamptz(6)
  submittedAt DateTime?        @db.Timestamptz(6)
  gradedAt    DateTime?        @db.Timestamptz(6)

  /// `null` cho tới khi chấm xong. KHÔNG mặc định 0 — 0 nghĩa là "làm sai hết",
  /// còn `null` nghĩa là "chưa ai chấm", và gộp hai thứ đó là đóng sổ trượt cho
  /// người chưa được chấm.
  totalScore Int?
  passed     Boolean?

  gradedByUserId String?
  feedback       String? @db.Text

  // TẦNG 2 — dấu vân kỹ thuật, KHÔNG lưu IP thô.
  ipHash        String?
  ipPrefix      String?
  deviceClass   String?
  browserFamily String?
  /// NOT NULL, ghi cứng lúc INSERT = mốc bắt đầu + 90 ngày. Thêm cột này sau bằng
  /// `ALTER TABLE` là để lại một lớp dữ liệu hành vi không có hạn dọn.
  purgeAfter    DateTime @db.Timestamptz(6)

  centerId  String
  orgUnitId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  exam    TrnExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers TrnExamAnswer[]

  /// Một người · một đề · một số thứ tự lượt = đúng một dòng. Đây là thứ chặn hai
  /// tab cùng bấm "Bắt đầu thi" tạo ra hai lượt.
  @@unique([examId, userId, attemptNo])
  @@index([userId, examId])
  @@index([status, startedAt])
  @@index([purgeAfter])
  @@index([orgUnitId])
  @@index([centerId])
}

/// EL-14 — câu trả lời cho MỘT câu trong MỘT lượt.
model TrnExamAnswer {
  id             String @id @default(cuid())
  attemptId      String
  examQuestionId String

  selectedChoiceIds String[] @default([])
  textAnswer        String?  @db.Text

  /// `null` = CHƯA CHẤM. Khác hẳn `false` (đã chấm, sai).
  isCorrect  Boolean?
  /// `null` = chưa chấm. Không mặc định 0.
  score      Int?
  graderNote String?  @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  attempt      TrnExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion TrnExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  /// Một lượt · một câu = đúng một dòng. Đây là thứ cho phép lưu dần từng câu
  /// trong lúc làm bài (mất mạng 10 giây không mất cả bài).
  @@unique([attemptId, examQuestionId])
  @@index([attemptId])
}

/// EL-14 — MỞ KHOÁ THÊM MỘT LƯỢT THI (BR-006).
///
/// ⚠️ Bảng riêng chứ không phải một cột `extraAttempts` trên đề: mỗi lần mở khoá là
/// một sự kiện có người chịu trách nhiệm, có lý do, đếm được. Một cột số thì không
/// biết ai cộng, cộng khi nào, và vì sao.
model TrnExamUnlock {
  id                   String @id @default(cuid())
  examId               String
  userId               String
  unlockedByUserId     String
  /// BẮT BUỘC. Mở khoá không lý do thì lần sau không ai biết vì sao ngoại lệ đó
  /// từng được cho.
  reason               String
  previousAttemptCount Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  exam TrnExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, userId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════════════
// EL-15 — BÀI TẬP CHẤM TAY + KHUNG CHẤM (rubric)
//
// ⚠️ Rubric cũ của repo (`RubricCriterion`/`RubricLevel`) KHÔNG dùng lại được: nó
// là enum CỨNG 6 tiêu chí robotics × 4 mức, gắn với lớp học sinh. Nó không biểu
// diễn nổi thang 100 điểm của quy trình tư vấn hay khung ngạch giáo viên — hai thứ
// EL-15 sinh ra để chấm. Dùng lại là bẻ cong một cấu trúc cho việc nó không làm
// được, và mỗi khung mới sẽ phải sửa enum.
// ════════════════════════════════════════════════════════════════════════════

enum TrnRubricStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TrnSubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  /// Người chấm trả lại để làm lại. KHÁC `DRAFT`: đã từng nộp, đã từng được đọc.
  NEEDS_REVISION
}

/// KHUNG CHẤM một bài tập.
model TrnRubric {
  id    String @id @default(cuid())
  code  String @unique
  title String

  /// Tổng điểm của khung (thường 100). ĐÓNG BĂNG lúc kích hoạt, cùng lý do với
  /// `TrnExam.maxScore`: tính lại lúc chấm là để một tiêu chí bị sửa điểm sau đó
  /// làm lệch thang của những bài đã chấm.
  totalPoints Int @default(100)

  /// Ngưỡng ĐẠT, tuyệt đối (vd 80 trên thang 100) — và giao diện cũng NHẬP TUYỆT
  /// ĐỐI, không quy đổi %.
  ///
  /// ⚠️ Ngưỡng nằm ở KHUNG chứ không ở bài học: một khung dùng cho nhiều bài, và
  /// mỗi bài đặt một ngưỡng khác nhau trên cùng khung nghĩa là hai người cùng làm
  /// một việc được chấm bằng hai thước. Muốn ngưỡng khác thì tạo khung khác.
  passPoints Int @default(80)

  version Int             @default(1)
  status  TrnRubricStatus @default(DRAFT)

  ownerUserId String

  /// NULL = khung DÙNG CHUNG toàn công ty ⇒ `NULL_IS_GLOBAL_MODELS`.
  centerId  String?
  orgUnitId String?

  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  criteria TrnRubricCriterion[]

  @@index([status])
  @@index([centerId])
  @@index([orgUnitId])
}

/// Một TIÊU CHÍ trong khung chấm.
model TrnRubricCriterion {
  id       String @id @default(cuid())
  rubricId String

  label       String
  description String? @db.Text

  /// Trọng số, tổng các tiêu chí = `TrnRubric.totalPoints`. Kiểm ở Zod — Postgres
  /// không ép được tổng của nhiều dòng.
  weight     Int
  orderIndex Int

  /// Các MỨC của tiêu chí: `[{label, points, desc}]`.
  ///
  /// ⚠️ Người chấm chọn MỘT mức, và `points` của mức đó là điểm tiêu chí. Không có
  /// phép nhân trọng số nào ở giữa: hai phép quy đổi (mức→điểm rồi điểm→trọng số)
  /// là hai chỗ để lệch, và người chấm không kiểm được con số cuối bằng mắt.
  levelsJson Json

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  rubric TrnRubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores TrnRubricScore[]

  @@unique([rubricId, orderIndex])
  @@index([rubricId])
}

/// Một lượt NỘP BÀI TẬP.
model TrnSubmission {
  id           String  @id @default(cuid())
  lessonId     String
  enrollmentId String?
  userId       String
  attemptNo    Int     @default(1)

  contentText String? @db.Text

  /// Tệp đính kèm: `[{key, mime, size, name}]` — `key` là khoá trên kho R2.
  ///
  /// ⚠️ Nội dung ở đây MANG DỮ LIỆU CÁ NHÂN CỦA BÊN THỨ BA: §13.3 bắt giáo viên nộp
  /// "video dạy thử" và tư vấn viên nộp "ghi âm hội thoại" — tức trẻ em và phụ
  /// huynh. Bốn quy tắc của kế hoạch áp ở TẦNG ĐƯỜNG GHI, không phải ở cột này.
  attachmentsJson Json?

  /// Khung chấm ĐÓNG BĂNG tại thời điểm nộp.
  ///
  /// ⚠️ KHÔNG suy khung qua `TrnLesson.rubricId` lúc chấm: cột đó sửa được bất cứ
  /// lúc nào, nên đổi khung sau khi đã có người nộp là chấm bài cũ bằng thước mới —
  /// `TrnRubricScore.criterionId` trỏ tiêu chí của khung khác, và bảng điểm in lại
  /// ra số khác mà không ai giải thích được.
  rubricId String?

  submittedAt DateTime?           @db.Timestamptz(6)
  status      TrnSubmissionStatus @default(DRAFT)

  /// `null` cho tới khi chấm xong. KHÔNG mặc định 0 — 0 nghĩa là "làm sai hết",
  /// còn `null` nghĩa là "chưa ai chấm".
  score  Int?
  passed Boolean?

  gradedByUserId String?
  gradedAt       DateTime? @db.Timestamptz(6)

  /// HẠN CHẤM = `submittedAt` + `SLA_GRADE_DAYS` NGÀY LÀM VIỆC.
  ///
  /// ⚠️ Không có cột này thì "nộp bài → có điểm trong 3 ngày làm việc" là thiện chí
  /// chứ không phải cam kết đo được, và hàng đợi chấm không có chỉ số tồn đọng.
  /// Index `[status, dueGradeAt]` chính là thứ cron nhắc người chấm đọc.
  dueGradeAt DateTime? @db.Timestamptz(6)

  feedback String? @db.Text

  /// SỔ bù SLA: số ngày làm việc ĐÃ bù cho lượt nộp này.
  ///
  /// ⚠️ Không có sổ thì cron đêm bù lại mỗi đêm cho cùng một lượt, hạn trôi ra vô
  /// hạn — và không ai thấy, vì cron không ghi `AuditLog`.
  slaBuNgayLam Int @default(0)

  centerId  String
  orgUnitId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  scores TrnRubricScore[]

  /// Một người · một bài · một số thứ tự lượt = đúng một dòng. Đây là thứ chặn hai
  /// tab cùng bấm "Nộp bài" tạo ra hai lượt.
  @@unique([lessonId, userId, attemptNo])
  @@index([status, gradedByUserId])
  @@index([status, dueGradeAt])
  @@index([userId, lessonId])
  @@index([enrollmentId])
  @@index([centerId])
  @@index([orgUnitId])
}

/// Điểm một TIÊU CHÍ của một lượt nộp.
model TrnRubricScore {
  id           String @id @default(cuid())
  submissionId String
  criterionId  String

  /// Chỉ số MỨC người chấm chọn, trong `levelsJson` của tiêu chí.
  levelIndex Int
  /// Điểm của mức đó, CHÉP LẠI lúc chấm.
  ///
  /// ⚠️ Chép chứ không join sống sang `levelsJson`: sửa khung sau đó sẽ ĐỔI HỒI TỐ
  /// điểm của mọi bài đã chấm, và không ai giải thích được vì sao bảng điểm tháng
  /// trước in lại hôm nay ra số khác.
  points     Float
  note       String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  submission TrnSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion  TrnRubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  /// Một lượt nộp · một tiêu chí = đúng một dòng.
  @@unique([submissionId, criterionId])
  @@index([submissionId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// MEDIA-REVIEW (BA 26/08/2026) — ảnh/video buổi học + cổng duyệt của QLCS.
//
// Vì sao dựng MỚI thay vì mở rộng `ClassSessionMedia`: chủ dự án chốt 26/08 làm mới
// theo đúng BA. `ClassSessionMedia` giữ nguyên, ĐỌC-ONLY cho dữ liệu cũ; đường ghi của
// giáo viên chuyển sang `MediaAsset`. Hai bảng sống song song đúng một giai đoạn rồi
// dọn — cùng nếp 2-phase đã dùng cho việc gộp hai hệ Trial.
//
// NGUYÊN TẮC GỐC (BA §7.1): nguồn sự thật của cây duyệt là LỊCH HỌC, không phải kho ảnh.
// Buổi có 0 ảnh vẫn phải hiện ra để QLCS bấm "Hôm nay không có ảnh" — dựng cây từ ảnh
// thì lớp không ảnh biến mất và mất luôn cơ chế giải trình.
// ═══════════════════════════════════════════════════════════════════════════════

enum MediaType {
  IMAGE
  VIDEO
}

// ───────────────────────────────────────────────────────────────────────────
// TRẦN CHI PHÍ THÁNG cho lời gọi ra ngoài (chốt 27/08/2026).
// Zalo 2tr · cước gọi 3tr · chấm điểm AI 1tr. Luật + câu lệnh: lib/ngan-sach-goi-ra/.
// ───────────────────────────────────────────────────────────────────────────
/// Sổ chi của MỘT trục gọi ra ngoài trong MỘT kỳ tháng. Đúng một dòng / (kỳ × trục).
///
/// Bảng này là CÁI CỔNG, không phải cái báo cáo: quyết định "còn tiền để gọi ra
/// không" nằm trong câu `UPDATE ... WHERE "spentVnd" + chi_phí <= trần` chạy trên
/// chính dòng này (Postgres khoá dòng ⇒ hai lời gọi cùng lúc lúc sát trần không cùng
/// lọt). Đừng thay bằng "đếm log rồi so" — đó chính là lỗ mà thiết kế này vá.
///
/// CỐ Ý KHÔNG CÓ `orgUnitId`/`centerId`: trần tháng là ngân sách của CÔNG TY, không
/// phải hạn mức chia cho từng cơ sở. Thêm cột đơn vị vào đây là ngầm hứa một tính
/// năng "trần theo cơ sở" chưa ai duyệt. (Luật cứng #3 của Nền Hệ thống áp cho bảng
/// có dữ liệu THEO ĐƠN VỊ — bảng này là dữ liệu toàn hệ thống.)
model OutboundSpendCounter {
  /// Kỳ tháng "YYYY-MM" theo LỊCH VN (xem `kyThangVn` — không dùng giờ máy chạy).
  period String
  /// "ZALO" | "CHAM_DIEM_AI" — khớp `TRUC_CHI_PHI` (dòng "GOI_DIEN" cũ: trục OmiCall đã gỡ
  /// 06/10/2026, báo cáo bỏ qua trục lạ). Để String thay vì
  /// enum: thêm trục sau này là thêm cấu hình, không phải chạy migration đổi enum.
  axis   String

  /// Tổng đã đặt chỗ trong kỳ (đ). Trừ khi đặt chỗ, cộng lại khi hoàn.
  spentVnd     Int @default(0)
  /// Số lượt đã trừ tiền — chia hoá đơn thật cho số này ra đơn giá thật.
  chargeCount  Int @default(0)
  /// Số lượt BỊ CHẶN vì hết ngân sách — cơ sở để tháng sau quyết nâng hay giữ trần.
  blockedCount Int @default(0)

  /// Mốc cảnh báo (mặc định 80%) đã phát chưa — NULL nghĩa là chưa. Cột này làm chốt
  /// chặn "báo đúng một lần mỗi kỳ": chỉ lượt đầu tiên qua mốc mới ghi được vào đây.
  warnedAt  DateTime? @db.Timestamptz(6)
  /// Lần đầu chạm trần trong kỳ.
  blockedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@id([period, axis])
  @@index([period])
}

// ═══════════════════════════════════════════════════════════════════════════════
// HỘP THƯ ĐA KÊNH (Site Sale) — hội thoại với NGƯỜI NGOÀI hệ thống.
// Spec: satarobo-sale/plan/20-SPEC-TICH-HOP-ZALO-OMICALL-AI.md §3.4 (Q-KT-2).
//
// ── VÌ SAO KHÔNG DÙNG LẠI `Conversation`/`Message` (chat nội bộ) ──────────────
// Đo trên chính schema này, ba rào ở TẦNG KHOÁ chứ không phải ở tầng ý kiến:
//   1. `ConversationParticipant.userId` là `User.id` NOT NULL. Khách trên Zalo chỉ
//      có `user_id` phạm vi-một-OA; trên Messenger chỉ có `psid`. Họ KHÔNG có `User`,
//      và tạo `User` giả cho từng khách là đẻ ra tài khoản đăng nhập được.
//   2. `Message.@@unique([conversationId, senderId, clientMsgId])` KHÔNG chặn được
//      gì khi người gửi ở ngoài hệ (`senderId = null`): Postgres coi mọi NULL là
//      khác nhau ⇒ webhook retry đẻ tin trùng. Idempotency kênh ngoài phải khoá
//      theo ID TIN CỦA KÊNH.
//   3. `Conversation.dmKey` = ghép 2 `userId` đã sort, và `@@unique([type,
//      subjectType, subjectId])` — cả hai vỡ khi một người nhắn qua 2 kênh.
// Cộng thêm: module chat đang phục vụ GV/PH THẬT trên prod (RLS + Supabase Realtime
// + `syncConversationMembership` ở ~20 call-site). Thêm một `ConversationType` là
// kéo cả chuỗi đó vào một việc không liên quan.
//
// ── VÌ SAO KHÔNG MỞ RỘNG `MessengerConversation` (PA-B của spec) ──────────────
// Bảng đó ĐÚNG hình dạng cho MỘT kênh, nhưng sai trục cho hộp thư đa kênh:
//   • Nó gộp DANH TÍNH + LUỒNG + LIÊN KẾT LEAD vào một dòng. Danh tính phải sống
//     ĐỘC LẬP: sự kiện `follow` của Zalo sinh ra một danh tính CHƯA có tin nào;
//     một người có thể vừa có `psid` vừa có `user_id` mà cùng trỏ một `Lead`.
//   • `@@unique([pageId, psid])` là hình dạng của Meta. Nhét `oa_id` vào cột tên
//     `pageId` là loại nhập nhằng mà `FacebookPageMapping` (suy `centerId` theo
//     `pageId`) sẽ mang đi khắp nơi.
//   • Nó mang cột `phone` — đúng thứ hộp thư này CỐ Ý không có (xem dưới).
// Bảng cũ giữ nguyên, chỉ đọc, cho tới khi kênh Messenger nối xong thì backfill
// (hiện 0 dòng trên prod, đo 12/08 — `lib/org/center-bridge.ts` PR_A_MODELS) rồi
// mới dọn. Nếp 2-phase, không đụng bảng đang chạy.
//
// ── 🔴 HỘP THƯ KHÔNG GIỮ MỘT CỘT LIÊN HỆ NÀO ─────────────────────────────────
// Không `phone`, không `email`. SĐT/email của phụ huynh sống ở `Lead` và chỉ ra
// khỏi server qua cổng `leads:view-pii` sẵn có (`lib/lead/pii.ts`). Đây là quyết
// định CHỐNG RÒ có chủ đích: bảng không có cột thì không có gì để quên che.
//
// ── ĐƠN VỊ: `orgUnitId`, KHÔNG có `centerId` (luật cứng Nền Hệ thống #3) ──────
// ⚠️ Hệ quả phải nhớ: `scopedDb` CHỈ lọc `centerId` nên ba bảng này KHÔNG được
// auto-scope. Tầm nhìn ép TAY bằng `inboxOrgScopeWhere(actor)` (`lib/inbox/scope.ts`),
// và MỌI truy vấn đi qua `lib/inbox/queries.ts`. Test `lib/inbox/cong-truy-cap.test.ts`
// đỏ nếu có file nào ngoài `lib/inbox/` chạm thẳng `db.inbox*`.
// `orgUnitId = NULL` nghĩa là CHƯA NỐI ĐƯỢC ĐƠN VỊ (hội thoại mồ côi) — trạng thái
// BÌNH THƯỜNG, không phải lỗi: webhook `user_send_text` không kèm SĐT nên tin đầu
// tiên của một người lạ luôn mồ côi. Nhóm này hiện với MỌI người mở được hộp thư,
// đúng lý do `BankTransaction` được xếp NULL_CHUA_KHOP: giấu tồn đọng khỏi người
// phải xử lý nó là cách chắc chắn để nó không bao giờ được xử lý.
// ═══════════════════════════════════════════════════════════════════════════════

enum InboxChannel {
  ZALO_OA
  /// Nick Zalo CÁ NHÂN của Sale, đi qua ZaloCRM (tích hợp 09/2026). KÊNH RIÊNG chứ
  /// không phải biến thể của ZALO_OA: khác ràng buộc nền tảng (nhắn được người chưa
  /// "Quan tâm"), khác hạn mức, khác người chịu trách nhiệm khi nick bị khoá.
  /// ⚠️ `accountId` của kênh này là `ZaloCrmNick.zcrmAccountId`, KHÔNG phải hằng
  /// "zalocrm": khoá hội thoại là `[channel, accountId, externalThreadId]`, nên dùng
  /// hằng thì một khách nhắn hai nick bị GỘP thành một hội thoại.
  ZALO_CA_NHAN
  MESSENGER
  /// Chat trên website. Chưa có đường vào — khai trước để không phải migrate enum.
  LIVECHAT
  /// Nhân viên chép tay hội thoại từ nơi khác vào. Không bao giờ gửi ra được.
  MANUAL
}

enum InboxDirection {
  IN
  OUT
}

/// Trạng thái GIAO của một tin đi ra. Chép nguyên nghĩa `ChatZnsStatus` (US-14) —
/// đó là bản đã đúng trong repo. `SIMULATED` = KHÁCH KHÔNG NHẬN GÌ.
///
/// ⚠️ Đừng chép nhánh còn lại (`lib/notify/attendance.ts`) chỉ log cảnh báo rồi vẫn
/// đánh dấu đã gửi — nó biến số liệu nghiệm thu thành số giả (spec §2.2 AD-4).
enum InboxDeliveryStatus {
  /// Đã GIÀNH CHỖ, chưa biết kết quả. Tiến trình chết giữa chừng thì dừng ở đây và
  /// KHÔNG gửi lại — nghiêng về "thiếu một tin" thay vì "gửi đôi cho khách".
  PENDING
  SENT
  /// Adapter chưa có khoá kết nối, hoặc công tắc live đang tắt. KHÔNG gọi API.
  SIMULATED
  /// Thiếu điều kiện gửi (kênh không gửi ra được, ngoài cửa sổ tin…).
  SKIPPED
  FAILED
}

enum InboxConversationStatus {
  OPEN
  SNOOZED
  CLOSED
}

/// Vì sao một danh tính được nối với `Lead`. Quyết định "được tự nối hay phải người
/// bấm" nằm ở `lib/inbox/identity.ts`, không nằm ở đây.
enum InboxIdentityLinkSource {
  /// Khách bấm "Chia sẻ thông tin" (`user_submit_info`) — đường DUY NHẤT lấy SĐT từ OA.
  WEBHOOK_PROFILE
  /// Khớp SĐT với đúng MỘT lead (`phoneVariants`). Nhiều hơn một thì KHÔNG tự nối.
  PHONE_MATCH
  MANUAL
  /// Nối theo NHÃN NGOÀI do hệ khác gắn sẵn: ZaloCRM ghi `Contact.externalRef =
  /// 'sata:lead:<id>'` nên danh tính về đã kèm số phiếu, không phải suy từ SĐT.
  ///
  /// ⚠️ CỐ Ý KHÔNG tái dùng `WEBHOOK_PROFILE` cho ca này. Giá trị đó là BẰNG CHỨNG
  /// ĐỒNG Ý: nó chỉ được ghi khi khách tự bấm "Chia sẻ thông tin" (`user_submit_info`
  /// của Zalo OA). Ghi một phép nối máy-với-máy vào đó là làm hỏng vết đồng ý — thứ
  /// duy nhất chứng minh được là khách đã tự đưa số cho mình.
  EXTERNAL_TAG
}

/// Một con người trên MỘT kênh. Sống độc lập với hội thoại: có danh tính chưa từng
/// nhắn (mới bấm "Quan tâm" OA), và có danh tính chưa nối được `Lead` nào.
model InboxIdentity {
  id             String       @id @default(cuid())
  channel        InboxChannel
  /// Tài khoản BÊN MÌNH nhận tin: `oa_id` của Zalo, `pageId` của Facebook.
  /// Định danh khách chỉ có nghĩa TRONG phạm vi tài khoản này — nên nó nằm trong khoá.
  accountId      String
  /// Định danh khách phía nhà cung cấp: Zalo `user_id`, Messenger `psid`.
  externalUserId String

  /// Tên hiển thị do nhà cung cấp trả về. KHÔNG phải tên thật đã xác minh — đừng
  /// dùng nó để đối chiếu danh tính, chỉ để người trực nhận ra ai đang nhắn.
  displayName String?
  avatarUrl   String?

  /// NULL = HỘI THOẠI MỒ CÔI. Trạng thái bình thường, không phải lỗi.
  leadId     String?
  linkedAt   DateTime?                @db.Timestamptz(6)
  linkedById String?
  linkSource InboxIdentityLinkSource?

  /// Zalo OA: khách đã bấm "Quan tâm" chưa. OA KHÔNG nhắn được người chưa quan tâm
  /// (ràng buộc nền tảng, không sửa bằng code) nên đây là đầu vào chỉ số M-OA-1.
  isFollowing  Boolean   @default(false)
  followedAt   DateTime? @db.Timestamptz(6)
  unfollowedAt DateTime? @db.Timestamptz(6)

  /// ⚠️ `scopedDb` KHÔNG lọc cột này. Xem khối ghi chú đầu mục.
  orgUnitId String?

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedById   String?
  deletedReason String?

  conversations InboxConversation[]

  @@unique([channel, accountId, externalUserId])
  @@index([leadId])
  @@index([orgUnitId])
  @@index([channel, leadId])
}

model InboxConversation {
  id               String       @id @default(cuid())
  channel          InboxChannel
  accountId        String
  identityId       String
  /// Luồng phía nhà cung cấp. Zalo OA không có khái niệm "thread" nên đường ghi đặt
  /// bằng chính `externalUserId`. NOT NULL có chủ đích: cột nullable trong UNIQUE là
  /// unique giả (mọi NULL khác nhau) nên webhook chạy song song đẻ hai hội thoại.
  externalThreadId String

  status       InboxConversationStatus @default(OPEN)
  assigneeId   String?
  assignedAt   DateTime?               @db.Timestamptz(6)
  assignedById String?

  lastInboundAt  DateTime? @db.Timestamptz(6)
  /// ⚠️ CHỈ set khi tin thật sự ĐI ĐƯỢC (`deliveryStatus = SENT`). Một tin mô phỏng
  /// KHÔNG phải là đã trả lời khách. Đây đúng là chỗ đã cháy một lần ở Messenger:
  /// `recordOutgoingMessage` set `respondedAt`, nên mỗi lần bấm "Gửi" là TẮT cảnh báo
  /// chậm phản hồi của một khách chưa ai trả lời (`lib/crm/messenger-send-gate.ts`).
  lastOutboundAt DateTime? @db.Timestamptz(6)
  lastMessageAt  DateTime? @db.Timestamptz(6)
  unreadCount    Int       @default(0)

  /// Khách đã nhắn mà CHƯA có tin nào ĐI ĐƯỢC sau đó. Đây là bộ lọc quan trọng
  /// nhất của hộp thư, nên nó là CỘT chứ không phải phép so hai mốc thời gian lúc
  /// đọc: Prisma không so được hai cột trong `where`, mà lọc sau khi lấy về thì
  /// trần 200 dòng ăn vào tập CHƯA lọc — người dùng mất đúng những hội thoại cũ
  /// đang bị bỏ quên, tức mất đúng thứ bộ lọc này sinh ra để tìm.
  ///
  /// Nguồn sự thật là hàm `tinhChoTraLoi()` (`lib/inbox/view.ts`); cột chỉ là kết
  /// quả đã lưu của nó, ghi lại ở mọi đường ghi trong `lib/inbox/`.
  awaitingReply Boolean @default(false)

  orgUnitId String?

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedById   String?
  deletedReason String?

  identity InboxIdentity  @relation(fields: [identityId], references: [id])
  messages InboxMessage[]

  @@unique([channel, accountId, externalThreadId])
  @@index([status, lastMessageAt])
  @@index([assigneeId, status])
  @@index([orgUnitId])
  @@index([identityId])
  @@index([awaitingReply, lastMessageAt])
}

model InboxMessage {
  id             String         @id @default(cuid())
  conversationId String
  /// Nhân bản từ hội thoại để khoá chống trùng dưới đây đứng một mình được.
  channel        InboxChannel
  direction      InboxDirection

  /// ID tin của NHÀ CUNG CẤP. Đây là khoá chống trùng thật (spec §3.1 A6): webhook
  /// retry gửi lại đúng id này. NULL hợp lệ ở dòng OUT vừa giành chỗ (chưa gửi nên
  /// chưa có id) — Postgres cho nhiều NULL cùng tồn tại, đúng ý.
  channelMessageId String?

  body        String? @db.Text
  attachments Json?

  /// Người thật đã bấm gửi. NGUỒN ATTRIBUTION DUY NHẤT (spec §3.3 S4).
  sentByUserId      String?
  /// Tin OA gửi đi mà KHÔNG qua hệ thống (nhân viên trả lời thẳng trên `oa.zalo.me`).
  /// Webhook chiều đó chỉ có `sender.id` = id của OA, không định danh được người gõ.
  /// Tỷ lệ dòng này là chỉ số M-OA-4 — vượt ngưỡng nghĩa là dữ liệu chấm điểm hỏng.
  sentOutsideSystem Boolean @default(false)

  /// Chỉ có nghĩa với `direction = OUT`.
  deliveryStatus    InboxDeliveryStatus?
  providerMessageId String?
  /// Mã lỗi/mã lý do có cấu trúc (`ZALO_OA_NOT_CONFIGURED`, `LIVE_OFF`…). KHÔNG bao
  /// giờ chứa giá trị secret.
  errorCode         String?
  /// Khoá GIÀNH CHỖ của một lượt gửi (spec §3.3 S3). Do Server Action sinh, chặn
  /// bấm-hai-lần và chặn hai tab cùng gửi một nội dung.
  outboundKey       String?

  sentAt        DateTime  @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  /// Mọi xoá là XOÁ MỀM (luật cứng module chat #3).
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedById   String?
  deletedReason String?

  orgUnitId String?

  conversation InboxConversation @relation(fields: [conversationId], references: [id])

  @@unique([channel, channelMessageId])
  @@unique([conversationId, outboundKey])
  @@index([conversationId, sentAt])
  @@index([deliveryStatus, createdAt])
  @@index([orgUnitId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ZALOCRM — HAI BẢNG ÁNH XẠ HẠ TẦNG (tích hợp 09/2026, kế hoạch §3.2 + S2/S3/S7)
//
// ZaloCRM là một hệ RIÊNG (fork, tự vận hành) cầm các nick Zalo cá nhân của Sale.
// Hai bảng dưới đây KHÔNG chứa hội thoại và KHÔNG chứa tin — nội dung chat vẫn sống
// ở `Inbox*`. Chúng chỉ trả lời hai câu hỏi mà `Inbox*` không trả lời được:
//   • "Nick `<zcrmAccountId>` là của ai, ở cơ sở nào?"  → ZaloCrmNick
//   • "Hội thoại `<zcrmConversationId>` thuộc phiếu lead nào?" → ZaloCrmThread
//
// ── VÌ SAO CÓ `centerId` (ngoại lệ CÓ CHỦ ĐÍCH với luật cứng Nền Hệ thống #3) ──
// Luật #3 nói bảng mới theo đơn vị dùng `orgUnitId`, không thêm `centerId` mới. Hai
// bảng này lệch luật, và lý do là chúng KHÔNG cùng loại với `Inbox*`:
// chúng là bảng ÁNH XẠ HẠ TẦNG, cùng họ `FacebookPageMapping` (:799) — mang
// `centerId` + `orgUnitId`. Đi theo họ đó
// thì được HAI lưới tự động canh sẵn: `[A0-04-T12-01]` (`lib/db-scope.test.ts`) bắt
// model có `centerId` mà chưa phân loại, và `[US-07-IT-08b]` bắt bảng có đủ hai cột
// mà chưa khai `BACKFILL_SPECS`. Đi đường "chỉ `orgUnitId`" thì KHÔNG có lưới nào
// và phải viết thêm một bộ scope thủ công thứ hai (`lib/inbox/scope.ts` là bộ thứ
// nhất) — nhiều mã hơn, ít lưới hơn.
//
// ── 🔴 `scopedDb` KHÔNG CÁCH LY HAI BẢNG NÀY ──────────────────────────────────
// Chúng nằm ở `SCOPE_EXEMPT` (`lib/db-scope.ts`), tức `injectScope` thoát ngay ở
// dòng đầu và trả nguyên `args`. Cách ly cơ sở là việc của nơi gọi:
// `lib/integrations/zalocrm/nick-admin.ts` lọc TAY theo `actor.visibleCenterIds`
// cho cả đường ĐỌC lẫn đường GHI. Đọc "đã khai vào db-scope" thành "đã được che" là
// đúng cái bẫy mà chú thích này sinh ra để chặn.
// Vì sao không cho vào `SCOPED_MODELS`: đây là bảng TRA CỨU. Người trực đối soát ở CS1 vẫn phải tra nổi chủ của một nick CS2 thì
// mới gán được hội thoại cho đúng người; cách ly nằm ở DỮ LIỆU (`Inbox*`, `Lead`),
// không ở bảng tra cứu.
//
// ── KHÔNG CÓ KHOÁ NGOẠI ──────────────────────────────────────────────────────
// Không FK sang `Lead`/`User`/`OrgUnit`/`Inbox*`, cùng lý do đã ghi ở cụm `Inbox*`:
// đây là dữ liệu ĐẾN TỪ MỘT HỆ NGOÀI, nó không được quyền chặn thao tác dọn dẹp của
// các bảng lõi. Toàn vẹn do tầng ứng dụng giữ.
//
// ── XOÁ MỀM, VÀ KHÔNG CÓ LƯỚI TỰ ĐỘNG ────────────────────────────────────────
// ⚠️ Cả hai có `deletedAt` nhưng CỐ Ý không nằm trong `SOFT_DELETE_MODELS`
// (`lib/soft-delete.ts` chỉ có Order/Payment/Receipt/Enrollment) — y hệt `Inbox*`.
// Nghĩa là base `db` KHÔNG tự ẩn dòng đã xoá: MỌI truy vấn phải tự thêm
// `deletedAt: null`. Quên là nick đã gỡ vẫn hiện trong danh sách và vẫn nhận tin.
// ═══════════════════════════════════════════════════════════════════════════════

/// Trạng thái kết nối của một nick, do ZaloCRM báo về (`zalo.connected` /
/// `zalo.disconnected`). ENUM chứ không phải chuỗi tự do: cột này là đầu vào của
/// cảnh báo "connected mà >N giờ không có sự kiện nào" — một giá trị gõ sai sẽ làm
/// cảnh báo im lặng đúng lúc cần kêu.
enum ZaloCrmNickStatus {
  /// Chưa đồng bộ lần nào, hoặc ZaloCRM chưa báo gì. KHÔNG đồng nghĩa "hỏng".
  UNKNOWN
  CONNECTED
  DISCONNECTED
}

/// MỘT NICK ZALO CÁ NHÂN do ZaloCRM cầm.
///
/// Đây là bảng CẤU HÌNH, không phải dữ liệu khách: không SĐT, không email, không tên
/// phụ huynh. `displayName` là tên hồ sơ Zalo của chính NHÂN VIÊN.
/// Giao nick Zalo cho NGƯỜI, kèm MỨC QUYỀN (chốt 24/09/2026).
///
/// Khớp đúng mô hình mà ZaloCRM vốn đã có: `zalo_account_access.permission` nhận
/// `read` (xem tin) / `chat` (gửi tin) / `admin` (quản lý nick).
///
/// ⚠️ Bảng này chỉ giữ phần GIAO TAY. Quản lý cơ sở KHÔNG có dòng ở đây — họ được
/// `admin` tự động trên mọi nick của cơ sở mình (`pham-vi-nick.ts`). Ghi họ vào đây là
/// tạo bản thứ hai của cùng một luật, và bản ghi tay sẽ mục đi khi người ta đổi cơ sở.
model ZaloCrmNickGiao {
  id         String   @id @default(cuid())
  nickId     String
  sataUserId String
  /// `read` | `chat` | `admin` — ràng bằng CHECK ở DB, KHÔNG phải enum Postgres: thêm
  /// mức thứ tư sau này chỉ là sửa CHECK, không phải ALTER TYPE trên bảng có dữ liệu.
  mucQuyen   String   @default("chat")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  nick ZaloCrmNick @relation(fields: [nickId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [sataUserId], references: [id], onDelete: Cascade)

  @@unique([nickId, sataUserId])
  @@index([nickId])
  @@index([sataUserId])
}

model ZaloCrmNick {
  id String @id @default(cuid())

  /// Định danh nick phía ZaloCRM (`ZaloAccount.id`). Khoá đối chiếu DUY NHẤT giữa
  /// hai hệ, và chính là `InboxIdentity.accountId` / `InboxConversation.accountId`
  /// của kênh `ZALO_CA_NHAN`.
  zcrmAccountId String  @unique
  /// Mã Organization bên ZaloCRM. Một org = một nick = một cơ sở (chốt kiến trúc),
  /// và cũng là đoạn `[org]` trên đường webhook `/api/webhooks/zalocrm/[org]`.
  orgCode       String
  /// `User.id` của Sale sở hữu nick. NULL = chưa gán chủ, hoặc chủ đã rời việc và
  /// nick đang chờ Quản lý cơ sở nhận lại — trạng thái BÌNH THƯỜNG, không phải lỗi.
  sataUserId    String?
  displayName   String?

  status      ZaloCrmNickStatus @default(UNKNOWN)
  /// Mốc sự kiện gần nhất nhận được từ nick này. NULL = chưa có sự kiện nào.
  /// Cặp (`status`, `lastEventAt`) là đầu vào cảnh báo "báo connected nhưng im
  /// > `zalocrm.idleAlertHours` giờ" — nick chết mà không ai biết là ca hỏng câm.
  lastEventAt DateTime?         @db.Timestamptz(6)

  /// NULL = orgCode CHƯA ánh xạ được cơ sở (thiếu mục trong setting
  /// `zalocrm.orgCodes`). Giữ NULL thay vì đoán: gán nhầm cơ sở kéo theo gán nhầm
  /// đơn vị cho mọi hội thoại của nick đó. Xem `BACKFILL_SPECS`.
  centerId  String?
  /// P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4). Cột TRẦN, không FK.
  orgUnitId String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Xoá MỀM. ⚠️ Không có lưới tự động — xem khối ghi chú đầu cụm.
  deletedAt DateTime? @db.Timestamptz(6)

  giao ZaloCrmNickGiao[]

  @@index([orgCode])
  @@index([sataUserId])
  @@index([centerId])
  @@index([orgUnitId])
  @@index([status, lastEventAt])
}

/// ÁNH XẠ MỘT HỘI THOẠI ZALOCRM ↔ MỘT PHIẾU LEAD.
///
/// Tồn tại vì hai chiều nối lead xảy ra ở hai THỜI ĐIỂM khác nhau:
///  • Chiều lead → chat (S2): Sale bấm "Nhắn Zalo" trên phiếu lead. Lúc đó hội thoại
///    bên ZaloCRM CHƯA TỒN TẠI, nên dòng "đặt trước" chỉ có `(orgCode, phone)` và
///    `zcrmConversationId` còn NULL. Webhook đầu tiên về mới điền nốt.
///  • Chiều chat → lead (S4): webhook mang sẵn `conversationId`, tra ngược ra lead.
///
/// ── VÌ SAO CÓ CỘT `phone` (khác luật của `Inbox*`) ────────────────────────────
/// Ba bảng `Inbox*` CẤM cột liên hệ, và có test canh (`lib/inbox/cong-truy-cap.test.ts`).
/// Bảng này buộc phải có, vì lúc "đặt trước" thì SĐT là THỨ DUY NHẤT đang cầm trong
/// tay — chưa có `conversationId`, chưa có `zcrmContactId`, chưa có danh tính nào.
/// Không có cột này thì chiều lead → chat không tra lại được và mọi hội thoại do Sale
/// chủ động mở sẽ về hệ thống ở trạng thái mồ côi.
/// Ràng buộc đi kèm, KHÔNG được nới:
///   • chuẩn hoá `84XXXXXXXXX` (KHÔNG dấu `+`, không `0` đầu) — dùng `phoneVariants`
///     khi tra, đừng so bằng: DB còn tồn tại cả hai dạng `0…` và `84…`;
///   • KHÔNG có `email`, KHÔNG có tên phụ huynh, KHÔNG có nội dung tin — số ở đây chỉ
///     để NỐI, không để hiển thị. Muốn hiện SĐT cho người dùng thì đọc `Lead` qua cổng
///     `leads:view-pii` như mọi chỗ khác.
model ZaloCrmThread {
  id String @id @default(cuid())

  /// Định danh hội thoại phía ZaloCRM = `InboxConversation.externalThreadId`.
  /// NULLABLE có chủ đích: dòng "đặt trước" ra đời TRƯỚC khi hội thoại tồn tại.
  /// `@unique` trên cột nullable — Postgres cho nhiều NULL cùng tồn tại, nên nhiều
  /// dòng đặt trước KHÔNG va nhau, còn khi đã có id thì tra ngược là duy nhất.
  zcrmConversationId String? @unique

  orgCode String
  /// Canonical `84XXXXXXXXX`. Xem khối ghi chú của model.
  phone   String

  /// Phiếu lead đã nối. NULL = chưa nối được (hội thoại mồ côi) — trạng thái BÌNH THƯỜNG.
  leadId        String?
  /// `Contact.id` phía ZaloCRM, để gọi `PUT /contacts/:id/external-ref` chiều ngược.
  zcrmContactId String?

  /// Chép từ nick khi biết. NULL = CHƯA khớp được cơ sở, giữ NULL thay vì đoán.
  centerId  String?
  /// P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4). Cột TRẦN, không FK.
  orgUnitId String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Xoá MỀM. ⚠️ Không có lưới tự động — xem khối ghi chú đầu cụm.
  deletedAt DateTime? @db.Timestamptz(6)

  /// KHOÁ CỦA VẾ "ĐẶT TRƯỚC", và là quyết định đáng cân nhắc nhất của bảng này.
  ///
  /// Chọn UNIQUE (không phải chỉ index) vì dòng này là một ÁNH XẠ, không phải một
  /// nhật ký: trong một org, một số điện thoại là một khách, là một phiếu. Có UNIQUE
  /// thì đường ghi lúc bấm "Nhắn Zalo" là một `upsert` idempotent — bấm hai lần, hai
  /// tab, hay webhook chạy song song đều không đẻ ra dòng thứ hai. Không có nó thì
  /// tra `(orgCode, phone)` có thể trả về nhiều dòng, và "nhiều ứng viên" ở đây nghĩa
  /// là nối hội thoại vào NHẦM phiếu — đúng loại lỗi mà `quyetDinhNoiTheoSdt` đã chọn
  /// "thà mồ côi còn hơn đoán" để tránh.
  ///
  /// GIÁ PHẢI TRẢ, nói thẳng: nếu cùng một số THẬT SỰ có hai hội thoại ZaloCRM trong
  /// cùng org (khách nhắn hai nick), chỉ hội thoại đầu ghi được vào đây. Đường webhook
  /// vì thế TUYỆT ĐỐI không được đè `zcrmConversationId` đang khác NULL — hội thoại
  /// thứ hai để mồ côi và cho người xử lý, đừng cướp ánh xạ của hội thoại thứ nhất.
  ///
  /// (UNIQUE này đã sinh sẵn index cho việc tra theo `(orgCode, phone)`; không khai
  /// thêm `@@index` cùng cột — index trùng chỉ tốn ghi, không nhanh thêm.)
  @@unique([orgCode, phone])
  @@index([leadId])
  @@index([zcrmContactId])
  @@index([centerId])
  @@index([orgUnitId])
}

// ═══════════════════════════════════════════════════════════════════════════
// MODULE CHẤM CÔNG v3 (L1 · 06/09/2026) — docs/cham-cong/KE-HOACH-CHAM-CONG-v3.md §3
//
// Thay 5 bảng cũ (EmployeeCheckin · ShiftRegistration · TimesheetAdjustmentRequest ·
// TimesheetEditLog · WorkShiftConfig — 0 dòng prod, giữ tới Pha B). Mọi bảng theo đơn vị
// mang CẢ `centerId` (scopedDb hôm nay khoá theo cột này) lẫn `orgUnitId` (ghi kép qua
// lib/org/dual-write.ts, khai ở BACKFILL_SPECS). Số công dùng Float: giá trị chỉ là bội
// của 0,5 và hệ số lễ 1–3, không phải tiền.
// ═══════════════════════════════════════════════════════════════════════════

/// KHÁC `MediaStatus` (của `ClassSessionMedia` cũ) — cố ý đặt tên riêng để hai hệ không
/// lẫn vào nhau trong lúc còn sống song song. `PURGED` = đã xoá file khỏi R2, giữ dòng
/// để còn dấu vết ai loại và loại lúc nào.
enum MediaAssetStatus {
  PENDING
  APPROVED
  REJECTED
  PURGED
}

enum SessionReviewStatus {
  OPEN
  APPROVED
  NO_MEDIA_DECLARED
}

/// Một tấm ảnh / một video của MỘT BUỔI HỌC.
model MediaAsset {
  id String @id @default(cuid())

  centerId  String // cách ly cơ sở (scopedDb) — MỌI create PHẢI set, scopedDb không che write
  // Luật Nền Hệ thống #3: bảng mới mang dữ liệu theo đơn vị phải có `orgUnitId`.
  // Giữ CẢ HAI vì cutover P4 chưa bật ở đâu — enforcement hôm nay vẫn chạy trên centerId.
  orgUnitId String?

  classId        String
  classSessionId String
  /// Ngày của buổi (@db.Date) — denormalize để dựng cây ngày→lớp không phải join.
  sessionDate    DateTime @db.Date

  uploadedById   String
  uploadedByName String?

  /// CẦU SANG HỆ CŨ, sống đúng một giai đoạn (2-phase migration).
  ///
  /// `ClassSessionMedia` vẫn là bản ghi GIAO cho phụ huynh (consent, tag học viên, portal,
  /// đính vào nhận xét buổi) — MediaAsset chỉ thay phần KHO + DUYỆT. Cột này nối 1-1 hai
  /// dòng sinh ra từ cùng một lần tải lên, để lúc QLCS duyệt ở màn mới thì dòng cũ cũng
  /// đổi trạng thái theo, không phải đoán bằng cách so `fileUrl`.
  /// Phase B (sau khi luồng mới chạy ổn trên prod): gỡ ClassSessionMedia → gỡ cột này.
  legacyMediaId String? @unique

  type        MediaType
  /// Khoá vật thể trên R2. KHÔNG lưu URL đầy đủ — bucket/CDN đổi thì mọi dòng chết.
  r2Key       String
  thumbKey    String?
  /// Chỉ video. Dùng cho cổng "phải xem hết" (BA §7.3b).
  durationSec Int?

  status         MediaAssetStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?        @db.Timestamptz(6)
  rejectReason   String?          @db.Text
  /// Duyệt bằng nút "Duyệt tất cả" chứ không mở từng tấm — để về sau soi lại chất lượng duyệt.
  approvedInBulk Boolean          @default(false)
  /// Tỉ lệ đã xem của video (0..1).
  watchedRatio   Float?
  /// Hạn dọn file khỏi R2 sau khi bị loại (BA §7.3a — xoá mềm 7 ngày, có đường khôi phục).
  purgeAfterAt   DateTime?        @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([centerId, sessionDate, status])
  @@index([classSessionId, status])
  @@index([status, purgeAfterAt])
  @@index([orgUnitId])
}

/// KẾT LUẬN MEDIA của một buổi học — đúng MỘT dòng / buổi.
///
/// Đây là thứ quyết định buổi còn nằm trong cây duyệt hay không: `OPEN` là còn việc,
/// `APPROVED` / `NO_MEDIA_DECLARED` là xong. Không có bảng này thì "lớp không có ảnh"
/// không thể biến mất khỏi cây, và không có gì để làm báo cáo SLA.
model SessionMediaReview {
  id String @id @default(cuid())

  classSessionId String   @unique
  centerId       String
  orgUnitId      String?
  sessionDate    DateTime @db.Date

  status        SessionReviewStatus @default(OPEN)
  /// Bắt buộc ≥10 ký tự khi khai "hôm nay không có ảnh" (BA US-04).
  noMediaReason String?             @db.Text

  decidedById   String?
  decidedByName String?
  decidedAt     DateTime? @db.Timestamptz(6)

  /// Hạn chốt (mặc định 10:00 hôm sau, sửa ở SystemSetting "media.reviewDeadlineHour").
  /// Quá hạn KHÔNG khoá thao tác — chỉ đánh dấu trễ (BA §7.8).
  deadlineAt DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([centerId, sessionDate, status])
  @@index([status, deadlineAt])
  @@index([orgUnitId])
}

// ═══════════════════════════════════════════════════════════════════════════
// MODULE CHẤM CÔNG v3 (L1 · 06/09/2026) — docs/cham-cong/KE-HOACH-CHAM-CONG-v3.md §3
//
// Thay 5 bảng cũ (EmployeeCheckin · ShiftRegistration · TimesheetAdjustmentRequest ·
// TimesheetEditLog · WorkShiftConfig — 0 dòng prod, giữ tới Pha B). Mọi bảng theo đơn vị
// mang CẢ `centerId` (scopedDb hôm nay khoá theo cột này) lẫn `orgUnitId` (ghi kép qua
// lib/org/dual-write.ts, khai ở BACKFILL_SPECS). Số công dùng Float: giá trị chỉ là bội
// của 0,5 và hệ số lễ 1–3, không phải tiền.
// ═══════════════════════════════════════════════════════════════════════════

enum ShiftTemplateKind {
  TIMED // có giờ (S, C, HC, CG…)
  LOCATION_ONLY // chỉ nơi làm, không giờ (D1, D2)
  FLEXIBLE // linh động (LD)
  OFF // nghỉ (X)
  LEAVE // nghỉ phép (P)
}

enum ShiftAttendanceMode {
  REQUIRED // phải quét QR
  OPTIONAL // quét thì ghi giờ, không quét vẫn 1 công (LD, NG)
  NONE // không chấm (X, P)
}

enum ShiftPayMode {
  SHIFT // công theo ca (1 công/ngày có mã)
  ADMIN_HOURS // giờ hành chính (HC) — vẫn 1 công/ngày, kèm giờ
  NONE
}

enum ShiftPlaceMode {
  AT_UNITS // phải ở một trong allowedOrgUnitIds
  ANY_CENTER // HO: chấm ở cơ sở nào cũng được
  OFFSITE // công tác ngoài (NG)
  ANYWHERE // linh động (LD)
}

enum ShiftAssignmentSource {
  PATTERN // sinh từ khung ca tuần
  IMPORT // import lưới tháng từ Excel
  MANUAL // sửa tay trên lưới
  SWAP // đơn đổi ca được duyệt
  LEAVE // đơn nghỉ được duyệt
  HOLIDAY // ngày lễ
}

enum ShiftAssignmentStatus {
  ACTIVE
  CANCELLED
}

enum ShiftPatternSection {
  KINH_DOANH
  GIAO_VIEN
  VAN_PHONG
}

enum StaffTimeLogSource {
  TICKET // quét QR có vé
  LEGACY_CHECKIN // chuyển từ EmployeeCheckin cũ
  MANUAL_ADJUST // TIMESHEET_FIX được duyệt
  KIOSK
  /// Bấm Check in/out ở màn "Của tôi" cho ngày CÔNG TÁC — không QR, không điểm chấm,
  /// `workLocationId = null`. Là ĐƯỜNG THỨ HAI, cố ý phân biệt được ở DB với đường QR
  /// (chốt phần A 15/09/2026: "có source riêng trong StaffTimeLog để phân biệt được").
  CONG_TAC
}

enum StaffTimeLogResult {
  ACCEPTED
  REJECTED
}

enum TimeLogReviewStatus {
  PENDING
  CONFIRMED
  DISMISSED // 06/10/2026: lượt đã bị THAY bằng chỉnh tay (ghi đè) — giữ để xem, KHÔNG còn tính công (`LUOT_CON_TINH`)
}

enum AttendanceDayType {
  WORK
  WEEKLY_OFF
  LEAVE
  HOLIDAY
  UNSCHEDULED
}

enum AttendanceDayStatus {
  COMPUTED
  ADJUSTED
  LOCKED
}

enum AttendanceComputedBy {
  ENGINE
  MANUAL
  LEGACY
}

enum AttendancePeriodStatus {
  OPEN
  CLOSING
  LOCKED
  REOPENED
}

enum ShiftBriefAudience {
  ALL
  KINH_DOANH
  GIAO_VIEN
}

enum ShiftBriefMode {
  APPEND
  SUPPRESS
  REPLACE
}

enum HolidayAttendanceEffect {
  PAID_LEAVE
  UNPAID_OFF
  INFO_ONLY
}

/// Danh mục mã ca — tab DANH MỤC CA của Sheet. segments = [{start,end,kind:"WORK"|"PAID_BREAK",place?}].
/// centerId = NULL là mã dùng chung mọi cơ sở (SCOPED + NULL_IS_GLOBAL, khuôn PaymentMethod).
model ShiftTemplate {
  id              String              @id @default(cuid())
  code            String // "S", "CG", "D1"… chuỗi Sheet, KHÔNG enum — thêm mã mới không cần dev
  name            String
  kind            ShiftTemplateKind   @default(TIMED)
  segments        Json // [{start:"07:45",end:"11:30",kind:"WORK",place?:"HOME"|"CENTER:CS1"|…}]
  defaultPlace    String              @default("HOME") // HOME | CENTER:<code> | ANY_CENTER | ASSIGNED | OFFSITE | ANYWHERE
  attendanceMode  ShiftAttendanceMode @default(REQUIRED)
  dayCredit       Float               @default(1) // K-01 theo Sheet: mọi mã làm việc = 1; X/P = 0
  isLeave         Boolean             @default(false)
  nominalMinutes  Int? // giờ kế hoạch khi không có segment (NG = 450); LD = null
  payMode         ShiftPayMode        @default(SHIFT)
  /// Số CẶP QUÉT kỳ vọng trong ngày — 0 / 1 / 2. Nguồn sự thật:
  /// `docs/cham-cong/BANG-MA-CA-CHOT.md` (chốt 09/09/2026), `catalog.test.ts` canh hai bên.
  ///   0 = không kiểm quét, không cờ thiếu lượt (LD · D1 · D2 · X · P)
  ///   1 = gom MỌI đoạn WORK thành MỘT cụm (vào = đầu, ra = cuối)
  ///   2 = HAI cụm, cắt ở khoảng hở LỚN NHẤT (chỉ ST)
  /// Mặc định 1 là chiều FAIL-CLOSED: quên khai thì hệ KIỂM THỪA, không KIỂM THIẾU.
  soCapQuetKyVong Int                 @default(1)
  scopeUserIds    String[]            @default([]) // Q-15: mã đặc thù của vài người — chỉ cảnh báo
  effectiveFrom   DateTime            @default(dbgenerated("'2000-01-01'::date")) @db.Date
  effectiveTo     DateTime?           @db.Date
  // Cột hiển thị cho màn danh mục (không dùng để tính — tính từ segments)
  amStart         String?
  amEnd           String?
  pmStart         String?
  pmEnd           String?
  pmBreakStart    String?
  pmBreakEnd      String?
  note            String?             @db.Text
  displayOrder    Int                 @default(0)
  isActive        Boolean             @default(true)
  centerId        String?
  orgUnitId       String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  patterns    ShiftWeeklyPattern[]
  assignments ShiftAssignment[]

  @@unique([code, effectiveFrom])
  @@index([centerId])
  @@index([orgUnitId])
  @@index([isActive, displayOrder])
}

/// Khung ca cố định hằng tuần — tab KHUNG CA CỐ ĐỊNH. Một người có thể có 2 bộ dòng (Mr Phúc: CS1 + CS2).
model ShiftWeeklyPattern {
  id            String              @id @default(cuid())
  userId        String
  centerId      String // khối trên Sheet: CS1 | CS2 | "hoi-so"
  orgUnitId     String?
  weekday       Int // 0=CN … 6=T7 (khớp vnWeekday)
  templateId    String
  templateCode  String
  placeOverride String?
  sheetName     String? // "Mr Phúc" — tên hiển thị trên Sheet, để export ngược
  section       ShiftPatternSection @default(KINH_DOANH)
  jobLabel      String? // "Quản lý" / "Tư vấn" / "Giáo viên"
  displayOrder  Int                 @default(0)
  effectiveFrom DateTime            @default(dbgenerated("'2000-01-01'::date")) @db.Date
  effectiveTo   DateTime?           @db.Date
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)
  template      ShiftTemplate       @relation(fields: [templateId], references: [id])

  @@unique([userId, centerId, weekday, effectiveFrom])
  @@index([centerId])
  @@index([orgUnitId])
}

/// Một ô lưới tháng (đã gộp D1/D2 vào ô đích). Đổi ca = CANCELLED + dòng mới.
/// Partial unique (userId, workDate) WHERE status='ACTIVE' tạo bằng SQL trong migration.
model ShiftAssignment {
  id                String                @id @default(cuid())
  userId            String
  employeeId        String?
  centerId          String // cơ sở LÀM / chịu công hôm đó (khác User.centerId là bình thường)
  orgUnitId         String?
  workDate          DateTime              @db.Date
  templateId        String
  templateCode      String
  segments          Json // bản resolve: place → orgUnitIds[]
  placeMode         ShiftPlaceMode        @default(AT_UNITS)
  allowedOrgUnitIds String[]              @default([])
  attendanceMode    ShiftAttendanceMode   @default(REQUIRED)
  /// Bản CHỤP `ShiftTemplate.soCapQuetKyVong` lúc xếp ca — cùng lý do `attendanceMode`,
  /// `dayCredit`, `segments` cũng được chụp: đổi danh mục hôm nay KHÔNG được đổi cách tính
  /// của những ngày đã xếp. Engine đọc cột này, KHÔNG đọc bảng danh mục.
  soCapQuetKyVong   Int                   @default(1)
  dayCredit         Float                 @default(1)
  isLeave           Boolean               @default(false)
  nominalMinutes    Int?
  sourceCells       Json? // {"CS1":"D2","CS2":"CG"} — export ngược đúng ô
  source            ShiftAssignmentSource @default(PATTERN)
  sourceRequestId   String?
  status            ShiftAssignmentStatus @default(ACTIVE)
  note              String?
  createdById       String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  template          ShiftTemplate         @relation(fields: [templateId], references: [id])

  @@index([userId, workDate])
  @@index([centerId, workDate])
  @@index([orgUnitId])
  @@index([workDate, status])
}

/// Điểm chấm công — chỉ cơ sở vận hành (CS1/CS2), KHÔNG có dòng cho "hoi-so".
model WorkLocation {
  id              String   @id @default(cuid())
  code            String   @unique // "CS1"
  name            String
  centerId        String
  orgUnitId       String?
  latitude        Float?
  longitude       Float?
  radiusMeters    Int      @default(100)
  geofenceEnabled Boolean  @default(false) // bật từng cơ sở sau khi đo toạ độ
  /// Đời khoá của mã QR TĨNH in ra. Tăng lên 1 là mọi tờ đã in / mọi ảnh chụp cũ chết ngay.
  /// Đây là cách DUY NHẤT thu hồi mã đã in mà không phải đổi `NEXTAUTH_SECRET` — khoá đó dùng
  /// chung cho session, vé SCORM, cookie portal, OTP, đổi nó là đá sập cả hệ thống.
  qrKeyVersion    Int      @default(1)
  ipAllowlist     String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  center          Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  timeLogs StaffTimeLog[]
  tickets  AttendanceTicket[]

  @@index([centerId])
  @@index([orgUnitId])
}

/// Sổ quét — mọi lượt kể cả bị từ chối. Không unique nghiệp vụ (nhiều lượt/ngày).
/// Mọi câu tính công lọc result='ACCEPTED' qua helper acceptedLogsOfDay (có test).
model StaffTimeLog {
  id              String              @id @default(cuid())
  userId          String
  centerId        String // nơi chấm; không WorkLocation thì assignment.centerId, rồi home, rồi "hoi-so"
  orgUnitId       String?
  workLocationId  String?
  direction       CheckinType
  loggedAt        DateTime            @default(now()) @db.Timestamptz(6)
  workDate        DateTime            @db.Date // vnDateOnly lúc ghi
  source          StaffTimeLogSource  @default(TICKET)
  result          StaffTimeLogResult  @default(ACCEPTED)
  rejectReason    String? // TICKET_INVALID | TICKET_EXPIRED | TICKET_REUSED | NO_WORKLOCATION | OVER_DAILY_CAP
  flags           String[]            @default([]) // NGOAI_VUNG | THIEU_GPS | CHUA_TOA_DO | TRUNG_2_PHUT | GPS_KEM_CHINH_XAC | SAI_NOI_LAM
  reviewStatus    TimeLogReviewStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?           @db.Timestamptz(6)
  reviewNote      String?
  latitude        Float?
  longitude       Float?
  accuracyMeters  Float?
  distanceMeters  Int?
  withinGeofence  Boolean?
  ticketId        String?
  ip              String?
  userAgent       String?
  verifyMethod    String? // chỗ cắm đợt 2
  verifyRefId     String?
  verifyScore     Float?
  adjustRequestId String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  workLocation    WorkLocation?       @relation(fields: [workLocationId], references: [id], onDelete: SetNull)

  @@index([userId, workDate])
  @@index([centerId, workDate])
  @@index([orgUnitId])
  @@index([reviewStatus, workDate])
}

/// Bảng công NGÀY — bảng quan trọng nhất. Ghi CHỈ qua recomputeAttendanceDay (upsert), LOCKED thì bỏ qua.
/// Kết luận của QUẢN LÝ về một ngày vắng mặt. Thiếu (null) = chưa ai xem tới.
enum AttendanceAbsenceStatus {
  UNAUTHORISED // nghỉ không phép — vào diện trừ % nội quy
  EXCUSED // có lý do chính đáng (quên quét, quầy hỏng, đi công tác) — KHÔNG trừ
}

model StaffAttendanceDay {
  id                  String                   @id @default(cuid())
  userId              String
  centerId            String
  orgUnitId           String?
  workDate            DateTime                 @db.Date
  assignmentId        String?
  templateCode        String?
  placeMode           ShiftPlaceMode?
  dayType             AttendanceDayType        @default(UNSCHEDULED)
  expectedMinutes     Int                      @default(0)
  workedMinutes       Int                      @default(0)
  paidBreakMinutes    Int                      @default(0)
  rawPairedMinutes    Int                      @default(0)
  amExpected          Int                      @default(0)
  amWorked            Int                      @default(0)
  pmExpected          Int                      @default(0)
  pmWorked            Int                      @default(0)
  lateMinutes         Int                      @default(0)
  /// Số phút đến muộn so với giờ bắt đầu ĐOẠN ĐẦU của ca, ghi THÔ — khác `lateMinutes`
  /// vốn chỉ cộng khi đã vượt dung sai `shift.lateGraceMinutes` (mặc định 30′). Không có
  /// cột này thì người trễ 20′ lưu thành 0 và không đếm được theo bất kỳ ngưỡng nào < 30′.
  arrivalDeltaMinutes Int                      @default(0)
  earlyLeaveMinutes   Int                      @default(0)
  /// Phần muộn/sớm nằm TRONG khung đơn LATE_EARLY đã duyệt (đợt 2 đơn từ, Q-5 08/10/2026). Engine ghi.
  lateApprovedMinutes Int                      @default(0)
  earlyLeaveApprovedMinutes Int                @default(0)
  /// OT (đợt 4): phút trong khung đã duyệt · phút làm thật trong khung (ngoài giờ ca) · phút được trả.
  otApprovedMinutes   Int                      @default(0)
  otActualMinutes     Int                      @default(0)
  otPayableMinutes    Int                      @default(0)
  /// Đợt 9 đơn từ: phút làm thật trong khung đơn LÀM NGÀY LỄ / NGÀY NGHỈ đã duyệt. Chỉ phút, không tiền.
  holidayWorkMinutes  Int                      @default(0)
  restDayWorkMinutes  Int                      @default(0)
  missedEarlyArrival  Boolean                  @default(false)
  dayCreditExpected   Float                    @default(0)
  dayCreditEarned     Float                    @default(0)
  hourCredit          Float                    @default(0)
  leaveUnits          Float                    @default(0)
  holidayPaidUnits    Float                    @default(0)
  overrideUnits       Float?
  overrideById        String?
  overrideAt          DateTime?                @db.Timestamptz(6)
  overrideNote        String?                  @db.Text
  /// Quản lý XÁC NHẬN ngày này là nghỉ không phép / có lý do. Chủ dự án chốt 06/09: không
  /// tự động trừ từ cờ `KHONG_CO_LUOT`, vì cờ đó còn do quên quét, quầy hỏng, đi công tác.
  /// Bốn cột này do NGƯỜI ghi, không do engine — `recomputeAttendanceDay` liệt kê tường minh
  /// các cột nó ghi nên chúng sống sót qua mỗi lần tính lại, y như cặp `override*` ở trên.
  absenceStatus       AttendanceAbsenceStatus?
  absenceById         String?
  absenceAt           DateTime?                @db.Timestamptz(6)
  absenceNote         String?                  @db.Text
  pairs               Json?
  flags               String[]                 @default([])
  status              AttendanceDayStatus      @default(COMPUTED)
  ruleSnapshot        Json?
  computedBy          AttendanceComputedBy     @default(ENGINE)
  computedAt          DateTime                 @default(now()) @db.Timestamptz(6)
  periodId            String?
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(6)

  @@unique([userId, workDate])
  @@index([centerId, workDate])
  @@index([orgUnitId])
  @@index([periodId])
  @@index([status, workDate])
}

/// Kỳ công / chốt sổ theo cơ sở (kỳ HO = centerId "hoi-so").
model AttendancePeriod {
  id                String                 @id @default(cuid())
  centerId          String
  orgUnitId         String?
  periodKey         String // "YYYY-MM"
  status            AttendancePeriodStatus @default(OPEN)
  standardUnits     Float? // công chuẩn — sinh tự động, Kế toán sửa được trước khoá (K-04)
  standardUnitsNote String?
  lockedById        String?
  lockedAt          DateTime?              @db.Timestamptz(6)
  lockReason        String?
  reopenedById      String?
  reopenedAt        DateTime?              @db.Timestamptz(6)
  reopenReason      String?
  summaryJson       Json? // nguồn export duy nhất sau khoá
  exportCount       Int                    @default(0)
  lastExportedAt    DateTime?              @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(6)

  @@unique([centerId, periodKey])
  @@index([orgUnitId])
  @@index([periodKey])
}

/// Vé quét 120s. NGOẠI LỆ CÓ CHỦ ĐÍCH: không cột đơn vị — vé sống 2 phút, gắn với
/// WorkLocation (đã có cơ sở) và tiêu nguyên tử; scope làm ở WorkLocation, không ở vé.
model AttendanceTicket {
  id             String       @id @default(cuid())
  userId         String
  deviceId       String?
  workLocationId String
  nonceHash      String       @unique
  expiresAt      DateTime     @db.Timestamptz(6)
  consumedAt     DateTime?    @db.Timestamptz(6)
  ip             String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  workLocation   WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// VIỆC CỐ ĐỊNH (theo thứ) + GHI CHÚ & GHI ĐÈ (theo ngày) — chỉ phục vụ tin 19:00 và màn lịch.
model ShiftBriefNote {
  id        String             @id @default(cuid())
  centerId  String
  orgUnitId String?
  weekday   Int? // xor date
  date      DateTime?          @db.Date
  audience  ShiftBriefAudience @default(ALL)
  mode      ShiftBriefMode     @default(APPEND)
  text      String             @db.Text
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  @@index([centerId, weekday])
  @@index([centerId, date])
  @@index([orgUnitId])
}

/// Danh mục loại nghỉ (K-06 theo MISA) — màn CRUD, seed 8 dòng 1 lần.
/// Cách quy một buổi dạy ra công: theo BUỔI hay theo GIỜ thực dạy.
enum TeachingCreditBasis {
  PER_SESSION
  PER_HOUR
}

/// Buổi đến từ đâu. Lớp chính thức hay buổi trải nghiệm — hai model khác hẳn nhau.
enum TeachingCreditSource {
  CLASS
  TRIAL
  /// Case dạy bù (docs/hoc-bu/DAC-TA.md) — thêm 29/09/2026.
  MAKEUP
}

/// Vai của người trong buổi đó.
enum TeachingRole {
  MAIN
  SUBSTITUTE
  ASSISTANT
}

/// Nguồn của `ClassSession.rosterSize` — thứ phân biệt SỐ ĐO với SỐ SUY ĐOÁN.
///
/// Bắt buộc phải có, vì backfill dữ liệu cũ KHÔNG có nguồn nào đúng cho mọi dòng (đo 07/09/2026):
/// đếm ghi danh thì THỪA người một chiều (`Enrollment.deletedAt` gần như không bao giờ được set
/// khi học viên rời lớp — có luật cứng cấm dùng nó cho việc đó), còn đếm dòng điểm danh thì THIẾU
/// người một chiều với mọi buổi trước 07/08/2026 (lưới cũ chỉ gửi những em đã sửa).
///
/// Trộn hai loại vào một cột không nhãn là để người mở báo cáo tin số suy đoán như số đo.
enum ClassRosterSource {
  /// Đo tại thời điểm hoàn tất buổi, từ danh sách ghi danh của lớp. Đây là số TIN ĐƯỢC.
  SNAPSHOT
  /// Backfill: đếm số dòng điểm danh của buổi (trừ khách học bù). Sát nhưng vẫn là suy đoán.
  FROM_ATTENDANCE
  /// Backfill: đếm ghi danh theo cửa sổ thời gian. Lệch THỪA người, càng cũ càng thừa.
  FROM_ENROLLMENT
  /// Backfill: không suy được. Cố ý ghi ra thay vì để null lẫn với "chưa chạy backfill".
  UNKNOWN
  /// Buổi được ĐÓNG bởi lệnh backfill (`scripts/backfill-dong-buoi-thoa.ts`, 09/09/2026),
  /// không phải bởi người dạy lúc buổi diễn ra.
  ///
  /// Vì sao KHÔNG dùng `SNAPSHOT`: `completeSession` đếm ghi danh ĐANG CÓ tại lúc gọi. Với
  /// một buổi dạy từ tháng 4 mà đóng vào tháng 9, con số đó là sĩ số HÔM NAY — không phải
  /// sĩ số lúc dạy. Ghi `SNAPSHOT` là dán nhãn "số đo" lên một số suy đoán, và
  /// `lib/payroll/roster-guard.ts` sẽ NHẬN nó vào công thức lương.
  ///
  /// Vì sao KHÔNG dùng `FROM_ENROLLMENT`: giá trị đó thuộc lệnh backfill SĨ SỐ
  /// (`backfill-si-so-buoi.ts`), một việc khác. Trộn hai nguồn vào một nhãn là mất dấu vết.
  BACKFILL_CLOSE
}

/// Danh mục PHÂN LOẠI BUỔI — buổi này là học chính thức, lớp Coach, bù, vượt, workshop hay sự kiện.
///
/// Vì sao là BẢNG chứ không phải enum: chủ dự án đặt luật "tự tạo tự add được qua hệ thống chứ
/// không cần code" (chốt 05/09, nhắc lại 06/09). Enum thì thêm "Sự kiện hè 2027" phải deploy.
///
/// Đây là CHIỀU THỨ BA của danh mục công dạy, và là thứ gỡ trần 6 dòng — xem `TeachingCreditType`.
model SessionCategory {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  /// Dòng nhận những buổi CHƯA phân loại (`ClassSession.sessionCategoryId = null`). Đúng một
  /// dòng được bật — ép bằng partial unique index, không phải bằng lời hứa ở tầng action.
  isDefault         Boolean  @default(false)
  /// Buổi TRÁCH NHIỆM của GV cơ hữu (Trial/Bù/Vượt/Hỗ trợ ĐT&VH — SR.QD.230 PL04 §A.1.b).
  /// ⚠️ Hiện chỉ LƯU. Chưa nơi nào trừ định mức 50/30/20 buổi — bộ đếm đó là việc của đợt tính
  /// TIỀN, và tiền thì chưa chốt (BA-CC-CD-001 §13 Q2/Q3 chưa có trả lời).
  countsTowardQuota Boolean  @default(false)
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  sessions    ClassSession[]
  creditTypes TeachingCreditType[]
}

/// Danh mục LOẠI CÔNG DẠY — người vận hành tự bật/tắt, chỉnh hệ số và THÊM DÒNG, không cần dev.
///
/// ── Vì sao khoá có ba cột, và vì sao trước đó chỉ có hai ────────────────────────────────────
/// Bản 06/09 khoá `@@unique([source, role])`: sáu tổ hợp (lớp/trải nghiệm × chính/thay/trợ giảng)
/// là TOÀN BỘ những gì hệ thống tự nhận ra được từ dữ liệu buổi lúc đó. Hệ quả không lường trước:
/// đó là TRẦN CỨNG 6 DÒNG, nên BLĐ chỉ sửa được hệ số chứ không bao giờ THÊM được loại nào —
/// trong khi SR.QD.230 PL03 §4 đòi đúng những dòng không có chỗ: Coach, bù, vượt, Workshop 120%,
/// Sự kiện. `categoryId` là chiều thứ ba mở trần đó ra.
///
/// ── Cách khớp một buổi với một dòng (`loaiCua` trong lib/cham-cong/cong-day.ts) ─────────────
/// Khớp ĐÚNG `(source, role, categoryId)` trước; không có thì rơi về dòng `categoryId = null`.
/// Dòng null là dòng BAO SÂN — sáu dòng seed cũ đều mang null nên hành vi hôm nay không đổi một
/// con số nào, và BLĐ thêm dòng riêng cho Workshop là nó tự thắng dòng bao sân.
///
/// Hai dòng bao sân cùng `(source, role)` thì `loaiCua` sẽ khớp dòng nào cũng được ⇒ số công đổi
/// theo thứ tự đọc. `@@unique` của Postgres KHÔNG chặn được (NULL coi là khác nhau), nên chặn
/// bằng partial unique index viết tay trong migration.
///
/// ⚠️ Thêm được DÒNG không có nghĩa là số tự chạy: một loại chỉ nhận được buổi khi buổi đó đã
/// được gán `sessionCategoryId`. Gán ở form sửa buổi.
model TeachingCreditType {
  id             String               @id @default(cuid())
  code           String               @unique
  name           String
  source         TeachingCreditSource
  role           TeachingRole
  basis          TeachingCreditBasis  @default(PER_SESSION)
  /// Hệ số quy đổi. 1 = một buổi tính một công dạy; 0,5 = nửa; theo giờ thì nhân với số giờ.
  factor         Float                @default(1)
  /// Tắt = vẫn liệt kê để theo dõi nhưng KHÔNG cộng vào tổng công dạy của kỳ.
  countsInPeriod Boolean              @default(true)
  isActive       Boolean              @default(true)
  displayOrder   Int                  @default(0)
  /// null = dòng BAO SÂN cho mọi phân loại chưa có dòng riêng. Xem chú thích khớp ở trên.
  categoryId     String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  category SessionCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([source, role, categoryId])
  @@index([categoryId])
}

model LeaveType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  paidRatio      Float    @default(1) // 1 = hưởng 100% · 0 = không lương
  maxDaysPerYear Int?
  /// Số ngày phải báo trước cho loại nghỉ NÀY. null = không đòi báo trước.
  ///
  /// Vì sao theo LOẠI chứ không một số chung: ma chay, ốm (BHXH), thai sản về bản chất không
  /// báo trước được. Một ngưỡng chung cho tất cả thì hoặc là vô hiệu với phép năm, hoặc là
  /// biến ba loại kia thành "luôn vi phạm". Nộp muộn hơn ngưỡng KHÔNG bị chặn — nhưng phải
  /// chỉ định người làm thay, đúng mục đích "để quản lý bố trí nhân sự hỗ trợ".
  noticeDays     Int?
  countsAsWorked Boolean  @default(false)
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

// ═══════════════════════════════════════════════════════════════════════════════
// WEB PUSH — THÔNG BÁO ĐẨY VÀO ĐIỆN THOẠI NHÂN VIÊN (Đợt 1, 08/09/2026)
//
// Vì sao có module này: chuông trong ứng dụng (`StaffNotification` + kênh realtime
// `user:{id}`) chỉ sống khi TAB ĐANG MỞ. Đóng trình duyệt là im. Lead nóng nhất là lead
// vừa để lại số, mà đúng lúc đó Sale thường không ngồi trước máy — đó là lỗ mà Web Push
// sinh ra để bịt, và là lỗ DUY NHẤT nó được giao.
//
// PHẠM VI ĐÃ CHỐT (chủ dự án, 08/09/2026): chỉ NHÂN VIÊN NỘI BỘ. Phụ huynh KHÔNG nhận
// Web Push — họ đi ZNS theo chốt 09/08/2026 (`lib/chat/zns-notify.ts:20`). Lý do không
// phải kỹ thuật: cơ chế này đứng được là nhờ ép được nhân viên iPhone "Thêm vào màn hình
// chính" (công cụ làm việc, bắt được); phụ huynh không ép được. Đừng mở lại vòng này.
//
// KÊNH DUY NHẤT, KHÔNG FALLBACK. Không Firebase, không dịch vụ bên thứ ba — VAPID thuần.
// ═══════════════════════════════════════════════════════════════════════════════

enum WebPushSubscriptionStatus {
  ACTIVE
  REVOKED // người dùng tự gỡ, hoặc tài khoản bị vô hiệu hoá
  EXPIRED // push service trả 404/410 Gone — đăng ký đã chết ở đầu bên kia
}

enum WebPushOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED // còn trong hạn thử lại
  DEAD // hết maxAttempts, hoặc lỗi 4xx vĩnh viễn
  SKIPPED // ngoài allowlist, hết hạn, hoặc người nhận không còn thiết bị nào ACTIVE
}

/// Thiết bị đã bật thông báo đẩy của MỘT người dùng.
///
/// NGOẠI LỆ CÓ CHỦ ĐÍCH của luật Nền Hệ thống #3 ("bảng mới có dữ liệu theo đơn vị BẮT
/// BUỘC có orgUnitId"): đây là dữ liệu THEO NGƯỜI, không theo đơn vị — một cái điện thoại
/// thuộc về một nhân viên, không thuộc về cơ sở nào. Cùng khuôn `StaffNotification`,
/// `ChatZnsNotification`, `AttendanceTicket`; và cùng lý do đã ghi thành văn tại
/// `docs/notification/00-ke-hoach-notification.md:48` — "luật Nền Hệ thống #3 KHÔNG ÁP
/// DỤNG: bảng này là dữ liệu theo người, không theo đơn vị; phạm vi đã được ép ở đường sinh".
///
/// ĐỪNG "sửa cho đúng luật #3" bằng cách thêm cột đơn vị. Đo được: `scopedDb` chỉ chèn theo
/// `centerId`, và `lib/org/dual-write.ts` chỉ kích hoạt khi khối `data` CÓ `centerId` — nên
/// `orgUnitId` ở đây sẽ KHÔNG BAO GIỜ được ghi tự động, và sẽ ôi thiu ngay lần nhân viên
/// chuyển cơ sở đầu tiên. Cơ sở suy từ User TẠI THỜI ĐIỂM GỬI; cách ly ép ở đường sinh
/// danh sách người nhận, không ở tầng bảng.
model WebPushSubscription {
  id     String @id @default(cuid())
  userId String

  /// URL của push service (FCM/Mozilla/WNS). KHOÁ TỰ NHIÊN: trình duyệt cấp lại ĐÚNG chuỗi
  /// này khi cùng máy + cùng khoá VAPID ⇒ đường ghi là UPSERT theo cột này, không bao giờ
  /// đẻ dòng thứ hai. Vì thế bảng CỐ Ý không có `deletedAt`: soft-delete + unique toàn cục
  /// là mâu thuẫn không vá được ở tầng code (bật lại thông báo trên máy cũ sẽ vỡ P2002),
  /// và `lib/soft-delete.ts` chỉ tự lọc `deletedAt` cho 4 model tài chính.
  /// Đo: endpoint thật ~90–250 ký tự, còn rất xa trần btree 2704 byte ⇒ giữ String (TEXT),
  /// KHÔNG băm, KHÔNG @db.VarChar. Trần độ dài chặn ở Zod (`lib/push/subscription.ts`).
  endpoint String @unique

  /// Khoá mã hoá payload đầu-cuối (RFC 8291), base64url. p256dh ~87 ký tự, auth ~22.
  /// Không ràng độ dài ở DB — hình dạng do Zod gác.
  p256dh String
  auth   String

  /// Origin đã đăng ký. Service worker khoá theo ORIGIN mà hệ thống chạy 4 host trên cùng
  /// một app ⇒ MỘT người có thể có nhiều dòng hợp lệ cùng lúc. Lưu tách ra để đo được "ai
  /// bật ở đâu" mà không phải bóc chuỗi endpoint.
  origin String

  /// Cặp khoá VAPID đã dùng lúc đăng ký. Ngày xoay khoá là ngày mọi dòng khác phiên bản
  /// chết 403 VapidPkHashMismatch — có cột này mới phân biệt được "khoá đổi" với "người
  /// dùng gỡ quyền". Thêm sau = ALTER trên bảng có dữ liệu (luật cứng #4 chặn).
  vapidKeyId String @default("v1")

  userAgent   String?
  deviceLabel String?

  /// Chế độ hiển thị lúc đăng ký — `matchMedia("(display-mode: standalone)")` ở trình duyệt.
  ///
  /// Đây là cột ĐO ĐƯỢC ĐIỀU KIỆN mà toàn bộ lý lẽ phạm vi của module đứng lên: iOS Safari CHỈ
  /// giao push khi trang đã được "Thêm vào màn hình chính". Không có cột này thì khi 6 nhân viên
  /// iPhone không nhận gì, màn quản trị chỉ thấy `status=ACTIVE, lastSuccessAt=null` — không phân
  /// biệt được "chưa cài PWA" với "push service bóp" hay "chưa có thông báo nào để gửi", tức
  /// người trực không có đường nào lần ra. Nullable vì trình duyệt cũ có thể không trả lời.
  displayMode String?

  status        WebPushSubscriptionStatus @default(ACTIVE)
  revokedAt     DateTime?                 @db.Timestamptz(6)
  revokedReason String?

  failureCount  Int       @default(0)
  lastErrorCode Int?
  lastSuccessAt DateTime? @db.Timestamptz(6)
  lastFailureAt DateTime? @db.Timestamptz(6)
  lastSeenAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Đường đọc chính: lấy thiết bị còn sống của một người ngay trước lúc gửi.
  @@index([userId, status])
  /// Rà thiết bị hỏng để dọn.
  @@index([status, lastFailureAt])
}

/// SỔ GỬI của kênh Web Push. 1 dòng = 1 thông báo cần đẩy tới 1 NGƯỜI.
///
/// KHÔNG PHẢI BUS SỰ KIỆN. `DomainEvent` vẫn là nơi DUY NHẤT ghi sự kiện miền, và không
/// handler nào đăng ký nghe theo `type` trên bảng này. Bảng này cùng vai `EmailQueue` và
/// `ChatZnsNotification` — mỗi kênh gửi giữ một sổ riêng.
///
/// Vì sao KHÔNG dùng thẳng `DomainEvent` (đo, không phải ý kiến):
///   1. Nó không có mốc lùi lịch. `lib/events/dispatcher.ts` quét PENDING theo `createdAt`
///      KHÔNG kèm điều kiện thời gian nào, cron chạy mỗi phút, `maxAttempts` 5 ⇒ nhịp thử
///      lại CỐ ĐỊNH 60 giây và một lượt gửi hỏng chết hẳn sau ~5 phút. Không có chỗ nào ghi
///      được `Retry-After` của 429.
///   2. Nó chỉ có MỘT cặp status/attempts cho cả sự kiện, trong khi 3 thiết bị của cùng một
///      người trả 3 số phận khác nhau (201 / 410 Gone / 429). `decideOutcome` chỉ biết
///      `anyFailed` ⇒ hỏng 1 máy là cả sự kiện về PENDING ⇒ lượt sau BẮN LẠI vào máy đã nhận.
///   3. Repo đã tự trả lời bằng tiền lệ: handler DomainEvent duy nhất gửi ra ngoài
///      (`lib/crm/_handlers/lead-converted.ts`) không tự gửi — nó đẩy vào `EmailQueue`.
///
/// NỘI DUNG KHÔNG LƯU Ở ĐÂY. Lúc gửi mới đọc `StaffNotification` theo (userId, dedupeKey).
/// Ba tính chất có được nhờ vậy: `lib/notifications/notify.ts` giữ nguyên vai "đường ghi
/// DUY NHẤT" (nó sinh ra để dẹp 17 đường ghi rời); số điện thoại đã bị `cheSdt()` che không
/// bị chép sang bảng thứ hai nên không đẻ bài toán lưu trữ PII mới; và thông báo đã bị thu
/// hồi (state REVOKED/EXPIRED) thì tự động không còn gì để gửi.
///
/// NGOẠI LỆ luật Nền #3 như `WebPushSubscription` — dữ liệu theo NGƯỜI. Xem chú thích ở đó.
model WebPushOutbox {
  id     String @id @default(cuid())
  userId String

  /// Nguyên khoá của chuông, vd `lead.moi:<leadId>`. DÙNG LẠI chứ không đẻ quy ước thứ hai:
  /// `lib/notifications/catalog.ts` phân loại bằng TIỀN TỐ của khoá này, và cặp
  /// (userId, dedupeKey) chính là khoá đọc ngược `StaffNotification`.
  ///
  /// Allowlist tiền tố (chốt 08/09/2026): Đợt 4 chỉ GỬI cho tiền tố nằm trong allowlist,
  /// đợt đầu đúng một giá trị `lead.moi:`. Loại khác ghi dòng SKIPPED chứ không gửi.
  /// Vì sao cần allowlist: `lead.nhap_lai:` nhét `now.getTime()` vào khoá
  /// (`lib/lead/assign-lead.ts:345`) ⇒ khách điền form 10 lần là 10 dòng chuông mới, không
  /// trần nào chặn. Allowlist cũng tự vô hiệu hoá 4 nơi đang bật `reopen: true`.
  dedupeKey String

  status      WebPushOutboxStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)

  /// Mốc được phép thử lần kế: 429 tôn trọng `Retry-After`, 5xx nhân đôi. Đây chính là thứ
  /// `DomainEvent` không có, và là lý do bảng này tồn tại.
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)

  /// Mốc một lượt cron GIÀNH CHỖ. Reaper phải đo theo cột NÀY, không theo `createdAt` —
  /// `lib/events/dispatcher.ts` đang đo nhầm đúng chỗ đó, nên mọi việc tồn đọng quá ngưỡng
  /// bị kéo về PENDING NGAY TRONG LÚC đang chạy. Với push, kế thừa lỗi đó là gửi trùng.
  claimedAt DateTime? @db.Timestamptz(6)

  /// Quá mốc này thì bỏ (SKIPPED), không gửi. Bật lại kênh sau sự cố không xả tin cũ hàng loạt.
  expiresAt DateTime? @db.Timestamptz(6)

  /// Kết quả theo TỪNG endpoint: `{ "<endpoint>": { code, at, error? } }`. Lượt thử sau chỉ
  /// gửi cho thiết bị CHƯA có kết quả thành công ⇒ máy đã nhận không bao giờ bị bắn lại.
  /// Thiết bị được phân giải theo `userId` LÚC GỬI, tuyệt đối không chốt subscriptionId lúc
  /// ghi: endpoint có thể đổi chủ trên máy dùng chung, chốt sớm là lead của A nổ trên màn
  /// hình khoá của B.
  resultJson    Json?
  lastError     String?
  lastErrorCode Int?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  sentAt    DateTime? @db.Timestamptz(6)

  /// Chống trùng ở tầng DB: hai lượt cron chồng nhau va nhau ở đây chứ không gửi đôi.
  /// Cái giá của gửi đôi không phải tiền — là người dùng tắt quyền thông báo ở cấp trình
  /// duyệt, mất kênh vĩnh viễn, code không lấy lại được.
  @@unique([userId, dedupeKey])
  /// Vòng quét của cron gửi.
  @@index([status, nextAttemptAt])
  /// Vòng DỌN. Cố ý theo `createdAt` chứ KHÔNG theo `sentAt`: mọi thông báo ngoài allowlist ghi
  /// một dòng `SKIPPED`, mà `SKIPPED`/`DEAD` luôn có `sentAt = NULL` — với allowlist đợt đầu đúng
  /// một tiền tố, gần như cả bảng sẽ là `SKIPPED`. Câu dọn tự nhiên
  /// (`status IN ('DEAD','SKIPPED') AND createdAt < X`) sẽ không có index nào dẫn nếu khoá thứ
  /// hai là `sentAt`. Tra "gửi lúc nào" vẫn đi được qua `status` rồi lọc.
  @@index([status, createdAt])
  /// Màn quản trị: sổ gửi của một người, mới nhất trước.
  @@index([userId, createdAt(sort: Desc)])
}
