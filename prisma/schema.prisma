// ============================================
// NEWS (Phase 4.UI.RESET.2 PART D4)
// Marketing articles (replaced legacy BlogPost in Phase A4)
// ============================================
model News {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String    @db.Text
  content        String    @db.Text
  coverImage     String?
  category       String?
  tags           String[]
  isPublished    Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  publishedAt    DateTime? @db.Timestamptz(6)
  displayOrder   Int       @default(0)
  seoTitle       String?
  seoDescription String?   @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([slug])
  @@index([isPublished, publishedAt])
}

// ============================================
// HALL OF FAME — VINH DANH NHÂN SỰ
// ============================================

enum HonorCategory {
  SPARK
  GROWTH
  IMPACT
  GRAND_CHAMPION
}

model Honor {
  id   String @id @default(cuid())
  slug String @unique

  // Link sang Employee (source of truth cho thông tin nhân sự)
  // Tạm thời nullable để migration backfill xong mới enforce NOT NULL ở Phase 4.7.1
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Snapshot lúc trao giải (override Employee data hiện tại nếu cần)
  jobTitleAtTime String?
  yearsAtTime    Int?

  // DEPRECATED: Giữ tạm để code cũ rollback an toàn, sẽ drop ở Phase 4.7.1
  // Code mới đọc qua honor.employee.fullName / jobTitle / avatarUrl
  fullName       String?
  jobTitle       String?
  avatarUrl      String?
  yearsAtCompany Int?

  category     HonorCategory
  awardName    String
  awardedAt    DateTime      @db.Timestamptz(6)
  awardQuarter String?

  story        String  @db.Text
  shortBio     String? @db.VarChar(280)
  pullQuote    String? @db.VarChar(500)
  achievements String? @db.Text

  isFeatured   Boolean @default(false)
  isPublished  Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String?
  createdBy   User?    @relation("HonorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isFeatured])
  @@index([isPublished, displayOrder])
  @@index([employeeId])
}

model TimelineItem {
  id              String   @id @default(cuid())
  occurredAt      DateTime @db.Timestamptz(6)
  title           String
  description     String   @db.Text
  coverImageUrl   String?
  relatedHonorIds String?
  isPublished     Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@index([isPublished, occurredAt])
}

model SitePageContent {
  id           String   @id @default(cuid())
  pageKey      String
  contentKey   String
  contentValue String   @db.Text
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  updatedById  String?
  updatedBy    User?    @relation("PageContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([pageKey, contentKey])
  @@index([pageKey])
}

// ============================================
// EMPLOYEE MODULE
// ============================================

// Track Department (R6 flexibility-hardening): phòng ban ĐỘNG (model DB) thay enum cứng.
// 2-phase: model + giữ enum Department → backfill → form đọc DB → drop enum ở PR-E.
// `code` khớp giá trị enum cũ để map. SUPER_ADMIN/HR thêm phòng ban không cần redeploy.
model DepartmentDef {
  id           String     @id @default(cuid())
  code         String     @unique // khớp enum cũ: DAO_TAO, MARKETING, ...
  name         String
  displayOrder Int        @default(0)
  isTeaching   Boolean    @default(false) // GIANG_DAY/DAO_TAO → hiện UI giảng dạy
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  employees    Employee[]

  /// EL-03 — yêu cầu đào tạo theo phòng ban (nhánh dùng được thật ở GƐ1: 15/15 có phòng ban).
  trnRequirements TrnRequirement[] @relation("TrnRequirementDepartment")

  @@index([isActive, displayOrder])
}

enum Department {
  BAN_GIAM_DOC
  DAO_TAO
  MARKETING
  KINH_DOANH
  IT
  HANH_CHANH_NHAN_SU
  KE_TOAN
  // Phase 4.7 extension
  TUYEN_SINH
  GIAO_VU
  GIANG_DAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractType {
  FULLTIME
  PARTTIME
  INTERN
  FREELANCE
  // Phase 4.7 extension — Vietnam labor law contract types
  THU_VIEC
  CHINH_THUC_XAC_DINH
  CHINH_THUC_KHONG_XAC_DINH
}

enum EmploymentStatus {
  ACTIVE // Đang làm
  ON_LEAVE // Tạm nghỉ (sản, ốm dài)
  RESIGNED // Đã nghỉ tự nguyện
  TERMINATED // Bị cho nghỉ
}

model Employee {
  id String @id @default(cuid())

  // Tier 1: cơ bản
  employeeCode  String         @unique
  fullName      String
  jobTitle      String
  department    Department // 2-phase: enum cũ, dual-write với departmentId (drop ở PR-E)
  departmentId  String? // Track Department: FK Department động (đọc động thay enum)
  departmentRef DepartmentDef? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  avatarUrl     String?
  email         String?        @unique
  joinedAt      DateTime?      @db.Timestamptz(6)
  bio           String?        @db.Text
  isActive      Boolean        @default(true)
  isPublic      Boolean        @default(false)
  displayOrder  Int            @default(0)

  // Tier 2: HR cơ bản
  phone        String?
  dateOfBirth  DateTime?     @db.Timestamptz(6)
  gender       Gender?
  contractType ContractType?
  salaryRank   Int?
  salaryLevel  Int?

  // Phase 4.7 — additional Tier 2 HR fields
  endDate          DateTime? @db.Timestamptz(6) // Ngày kết thúc HĐ (cho hợp đồng có thời hạn)
  bhxhBase         Int? // Mức lương đóng BHXH — VND (số nguyên), H5/COL2
  address          String?
  emergencyContact String? // Tên - Quan hệ - SĐT
  notes            String?   @db.Text

  // Phase C1 — extended HR fields
  nationalId     String? // CCCD / CMND
  status         EmploymentStatus @default(ACTIVE)
  subjects       String[]         @default([]) // Môn dạy (mainly for GIANG_DAY / DAO_TAO)
  certifications String[]         @default([]) // Chứng chỉ chuyên môn

  // Cơ sở làm việc
  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  // Self-relation: quản lý trực tiếp
  managerId    String?
  manager      Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeManager")

  // CEO flag (chỉ 1 employee được isCEO=true tại 1 thời điểm)
  isCEO           Boolean @default(false)
  // Module chấm công v3 (T-02, 05/09/2026): miễn tính công (Mr Phúc). Cờ theo NGƯỜI, chỉ
  // SUPER_ADMIN set (khuôn SEC-M15 của isCEO) — KHÔNG tái dùng isCEO (cờ vinh danh công khai).
  // Engine: EXEMPT thì không sinh StaffAttendanceDay, không vào summary kỳ.
  timesheetExempt Boolean @default(false)

  // Meta
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String?
  createdBy   User?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Relations
  honors             Honor[]
  userAccount        User?                  @relation("UserEmployee")
  roleAuditLogs      RoleAuditLog[]
  authoredQuestions  Question[]             @relation("QuestionAuthor")
  createdExams       Exam[]                 @relation("ExamCreator")
  gradedAttempts     ExamAttempt[]          @relation("AttemptGrader")
  uploadedDocuments  Document[]             @relation("DocumentUploader")
  createdAssignments Assignment[]           @relation("AssignmentCreator")
  gradedSubmissions  AssignmentSubmission[] @relation("SubmissionGrader")
  generatedReports   ProgressReportLog[]    @relation("ReportGenerator")
  performedMovements StockMovement[]        @relation("MovementPerformer")
  performedAudits    InventoryAudit[]       @relation("AuditPerformer")

  @@index([department])
  @@index([isActive])
  @@index([isPublic])
  @@index([isCEO])
  @@index([status])
  @@index([orgUnitId])
  // IDX-1: Employee ∈ SCOPED_MODELS — centerId bị inject vào WHERE mọi read scoped
  // nhưng TRƯỚC ĐÂY thiếu index → seq scan mỗi lần đọc HR. Đây là model scoped DUY NHẤT thiếu.
  @@index([centerId])
  @@index([centerId, status])
}

// Audit trail for User.role changes scoped to one Employee (the linked
// userAccount's role). Stored as String (not Role enum) so the log
// stays readable if the enum ever shifts. Cascade on Employee delete.
model RoleAuditLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  fromRole String
  toRole   String

  changedByUserId String? // nullable — defensive if the auditor User row gets removed
  changedByName   String // snapshot so the trail is human-readable even after deletion

  reason String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([employeeId, createdAt])
  @@index([createdAt])
}

// ─── Phase 4.UI.FIX.2 ─────────────────────────────────────────────────────
// Học cụ Robotics ZMROBO — 3 bộ kit (Alpha / Beta / Intelligence Storm).
// Specs/features/highlights là JSON để giữ schema linh hoạt.
model ZMRoboKit {
  id   String @id @default(cuid())
  slug String @unique

  brand            String  @default("ZMROBO")
  series           String
  code             String?
  title            String
  subtitle         String
  shortDescription String  @db.Text
  description      String  @db.Text

  priceDisplay String  @default("Liên hệ tư vấn")
  isAvailable  Boolean @default(true)

  specs      Json
  features   Json
  highlights Json

  mainImage     String   @default("")
  galleryImages String[]

  sourceUrl String?

  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Phase 5.10 — Product catalog link
  products Product[]

  @@index([slug])
  @@index([isPublished, displayOrder])
}

// ─── Phase E1 ─────────────────────────────────────────────────────────────
// Curriculum (Giáo trình) chứa Lesson (Bài học). Tách rời khỏi Course để
// course (protected) giữ metadata, còn syllabus có thể update qua versions.
model Curriculum {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  version     Int     @default(1)
  name        String
  description String? @db.Text

  isActive Boolean          @default(true)
  status   CurriculumStatus @default(ACTIVE) // LMS-1

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lessons Lesson[]

  // FL W0 — kho câu hỏi theo khung CT (FL1-03) + template bài tập theo khung (FL1-06).
  questions           Question[]
  assignmentTemplates AssignmentTemplate[]

  @@unique([courseId, version])
  @@index([courseId, isActive])
}

// T5.3 — rút gọn còn 2 trạng thái theo yêu cầu vận hành: Nháp / Đang dùng.
// ARCHIVED + UNPUBLISHED đã map về DRAFT trong migration
// 20260726000000_curriculum_status_draft_active (QĐ-11: KHÔNG tự kích hoạt lại).
enum CurriculumStatus {
  DRAFT
  ACTIVE
}

// R7-10 — trạng thái từng buổi (5 mức) + khóa sửa.
enum LessonStatus {
  INCOMPLETE
  COMPLETE
  IN_USE
  NEEDS_UPDATE
  LOCKED
}

model Lesson {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  order Int

  title       String
  description String? @db.Text
  content     String? @db.Text

  // Mockup giáo trình 5 năm (25/08) — HỌC PHẦN của bài. Giáo trình Sata3–7 chia
  // 4 học phần × 12 buổi; nhãn buổi trên site GV in "Buổi 1 - HP1 - Bàn Tay Ma Thuật".
  // Khoá luyện thi (Sata1/2/8) không chia học phần ⇒ để null, nhãn tự rút còn
  // "Buổi 1 - <tên bài>". Nguồn nạp: prisma/seed-curriculum-sata.ts.
  moduleCode String? // "HP1"
  moduleName String? // "Học phần 1"

  duration   Int      @default(90)
  objectives String[] @default([])
  materials  String[] @default([]) // LMS-1: dùng làm "Thiết bị cần chuẩn bị"

  notes String? @db.Text

  // R7-10 — trạng thái buổi + khóa sửa + archive (soft) + optimistic lock.
  status     LessonStatus @default(INCOMPLETE)
  lockedAt   DateTime?
  lockedById String?
  archivedAt DateTime?
  version    Int          @default(0)

  // LMS-1 — giáo án chi tiết
  teacherGuide       String? @db.Text // hướng dẫn giảng dạy
  expectedOutput     String? @db.Text // kết quả mong đợi
  homeworkDefault    String? @db.Text // bài tập mặc định
  assessmentCriteria String? @db.Text // tiêu chí đánh giá

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  questions           Question[]
  exams               Exam[]
  documents           Document[]
  assignments         Assignment[]
  classSessions       ClassSession[]
  changeRequests      LessonChangeRequest[]
  scormPackages       ScormPackage[]
  skillAssessments    StudentSkillAssessment[] // W4b
  assignmentTemplates AssignmentTemplate[] // FL W0 (FL1-06) — template bài tập theo buổi
  makeupCaseLessons   MakeupCaseLesson[] // T07 — bài nằm trong bộ bài của case dạy bù

  @@unique([curriculumId, order])
  @@index([curriculumId])
  @@index([status])
}

// R7-10 — GV đề xuất chỉnh sửa buổi → Đào tạo xử lý.
enum LessonChangeStatus {
  OPEN
  ACCEPTED
  REJECTED
}

model LessonChangeRequest {
  id            String             @id @default(cuid())
  lessonId      String
  lesson        Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  requestedById String
  content       String             @db.Text
  status        LessonChangeStatus @default(OPEN)
  response      String?            @db.Text
  handledById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([lessonId])
  @@index([status])
}

// ─── Phase E2 ─────────────────────────────────────────────────────────────
// Question bank with 5 types. Choice (cascade) only used by MULTIPLE_CHOICE
// + TRUE_FALSE; correctAnswer used by SHORT_ANSWER / CODE / ESSAY.
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  CODE
  // Parity site GV 18/08 — 3 loại soạn đề mới (điền khuyết / ghép cặp / sắp xếp).
  // Nội dung đặc thù nằm ở Question.meta; correctAnswer/choices không dùng.
  FILL_BLANK
  MATCHING
  ORDERING
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Question {
  id String @id @default(cuid())

  questionCode String?      @unique
  type         QuestionType
  text         String       @db.Text
  explanation  String?      @db.Text
  imageUrl     String? // R7-13 — ảnh đề bài (upload R2)

  difficulty QuestionDifficulty @default(MEDIUM)
  tags       String[]           @default([])

  // FL W0 (FL1-03) — khung chương trình để lọc câu hỏi theo Sata x; điểm + thời gian/câu.
  curriculumId String?
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  points       Float? // điểm cho câu hỏi (null = dùng mặc định của đề/bài)
  timeLimitSec Int? // thời gian cho câu hỏi (giây)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  assignmentId String?
  assignment   Assignment? @relation("AssignmentQuestions", fields: [assignmentId], references: [id], onDelete: Cascade)

  // FL1-06 (R2) — link tới AssignmentTemplate (ngân hàng câu hỏi cho template).
  templateLinks AssignmentTemplateQuestion[] @relation("QuestionTemplateLinks")

  // For SHORT_ANSWER / CODE / ESSAY
  correctAnswer String? @db.Text

  // Parity site GV 18/08 — payload soạn đề theo loại (nguồn sự thật khi hiển thị/sửa):
  //   MULTIPLE_CHOICE: { ui: "single" | "multiple" }  (radio 1 đáp án vs checkbox nhiều)
  //   FILL_BLANK:      { answers: string[] }           (đáp án từng chỗ trống ______)
  //   MATCHING:        { pairs: { left, right }[] }    (cặp đúng trái ↔ phải)
  //   ORDERING:        { items: string[] }             (các mục theo ĐÚNG thứ tự)
  // Null = câu hỏi cũ trước parity — suy ui từ số đáp án đúng.
  meta Json?

  // For MULTIPLE_CHOICE / TRUE_FALSE
  choices Choice[]

  examQuestions ExamQuestion[]

  authorId String?
  author   Employee? @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  isPublic Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([lessonId])
  @@index([assignmentId])
  @@index([type, difficulty])
  @@index([authorId])
  @@index([curriculumId])
  @@index([courseId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  order     Int
  text      String  @db.Text
  isCorrect Boolean @default(false)
  imageUrl  String? // R7-13 — ảnh đáp án (upload R2)

  @@unique([questionId, order])
}

// ─── Phase E3 — Exam workflow ────────────────────────────────────────────
enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  REVIEWED // LMS-8: DỰ TRỮ — được đọc như trạng thái "đã xong" nhưng CHƯA flow nào set.
}

model Exam {
  id String @id @default(cuid())

  examCode    String? @unique
  title       String
  description String? @db.Text

  classId  String?
  class    Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  durationMinutes  Int     @default(60)
  totalPoints      Float   @default(10)
  passingScore     Float   @default(5)
  shuffleQuestions Boolean @default(false)
  shuffleChoices   Boolean @default(false)

  // R7-13 — cấu hình bài kiểm tra bổ sung (khôi phục sau merge main→erd-fix-p0).
  maxAttempts           Int?
  defaultDueDays        Int?
  scoringMode           String?
  showResultAfterSubmit Boolean @default(true)

  openAt  DateTime? @db.Timestamptz(6)
  closeAt DateTime? @db.Timestamptz(6)

  status ExamStatus @default(DRAFT)

  createdById String?
  createdBy   Employee? @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([status, classId])
  @@index([lessonId])
  @@index([createdById])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  order  Int
  points Float @default(1)

  answers ExamAnswer[]

  @@unique([examId, order])
  @@unique([examId, questionId])
  @@index([examId])
}

model ExamAttempt {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  // LMS-12 — thi lại: nhiều lần làm/HV/đề, đánh số attemptNo (1..maxAttempts).
  attemptNo   Int       @default(1)
  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  submittedAt DateTime? @db.Timestamptz(6)
  gradedAt    DateTime? @db.Timestamptz(6)

  status     AttemptStatus @default(IN_PROGRESS)
  totalScore Float?
  passed     Boolean?

  gradedById String?
  gradedBy   Employee? @relation("AttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  feedback   String?   @db.Text

  answers ExamAnswer[]

  // Phase 5.6 — Order item link
  orderItems OrderItem[] @relation("ExamOrderItems")

  @@unique([examId, studentId, attemptNo])
  @@index([status, examId])
  @@index([studentId])
}

model ExamAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id])

  selectedChoiceIds String[] @default([])
  textAnswer        String?  @db.Text

  isCorrect  Boolean?
  score      Float?
  graderNote String?  @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([attemptId, examQuestionId])
}

// ─── Phase E4 — Document management ──────────────────────────────────────
enum DocumentType {
  PDF
  IMAGE
  VIDEO
  SLIDE
  WORKSHEET
  AUDIO
  OTHER
}

model Document {
  id String @id @default(cuid())

  documentCode String? @unique
  title        String
  description  String? @db.Text

  type     DocumentType
  fileUrl  String
  fileName String
  fileSize Int
  mimeType String?

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  isPublic Boolean @default(false)

  tags  String[] @default([])
  notes String?  @db.Text

  uploadedById String?
  uploadedBy   Employee? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  assignmentDocs AssignmentDocument[]

  @@index([lessonId])
  @@index([type])
  @@index([isPublic])
  @@index([uploadedById])
}

// ─── Phase E5 — Assignment + Submission workflow ─────────────────────────
enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  GRADED
}

enum AssignmentKind {
  // LMS-8: NHÃN HIỂN THỊ thuần — KHÔNG drive logic. Tự-động-giao bài kèm buổi do
  // model HomeworkAssignment + liên kết Exam↔Lesson lo (R7-14), không bởi kind này.
  CLASSWORK // bài trên lớp
  HOMEWORK // bài tập về nhà
}

model Assignment {
  id String @id @default(cuid())

  title        String
  description  String         @db.Text
  instructions String?        @db.Text
  // P-new — phân biệt bài về nhà vs bài trên lớp.
  kind         AssignmentKind @default(CLASSWORK)

  classId  String
  class    Class   @relation(fields: [classId], references: [id])
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  // FL W0 (FL1-06) — bài giao cho lớp sinh từ template (nguồn theo khung CT). Null = tạo trực tiếp.
  templateId String?
  template   AssignmentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  totalPoints Float @default(10)

  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  dueAt      DateTime? @db.Timestamptz(6)

  // Parity site GV 18/08 — bài KIỂM TRA có khung giờ làm bài; dueAt vẫn được set
  // (= closeAt) để mọi màn cũ đọc dueAt không vỡ (2-phase).
  openAt  DateTime? @db.Timestamptz(6)
  closeAt DateTime? @db.Timestamptz(6)

  // Parity site GV 18/08 — bài giao gắn với 1 buổi học cụ thể (không bắt buộc).
  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)

  allowText Boolean @default(true)
  allowFile Boolean @default(true)

  // Site GV 25/08 — QUÁ HẠN TỰ ĐÓNG + GV mở gia hạn "nộp trễ".
  //
  // Trước đó `dueAt` trôi qua KHÔNG đổi gì: bài vẫn "Đang mở" vĩnh viễn, cổng phụ huynh
  // vẫn nhận bài (chỉ gắn cờ SubmissionStatus.LATE), và chỉ admin mới đóng được bằng tay.
  //
  // Nay trạng thái hiển thị SUY Ở LÚC ĐỌC (lib/lms/assignment-window.ts) — KHÔNG cron,
  // không cột `closedAt`: quá `dueAt` mà không có cửa gia hạn ⇒ coi như ĐÓNG.
  // `lateUntil` = hạn của cửa gia hạn do GV mở; bài nộp trong cửa này vẫn tính LATE
  // (đối chiếu `dueAt`, không đối chiếu `lateUntil`) để học bạ không mất dấu nộp trễ.
  // Học theo TrnAssignment (e-learning): gia hạn ghi hạn MỚI, KHÔNG bao giờ sửa `dueAt`.
  lateUntil       DateTime? @db.Timestamptz(6)
  lateReason      String?   @db.Text
  lateGrantedById String?
  lateGrantedAt   DateTime? @db.Timestamptz(6)

  status AssignmentStatus @default(DRAFT)

  createdById String?
  createdBy   Employee? @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  submissions AssignmentSubmission[]
  documents   AssignmentDocument[]
  questions   Question[]             @relation("AssignmentQuestions")
  // BGĐ 31/07 — file GV upload trực tiếp khi giao bài (khác documents = ngân hàng).
  attachments AssignmentAttachment[]

  // FL-R2 W5 (R2-LMS-4) — idempotent tự sinh từ template: 1 template → tối đa 1
  // Assignment/lớp. templateId nullable → bài tạo tay (templateId NULL) KHÔNG bị ràng.
  @@unique([classId, templateId])
  @@index([status, classId])
  @@index([dueAt])
  @@index([createdById])
  @@index([templateId])
  @@index([classSessionId])
}

// FL W0 (FL1-06, QĐ-T2) — TEMPLATE bài tập (nguồn/bank theo KHUNG CHƯƠNG TRÌNH / buổi),
// TÁCH khỏi Assignment (bài GIAO cho lớp). Template KHÔNG gắn lớp; gán vào buổi rồi sinh
// Assignment cho từng lớp. `createdById` là dấu vết audit (flat — không relation Employee).
model AssignmentTemplate {
  id String @id @default(cuid())

  title        String
  description  String         @db.Text
  instructions String?        @db.Text
  kind         AssignmentKind @default(HOMEWORK)

  lessonId     String?
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  curriculumId String?
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)

  totalPoints Float   @default(10)
  allowText   Boolean @default(true)
  allowFile   Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  instances         Assignment[]
  // FL1-06 (R2) — câu hỏi gắn vào template (từ ngân hàng) để khi sinh bài giao thì CLONE sang Assignment.
  templateQuestions AssignmentTemplateQuestion[]
  // BGĐ 31/07 — file GV upload khi soạn đề; khi giao bài được copy tham chiếu sang Assignment.
  attachments       AssignmentAttachment[]

  @@index([lessonId])
  @@index([curriculumId])
}

// FL1-06 (R2) — nối Template ↔ Question (ngân hàng). Khi generate bài giao cho lớp,
// mỗi link được CLONE thành Question mới gắn Assignment đích (Question.assignmentId).
model AssignmentTemplateQuestion {
  id         String             @id @default(cuid())
  templateId String
  template   AssignmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questionId String
  question   Question           @relation("QuestionTemplateLinks", fields: [questionId], references: [id], onDelete: Cascade)
  order      Int                @default(0)

  @@unique([templateId, questionId])
  @@index([templateId])
  @@index([questionId])
}

model AssignmentDocument {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document   @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([assignmentId, documentId])
  @@index([documentId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])

  textAnswer String? @db.Text
  fileUrl    String?
  fileName   String?
  fileSize   Int?
  mimeType   String?

  submittedAt DateTime?        @db.Timestamptz(6)
  status      SubmissionStatus @default(NOT_SUBMITTED)

  score      Float?
  feedback   String?   @db.Text
  gradedAt   DateTime? @db.Timestamptz(6)
  gradedById String?
  gradedBy   Employee? @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  rubricScores SubmissionRubricScore[]
  // BGĐ 31/07 — HV nộp NHIỀU file+ảnh (2-phase: cột fileUrl đơn ở trên GIỮ NGUYÊN,
  // luôn = file đầu tiên để màn cũ không vỡ).
  files        AssignmentSubmissionFile[]

  @@unique([assignmentId, studentId])
  @@index([status, assignmentId])
  @@index([studentId])
}

// BGĐ 31/07 — file GV đính kèm trực tiếp (upload R2) khi soạn đề (templateId) hoặc
// khi giao bài cho lớp (assignmentId) — đúng 1 trong 2 được set. Khác AssignmentDocument
// (ngân hàng Document dùng lại): attachment là file 1-lần gắn chặt với đề/bài.
model AssignmentAttachment {
  id String @id @default(cuid())

  templateId   String?
  template     AssignmentTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  fileUrl  String
  fileName String
  fileSize Int?
  mimeType String?

  // User.id người upload — audit flat, không relation.
  uploadedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([templateId])
  @@index([assignmentId])
}

// BGĐ 31/07 — nhiều file/ảnh cho MỘT bài nộp của HV.
model AssignmentSubmissionFile {
  id           String               @id @default(cuid())
  submissionId String
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  fileUrl  String
  fileName String
  fileSize Int?
  mimeType String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([submissionId])
}

// ─── Phase E7 — Audit log for generated PDF reports ──────────────────────
model ProgressReportLog {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  generatedById String?
  generatedBy   Employee? @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  sentToEmail   String?
  sentAt        DateTime? @db.Timestamptz(6)
  reportTitle   String
  metadata      Json?

  @@index([studentId, generatedAt])
  @@index([classId])
  @@index([generatedAt])
}

// ─── Phase F — Inventory ─────────────────────────────────────────────────
enum InventoryCategory {
  MAINBOARD
  SENSOR
  MOTOR
  BATTERY
  MECHANICAL
  WIRE
  TOOL
  CONSUMABLE
  ROBOSIM
  OTHER
}

model InventoryItem {
  id String @id @default(cuid())

  itemCode    String  @unique
  name        String
  description String? @db.Text

  category InventoryCategory @default(OTHER)
  unit     String            @default("Cái")

  pricePerUnit Int? // VND (số nguyên) — H5/COL2
  supplier     String?

  defaultMinThreshold Int @default(5)

  imageUrl String?
  tags     String[] @default([])

  isActive Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  balances   StockBalance[]
  movements  StockMovement[]
  auditItems InventoryAuditItem[] @relation("AuditedItem")

  @@index([category, isActive])
}

model StockBalance {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)

  quantity     Int  @default(0)
  reserved     Int  @default(0)
  minThreshold Int?

  lastReceiptAt DateTime? @db.Timestamptz(6)
  lastIssueAt   DateTime? @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([itemId, centerId])
  @@index([centerId, quantity])
  @@index([orgUnitId])
}

// ─── Phase F2 — Stock movement workflow ──────────────────────────────────
enum StockMovementType {
  RECEIPT // Nhập kho từ supplier
  ISSUE // Xuất kho cho lớp / sự kiện / hỏng
  TRANSFER_OUT // Chuyển đi cơ sở khác
  TRANSFER_IN // Nhận từ cơ sở khác
  ADJUSTMENT_INCREASE // Kiểm kê thừa
  ADJUSTMENT_DECREASE // Kiểm kê thiếu
}

model StockMovement {
  id String @id @default(cuid())

  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center        @relation(fields: [centerId], references: [id])

  type     StockMovementType
  quantity Int

  // TRANSFER pair link (OUT ↔ IN)
  transferPairId String?
  transferPair   StockMovement?  @relation("TransferPair", fields: [transferPairId], references: [id])
  transferOf     StockMovement[] @relation("TransferPair")

  // Free-form reference linking
  referenceType String?
  referenceId   String?
  referenceNote String?

  // Pricing snapshot (RECEIPT only) — VND (số nguyên), H5/COL2
  unitPrice Int?
  totalCost Int?

  performedById String?
  performedBy   Employee? @relation("MovementPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  performedAt   DateTime  @default(now()) @db.Timestamptz(6)
  notes         String?   @db.Text

  auditItem InventoryAuditItem? @relation("AuditMovement")

  @@index([itemId, centerId, performedAt])
  @@index([centerId, performedAt])
  @@index([type, performedAt])
  @@index([transferPairId])
  @@index([orgUnitId])
}

// ─── Phase F4 — Inventory audit (kiểm kê) ────────────────────────────────
enum InventoryAuditStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryAudit {
  id        String  @id @default(cuid())
  auditCode String? @unique
  centerId  String
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center  @relation(fields: [centerId], references: [id])

  status InventoryAuditStatus @default(DRAFT)

  // Snapshot stats (filled on submit)
  totalItems     Int @default(0)
  totalAdjusted  Int @default(0)
  totalIncreases Int @default(0)
  totalDecreases Int @default(0)

  performedById String?
  performedBy   Employee? @relation("AuditPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  performedAt   DateTime? @db.Timestamptz(6)

  notes String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items InventoryAuditItem[]

  @@index([centerId, performedAt])
  @@index([status])
  @@index([orgUnitId])
}

model InventoryAuditItem {
  id      String         @id @default(cuid())
  auditId String
  audit   InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemId  String
  item    InventoryItem  @relation("AuditedItem", fields: [itemId], references: [id])

  previousQty Int
  actualQty   Int
  delta       Int

  reason String? @db.Text

  // Link to the ADJUSTMENT movement generated on submit (null in DRAFT).
  movementId String?        @unique
  movement   StockMovement? @relation("AuditMovement", fields: [movementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([auditId, itemId])
  @@index([itemId])
}

// =============================================================================
// Phase 5.4.0 — Audit log foundation (5 domain-specific models)
// =============================================================================
// Follow pattern from RoleAuditLog + EnrollmentAuditLog: FK Cascade to target
// entity, nullable changedByUserId (defensive — no FK), changedByName snapshot
// for human-readable history forever, reason Text + metadata Json for extensibility.
// String action field (not enum) for consistency with existing pattern.
// =============================================================================

model UserAuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DISABLE" | "ENABLE" | "PASSWORD_RESET" | "ROLE_CHANGE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

model PermissionGrantAuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserGrantAudits", fields: [userId], references: [id], onDelete: Cascade)

  // grant snapshot — no FK because grant can be removed (REMOVE action)
  grantId   String?
  actionKey String // e.g. "users:manage"

  action String // "ADD" | "UPDATE" | "REMOVE"

  changedByUserId String?
  changedByName   String

  oldGrant String? // "ALLOW" | "DENY" | null (on ADD)
  newGrant String? // "ALLOW" | "DENY" | null (on REMOVE)

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

model LeadAuditLog {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation("LeadAuditLogs", fields: [leadId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DELETE" | "ASSIGN" | "STATUS_CHANGE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([leadId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Lead Activity + Task (Phase T1.2) ───────────────────────────────────────

enum LeadActivityType {
  CALL
  MESSAGE
  NOTE
  STATUS_CHANGE
  EMAIL
  HANDOVER // Module CRM PHẦN 3 — bàn giao khi chuyển lead
}

// Module CRM & Lead PHẦN 2 — cấu hình chia lead trong cơ sở.
enum LeadAssignMode {
  ROUND_ROBIN // luân phiên đều
  CLOSE_RATE // theo tỷ lệ chốt tháng gần nhất
  MANUAL // quản lý gán tay
}

model LeadAssignmentConfig {
  id        String  @id @default(cuid())
  centerId  String  @unique
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  mode      LeadAssignMode @default(ROUND_ROBIN)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  @@index([orgUnitId])
}

// Đợt D (22/08/2026) — SỔ LƯỢT của vòng luân phiên chia lead.
//
// Chủ dự án chốt Q7 (21/08): chia đều theo SỐ LƯỢT, "qua ngày không reset".
// Bộ đếm phải sống ở DB chứ không suy từ bảng Lead: 69% lead trên prod không đi
// qua vòng chia (gán tay / sale tự nhập / nhập Excel), lấy tổng lead làm bộ đếm
// là để phần nhiễu quyết định phần được chia.
//
// `orgUnitId` chứ không `centerId` — luật cứng Nền Hệ thống #3 cho bảng MỚI.
// Dòng của người đã rời vòng được GIỮ LẠI: họ quay lại thì vào đúng chỗ cũ,
// không làm lại từ 0 rồi nhận dồn.
model LeadRotationTurn {
  id           String    @id @default(cuid())
  orgUnitId    String
  userId       String
  /// Vị trí trong vòng. CHỈ TĂNG — không có đường về 0.
  turns        Int       @default(0)
  /// Khởi điểm lúc VÀO vòng (0 nếu có mặt từ đầu; = mức thấp nhất của vòng nếu
  /// vào sau). Số lead thật sự đã nhận qua vòng chia = `turns - seedTurns`.
  /// Không có cột này thì bảng bằng chứng nói sai về đúng người dễ bị soi nhất.
  seedTurns    Int       @default(0)
  /// Lần gần nhất tới lượt; null = chưa bao giờ. Dùng để phá hoà cho công bằng.
  lastTurnAt   DateTime? @db.Timestamptz(6)
  /// 29/08/2026 — CÓ NHẬN LEAD KHÔNG. Đây là tư cách thành viên pool, và nó nằm
  /// CHUNG HÀNG với bộ đếm có chủ đích (xem khối ghi chú bên dưới model này).
  ///
  /// Trước ngày này "pool" là điều kiện ngầm — `role SALES_CSM + isActive + thuộc
  /// đơn vị` — nên không tắt được một người mà không khoá cả tài khoản của họ.
  isActive     Boolean   @default(true)
  pausedAt     DateTime? @db.Timestamptz(6)
  /// Bắt buộc ở đường ghi khi tắt: tắt là lấy lead khỏi tay người ta.
  pausedReason String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([orgUnitId, userId])
  @@index([orgUnitId, isActive, turns])
  @@index([orgUnitId])
}

// ─── Chia lead tự động (29/08/2026) ─────────────────────────────────────────
//
// `LeadRotationTurn` ở trên vừa là BỘ ĐẾM LƯỢT vừa là TƯ CÁCH THÀNH VIÊN pool —
// cố ý một bảng. Hai thứ đó cùng khoá `(orgUnitId, userId)`, cùng được đọc/ghi
// trong một transaction dưới cùng một advisory lock, và luật "bật lại thì seed
// turns = MIN(pool đang bật)" là một thao tác ĐỌC isActive rồi GHI turns nguyên
// tử. Chung một hàng thì đó là MỘT `UPDATE`; tách hai bảng thì đó là hai bảng
// phải khoá đúng thứ tự — và sáu tháng nữa sẽ có người khoá sai thứ tự.
//
// Hai bảng dưới thì KHÁC: chúng là NHẬT KÝ, không phải trạng thái. Chia tách là
// đúng — trạng thái đọc mỗi lần chia, nhật ký chỉ ghi rồi đọc khi cần tra.

/// Đường nào đưa lead tới chủ của nó. Chỉ `AUTO` tiêu lượt của vòng.
enum LeadAssignSource {
  AUTO /// máy chia theo vòng luân phiên (hoặc tỷ lệ chốt)
  SELF /// sale tự nhập phiếu cho ĐÚNG cơ sở của mình
  MANAGER /// quản lý giao tay / đổi chủ
  IMPORT /// nhập Excel, dòng có sẵn tên sale hợp lệ
  AFFILIATE /// landing page có mã NV, người đó là sale ĐÚNG cơ sở khách chọn
  DUPLICATE /// trùng SĐT — giữ nguyên chủ cũ, không đụng bộ đếm
}

/// SỔ CHIA LEAD — mỗi lượt đưa lead tới một người là một dòng ở đây.
///
/// Vì sao tách khỏi `LeadAuditLog`/`LeadAssignmentHistory` đang có: hai bảng đó
/// trả lời "lead này từng đổi chủ thế nào". Bảng này trả lời câu khác — "vòng
/// chia có công bằng không" — nên nó phải mang `consumedTurn` + `poolSnapshot`,
/// hai thứ vô nghĩa với lịch sử đổi chủ. Ghi cả lượt KHÔNG tiêu lượt: đó chính
/// là chỗ giải thích vì sao "tổng lead đang giữ" cao hơn "lượt đã nhận".
model LeadAssignmentLog {
  id             String           @id @default(cuid())
  leadId         String?
  /// Luật cứng Nền Hệ thống #3: bảng MỚI dùng `orgUnitId`, không thêm `centerId`.
  orgUnitId      String
  assignedToId   String?
  createdById    String?
  source         LeadAssignSource
  consumedTurn   Boolean
  /// `turns` của người nhận NGAY SAU lượt này. Null khi không tiêu lượt.
  turnCountAfter Int?
  /// Ảnh chụp pool lúc chia: `[{userId, turns, isActive}]`. Không có nó thì một
  /// tháng sau không ai dựng lại được "vì sao lượt đó rơi vào người này".
  poolSnapshot   Json?
  note           String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)

  @@index([orgUnitId, createdAt])
  @@index([assignedToId, createdAt])
  @@index([leadId])
}

/// Nhật ký THAY ĐỔI POOL — ai bật/tắt/thêm ai, vì sao.
///
/// `reason` để nullable ở tầng DB nhưng đường ghi BẮT BUỘC có với `DEACTIVATE`
/// và `MANUAL_ADJUST`: hai thao tác đó lấy lead khỏi tay người ta.
model LeadAssignmentPoolEvent {
  id        String   @id @default(cuid())
  orgUnitId String
  userId    String
  /// ADD | ACTIVATE | DEACTIVATE | SEED | RESET_UNIT | MANUAL_ADJUST | TRANSFER
  action    String
  fromValue Json?
  toValue   Json?
  reason    String?
  actorId   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgUnitId, createdAt])
  @@index([userId, createdAt])
}

// Module CRM & Lead PHẦN 3/4 — log chuyển lead (sale/cơ sở) + bàn giao.
model LeadTransfer {
  id                String   @id @default(cuid())
  leadId            String
  fromCenterId      String?
  toCenterId        String?
  fromSaleId        String?
  toSaleId          String?
  note              String   @db.Text // nội dung bàn giao "đã tư vấn gì"
  reason            String? // lý do chuyển (tuỳ chọn)
  transferredById   String?
  transferredByName String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([leadId])
  @@index([fromCenterId, toCenterId])
}

enum LeadTaskStatus {
  OPEN
  DONE
  SKIPPED
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String
  type      LeadActivityType
  content   String           @db.Text
  metadata  Json?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([leadId, createdAt])
}

model LeadTask {
  id             String         @id @default(cuid())
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedToName String?
  title          String
  description    String?        @db.Text
  dueAt          DateTime       @db.Timestamptz(6)
  completedAt    DateTime?      @db.Timestamptz(6)
  status         LeadTaskStatus @default(OPEN)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  @@index([leadId])
  @@index([assignedToId, status, dueAt])
  @@index([status, dueAt])
}

// Phase T1.3 — log lần submit trùng SĐT (đã chặn tạo lead mới)
model LeadDuplicate {
  id             String   @id @default(cuid())
  primaryLeadId  String
  primaryLead    Lead     @relation("LeadDuplicates", fields: [primaryLeadId], references: [id], onDelete: Cascade)
  duplicatePhone String
  source         String?
  matchedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([primaryLeadId])
  @@index([duplicatePhone])
}

model ClassAuditLog {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation("ClassAuditLogs", fields: [classId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DELETE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([classId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

model StudentAuditLog {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation("StudentAuditLogs", fields: [studentId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "DELETE"

  changedByUserId String?
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([studentId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// =============================================================================
// Phase 5.6.0 — Payment + Order foundation
// =============================================================================
// Order is polymorphic via OrderItem.type (COURSE/PACKAGE/EXAM/PRODUCT).
// Customer info snapshotted on Order (immutable per order — no Parent model yet).
// VND-only Int storage. No Decimal, no multi-currency.
// Status workflow enforced at app layer via lib/orders/status.ts.
// =============================================================================

model PaymentMethod {
  id          String            @id @default(cuid())
  code        String            @unique // "CASH", "BANK_TRANSFER", "VNPAY", "TINGEE"
  name        String
  type        PaymentMethodType
  image       String?
  description String?           @db.Text

  // Allowed-for flags (match SataWorld pattern)
  canBuyCourse  Boolean @default(true)
  canBuyPackage Boolean @default(true)
  canBuyExam    Boolean @default(true)
  canBuyProduct Boolean @default(false) // Sprint 5.10
  canDeposit    Boolean @default(false) // wallet topup — reserved

  // ─── Tài khoản nhận tiền (chỉ BANK_TRANSFER) ─────────────────────────────
  // ⚠️ 31/08/2026 — 4 cột này TỪNG là dữ liệu chết (không đường tiền nào đọc), nay là
  // NGUỒN SỰ THẬT DUY NHẤT: mã QR gửi phụ huynh dựng từ đây. Kho cũ
  // `IntegrationConfig` khoá `VIETQR:<centerId>` đã NGỪNG là nơi khai (màn /admin/tich-hop
  // gỡ khối đó) và chỉ còn là đường LÙI cho dữ liệu cũ — xem lib/payments/vietqr.ts.
  //
  // Vì tài khoản gắn vào PHƯƠNG THỨC (không phải vào cơ sở), một cơ sở có thể khai nhiều
  // tài khoản bằng cách tạo nhiều phương thức chuyển khoản (vd Vietcombank + MB).
  bankBin           String? // mã ngân hàng 6 số chuẩn VietQR (970415 = Vietinbank)
  bankName          String?
  bankBranch        String?
  bankAccountNumber String?
  bankAccountName   String?

  // Gateway config (VNPAY/TINGEE only) — defer Sprint 5.6.5
  gatewayConfig Json?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  // ─── Thanh toán theo cơ sở (30/08/2026) ──────────────────────────────────
  // `centerId = NULL` nghĩa là PHƯƠNG THỨC DÙNG CHUNG cho mọi cơ sở (tiền mặt,
  // cổng online…), KHÔNG phải "chưa gán". Đây là lý do PaymentMethod phải khai ở
  // CẢ HAI nơi trong lib/db-scope.ts: `SCOPED_MODELS` (để cách ly) và
  // `NULL_IS_GLOBAL_MODELS` (để dòng dùng chung không bị `centerId IN (...)` ẩn mất
  // khỏi chính người cấp cơ sở — bỏ sót là form tạo đơn hiện danh sách RỖNG).
  //
  // ⚠️ `code` VẪN @unique TOÀN CỤC — cố ý không đổi sang @@unique([code, centerId]):
  //   (a) đổi khoá unique là ALTER trên bảng đang có dữ liệu prod (luật cứng #4),
  //   (b) 5 chỗ đang gọi `where: { code }` (3 file seed + 2 chỗ trong _actions) sẽ
  //       vỡ typecheck, và
  //   (c) Postgres coi NULL là khác nhau nên ("BANK_TRANSFER", NULL) vẫn chèn được
  //       hai lần ⇒ khoá ghép KHÔNG chặn được đúng ca cần chặn.
  // Quy ước thay thế: phương thức riêng của cơ sở đặt mã có hậu tố cơ sở
  // (`BANK_CS1`, `BANK_CS2` — đúng thứ prisma/seed-uat/01-nen.ts đã làm sẵn).
  centerId String?
  // Restrict (KHÔNG phải SetNull mặc định của Prisma cho quan hệ optional): xoá cơ sở
  // mà để null lại là biến phương thức RIÊNG của cơ sở đó thành DÙNG CHUNG — tài khoản
  // ngân hàng của một cơ sở đã đóng bỗng hiện ra cho mọi cơ sở còn lại.
  center   Center? @relation(fields: [centerId], references: [id], onDelete: Restrict)

  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4). Tự điền qua
  // lib/org/dual-write.ts nhờ khai PaymentMethod trong BACKFILL_SPECS.
  orgUnitId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  orders Order[]

  // Phase 5.6.1 — Audit log
  auditLogs PaymentMethodAuditLog[]

  @@index([code])
  @@index([isActive, displayOrder])
  @@index([centerId, isActive, displayOrder])
  @@index([orgUnitId])
}

model Order {
  id     String      @id @default(cuid())
  code   String      @unique // "ORD-260521-000001"
  type   OrderType
  status OrderStatus @default(DRAFT)

  // Customer snapshot (immutable per order)
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String? @db.Text
  customerWard    String?
  customerCity    String?
  customerCccd    String? // FIX lead→payment→enroll (M0) — CCCD người mua (snapshot đơn)

  // ─── Hoá đơn GTGT (14/09/2026) — khối "người mua" của mẫu hoá đơn ───
  // ĐỀU NULLABLE và KHÔNG có default: để trống = "chưa khai", đường đọc tự rơi về cột
  // `customer*` tương ứng (`lib/finance/hoa-don/nguoi-mua.ts`). Đặt default kiểu copy
  // `customerName` là biến "chưa khai" thành "đã khai đúng bằng tên người đặt" — sai im
  // lặng trên một tờ giấy pháp lý.
  //
  // ⚠️ KHÔNG có cột thuế suất / pháp nhân ở đây: đó là CẤU HÌNH vận hành, không phải
  // thuộc tính của đơn. Chốt vào đơn là mỗi lần BGĐ đổi mức thuế lại phải chạy migration.
  /// Người ĐỨNG TÊN hoá đơn — có thể khác người đặt đơn (1C26MNV-13: người mua "Phan Thị
  /// Hồng", học viên "Nguyễn Đức Huy Hoàng"). Trống ⇒ dùng `customerName`.
  invoiceBuyerName   String?
  /// Ô "Tên đơn vị" khi khách xuất hoá đơn cho công ty.
  invoiceCompanyName String?
  /// "MST/CCCD chủ hộ" của NGƯỜI MUA — khác mã số thuế của pháp nhân BÁN.
  invoiceTaxCode     String?
  /// Nơi nhận hoá đơn điện tử. Tách khỏi `customerEmail`: email nhận hoá đơn thường là
  /// email kế toán của khách, không phải email liên hệ. Trống ⇒ dùng `customerEmail`.
  invoiceEmail       String?

  // Optional links
  studentId String?
  student   Student? @relation("StudentOrders", fields: [studentId], references: [id])

  leadId String?
  lead   Lead?   @relation("LeadOrders", fields: [leadId], references: [id])

  /// N-2 · quyết định B4 (24/08/2026) — MỘT ĐƠN – MỘT CON. `leadId` là cấp PHỤ HUYNH,
  /// mà đơn vị sinh doanh thu là ĐỨA TRẺ: không có cột này thì "doanh thu theo học sinh"
  /// (C-03) và mẫu số của D-04/D-05 không tính được.
  /// NULL = **chưa quy được về con**, KHÔNG phải "không có con": đơn cũ tạo trước N-2,
  /// đơn vãng lai không gắn phiếu, và đơn của phiếu nhiều con mà người tạo không chọn.
  /// Báo cáo BẮT BUỘC hiện nhóm này thành một dòng riêng thay vì bỏ im lặng
  /// (`lib/reports/revenue-by-child.ts`). Đơn combo 2 con phải tách thành 2 đơn.
  /// SetNull: xoá phiếu con không được kéo theo đơn — đơn là chứng từ tiền.
  leadChildId String?
  leadChild   LeadChild? @relation("LeadChildOrders", fields: [leadChildId], references: [id], onDelete: SetNull)

  centerId  String?
  orgUnitId String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  center    Center? @relation(fields: [centerId], references: [id])

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  // Amounts (VND, Int)
  subtotal       Int @default(0)
  discountAmount Int @default(0)
  shippingFee    Int @default(0)
  totalAmount    Int @default(0)

  // Voucher (Sprint 5.7 — nullable, no FK yet)
  voucherCode String?

  // Payment proof / external refs
  bankReference String?
  gatewayTxnId  String?
  paidAt        DateTime? @db.Timestamptz(6)

  // Confirmation by staff
  // 31/08/2026 — NGƯỜI TẠO ĐƠN (cột danh sách /admin/orders).
  //
  // Cột TRẦN, KHÔNG quan hệ Prisma — theo đúng lối của `confirmedByUserId` ngay dưới,
  // `Payment.recordedById`, `installmentRequestedById`…: xoá/vô hiệu một nhân sự không
  // được kéo theo hay chặn đơn hàng. Tra tên bằng một query `user.findMany` ở tầng đọc
  // (khuôn mẫu: `queryPayments` trong admin/payments/_actions.ts).
  //
  // ⚠️ Đơn TẠO TRƯỚC ngày này để NULL vĩnh viễn: không có nguồn nào suy ngược ra người
  // tạo (AuditLog chưa từng ghi sự kiện tạo đơn — đo trên DB: chỉ có DISCOUNT_APPROVED).
  // Danh sách hiển thị "—" cho nhóm đó, KHÔNG đoán bừa.
  createdById String?

  confirmedByUserId String?
  confirmedAt       DateTime? @db.Timestamptz(6)

  // FIX lead→payment→enroll (M0/C4) — duyệt kế hoạch thanh toán 2 đợt.
  // null = không có kế hoạch 2 đợt cần duyệt.
  installmentApprovalStatus InstallmentApprovalStatus?
  installmentRequestedById  String?
  installmentApprovedById   String?
  installmentApprovedAt     DateTime?                  @db.Timestamptz(6)
  installmentRejectReason   String?                    @db.Text

  // BGĐ 31/07 — GIẢM GIÁ do nhân viên nhập tay: nhập theo % hoặc số tiền, BẮT BUỘC
  // giải trình, Quản lý cơ sở duyệt trước khi đơn được xác nhận. Giảm giá từ VOUCHER
  // (chính sách đã duyệt sẵn) KHÔNG đi qua luồng này → discountApprovalStatus = null.
  discountPercent        Int? // 1..100 khi nhập theo %; null = nhập số tiền tuyệt đối
  discountReason         String?                 @db.Text
  discountApprovalStatus DiscountApprovalStatus?
  discountRequestedById  String?
  discountApprovedById   String?
  discountApprovedAt     DateTime?               @db.Timestamptz(6)
  discountRejectReason   String?                 @db.Text

  // 25/09/2026 — DUYỆT SỐ BUỔI (mốc học phần). Chủ dự án: *"nếu buổi học khác 12 24 36 48
  // tức 1/2/3/4 học phần thì phải qua quản lý duyệt"*, chỉ áp cho khoá đủ 4 học phần
  // (`Course.totalSessions = 48`). Luật ở `lib/orders/so-buoi-hoc-phan.ts`.
  //
  // ⚠️ CỘT THỨ BA, KHÔNG gộp vào hai cột trên. Gộp là mất khả năng trả lời "đơn này phải
  // duyệt VÌ LÝ DO GÌ" khi đối soát — đúng lý do hai cột kia được giữ riêng (xem
  // `lib/orders/approval.ts`). Bốn cột phụ đi theo đúng khuôn của hai nhóm có sẵn.
  soBuoiApprovalStatus SoBuoiApprovalStatus?
  soBuoiRequestedById  String?
  soBuoiApprovedById   String?
  soBuoiApprovedAt     DateTime?             @db.Timestamptz(6)
  soBuoiRejectReason   String?               @db.Text

  customerNote String? @db.Text
  internalNote String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6) // FIX-C3 — soft-delete tài chính (read filter deletedAt: null)

  items   OrderItem[]
  history OrderStatusHistory[]

  // Sprint 5.7 — Voucher
  /// NHIỀU lượt dùng — mã áp theo DÒNG từ 28/09/2026 (trước đó `orderId @unique`).
  voucherRedemptions VoucherRedemption[] @relation("OrderVoucherRedemption")

  // Commit 4 — thanh toán tối đa 2 đợt
  installments    OrderInstallment[]
  payments        Payment[]          @relation("OrderPayments") // R7-04
  // 03/08 — sổ thu theo ĐỢT (PaymentRequest) + sổ phân bổ. Chạy SONG SONG với
  // OrderInstallment/Payment cho tới khi shadow-compare sạch (cờ PAYMENT_LEDGER_V2).
  paymentRequests PaymentRequest[]
  /// 16/09 — phiếu gộp: MỘT mã QR cho cả gia đình, chia về từng con theo thứ tự dòng.
  paymentBills    PaymentBill[]
  /// 26/09 — hoá đơn GTGT kế toán phát hành ở MISA rồi tải lên (docs/ke-toan-hoa-don/PLAN.md).
  hoaDonDienTu    HoaDonDienTu[]

  @@index([code])
  @@index([status])
  @@index([type, status])
  @@index([studentId])
  @@index([leadId])
  @@index([centerId, createdAt])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([orgUnitId])
  // IDX-4: cron order-debt-reminder (getOverdueOrders: status=PENDING + createdAt<cutoff
  // ORDER createdAt) + admin order lists filter status. status+createdAt phục vụ filter+sort.
  @@index([status, createdAt])
  // N-2 — "doanh thu theo con" gom Payment qua Order.leadChildId; không có index thì
  // mỗi lần mở tab Kinh doanh là một lượt quét toàn bảng đơn.
  @@index([leadChildId])
}

// Commit 4 — lịch thanh toán tối đa 2 đợt cho 1 Order.
enum InstallmentStatus {
  PENDING
  PAID
}

// FIX lead→payment→enroll (M0/C4) — trạng thái duyệt kế hoạch thanh toán 2 đợt.
enum InstallmentApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// BGĐ 31/07 — trạng thái duyệt GIẢM GIÁ nhập tay (Quản lý cơ sở duyệt).
enum DiscountApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// 25/09/2026 — trạng thái duyệt SỐ BUỔI (mốc học phần 12/24/36/48).
enum SoBuoiApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model OrderInstallment {
  id             String            @id @default(cuid())
  orderId        String
  soDot          Int // 1 hoặc 2
  amount         Int
  status         InstallmentStatus @default(PENDING)
  dueDate        DateTime?         @db.Timestamptz(6)
  paidAt         DateTime?         @db.Timestamptz(6)
  recordedById   String?
  // R7-04 — số ngày nhắc trước hạn (QĐ-O7); null → đọc SystemSetting default 14.
  reminderDays   Int?
  // Mốc nhắc công nợ gần nhất (chống spam — 1 nhắc/ngày).
  lastReminderAt DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict) // FIX-C3

  @@unique([orderId, soDot])
  @@index([status, dueDate])
}

model OrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict) // FIX-C3
  type    OrderItemType

  // Polymorphic refs (only one non-null per row, by type)
  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentOrderItems", fields: [enrollmentId], references: [id])

  packageId String?
  package   CoursePackage? @relation(fields: [packageId], references: [id])

  examAttemptId String?
  examAttempt   ExamAttempt? @relation("ExamOrderItems", fields: [examAttemptId], references: [id])

  // Phase 5.10.1 — FK to Product (SetNull on product delete)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Dòng hàng này mua cho CON NÀO (15/09/2026 — đơn nhiều con).
  ///
  /// Lúc tạo đơn thủ công thì `Enrollment` CHƯA tồn tại (convert-lead sinh sau), nên
  /// `enrollmentId` luôn null và không có gì phân biệt hai dòng của hai đứa trẻ. Cột này
  /// là chỗ đó.
  ///
  /// NULL là giá trị HỢP LỆ, không phải thiếu dữ liệu: đơn sản phẩm không thuộc học viên
  /// nào, và khách vãng lai thì con chưa có bản ghi `Student` (tên con nằm ở `itemName`).
  /// `SetNull` theo đúng nếp `productId`: xoá học viên không được kéo theo sổ tiền.
  studentId String?
  student   Student? @relation("StudentOrderItems", fields: [studentId], references: [id], onDelete: SetNull)

  // Item display snapshot (immutable)
  itemName        String
  itemDescription String? @db.Text

  // Pricing (VND, Int)
  quantity   Int @default(1)
  unitPrice  Int
  /// TẠM TÍNH của dòng — `unitPrice * quantity`, TRƯỚC giảm giá.
  ///
  /// Cố ý giữ nguyên nghĩa GỘP: `Order.subtotal` = Σ cột này, và chân bảng sản phẩm
  /// trừ giảm giá ở một dòng riêng. Đổi cột này thành số sau-giảm là làm lệch âm thầm
  /// ba đường ghi khác đang đặt nó bằng giá gộp (`backfill-order`, `ghi-giao-dich-cu`).
  totalPrice Int

  /// Giảm giá của RIÊNG dòng này (15/09/2026 — "tách riêng theo từng dòng").
  ///
  /// Ưu đãi thật gần như luôn bám vào MỘT em (anh chị em học cùng, học bổng), nên gộp
  /// thành một số ở cấp đơn là mất thông tin đúng lúc sau này phải trả lời: hoàn tiền
  /// cho một em thì trừ bao nhiêu.
  ///
  /// ⚠️ KHÔNG hạ `unitPrice` để thay cho cột này — `lib/orders/price-guard.ts` so
  /// `unitPrice` với giá niêm yết, nhét phần giảm vào đó là làm mù cổng soát giá.
  /// Cùng khuôn với `Enrollment` (listPrice + discountAmount + finalPrice).
  ///
  /// Thành tiền sau giảm = `totalPrice - discountAmount` (xem `lib/orders/giam-gia-dong.ts`).
  discountAmount  Int     @default(0)
  /// % đã gõ, giữ lại ý định của người bán. NULL = nhập theo số tiền tuyệt đối.
  discountPercent Int?
  /// Giải trình của RIÊNG dòng — dấu vết thay cho cơ chế duyệt đã gỡ 14/09/2026.
  discountReason  String? @db.Text

  /// CÁC KHOẢN giảm của dòng này, theo thứ tự người bán gõ (15/09/2026 — "làm flex").
  ///
  /// Ưu đãi thật chồng lên nhau: anh chị em học cùng + đóng sớm cả khoá + học bổng
  /// riêng. Một ô duy nhất làm mất TÊN của từng khoản — và đó đúng là thứ kế toán hỏi
  /// sáu tháng sau ("500.000đ này là chương trình nào").
  ///
  /// `[{ kieu: "SO_TIEN"|"PHAN_TRAM", giaTri: number, giam: number, lyDo: string|null }]`
  ///
  /// Cột JSON (thay vì bảng `OrderItemDiscount` riêng) và luật `discountPercent = NULL
  /// khi nhiều khoản` là hai đề xuất của người viết mã, chủ dự án đã PHÊ 15/09/2026
  /// ("bạn tự đề xuất rồi tự quyết đi"). Lý do đầy đủ ở đầu migration
  /// `20260915170000_order_item_nhieu_giam_gia`.
  ///
  /// ⚠️ KHÔNG phải sổ tiền thứ hai. Số tiền của dòng vẫn là `discountAmount` (Int) và
  /// `Order.discountAmount` = Σ cột đó; mảng này là BẢN GIẢI THÍCH của con số ấy. Ai
  /// cộng tiền thì cộng `discountAmount`, không duyệt JSON.
  ///
  /// ⚠️ `giaTri` (số đã gõ) và `giam` (số thực sự trừ được sau khi kẹp vào tạm tính của
  /// dòng) cố ý tách đôi: lưu một trong hai là hoặc bảng hiển thị cộng không ra tổng,
  /// hoặc mất dấu việc khoản cuối đã bị cắt bớt.
  discounts Json?

  metadata Json?

  // ── PHIÊN D · QUYẾT TOÁN KHI CON NÀY DỪNG HỌC [21/09/2026] ─────────────────
  //
  // ⚠️ KHÔNG sửa `totalPrice` / `discountAmount` ở trên. Hai cột đó là lời khai lúc BÁN
  // (`Order.subtotal` = Σ `totalPrice`; cổng soát giá so `unitPrice` với giá niêm yết).
  // "Rốt cuộc bé này phải trả bao nhiêu" là một sự kiện KHÁC xảy ra sau, nên nó có chỗ
  // riêng — và giữ cả hai con số là giữ được câu trả lời cho "đã bớt cho bé bao nhiêu vì
  // nghỉ giữa chừng".
  status            OrderItemStatus      @default(ACTIVE)
  stoppedAt         DateTime?            @db.Timestamptz(6)
  /// Ai bấm dừng. Cột TRẦN, không quan hệ — theo nếp `Order.createdById`: nhân sự nghỉ
  /// việc không được kéo theo hay chặn sổ tiền.
  stoppedById       String?
  /// Ngày BUỔI CUỐI mà sale xác nhận bé có học. Mốc đếm buổi đã dùng, và là ngày hiệu
  /// lực của `Enrollment.endedAt`.
  lastSessionDate   DateTime?            @db.Timestamptz(6)
  /// Số buổi đã dùng — đếm `ClassSession` của lớp có `date ≤ lastSessionDate`, KHÔNG đếm
  /// theo `status` (đo prod: buổi quá khứ phần lớn còn `SCHEDULED`; xem
  /// `lib/finance/lop-chua-chot-buoi.ts`). Sale xác nhận con số này bằng mắt.
  usedSessions      Int?
  /// SNAPSHOT `Course.totalSessions` lúc dừng — số buổi CAM KẾT của khoá.
  ///
  /// ⚠️ Chụp lại, cố ý KHÔNG đọc lại `Course` về sau (chủ dự án chốt 21/09): admin sửa số
  /// buổi cam kết sang năm không được làm đổi một khoản quyết toán đã chốt hôm nay.
  committedSessions Int?
  /// SNAPSHOT đơn giá một buổi = `(totalPrice − discountAmount) ÷ committedSessions`, làm
  /// tròn XUỐNG tới 1.000đ. Phần lẻ dồn vào buổi cuối — xem `lib/finance/dung-hoc.ts`.
  ///
  /// ⚠️ Tiền tố `stop` vì `OrderItem.unitPrice` ĐÃ tồn tại và là giá bán một đơn vị của
  /// dòng. Hai con số khác hẳn nhau; trùng tên là chỗ bug tiền nằm (`prisma format` bắt
  /// được lần đầu, nhưng đừng trông vào nó).
  stopUnitPrice     Int?
  /// Số tiền bé này rốt cuộc phải trả. **Công nợ của bé đọc cột này khi `status = STOPPED`.**
  /// `TRUNG_TAM_HUY` ⇒ luôn 0.
  usedValue         Int?
  stopReason        OrderItemStopReason?
  /// BẮT BUỘC khi sale sửa số buổi hệ thống gợi ý, và khi lý do là `KHAC`.
  stopNote          String?              @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// 16/09 — phiếu thu của RIÊNG dòng này ("công nợ theo CON").
  paymentRequests    PaymentRequest[]
  /// PHIÊN D — yêu cầu hoàn tiền sinh từ lượt dừng học của bé này.
  refundRequests     RefundRequest[]
  /// 16/09 — khoản tiền đã vào RIÊNG dòng này. Xem chú thích `Payment.orderItemId`.
  payments           Payment[]
  /// Lượt dùng mã khuyến mãi của RIÊNG dòng này [28/09/2026].
  voucherRedemptions VoucherRedemption[]

  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([enrollmentId])
  @@index([packageId])
  @@index([examAttemptId])
  @@index([productId])
  @@index([studentId])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict) // FIX-C3

  fromStatus OrderStatus
  toStatus   OrderStatus

  changedByUserId String? // no FK, defensive (consistent with audit log pattern)
  changedByName   String

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// Phase 5.6.1 — PaymentMethod audit log
model PaymentMethodAuditLog {
  id              String        @id @default(cuid())
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  action String // "CREATE" | "UPDATE" | "ENABLE" | "DISABLE"

  changedByUserId String? // no FK, defensive
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([paymentMethodId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Phase 5.7 — Voucher foundation ───────────────────────────────────────
// 5 types (COURSE/PACKAGE/KIT_ROBOT/SENSOR/ALL) × 2 discount kinds
// (PERCENT + max cap, FIXED). KIT_ROBOT/SENSOR can't apply until Sprint 5.10
// adds Product model — created here to lock the schema shape early.

model Voucher {
  id           String              @id @default(cuid())
  code         String              @unique // "OPENING2026", "SATA8_LAUNCH"
  name         String // "Giảm 20% khai trương 2026"
  description  String?             @db.Text
  type         VoucherType
  discountKind VoucherDiscountKind

  // Discount values — one of two non-null depending on discountKind
  discountPercent Int? // 1-100 (when PERCENT)
  discountAmount  Int? // VND (when FIXED)
  maxDiscount     Int? // cap VND (only when PERCENT)
  minOrderValue   Int  @default(0)

  // Usage limits
  quantity          Int? // null = unlimited
  usedCount         Int  @default(0)
  usageLimitPerUser Int  @default(1)

  // Validity
  validFrom  DateTime @db.Timestamptz(6)
  validUntil DateTime @db.Timestamptz(6)
  isActive   Boolean  @default(true)

  // Audit
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  createdByUserId String?

  // 26/09/2026 — chính sách khuyến mãi (văn bản BLĐ) mà mã này thuộc về. Cho phép trống vì
  // bảng có từ 24/05 (hệ mã khuyến mãi cũ, đã gỡ khỏi đơn 03/08); mã tạo mới LUÔN có cha
  // — xem `lib/khuyen-mai`. Hiệu lực của mã = hiệu lực của chính sách (đồng bộ khi sửa).
  policyId String?
  policy   PromotionPolicy? @relation(fields: [policyId], references: [id], onDelete: Restrict)

  redemptions VoucherRedemption[]
  auditLogs   VoucherAuditLog[]

  @@index([code])
  @@index([type, isActive, validFrom, validUntil])
  @@index([createdAt])
  @@index([policyId])
}

/// Chính sách khuyến mãi (26/09/2026) — một VĂN BẢN do BLĐ ban hành (mã SR.QD.xxx).
///
/// Chủ dự án: "chính sách mới thì BLĐ up lên là nhận luôn và gửi về cho sale tra cứu, sau
/// này sẽ add voucher vào quy trình thanh toán". Nên: ban hành = có hiệu lực theo ngày ngay,
/// báo Sale trong phạm vi, và mã voucher (bảng `Voucher`) là CON của văn bản.
///
/// ⚠️ Hôm nay CHƯA nối vào đơn hàng: giảm giá trên đơn vẫn nhập tay kèm giải trình
/// (`lib/orders/price-guard.ts`). Sale tra văn bản để biết được hứa gì với khách.
///
/// Không mang centerId/orgUnitId — phạm vi áp dụng là NỘI DUNG (`orgUnitIds`, rỗng = toàn
/// hệ thống), không phải dữ liệu thuộc một cơ sở. Không nằm trong SCOPED_MODELS.
///
/// "Còn hiệu lực" tính LÚC ĐỌC (không cron): `validFrom ≤ ngày ≤ validUntil` và chưa thu
/// hồi — một hàm duy nhất ở `lib/khuyen-mai/hieu-luc.ts`.
model PromotionPolicy {
  id            String  @id @default(cuid())
  /// Mã văn bản, vd "SR.QD.233". Khoá tra cứu của Sale và của agent (`ma_van_ban`).
  documentCode  String  @unique
  name          String
  /// Ưu đãi khách nhận được — Sale đọc câu này để tư vấn. Bắt buộc.
  benefitText   String  @db.Text
  /// Điều kiện áp dụng (đối tượng, số buổi tối thiểu, không cộng dồn…). Tuỳ chọn.
  conditionText String? @db.Text

  /// Ngày lịch VN, TÍNH CẢ HAI ĐẦU. `@db.Date` — nửa đêm UTC là đúng, không mang giờ.
  validFrom  DateTime @db.Date
  validUntil DateTime @db.Date

  /// OrgUnit.id các cơ sở được áp. Rỗng = toàn hệ thống.
  orgUnitIds String[] @default([])
  /// Course.id các khoá được áp. Rỗng = mọi khoá.
  courseIds  String[] @default([])

  /// Tệp văn bản gốc trên R2 (thư mục documents). Tuỳ chọn — văn bản chưa scan vẫn ban hành được.
  fileKey  String?
  fileName String?
  fileUrl  String?

  /// Thu hồi sớm: hết hiệu lực từ NGÀY thu hồi (ngày VN), dù `validUntil` còn xa.
  revokedAt    DateTime? @db.Timestamptz(6)
  revokedById  String?
  revokeReason String?   @db.Text

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  vouchers Voucher[]

  @@index([validFrom, validUntil])
  @@index([createdAt])
}

model VoucherRedemption {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  orderId String
  order   Order  @relation("OrderVoucherRedemption", fields: [orderId], references: [id], onDelete: Cascade)

  /// DÒNG ĐƠN đã dùng mã này [28/09/2026]. Mã áp theo DÒNG, không theo đơn: chương trình
  /// khai phạm vi bằng `PromotionPolicy.courseIds`, nên một đơn hai con học hai khoá khác
  /// nhau có thể ăn hai chương trình khác nhau.
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  customerPhone String // snapshot for per-user limit check
  customerId    String? // future: User account link (no FK, defensive)

  discountApplied Int // VND actual discount snapshot

  redeemedAt DateTime @default(now()) @db.Timestamptz(6)

  /// 1 DÒNG 1 MÃ (trước 28/09 là `orderId @unique` — "1 order = 1 voucher max").
  /// Đây cũng là khoá CHỐNG GHI ĐÔI: ghi lượt dùng hai lần cho cùng một dòng sẽ va khoá
  /// chứ không lặng lẽ cộng `usedCount` thêm một lần nữa.
  @@unique([orderId, orderItemId])
  @@index([voucherId, redeemedAt])
  @@index([customerPhone, voucherId])
  @@index([orderItemId])
}

model VoucherAuditLog {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  action          String // CREATE | UPDATE | ENABLE | DISABLE
  changedByUserId String? // no FK, defensive
  changedByName   String

  oldValues     Json?
  newValues     Json?
  changedFields String[] @default([])

  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([voucherId, createdAt])
  @@index([createdAt])
  @@index([changedByUserId])
}

// ─── Phase 5.9 — Student lifecycle: reserve history ───────────────────────
// Multiple reserve periods per student. enrollmentId NULL = áp dụng cho mọi
// active enrollment của học viên (whole-student reserve). Actor info được
// snapshot (không FK) để giữ audit trail dù user gốc bị xoá.

model StudentReserve {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation("StudentReserves", fields: [studentId], references: [id], onDelete: Cascade)

  enrollmentId String?
  enrollment   Enrollment? @relation("EnrollmentReserves", fields: [enrollmentId], references: [id], onDelete: SetNull)

  reason        String    @db.Text
  startedAt     DateTime  @default(now()) @db.Timestamptz(6)
  expectedEndAt DateTime? @db.Timestamptz(6)
  endedAt       DateTime? @db.Timestamptz(6)
  endReason     String?   @db.Text

  // Actor snapshots — no FK (defensive)
  createdByUserId String?
  createdByName   String
  endedByUserId   String?
  endedByName     String?

  /// Cờ phi chuẩn hoá để đọc nhanh. ⚠️ Từ Bảo lưu Phiên 2 nó là giá trị SUY RA từ `status`
  /// (`suyRaIsActive` trong `lib/bao-luu/trang-thai.ts`), chỉ được ghi trong hàm chuyển trạng thái.
  /// Lưới `[BL2-ISACTIVE]` cấm ghi ở nơi khác.
  isActive Boolean @default(true)

  // ── Bảo lưu Phiên 2 (docs/bao-luu/spec.md §F) — MỞ RỘNG bảng này, KHÔNG dựng bảng thứ hai ────
  // Ánh xạ tên thiết kế → cột sẵn có: startDate = startedAt · expectedReturnDate = expectedEndAt ·
  // actualEndDate = endedAt · requestedById/Name = createdByUserId/createdByName.
  /// `ACTIVE` mặc định để đường cũ (`reserveStudentAction` trước Phiên 3) vẫn nhất quán: lượt tạo
  /// ra là có hiệu lực ngay. Dòng cũ đã đóng được migration chuyển sang `ENDED`.
  status StudentReserveStatus @default(ACTIVE)
  /// Dòng cũ `enrollmentId = NULL` được migration gắn `LEGACY`; còn lại mặc định `PARENT`.
  type   StudentReserveType   @default(PARENT)
  reasonCode StudentReserveReason?
  reasonNote String? @db.Text

  /// Cơ sở của học viên tại lúc lập. Cột cách ly đang được `scopedDb` đọc (CLAUDE.md luật 3).
  centerId  String?
  /// Ghi kép tự động từ `centerId` (`lib/org/dual-write.ts`).
  orgUnitId String?

  requestedAt      DateTime? @db.Timestamptz(6)
  /// Buổi nghỉ đầu tiên khi lùi ngày bắt đầu (BR-09).
  firstAbsentDate  DateTime? @db.Timestamptz(6)
  approvedAt       DateTime? @db.Timestamptz(6)
  /// Hạn tiêu chuẩn = ngày bắt đầu + `maxMonths` (BR-10). Dòng cũ: chép từ `expectedEndAt`.
  standardEndDate  DateTime? @db.Timestamptz(6)
  extendedEndDate  DateTime? @db.Timestamptz(6)
  extendCount      Int       @default(0)
  /// Lý do kết thúc (RESUMED · TERMINATED · REFUNDED · TRANSFERRED). `endReason` (text) giữ nguyên
  /// làm ghi chú tự do của đường cũ.
  endKind          StudentReserveEndKind?

  officialNoticeSentAt    DateTime? @db.Timestamptz(6)
  officialNoticeChannel   String?
  responseDeadline        DateTime? @db.Timestamptz(6)
  lastContactAt           DateTime? @db.Timestamptz(6)

  // Ảnh chụp quyền lợi tại START (BR-14). ⚠️ Lưu CẶP chưa chia (tử số, số buổi mua) — chốt 07/10:
  // chia sớm là mất phần lẻ. `snapUnitPrice` là giá trị suy ra (làm tròn xuống 1.000đ) để hiển thị.
  // Thiếu giá ⇒ `snapUnitPrice = NULL`, KHÔNG BAO GIỜ 0 (0 = miễn phí, và `refund.ts` đọc 0 thành hoàn 100%).
  snapSessionsRemaining   Int?
  snapUnitPrice           Int?
  snapTuitionNet          Int?
  snapSoBuoiMua           Int?
  /// `true` khi `soBuoi` thiếu và hệ thống suy "mua đủ khoá" — hiện cho QLTT/Kế toán.
  snapSoBuoiSuyRa         Boolean @default(false)
  snapPricing             Json?
  snapStoppedAtLessonOrder Int?
  policySnapshot          Json?

  approvedById   String?
  extendedById   String?
  /// Đề nghị gia hạn đang chờ duyệt: { requestedById, requestedAt, newEndDate, reason }.
  extendRequest  Json?
  /// Khoá R2 RIÊNG TƯ (không phải URL công khai) — đọc qua URL ký hạn ngắn.
  applicationFileKey String?
  evidenceFileKeys   String[] @default([])
  resumeClassId      String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  events StudentReserveEvent[]

  @@index([studentId, isActive])
  @@index([studentId, startedAt])
  @@index([startedAt])
  @@index([endedAt])
  @@index([centerId, status])
  @@index([status, standardEndDate])
  @@index([orgUnitId])
}

enum StudentReserveStatus {
  PENDING
  APPROVED
  ACTIVE
  RESUME_PENDING
  ENDED
  REJECTED
  CANCELLED
  OVERDUE
  NOTICE_SENT
  TERMINATED
}

enum StudentReserveType {
  PARENT
  CENTER
  LEGACY
}

enum StudentReserveReason {
  ILLNESS
  FAMILY
  RELOCATION
  SCHEDULE
  OTHER
}

enum StudentReserveEndKind {
  RESUMED
  TERMINATED
  REFUNDED
  TRANSFERRED
}

enum StudentReserveEventKind {
  REQUEST
  APPROVE
  REJECT
  START
  EXTEND_REQUEST
  EXTEND
  CONTACT
  NOTICE
  RESUME_REQUEST
  RESUME
  EXPIRE
  ESCALATE
  TERMINATE
  RESTORE
  CANCEL
  CONVERT_CENTER
}

/// Nhật ký sự kiện của hồ sơ bảo lưu — BẤT BIẾN, chỉ INSERT (trigger chặn UPDATE).
model StudentReserveEvent {
  id        String   @id @default(cuid())
