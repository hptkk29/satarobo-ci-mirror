model MarketingConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([key])
}

// ============================================
// COURSE PACKAGES (Phase 4.UI.RESET.2 PART D3)
// Sata1-Sata8 + Combo packages — children of Course "laptrinhrobot"
// ============================================
model CoursePackage {
  id               String  @id @default(cuid())
  slug             String  @unique
  code             String
  name             String
  shortName        String?
  subtitle         String?
  shortDescription String? @db.Text
  description      String? @db.Text

  ageGroup String?
  level    String?

  lessons        Int?
  duration       String?
  priceOriginal  Int?
  priceEarlyBird Int?
  priceMember    Int?

  features   Json?
  highlights Json?
  curriculum Json?

  badge        String?
  color        String?
  displayOrder Int     @default(0)
  isPublished  Boolean @default(false)
  isFeatured   Boolean @default(false)

  thumbnail String?

  seoTitle       String?
  seoDescription String? @db.Text

  parentCourseSlug String?

  // FL W0 (FL1-05) — gắn gói bán với khoá dạy (gộp gói/khoá); `curriculum` JSON deprecate 2-phase.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // Phase TD-1 — Detail content cho /khoa-hoc/[slug]
  audienceTag          String?
  audienceDescription  String? @db.Text
