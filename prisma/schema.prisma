generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum GrantType {
  ALLOW
  DENY
}

enum Role {
  SUPER_ADMIN
  CENTER_MANAGER // Phase T0.1 — đổi tên từ MANAGER (quản lý cơ sở)
  HR
  SALES_CSM // Phase T0.1 — đổi tên từ SALES (tư vấn & chăm sóc học viên)
  TEACHER
  TRAINING // FL W0 (QĐ-T1) — Đào tạo: quản lý TOÀN BỘ LMS (curriculum/SCORM/câu hỏi/bài tập). KHÁC TEACHER (chỉ lớp được giao).
  MARKETING
  ACCOUNTANT
  PARENT // Phase T0.1 — phụ huynh (portal hocvien.satarobo.vn), KHÔNG vào /admin
}

// R1-04 — nguồn hoa hồng (SR.QD.217): từ ads/admin · sale tự kiếm · giới thiệu.
enum CommissionSource {
  MARKETING_ADMIN
  SALE_SELF
  REFERRAL
}

/// GĐ5 (25/08/2026) — RÚT TỪ 15 XUỐNG 10 GIÁ TRỊ theo đặc tả bàn giao mục 3.
///
/// Năm giá trị bị gỡ và lý do:
///   ASSIGNED       → chức năng của `Lead.assignedToId`, không phải một bậc phễu.
///   NO_ANSWER      → thuộc tính của LẦN GỌI, không phải của lead. Về DA_LIEN_HE.
///   DUPLICATE      → chặn bằng ràng buộc lúc tạo, không phải một bậc phễu.
///   DEMO_SCHEDULED → đã deprecated từ lâu, dữ liệu đã map sang hẹn học thử.
///   ENROLLED       → GỘP vào DA_DANG_KY (chủ dự án chốt câu 6 = A). Phân biệt "đã
///                    chốt" với "mới đăng ký" bằng `Lead.convertedAt`, không bằng
///                    trạng thái — mốc đó do chính lượt convert ghi nên chính xác hơn.
///
/// ⚠️ Khoá chống đua của convert PHẢI bám `convertedAt IS NULL` (đã đổi trước khi gộp).
/// Bám status như bản cũ thì sau khi gộp, lead "đã đăng ký" sẽ không convert được nữa.
enum LeadStatus {
  MOI
  DA_LIEN_HE
  DANG_TU_VAN
  DA_HEN_HOC_THU
  DANG_HOC_THU
  DA_HOC_THU
  CHO_QUYET_DINH
  DA_DANG_KY
  DANG_NUOI_DUONG
  DA_MAT
}

/// R7-01 — trạng thái học thử của từng con trong 1 lead (LeadChild).
enum LeadChildTrialStatus {
  NONE
  SCHEDULED
  IN_PROGRESS
  ATTENDED
}

/// C-06 (SL-09) — trạng thái phễu của TỪNG ĐỨA CON, tách hẳn `LeadStatus` (15 giá trị,
/// cấp phụ huynh). Một phụ huynh hai con: đứa này ghi danh trong khi đứa kia rớt là ca
/// thường, nên "chốt" và "rớt" phải đo được theo đầu học sinh.
/// KHÔNG tái dùng `LeadStatus`: 9/15 giá trị của nó ("Không nghe máy", "Trùng lặp",
/// "Đang nuôi dưỡng"…) vô nghĩa với một đứa trẻ, và guard chuyển trạng thái ở
/// `lib/leads/status.ts` bám vào ngữ cảnh thanh toán của cả phiếu.
enum LeadChildStatus {
  NEW // Mới
  CONSULTING // Đang tư vấn
  TRIAL_SCHEDULED // Hẹn học thử
  TRIAL_ATTENDED // Đã học thử
  ENROLLED // Chốt
  LOST // Rớt
}

enum CourseType {
  ONLINE
  OFFLINE
  HYBRID
}

enum EnrollmentStatus {
  // Legacy (kept for back-compat with existing rows)
  ACTIVE
  CANCELLED

  // D5 workflow
  PENDING
  CONFIRMED
  STUDYING
  PAUSED
  COMPLETED
  WITHDREW
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  // R7-08 — 2-phase bước A: thêm giá trị mới, map dần, chưa drop ABSENT/EXCUSED cũ.
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
}

// Module QL học viên PHẦN 2 — trạng thái học bù của buổi vắng.
enum MakeupStatus {
  NONE // không cần bù (mặc định)
  NEEDS_MAKEUP // vắng cần xếp buổi bù
  MADE_UP // đã học bù xong (tính như có mặt)
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
  PAUSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWED
  ACCEPTED
  REJECTED
}

// ─── Phase 5.6 — Payment + Order enums ────────────────────────────────────

enum PaymentMethodType {
  CASH
  BANK_TRANSFER
  VNPAY
  TINGEE
  COD
  WALLET // reserved for future wallet system (Sprint defer)
}

enum OrderType {
  COURSE // offline class enrollment
  PACKAGE // CoursePackage purchase
  EXAM // exam registration
  PRODUCT // physical product (kit/sensor) — Sprint 5.10
  COMBO // bundle, defer
}

// FIX lead→payment→enroll (M0/LD1/O1) — loại đơn dự kiến của lead (2 lựa chọn nghiệp vụ).
enum OrderKind {
  COURSE // Khoá học (gồm combo)
  PRODUCT // Sản phẩm
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED // payment confirmed, awaiting fulfillment
  COMPLETED // fulfilled (e.g., student attended class, kit delivered)
  CANCELLED // pre-COMPLETED cancellation
  REFUNDED // post-COMPLETED refund
}

enum OrderItemType {
  COURSE_ENROLLMENT // link tới Enrollment (offline class)
  COURSE_PACKAGE // link tới CoursePackage
  EXAM_REGISTRATION // link tới ExamAttempt
  PRODUCT // link tới Product (Sprint 5.10, nullable for now)
  MAKEUP_FEE // phí học bù khi hết lượt (docs/hoc-bu/DAC-TA.md) — không link bảng nào
}

/// PHIÊN D [21/09/2026] — một CON trên đơn còn đang học hay đã dừng.
///
/// Ở mức DÒNG ĐƠN chứ không mức đơn: đơn hai con thì một bé nghỉ, một bé học tiếp, và
/// `Order.status` không diễn đạt được điều đó.
enum OrderItemStatus {
  ACTIVE
  /// Đã quyết toán theo số buổi đã dùng. Công nợ của bé này đọc `usedValue`, KHÔNG đọc
  /// `totalPrice − discountAmount` nữa.
  STOPPED
}

/// Vì sao con này dừng học. `TRUNG_TAM_HUY` KHÔNG phải một nhãn hiển thị — nó ĐỔI PHÉP
/// TÍNH: trung tâm huỷ thì phí bằng 0 và toàn bộ đã thu thành khoản dư (chốt 21/09/2026).
enum OrderItemStopReason {
  PH_CHU_DONG
  TRUNG_TAM_HUY
  KHAC
}

// ─── Phase 5.7 — Voucher enums ────────────────────────────────────────────

enum VoucherType {
  COURSE // áp dụng cho đơn type=COURSE
  PACKAGE // áp dụng cho đơn type=PACKAGE
  KIT_ROBOT // áp dụng cho product category=KIT (Sprint 5.10 ready)
  SENSOR // áp dụng cho product category=SENSOR (Sprint 5.10 ready)
  ALL // áp dụng cho bất kỳ loại đơn
}

enum VoucherDiscountKind {
  PERCENT // % giảm + max cap VND
  FIXED // tiền cố định VND
}

// ─── Phase 5.10 — Product catalog enums ───────────────────────────────────

enum ProductCategory {
  KIT_ROBOT // Bộ kit robot hoàn chỉnh
  SENSOR // Cảm biến riêng lẻ
  MISSION_BLOCK // Khối nhiệm vụ thi đấu
  ACCESSORY // Phụ kiện
  BOOK // Sách/tài liệu
  CONSUMABLE // Vật tư tiêu hao
  OTHER
}

enum ProductStatus {
  DRAFT // Soạn nháp, chưa bán
  ACTIVE // Đang bán
  PAUSED // Tạm ngưng bán
  DISCONTINUED // Ngừng kinh doanh
}

enum ProductMovementType {
  PURCHASE // Nhập hàng (+)
  SALE // Bán (-)
  ADJUSTMENT // Điều chỉnh (+/-)
  DAMAGE // Hỏng (-)
  RETURN // Trả lại từ KH (+)
  TRANSFER_IN // Chuyển từ CN khác (+)
  TRANSFER_OUT // Chuyển sang CN khác (-)
}

// ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
}

// ─── Core Business ───────────────────────────────────────────────────────────

model Center {
  id            String  @id @default(cuid())
  code          String? @unique // Phase T0.2 — mã cơ sở "CS1", "CS2" cho codegen
  name          String
  slug          String  @unique
  address       String
  ward          String?
  district      String?
  city          String  @default("")
  phone         String?
  email         String?
  googleMapUrl  String? @db.Text
  workingHours  String?
  /// CHUỖI TÊN — chỉ để HIỂN THỊ (trang liên hệ, danh sách cơ sở). GIỮ NGUYÊN theo nếp
  /// hai pha: thêm `managerUserId` trước, bỏ cột này sau khi ổn định. ĐỪNG dùng nó để
  /// suy ra người hưởng hoa hồng — nó không nối được tới tài khoản nào.
  managerName   String?
  /// 27/08/2026 — LIÊN KẾT TÀI KHOẢN quản lý cơ sở. Bắt buộc khi TẠO cơ sở mới (ép ở
  /// tầng validator, không phải ở DB: cơ sở cũ chưa khai nên cột phải nullable).
  ///
  /// Đây là con trỏ "hiện tại" cho vận hành/hiển thị. NGUỒN SỰ THẬT của tiền là sổ
  /// `CenterCommissionAssignee` (role QL_TT) — hai thứ này được ghi TRONG CÙNG MỘT
  /// transaction bởi `datQuanLyCoSo()` (lib/crm/commission-assignee-store.ts), và màn
  /// quản trị hiện cảnh báo nếu chúng lệch nhau.
  managerUserId String?
  managerUser   User?   @relation("CenterManagerUser", fields: [managerUserId], references: [id], onDelete: SetNull)

  // Phase NHÓM 4 — geofence chấm công QR.
  latitude            Float?
  longitude           Float?
  allowedRadiusMeters Int?     @default(100)
  logoUrl             String?
  bannerUrl           String?
  description         String?  @db.Text
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  users             User[]
  leads             Lead[]
  classes           Class[]
  classGroups       ClassGroup[]
  trialClasses      TrialClass[]
  students          Student[]
  studentsPreferred Student[]        @relation("StudentPreferredCenter")
  employees         Employee[]
  rooms             Room[]
  holidays          Holiday[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  inventoryAudits   InventoryAudit[]

  // Phase 5.6 — Order
  orders Order[]

  // 27/08 — sổ người hưởng hoa hồng theo cơ sở (QC 1% + Quản lý TT 2%).
  commissionAssignees CenterCommissionAssignee[] @relation("CenterCommissionAssignees")
  // 30/08/2026 — phương thức thanh toán RIÊNG của cơ sở (dòng centerId = null là
  // phương thức dùng chung, không thuộc cơ sở nào).
  paymentMethods      PaymentMethod[]

  // Module chấm công v3 (L1 · 06/09/2026) — điểm chấm công của cơ sở vận hành.
  workLocations WorkLocation[]

  // 29/09/2026 — máy SmartPOS Techcombank đặt tại cơ sở (docs/pos-the-smartpos.md).
  posTerminals PosTerminal[]
  // 07/10/2026 — GĐ4 POS: máy đồng bộ (Chrome extension) của merchant portal cơ sở này.
  posAgents    PosAgent[]

  @@index([isActive])
  @@index([displayOrder])
  @@index([managerUserId])
}

// ─── A0-01 — OrgUnit tree (Doc 15 §2.1, OI-1) ───
// [Nền Hệ thống P1 · US-05] Hình cây ĐÃ ĐỔI (chủ dự án chốt 11/08/2026, theo BA 08/08 §1.1):
//   HO (gốc) → REGION (khối tỉnh/TP) → CENTER (cơ sở)
// Trước đó Doc 15 OI-1 để ROOT → HO, CS1, CS2 NGANG HÀNG; bản BA thắng theo README bàn giao §1.
// Node ROOT cũ (SATAROBO) vẫn hợp lệ về schema — việc dời cây trên DB đang chạy làm bằng
// script dry-run `scripts/nen-p1-reshape-org-tree.ts`, KHÔNG nhét vào migration (luật cứng #4).
enum OrgUnitType {
  ROOT
  HO
  REGION // P1 — khối quản lý tỉnh/TP (BA §1.1); cha của CENTER
  DEPARTMENT // P1 — phòng ban trong HO/cơ sở (BA §2.2)
  CENTER
  CAMPUS
  PARTNER
  FRANCHISE
}

// P1 — TRỤC SỞ HỮU, độc lập với unitType (BA §2.2: thứ AMIS không có).
// KHÔNG suy từ OrgUnitType.FRANCHISE (giá trị chết, giữ lại chỉ vì additive).
enum OrgRelationshipType {
  OWNED
  FRANCHISEE
  AFFILIATE
}

// P1 — vòng đời đơn vị (BA §2.2). GHI CHÚ QUAN TRỌNG: tới hết P1 đây là cột GƯƠNG của
// `isActive`, KHÔNG phải nguồn sự thật thứ ba. Mọi nơi hỏi "đơn vị còn sống không" đi qua
// đúng một hàm `isOrgUnitLive()` / `isOrgUnitActiveAt()` trong lib/org/status.ts.
enum OrgUnitStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model OrgUnit {
  id      String      @id @default(cuid())
  type    OrgUnitType
  code    String      @unique // "SATAROBO","HO","DANANG","CS1","CS2"
  name    String
  address String? // chỉ thông tin, KHÔNG suy ra quan hệ quản lý

  parentId String?
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children OrgUnit[] @relation("OrgUnitTree")

  // P1 · US-05 — materialized path. Dạng "/ho/danang/cs1/" (CÓ "/" ở cuối để `LIKE path || '%'`
  // cắt đúng biên node, không dính "/cs1" với "/cs10"). Segment = code viết thường, "_" → "-".
  // Nullable ở P1 vì migration additive; write path LUÔN set, invariant test chặn NULL mới.
  path  String?
  depth Int?

  relationshipType OrgRelationshipType @default(OWNED)
  status           OrgUnitStatus       @default(ACTIVE)
  effectiveFrom    DateTime?           @db.Timestamptz(6)
  effectiveTo      DateTime?           @db.Timestamptz(6)

  // Pháp nhân sở hữu (US-06). Nullable: đơn vị nội bộ chưa gắn pháp nhân vẫn hợp lệ ở P1.
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  // Khuôn mẫu sinh ra đơn vị — BA §6 "chừa cột trước, engine sau" (UnitTemplate là P5).
  // Cố ý KHÔNG có FK: bảng đích chưa tồn tại.
  templateId String?

  centerId   String?     @unique // Phase A: trỏ Center cũ. P1 nới cho cả HO (Center 'hoi-so').
  isActive   Boolean     @default(true)
  deletedAt  DateTime?   @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(6)
  positions  Position[]  @relation("PositionOrgUnit")
  workScopes WorkScope[] @relation("WorkScopeOrgUnit")

  /// EL-03 — yêu cầu đào tạo áp cho chính đơn vị này (scopeKind=ORG_UNIT).
  trnRequirements TrnRequirement[] @relation("TrnRequirementOrgUnit")

  @@index([type])
  @@index([parentId])
  @@index([deletedAt])
  // text_pattern_ops PHẢI khai ở đây cho khớp migration 20260811030000. Thiếu nó, lần
  // `prisma migrate dev` kế tiếp thấy shadow DB có opclass còn schema thì không, và sinh
  // migration DROP/CREATE đổi về btree thường — mọi `path LIKE '/ho/danang/%'` của P3 âm
  // thầm quay về seq scan.
  @@index([path(ops: raw("text_pattern_ops"))])
  @@index([legalEntityId])
  @@index([status])
}

// [Nền Hệ thống P1 · US-06] Pháp nhân — TÁCH khỏi đơn vị vận hành (BA §2.3).
// Vì sao tách: học phí thu ở cơ sở nhượng quyền thuộc pháp nhân CỦA HỌ, không phải doanh
// thu của SataRobo. Gắn doanh thu vào orgUnitId thôi là ngày ký hợp đồng đầu tiên phải sửa bảng.
model LegalEntity {
  id        String    @id @default(cuid())
  taxCode   String    @unique // MST — khoá nghiệp vụ thật
  legalName String
  address   String?
  // Đúng MỘT pháp nhân gốc SataRobo. Ép bằng partial unique index (chỉ 1 dòng isPrimary=true).
  isPrimary Boolean   @default(false)
  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  orgUnits OrgUnit[]

  @@index([deletedAt])
}

// ─── A0-02 — RBAC động (Doc 15 §2.2/§2.3) ───
// Role + permission + gán quyền nằm trong DB; admin cấu hình qua UI. can() v2 (A0-03)
// đọc các bảng này. KHÔNG đụng matrix tĩnh permissions.ts / User.role[] (cắt ở Phase C).
enum ScopeType {
  GLOBAL
  CENTER
  CLASS
  OWN
  CHILDREN
  ASSIGNED
}

enum AssignStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model RoleDef {
  id            String           @id @default(cuid())
  code          String           @unique // HO_ACCOUNTANT, CENTER_MANAGER...
  name          String
  isSystem      Boolean          @default(false) // SUPER_ADMIN, PARENT — không xóa/đổi code
  isActive      Boolean          @default(true)
  /// Đường dẫn mục menu ẨN với vai này (vd "/students") — chỉ gọn MENU, KHÔNG đổi quyền:
  /// trang vẫn mở được bằng link. Người giữ nhiều vai: mục chỉ ẩn khi MỌI vai đang dùng
  /// đều ẩn nó (`lib/auth/menu-gon.ts`). Nguồn: `prisma/seed-roles.ts` + màn Vai trò & quyền.
  anMenu        String[]         @default([])
  permissions   RolePermission[]
  userRoles     UserOrgRole[]
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  positionRoles PositionRole[]
}

model RolePermission {
  roleId    String
  action    String // validate qua ACTION_REGISTRY
  scopeType ScopeType
  role      RoleDef   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, action])
  @@index([roleId])
}

// ─── Nền Hệ thống P0 · US-01 — Registry quyền tập trung (TS-01) ───
// Nguồn khai báo: lib/permissions/registry (mỗi module 1 ModuleDecl). Seed nạp lúc
// deploy qua prisma/seed-permission-registry.ts (pnpm db:seed:permissions).
// Key vắng khỏi khai báo → isActive=false, KHÔNG DELETE (giữ vết audit/rollback).
model PermissionDescriptor {
  key             String   @id // vd "leads:view-all" (format v1) — format mới chuẩn hoá ở pha sau
  module          String // module nghiệp vụ sở hữu quyền, vd "crm", "lms"
  action          String // verb thô sau dấu ":"
  scopable        Boolean  @default(true) // quyền có cần data scope không (BA §2.5)
  sensitiveFields String[] @default([])
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  grants PermissionGrant[] // US-02 — grant trỏ về key registry (Restrict: không xoá key còn grant)

  @@index([module])
}

// ─── Nền Hệ thống P0 · US-02 — PermissionGrant (TS-02) ───
// Bảng grant MỚI cho engine can() hợp nhất (lib/permissions/can.ts). Ship RỖNG:
// không grant khớp → fallback NGUYÊN TRẠNG đường cũ (v1/v2/shadow/flag).
// KHÔNG liên quan UserPermissionGrant cũ — engine mới TUYỆT ĐỐI không đọc bảng cũ
// (test ghim [A0-03-T6-02] "grant DENY không làm mất quyền role" phải xanh nguyên trạng).

/// US-02 — chủ thể nhận grant: RoleDef (subjectId = RoleDef.id) hoặc UserGroup (US-03).
enum GrantSubjectType {
  ROLE
  GROUP
}

/// US-02 — phạm vi dữ liệu của grant (BA §2.5). Trước P1 fallback theo centerId (AC3).
enum DataScope {
  ALL
  UNIT_AND_BELOW
  UNIT_ONLY
  OWN
}

model PermissionGrant {
  id            String               @id @default(cuid())
  subjectType   GrantSubjectType
  subjectId     String // polymorphic theo subjectType (RoleDef.id | UserGroup.id US-03) — KHÔNG FK có chủ đích
  // FK về registry (Restrict): không cho grant trỏ key chưa khai báo, không xoá key còn grant.
  permissionKey String
  descriptor    PermissionDescriptor @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  effect        GrantType // ALLOW | DENY — DENY fieldMask rỗng chặn action, KHÁC rỗng chỉ che trường
  dataScope     DataScope
  fieldMask     String[]             @default([]) // rỗng = toàn action; khác rỗng (DENY) = che các trường này
  derivedFrom   String? // vd hợp đồng franchise sinh grant (BA §6 "chừa cột trước" — engine chưa dùng)
  reason        String?              @db.Text // lý do cấp/chặn (audit)
  createdById   String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  @@unique([subjectType, subjectId, permissionKey, effect])
  @@index([subjectType, subjectId])
  @@index([permissionKey])
}

// ─── Nền Hệ thống P0 · US-03 — UserGroup (nhóm người dùng, TS-02) ───
// Nhóm cấp quyền ad-hoc cho ít người mà không sửa vai trò chuẩn: PermissionGrant
// subjectType=GROUP trỏ subjectId = UserGroup.id (polymorphic, không FK — như ROLE).
// SOFT DELETE (deletedAt): nhóm đã xoá → resolveActor bỏ membership → grant của nhóm
// VÔ HIỆU ngay lần resolve kế, KHÔNG cần dọn grant. Grant GROUP ở P0 chỉ nhận
// dataScope ALL|OWN (validator chặn UNIT_* — GROUP không có mapping roleCenterScope
// tới P1, xem [PIN] trong lib/permissions/can.test.ts).
model UserGroup {
  id          String    @id @default(cuid())
  // Unique theo tên CHỈ giữa nhóm còn sống: partial unique index
  // "UserGroup_name_active_key" ON (name) WHERE deletedAt IS NULL — Prisma chưa
  // biểu diễn được partial index nên viết trong SQL migration (20260809160000).
  name        String
  description String?   @db.Text
  deletedAt   DateTime? @db.Timestamptz(6) // SOFT DELETE — nhóm xoá vẫn giữ vết audit
  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  members UserGroupMember[]
}

// Thành viên nhóm — HARD DELETE (gỡ là mất ngay ở lần resolve kế; audit ở RbacAuditLog).
model UserGroupMember {
  userId    String
  groupId   String
  addedById String? // ai thêm (audit nhẹ tại chỗ; vết đầy đủ ở RbacAuditLog)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model UserOrgRole {
  userId        String
  orgUnitId     String
  roleId        String
  effectiveFrom DateTime     @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?    @db.Timestamptz(6) // null = vô thời hạn
  status        AssignStatus @default(ACTIVE)
  grantedById   String // ai cấp (audit)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  role          RoleDef      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, orgUnitId, roleId])
  @@index([userId])
  @@index([orgUnitId])
  @@index([roleId])
}

// Audit cho thay đổi role/permission/assignment (AC4). A0-06 sẽ hợp nhất AuditLog.
model RbacAuditLog {
  id              String   @id @default(cuid())
  entity          String // ROLE | PERMISSION | ASSIGNMENT
  entityId        String
  action          String // CREATE | UPDATE | DELETE | ASSIGN | REVOKE
  changedByUserId String?
  changedByName   String
  oldValues       Json?
  newValues       Json?
  reason          String
  metadata        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([changedByUserId])
  @@index([createdAt])
}

// ─── A0-06 — AuditLog HỢP NHẤT (Doc 15 §8.1) ───
// 1 bảng cho mọi module (thay 8 bảng audit cũ — giữ đọc-only). Immutable: KHÔNG
// có server action update/delete. Viewer scope theo orgUnitId + mask PII theo quyền.
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String? // null = System (cron/dispatcher)
  actorName     String // snapshot tên actor
  module        String // 'rbac','orders','employees',...
  entityType    String
  entityId      String
  action        String // CREATE/UPDATE/DELETE/STATUS_CHANGE/EXPORT/SCOPE_BYPASS...
  oldValues     Json?
  newValues     Json?
  changedFields String[]
  reason        String?
  orgUnitId     String? // để scope viewer theo cơ sở
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@index([orgUnitId, createdAt])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
}

// ─── A0-07 — DomainEvent outbox (Doc 15 §4.5) ───
// Ghi event TRONG transaction nghiệp vụ → dispatcher (cron) gọi handler theo type,
// idempotent + retry. Thêm consumer = 1 dòng on(), không sửa publisher.
model DomainEvent {
  id          String    @id @default(cuid())
  type        String
  payloadJson Json
  status      String    @default("PENDING") // PENDING/PROCESSING/DONE/FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  dedupeKey   String?   @unique // idempotency producer-side
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([type])
}

// ─── A0-08 — EmployeeOrgAssignment (Doc 15 §2.2, OI-6/OI-8/OI-10) ───
// Nhân sự/kiêm nhiệm/lương — KHÔNG sinh quyền (quyền chỉ từ UserOrgRole).
/// P2 · US-08 — KIỂU PHÂN CÔNG VỊ TRÍ (BA §2.4). KHÁC hẳn `AssignmentType` ngay bên
/// dưới: cái đó là phân bổ nhân sự/lương của `EmployeeOrgAssignment` và CỐ Ý KHÔNG sinh
/// quyền; cái này quyết định người đó hưởng bộ quyền của Position nào.
/// Lý do điều động (BA §2.4). Là DỮ LIỆU VẬN HÀNH, không tham gia tính quyền — engine
/// chỉ hỏi "đơn vị nào, trong khoảng nào"; lý do để người duyệt và người tra soát đọc.
enum WorkScopeReason {
  TEACHING
  MAKEUP
  TRIAL
  SUPPORT
}

enum PositionAssignmentKind {
  PRIMARY
  CONCURRENT
  DELEGATED
}

/// P2 · US-08 — VỊ TRÍ CÔNG VIỆC (BA §2.4). Quyền gắn vào VỊ TRÍ, không gắn vào người:
/// người nghỉ → gỡ assignment, vị trí giữ nguyên bộ quyền cho người kế nhiệm.
///
/// `reportsToPositionId` là CÂY THỨ HAI, độc lập cây tổ chức (BA §10): dùng cho luồng
/// duyệt, **KHÔNG** dùng để resolve dataScope. Chống vòng lặp enforce ở tầng ghi
/// (`assertNoReportingCycle`) — Postgres không có ràng buộc đệ quy khai báo được.
model Position {
  id                  String    @id @default(cuid())
  /// Đơn vị TRỰC THUỘC (biên chế) — nơi TÁC NGHIỆP là WorkScope của assignment (US-10).
  orgUnitId           String
  title               String
  isManagerial        Boolean   @default(false)
  reportsToPositionId String?
  isActive            Boolean   @default(true)
  deletedAt           DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  orgUnit     OrgUnit              @relation("PositionOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  reportsTo   Position?            @relation("PositionReportsTo", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  reports     Position[]           @relation("PositionReportsTo")
  roles       PositionRole[]
  assignments PositionAssignment[]

  /// EL-03 — yêu cầu đào tạo theo vị trí. PROD có 0 dòng Position (20/08/2026) nên
  /// ở GƐ1 nhánh này áp cho 0 người — giữ FK vì nó rẻ, không vì nó dùng được ngay.
  trnRequirements TrnRequirement[] @relation("TrnRequirementPosition")

  @@index([orgUnitId, isActive])
  @@index([reportsToPositionId])
}

/// Bộ vai trò của một vị trí. Người nhận assignment vào vị trí hưởng đủ các vai này.
model PositionRole {
  positionId String
  roleId     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  role     RoleDef  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([positionId, roleId])
  @@index([roleId])
}

/// Phân công một NGƯỜI vào một VỊ TRÍ, có thời hạn (US-09 mở rộng ràng buộc PRIMARY).
///
/// ⚠️ TÊN `Assignment` ĐÃ BỊ CHIẾM bởi bài tập LMS (`model Assignment` phía dưới), nên
/// entity của BA mang tên `PositionAssignment`. Đừng đổi lại — đổi là va tên trên toàn
/// bộ Prisma Client.
///
/// KHÔNG xoá lịch sử: hết hiệu lực thì đóng `effectiveTo`, quyền tự tắt vì resolver lọc
/// theo mốc thời gian (US-09 AC2 — không cần cron gỡ tay).
model PositionAssignment {
  id            String                 @id @default(cuid())
  positionId    String
  userId        String
  kind          PositionAssignmentKind @default(PRIMARY)
  effectiveFrom DateTime               @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?              @db.Timestamptz(6)
  status        AssignStatus           @default(ACTIVE)
  note          String?
  createdById   String?
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(6)

  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  user     User     @relation("UserPositionAssignments", fields: [userId], references: [id], onDelete: Cascade)

  workScopes WorkScope[]

  @@index([userId, status])
  @@index([positionId, status])
}

/// P2 · US-10 — NƠI TÁC NGHIỆP, tách khỏi NƠI TRỰC THUỘC (BA §2.4).
///
/// Giáo viên biên chế phòng Đào tạo (Hội sở) được điều xuống CS1 dạy: `Position.orgUnitId`
/// giữ nguyên (biên chế không đổi), `WorkScope` mở đúng CS1 trong đúng khoảng thời gian.
/// Đổi cơ sở dạy = sửa WorkScope, KHÔNG đụng vai trò hay quyền.
///
/// ⚠️ WorkScope KHÔNG cấp quyền — nó chỉ NỚI PHẠM VI DỮ LIỆU của những vai người đó ĐÃ có
/// qua phân công này. Giáo viên được điều sang CS1 vẫn chỉ là giáo viên ở CS1, và vẫn chỉ
/// thấy lớp mình được phân công (quyền lớp của họ vốn scope ASSIGNED).
///
/// ⚠️ KHÔNG có cột `status`: "còn hiệu lực" ở đây là một KHOẢNG THỜI GIAN. Thêm cờ song
/// song là đẻ nguồn sự thật thứ hai — bài học US-09. Kết thúc điều động = đóng `effectiveTo`.
model WorkScope {
  id            String          @id @default(cuid())
  assignmentId  String
  orgUnitId     String
  reason        WorkScopeReason
  effectiveFrom DateTime        @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime?       @db.Timestamptz(6)
  note          String?
  createdById   String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  assignment PositionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  orgUnit    OrgUnit            @relation("WorkScopeOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([orgUnitId])
}

enum AssignmentType {
  PRIMARY
  SECONDARY
  SUPPORT
  SUBSTITUTE
  SHARED
}

model EmployeeOrgAssignment {
  id                String         @id @default(cuid())
  employeeId        String
  orgUnitId         String
  roleInOrg         String? // mô tả vai trò nghiệp vụ (KHÔNG phải RoleDef)
  assignmentType    AssignmentType
  effectiveFrom     DateTime       @default(now()) @db.Timestamptz(6)
  effectiveTo       DateTime?      @db.Timestamptz(6)
  status            AssignStatus   @default(ACTIVE)
  allocationPercent Int? // 0..100 — phân bổ chi phí/lương
  createdById       String
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  @@index([employeeId, status])
  @@index([orgUnitId, status])
}

// ─── R1-01 — CRM Messenger (SR.QD.217, Doc 15 §5) ───
// Page HO/CS → hội thoại → message. centerId để scopedDb cách ly (C1.4).
model FacebookPageMapping {
  id        String      @id @default(cuid())
  pageId    String      @unique
  pageName  String?
  scopeType OrgUnitType // HO | CENTER (validate ở service)
  centerId  String? // chỉ khi scopeType=CENTER
  // P1 · US-07 — cột SONG SONG với centerId (ghi kép tới hết P4).
  // Cột TRẦN, không FK — giống 28 bảng của PR-A. Ý nghĩa của NULL theo
  // từng bảng: xem BACKFILL_SPECS trong lib/org/center-bridge.ts.
  orgUnitId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([scopeType])
  @@index([orgUnitId])
}

model MessengerConversation {
  id             String             @id @default(cuid())
  pageId         String
  psid           String // page-scoped user id
  parentName     String?
  phone          String?
  status         String             @default("OPEN") // OPEN/QUALIFIED/CLOSED
  centerId       String? // suy từ page mapping → scopedDb
  orgUnitId      String? // PR-A: OrgUnit.id (song song centerId, scopedDb flip ở PR-D)
  firstMessageAt DateTime?          @db.Timestamptz(6)
  respondedAt    DateTime?          @db.Timestamptz(6)
  leadId         String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  messages       MessengerMessage[]

  @@unique([pageId, psid])
  @@index([centerId])
  @@index([status])
  @@index([leadId])
  @@index([orgUnitId])
}

model MessengerMessage {
  id              String   @id @default(cuid())
  conversationId  String
  direction       String // IN | OUT
  text            String?  @db.Text
  attachments     Json?
  externalEventId String?  @unique // idempotency webhook (R1-02 C2.4)
  sentAt          DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  // ── S-2b (27/08/2026) — SỔ ĐỐI SOÁT LƯỢT GỬI RA META. Chỉ THÊM cột, nullable,
  // không đụng cột cũ: tin ĐẾN và mọi tin cũ trước đợt này để NULL, đọc ra đúng nghĩa
  // "không có thông tin", không phải "đã gửi thành công".
  /// PENDING | SENT | SIMULATED | FAILED (lib/crm/messenger-send.ts). NULL = tin ĐẾN / tin cũ.
  /// PENDING nằm lại = tiến trình chết giữa chừng, KHÔNG rõ tin có tới khách không.
  /// SIMULATED = đã ghi sổ nhưng KHÔNG gọi Meta ⇒ KHÁCH KHÔNG NHẬN GÌ (tiền lệ ZNS).
  sendStatus        String?
  /// `mid` Meta trả về khi gửi thật — bằng chứng duy nhất tin đã đi.
  providerMessageId String?
  /// Mã lỗi Meta dạng `code` hoặc `code/subcode` (vd `10/2018278` = ngoài cửa sổ 24h).
  errorCode         String?
  /// Nguyên văn lời Meta, ĐÃ lọc secret (lib/crm/meta-messenger-provider.ts).
  errorMessage      String? @db.Text
  /// Người thật bấm gửi (User.id, ref phẳng). Nguồn attribution duy nhất cho tin OUT.
  sentByUserId      String?

  conversation MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  /// Đối soát: "còn lượt gửi nào kẹt PENDING / hỏng FAILED không".
  @@index([sendStatus, sentAt])
}

// R1-10 — Bảng hoa hồng theo kỳ (SR.QD.217, tiền). DRAFT→APPROVED→REOPENED.
enum CommissionStatus {
  DRAFT
  APPROVED
  REOPENED
}

model CommissionStatement {
  id           String           @id @default(cuid())
  period       String           @unique // "2026-06"
  status       CommissionStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  lines        CommissionLine[]
}

model CommissionLine {
  id          String              @id @default(cuid())
  statementId String
  recipientId String // user hưởng hoa hồng
  tier        String // QC | SALE_ADMIN | SALE | QL_TT | TRIAL_TEACHER
  amount      Int // VND; âm = clawback
  isClawback  Boolean             @default(false)
  leadId      String?
  statement   CommissionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  // Site GV 25/08 — hoa hồng GV dạy trial (tier TRIAL_TEACHER, 1% học phí khi học viên
  // học thử NHẬP HỌC). Khác 4 tầng Sale ở chỗ nó sinh TỪNG DÒNG theo ghi danh, ngay
  // trong transaction convert — nên cần khoá chống ghi trùng khi convert bị chạy lại.
  // 4 tầng Sale không dùng 2 cột này (setStatementLines ghi lại cả kỳ, tự nhất quán).
  enrollmentId String?
  note         String?

  @@unique([statementId, tier, recipientId, enrollmentId])
  @@index([statementId])
  @@index([recipientId])
  @@index([enrollmentId])
}

/// 27/08/2026 — HAI VAI HƯỞNG HOA HỒNG GẮN THEO CƠ SỞ.
/// Tên vai TRÙNG tên tầng trong `COMMISSION_TIERS` (lib/crm/commission.ts) — cố ý,
/// để engine ánh xạ vai → tầng bằng chính chuỗi đó, không cần bảng tra thứ hai.
enum CenterCommissionRole {
  /// Quảng cáo — tầng QC 1%.
  QC
  /// Quản lý trung tâm — tầng QL_TT 2%.
  QL_TT
}

/// SỔ "AI PHỤ TRÁCH CƠ SỞ NÀO, TỪ KHI NÀO TỚI KHI NÀO" (chủ dự án chốt 27/08/2026).
///
/// Vì sao là SỔ chứ không phải một cột "người phụ trách hiện tại": kỳ hoa hồng được
/// CHỐT LẠI nhiều lần và kỳ cũ có thể REOPEN. Một cột "hiện tại" nghĩa là đổi QC hôm
/// nay sẽ viết lại hoa hồng của tháng trước cho người mới — người làm việc tháng trước
/// mất tiền, và không dòng nào báo lỗi. Câu hỏi engine hỏi luôn là "ai phụ trách cơ sở
/// X TẠI THỜI ĐIỂM kế toán xác nhận thu tiền".
///
/// Biên hiệu lực PHẢI MỞ: `effectiveFrom <= t < effectiveTo` (xem lib/crm/commission-assignee.ts).
///
/// Một cơ sở có thể có NHIỀU dòng QC cùng hiệu lực ⇒ 1% chia đều (không có khoá chặn
/// chồng lấn, đó là thiết kế). Vai QL_TT được đường ghi ép còn một người và đồng bộ
/// với `Center.managerUserId`, nhưng engine vẫn chia đều nếu gặp nhiều — lưới an toàn
/// chống chi vượt tỉ lệ tầng khi dữ liệu lọt vào bằng đường khác.
model CenterCommissionAssignee {
  id String @id @default(cuid())

  /// Cơ sở được phụ trách. NOT NULL — một phân công luôn thuộc đúng một cơ sở.
  centerId  String
  center    Center  @relation("CenterCommissionAssignees", fields: [centerId], references: [id], onDelete: Cascade)
  /// P1 · US-07 — cột SONG SONG với centerId (ghi kép qua lib/org/dual-write.ts).
  orgUnitId String?

  role CenterCommissionRole

  /// LIÊN KẾT TÀI KHOẢN, không phải chuỗi tên — đây là điểm khác biệt với `Center.managerName`.
  /// Restrict: người rời công ty không được kéo theo dấu vết tiền đã chi cho họ.
  userId String
  user   User   @relation("CenterCommissionAssignments", fields: [userId], references: [id], onDelete: Restrict)

  effectiveFrom DateTime  @db.Timestamptz(6)
  /// `null` = đang phụ trách.
  effectiveTo   DateTime? @db.Timestamptz(6)

  note          String? @db.Text
  createdById   String?
  createdByName String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Chặn nhập TRÙNG KHÍT một dòng (bấm hai lần). KHÔNG chặn chồng lấn khác mốc —
  /// chồng lấn là hợp lệ với QC, và engine khử trùng theo userId nên không ai ăn hai suất.
  @@unique([centerId, role, userId, effectiveFrom])
  @@index([centerId, role, effectiveFrom])
  @@index([userId])
  @@index([orgUnitId])
}

// R6-F2 — Bản ghi LỆCH giữa can() v1 (matrix) và v2 (DB actor) khi shadow-run.
// Mục tiêu: report = 0 trong N ngày → an toàn bật RBAC_V2_ENABLED. Chỉ ghi khi LỆCH.
/// P3 · US-12 — lệch giữa resolver dataScope CŨ (đo centerId) và MỚI (đo orgUnitId).
///
/// BẢNG RIÊNG, không dùng chung `RbacShadowDiff`: bảng kia so `can()` v1↔v2 và có một
/// cổng đang đọc nó (`isSafeToEnableRbacV2`). Trộn hai phép so vào một bảng làm cả hai
/// báo cáo mất nghĩa và cổng kia đếm nhầm.
///
/// `ketQua` có BA giá trị chứ không phải hai: ngoài `LECH` còn `CHUA_PHU` — chỗ gọi
/// chưa truyền `orgUnitId` nên không so được. Đếm riêng vì đó là ĐỘ PHỦ, không phải
/// lỗi; và vì coi nó là lệch thì cổng 7 ngày sẽ không bao giờ xanh vì lý do sai.
model ScopeShadowDiff {
  id              String   @id @default(cuid())
  /// LECH | CHUA_PHU — `GIONG` KHÔNG ghi (ghi mọi request là tự DDoS chính mình).
  ketQua          String
  permissionKey   String
  /// "grant" (bảng PermissionGrant P0) hay "perm" (đường cũ đang enforce) — biết
  /// shadow phủ được nhánh nào.
  nguon           String
  userId          String
  /// Kết quả đường CŨ (đang chạy thật). Đây là thứ người dùng thực sự nhận được.
  cu              Boolean
  /// Kết quả đường MỚI; null khi `CHUA_PHU`.
  moi             Boolean?
  /// Ngữ cảnh đủ để TÁI HIỆN (AC2) — không phải chỉ để đếm.
  roleId          String?
  targetCenterId  String?
  targetOrgUnitId String?
  /// Đơn vị của dòng log (luật cứng #3). = targetOrgUnitId khi có, để lọc theo đơn vị.
  orgUnitId       String?
  lyDo            String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([ketQua, createdAt])
  @@index([permissionKey])
  @@index([orgUnitId])
}

model RbacShadowDiff {
  id        String   @id @default(cuid())
  action    String
  userId    String
  v1        Boolean
  v2        Boolean
  targetKey String? // mô tả target (centerId/classId...) để truy vết
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([action])
}

// R6-B1 — Tỉ lệ hoa hồng theo kỳ trong DB (thay hằng số DEFAULT_RATES).
// Mỗi tier có chuỗi version theo effectiveFrom/To; rate hiệu lực = row phủ thời điểm
// đóng đơn. Trần Σ rate ≤ 8% enforce khi ghi. SUPER_ADMIN sửa + audit + reason.
model CommissionRateConfig {
  id            String    @id @default(cuid())
  tier          String // QC | SALE_ADMIN | SALE | QL_TT
  rate          Float // 0..1
  effectiveFrom DateTime  @db.Timestamptz(6)
  effectiveTo   DateTime? @db.Timestamptz(6) // null = đang hiệu lực
  reason        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tier, effectiveFrom])
}

// R1-12 — Báo cáo marketing tuần/tháng (snapshot) của QL TT (SR.QD.217 C12.2).
enum ReportPeriodType {
  WEEK
  MONTH
}

model MarketingReport {
