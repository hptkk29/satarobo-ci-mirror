// R3-06 — Đồng ý dùng hình ảnh học viên (privacy-first, Doc 15 §8.3).
enum ConsentType {
  CLASS_MEDIA
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model StudentConsent {
  id        String        @id @default(cuid())
  studentId String
  type      ConsentType
