  center       Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  capacity     Int        @default(15)
  equipment    String[]   @default([])
  status       RoomStatus @default(ACTIVE)
  notes        String?    @db.Text
  displayOrder Int        @default(0)
