META_APP_SECRET=""             # App → Settings → Basic → App Secret (ký X-Hub-Signature-256)
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""      # reply Messenger + Ads Insights. CẦN quyền `pages_messaging`
