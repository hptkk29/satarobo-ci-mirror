ZALO_OA_ID="40213330288531842"
ZALO_OA_ACCESS_TOKEN=""
ZALO_LIVE="false"
ZALO_ZNS_TEMPLATE_ATTENDANCE=""
ZALO_ZNS_TEMPLATE_DEBT=""
# BGĐ 31/07 — template ZNS thông báo cấp tài khoản (TK + link, KHÔNG kèm mật khẩu).
# Mẫu ZBS `616899` tạo 01/08/2026, tham số `name`(30) + `login_id`(15) — xem bảng
# khai ở lib/zalo/templates.ts. ⚠️ ĐANG CHỜ ZALO DUYỆT: đặt giá trị trước khi
# duyệt xong = mọi cú gửi hỏng mà provision.ts nuốt lỗi nên im lặng. Để trống thì
# hệ thống tự SKIP an toàn.
ZALO_ZNS_TEMPLATE_ACCOUNT=""
# AUTH-SĐT P5 — công tắc ngắt đường TỰ ĐỘNG cấp tài khoản phụ huynh theo SĐT
# (xác nhận đơn CONFIRMED + webhook SePay). Mặc định BẬT; để ngắt phải là đúng
# chuỗi `false` (viết hoa một chữ là vẫn chạy — xem lib/flags.test.ts).
# KHÔNG chắn các form nhân viên tự bấm; chỉ chắn đường chạy không có người duyệt.
# Kéo cờ khi: /kich-hoat chưa nhận SĐT (P5 chưa lên môi trường đó), hoặc ZNS chết
# hàng loạt khiến phụ huynh nhận tài khoản mà không nhận được mã.
AUTH_PHONE_PROVISIONING="true"
# AUTH-SĐT P5 — xác nhận đơn / biên nhận cho khách KHÔNG có email (mẫu đã duyệt
# 616258 "Học phí + tài khoản"). ⚠️ Đối chiếu TÊN THAM SỐ thật của mẫu trước khi
# đặt giá trị (bài học PR #77: mẫu Xác thực bắt tên `otp`, không phải tên tự đặt).
ZALO_ZNS_TEMPLATE_PAYMENT=""
# Auto-refresh (lib/zalo/token.ts): cấp 3 biến dưới (OAuth v4 1 lần) → tự xoay token.
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_REFRESH_TOKEN=""
ZALO_OA_TOKEN=""               # legacy (giữ tương thích)

